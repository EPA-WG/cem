# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly mark text files as UTF-8
*.md text working-tree-encoding=UTF-8
*.js text working-tree-encoding=UTF-8
*.mjs text working-tree-encoding=UTF-8
*.cjs text working-tree-encoding=UTF-8
*.ts text working-tree-encoding=UTF-8
*.mts text working-tree-encoding=UTF-8
*.cts text working-tree-encoding=UTF-8
*.json text working-tree-encoding=UTF-8
*.yml text working-tree-encoding=UTF-8
*.yaml text working-tree-encoding=UTF-8
*.html text working-tree-encoding=UTF-8
*.xhtml text working-tree-encoding=UTF-8
*.xml text working-tree-encoding=UTF-8
*.css text working-tree-encoding=UTF-8
*.scss text working-tree-encoding=UTF-8
*.svg text working-tree-encoding=UTF-8

# Preserve intentional byte-level line-ending fixtures.
packages/cem_ml/schema-packages/csv/v1/examples/line-ending-crlf.csv -text -diff
packages/cem_ml/schema-packages/cem-ql/v1/examples/line-ending-crlf.cemql -text -diff
packages/cem_ml/schema-packages/cem-ql/v1/examples/invalid-utf8.cemql -text -diff
examples/projects/native-projections/projections/*.cem-bin binary

# Preserve trailing spaces emitted by native byte-exact output fixtures.
examples/projects/csv-inventory/expected/low-stock.html whitespace=-blank-at-eol
examples/projects/json-yaml-report/expected/formatted.json whitespace=-blank-at-eol
examples/projects/json-yaml-report/expected/report.html whitespace=-blank-at-eol
examples/projects/xhtml-document/expected/article.html whitespace=-blank-at-eol
examples/projects/svg-diagram/expected/diagram.html whitespace=-blank-at-eol
examples/projects/mathml-formula/expected/formula.html whitespace=-blank-at-eol
examples/projects/css-stylesheet/expected/cards.html whitespace=-blank-at-eol
examples/projects/scss-stylesheet/expected/index.html whitespace=-blank-at-eol
examples/projects/cem-transform/expected/index.html whitespace=-blank-at-eol
examples/projects/xslt-transform/expected/index.html whitespace=-blank-at-eol
examples/projects/json-schema/expected/formatted-note.schema.json whitespace=-blank-at-eol
examples/projects/module-maps/expected/formatted-v1.json whitespace=-blank-at-eol
examples/projects/module-maps/expected/formatted-v2.json whitespace=-blank-at-eol
examples/projects/module-maps/expected/formatted-v3.json whitespace=-blank-at-eol
examples/projects/portable-config/expected/index.html whitespace=-blank-at-eol

# Preserve the missing-brace fixture's original EOF diagnostic position.
examples/projects/cemql-orders/failures/invalid-expression.cem-ql whitespace=-blank-at-eof

# Preserve original malformed XML input bytes used by failed-build fixtures.
examples/projects/cem-transform/failures/orders.xml whitespace=-blank-at-eof
examples/projects/xslt-transform/failures/orders.xml whitespace=-blank-at-eof

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
