{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "npmScope": "epa-wg",
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": [
            "default",
            "!{projectRoot}/.eslintrc.json",
            "!{projectRoot}/eslint.config.mjs",
            "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
            "!{projectRoot}/tsconfig.spec.json"
        ],
        "sharedGlobals": []
    },
    "plugins": [
        {
            "plugin": "@nx/js/typescript",
            "options": {
                "typecheck": {
                    "targetName": "typecheck"
                },
                "build": {
                    "targetName": "build",
                    "configName": "tsconfig.lib.json",
                    "buildDepsName": "build-deps",
                    "watchDepsName": "watch-deps"
                }
            }
        },
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "lint"
            }
        },
        {
            "plugin": "@nx/vitest",
            "options": {
                "testTargetName": "test",
                "ciTargetName": "test-ci",
                "testMode": "watch"
            }
        },
        "@monodon/rust"
    ],
    "release": {
        "groups": {
            "cem": {
                "projects": ["@epa-wg/cem", "@epa-wg/cem-theme", "@epa-wg/cem-components", "cem-elements", "@epa-wg/custom-element"],
                "projectsRelationship": "fixed",
                "releaseTag": {
                    "pattern": "{version}",
                    "requireSemver": true
                },
                "version": {
                    "groupPreVersionCommand": "node tools/scripts/sync-release-version.cjs && yarn dlx nx run-many -t build",
                    "conventionalCommits": true,
                    "updateDependents": "never",
                    "versionPrefix": "^",
                    "generatorOptions": {
                        "updateDependents": "never"
                    }
                },
                "changelog": {
                    "workspaceChangelog": {
                        "createRelease": "github"
                    },
                    "projectChangelogs": false
                }
            },
            "cem-ml-platform": {
                "projects": [
                    "cem_ml",
                    "cem_ml_cli",
                    "@epa-wg/cem-ml",
                    "@epa-wg/cem-ml-cli",
                    "cem_ml_cli_native_linux_amd64",
                    "cem_ml_cli_native_brew_arm64",
                    "cem_ml_cli_native_windows_amd64"
                ],
                "projectsRelationship": "fixed",
                "releaseTag": {
                    "pattern": "cem-ml-v{version}",
                    "requireSemver": true
                },
                "version": {
                    "groupPreVersionCommand": "yarn nx run cem_ml:verify:platform-version",
                    "specifierSource": "prompt",
                    "currentVersionResolver": "disk",
                    "versionPrefix": "=",
                    "updateDependents": "never",
                    "preserveMatchingDependencyRanges": false,
                    "versionActions": "tools/scripts/cem-ml-nx-version-actions.cjs"
                },
                "changelog": {
                    "workspaceChangelog": {
                        "createRelease": "github"
                    },
                    "projectChangelogs": false
                }
            }
        },
        "version": {
            "generatorOptions": {
                "currentVersionResolver": "git-tag",
                "specifierSource": "conventional-commits"
            }
        },
        "changelog": {
            "automaticFromRef": true
        }
    },
    "targetDefaults": {
        "nx-release-publish": {
            "options": {
                "access": "public"
            }
        },
        "test": {
            "dependsOn": ["^build"]
        }
    },
    "analytics": true
}
