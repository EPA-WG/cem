@doc cem-ml 1
{run |
    {import @content-type=application/xml @id=dispatch @schema=https://cem.dev/ns/data/xml/1
        @src=../data/card.xml |
        {transform @entrypoint=card @id=card @src=../templates/card.cemt
            @template-content-type="application/vnd.cem.template+cem"
            @template-schema=https://cem.dev/ns/template/cem-native/1 |
            {param @name=heading @value="Dispatch board"}
            {export @content-type=text/html @id=html @out=../generated/index.html
                @schema=https://cem.dev/ns/data/html/1}
}   }   }
