@doc cem-ml 1
{run |
    {import @content-type=application/xml @id=orders @schema=https://cem.dev/ns/data/xml/1
        @src=../data/orders.xml |
        {transform @content-type=application/cem @entrypoint=report @id=report
            @schema=https://cem.dev/ns/cem-ml/1 @src=../templates/report.xsl
            @template-content-type="application/xslt+xml"
            @template-schema=https://cem.dev/ns/transform/xslt/1 |
            {param @name=minimum @value=30}
            {transform @entrypoint=page @id=page @src=../templates/page.cemt
                @template-content-type="application/vnd.cem.template+cem"
                @template-schema=https://cem.dev/ns/template/cem-native/1 |
                {param @name=heading @value="Ready orders"}
                {export @content-type=text/html @id=page-html @out=../generated/index.html
                    @schema=https://cem.dev/ns/data/html/1}
}   }   }   }
