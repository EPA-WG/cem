@doc cem-ml 1
{run |
    {import @content-type=text/vnd.cem.scss @id=styles @schema=https://cem.dev/ns/data/scss/1
        @src=../styles/cards.scss |
        {export @content-type=text/css @id=css @out=../generated/cards.css
            @schema=https://cem.dev/ns/data/css/1}
    }
    {import @content-type=text/html @id=card @schema=https://cem.dev/ns/data/html/1
        @src=../data/card.html |
        {transform @entrypoint=main @id=page @src=../templates/page.cemt
            @template-content-type="application/vnd.cem.template+cem"
            @template-schema=https://cem.dev/ns/template/cem-native/1 |
            {export @content-type=text/html @id=html @out=../generated/index.html
                @schema=https://cem.dev/ns/data/html/1}
}   }   }
