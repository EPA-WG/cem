@doc cem-ml 1
{run |
    {import @id=cart-response @src=../data/cart.json @content-type=application/json
        @schema=https://cem.dev/ns/data/json/1 |
        {transform @id=cart-snapshot @src=../templates/snapshot.cemt @entrypoint=main
            @template-content-type="application/vnd.cem.template+cem"
            @template-schema=https://cem.dev/ns/template/cem-native/1 |
            {export @id=cart-page @out=../generated/cart.html @content-type=text/html
                @schema=https://cem.dev/ns/data/html/1}
        }
    }
}
