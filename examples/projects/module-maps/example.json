  "configurations": [
    {
      "id": "validate-v1",
      "name": "Validate v1 JSON source syntax",
      "kind": "validation",
      "source": "source-v1",
      "description": "Validate the JSON source buffer under the explicit version identity; deployment semantic rules are enforced by graph planning, not this syntax adapter.",
      "argv": [
        "validate",
        "$source",
        "--content-type",
        "application/vnd.cem.module-map+json",
        "--schema",
        "https://cem.dev/ns/data/module-map/1",
        "--format",
        "json",
        "--no-color"
      ],
      "expectedValidation": {
        "errorCount": 0,
        "warningCount": 0
      }
    },
    {
      "id": "inspect-v1",
      "name": "Inspect v1 source structure",
      "kind": "inspection",
      "source": "source-v1",
      "description": "Inspect the generic imported CEM source structure and original ranges; this is not a typed module-map AST or an execution plan.",
      "argv": [
        "inspect",
        "$source",
        "--content-type",
        "application/vnd.cem.module-map+json",
        "--schema",
        "https://cem.dev/ns/data/module-map/1",
        "--show",
        "ast",
        "--no-color"
      ],
      "expectedText": [
        "@schema=https://cem.dev/ns/cem-ml/1",
        "imports",
        "@byte-offset="
      ]
    },
    {
      "id": "format-v1",
      "name": "Format v1 map source",
      "kind": "conversion",
      "source": "source-v1",
      "dependencies": [
        "formatted-v1"
      ],
      "description": "Apply the native tabular JSON source formatter with exact expected bytes; formatting grants no deployment or read authority.",
      "argv": [
        "convert",
        "$source",
        "--content-type",
        "application/vnd.cem.module-map+json",
        "--schema",
        "https://cem.dev/ns/data/module-map/1",
        "--to-content-type",
        "application/vnd.cem.module-map+json",
        "--to-schema",
        "https://cem.dev/ns/data/module-map/1",
        "--cemt-formatter-profile",
        "tabular",
        "--output-color-type",
        "none",
        "--no-color"
      ],
      "expectedOutput": "formatted-v1"
    },
    {
      "id": "repair-v1",
      "name": "Repair v1 JSON syntax",
      "kind": "validation",
      "source": "invalid-syntax-v1",
      "description": "Restore the missing outer object brace after reviewing the original native EOF diagnostic; this does not validate deployment semantics.",
      "argv": [
        "validate",
        "$source",
        "--content-type",
        "application/vnd.cem.module-map+json",
        "--schema",
        "https://cem.dev/ns/data/module-map/1",
        "--format",
        "json",
        "--no-color"
      ],
      "expectedExit": 1,
      "expectedValidation": {
        "errorCount": 1,
        "warningCount": 0,
        "errorCode": "cem.json.parse_error",
        "location": {
          "line": 6,
          "column": 1,
          "byteOffset": 119
        }
      },
      "repair": {
        "find": "\"@demo/caption\": \"../modules/caption.js\"\n  }\n",
        "replace": "\"@demo/caption\": \"../modules/caption.js\"\n  }\n}\n"
      }
    },
    {
      "id": "build-v1",
      "name": "Build the v1 mapped deployment",
      "kind": "transformation-graph",
      "source": "graph-v1",
      "dependencies": [
        "caption-module",
        "expected-html-v1",
        "page-v1",
        "source-v1",
        "target-v1"
      ],
      "description": "Lower the real v1 paired-map contract, copy only declared resources and rewrite the authored HTML import map; the sandboxed preview never executes those modules.",
      "entryArtifact": "generated/v1/index.html",
      "argv": [
        "transform",
        "--config",
        "$source",
        "--config-content-type",
        "application/cem",
        "--config-schema",
        "https://cem.dev/ns/cli/transform-config/1"
      ],
      "expectedGraphOutputs": {
        "generated/v1/index.html": "expected-html-v1",
        "generated/v1/assets/caption.js": "caption-module"
      },
      "expectedUnmappedOutputs": [
        "generated/v1/index.html",
        "generated/v1/assets/caption.js"
      ],
      "expectedNativeAssets": [
        {
          "specifier": "@demo/caption",
          "source": "caption-module",
          "sourceMap": "source-v1",
          "destination": "generated/v1/assets/caption.js",
          "target": "./assets/caption.js",
          "contentType": "text/javascript",
          "expectedOutput": "caption-module"
        }
      ],
      "expectedNativeAssetHash": "d7ea6404f152aa9cb257a78827a72856ffc58f889bd01c4f1e8b9830561fee70",
      "expectedGraphRefusals": [
        {
          "source": "source-v1",
          "replacement": "invalid-contract-v1",
          "exitCode": 2,
          "code": "cem.module_map.entries_mismatch"
        }
      ]
    },
