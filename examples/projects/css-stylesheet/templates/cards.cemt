@doc cem-ml 1
@ns template = "https://cem.dev/ns/template/cem-native/1"
@ns cem = "https://cem.dev/ns/core/1"
@default template
{param @name=input @required=true}
{template @name=main @visibility=public @cem:whitespace=layout |
    {cem:variable @name=main
        @select='seq:first(seq:where(input.descendants, fn(node) => node.kind == "element" && node.name == "main"))'}
    {element @name=html @namespace=http://www.w3.org/1999/xhtml |
        {attribute @name=lang @value=en}
        {element @name=head @namespace=http://www.w3.org/1999/xhtml |
            {element @name=meta @namespace=http://www.w3.org/1999/xhtml |
                {attribute @name=charset @value=utf-8}
            }
            {element @name=title @namespace=http://www.w3.org/1999/xhtml | Scoped card stylesheet}
            {element @name=link @namespace=http://www.w3.org/1999/xhtml |
                {attribute @name=rel @value=stylesheet}
                {attribute @name=href @value=cards.css}
        }   }
        {element @name=body @namespace=http://www.w3.org/1999/xhtml |
            {$ | main}
}   }   }
