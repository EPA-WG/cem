{
  "id": "login",
  "name": "Login",
  "version": "2.2.0",
  "description": "Login source, equivalent XPath/CEM-QL queries, HTML/CEM semantic comparison, schema validation and command configurations.",
  "sources": [
    {
      "id": "login-cem",
      "source": "examples/cem-ml/login.cem",
      "path": "data/login.cem",
      "contentType": "application/cem",
      "schema": "https://cem.dev/ns/cem-ml/1"
    },
    {
      "id": "login-html",
      "source": "examples/semantic/login.html",
      "path": "data/login.html",
      "contentType": "text/html",
      "schema": "https://cem.dev/ns/data/html/1"
    },
    {
      "id": "login-invalid",
      "source": "examples/projects/login/login-invalid.cem",
      "path": "data/login-invalid.cem",
      "contentType": "application/cem",
      "schema": "urn:demo:login",
      "role": "data"
    },
    {
      "id": "login-schema-package",
      "source": "examples/projects/login/login-schema-package.cem",
      "path": "schemas/login-schema-package.cem",
      "contentType": "application/vnd.cem.schema-package+cem",
      "schema": "https://cem.dev/ns/schema-package/1",
      "role": "schema"
    },
    {
      "id": "login-schema",
      "source": "examples/projects/login/login-schema.cem",
      "path": "schemas/login-schema.cem",
      "contentType": "application/cem",
      "schema": "https://cem.dev/ns/schema/1",
      "role": "schema"
    },
    {
      "id": "readme",
      "source": "examples/projects/login/README.md",
      "path": "README.md",
      "contentType": "text/markdown",
      "schema": "https://cem.dev/ns/data/markdown/1",
      "role": "data"
    },
    {
      "id": "login-semantics-query",
      "source": "examples/projects/login/queries/semantics.xpath",
      "path": "queries/semantics.xpath",
      "contentType": "application/vnd.cem.xpath",
      "schema": "https://cem.dev/ns/query/xpath/1",
      "role": "query"
    },
    {
      "id": "login-semantic-contract",
      "source": "examples/projects/login/expected/semantics.json",
      "path": "expected/semantics.json",
      "contentType": "application/json",
      "schema": "https://cem.dev/ns/data/json/1",
      "role": "data"
    },
    {
      "id": "login-semantics-cemql",
      "source": "examples/projects/login/queries/semantics.cemql",
      "path": "queries/semantics.cemql",
      "contentType": "application/vnd.cem.query+cem-ql",
      "schema": "https://cem.dev/ns/query/cem-ql/1",
      "role": "query"
    }
  ],
  "collections": [
    "amsterdam-2026"
  ],
  "configurations": [
    {
      "id": "read-edit",
      "name": "Parse login",
      "kind": "inspection",
      "source": "login-cem",
      "argv": [
        "parse",
        "$source",
        "--content-type",
        "application/cem",
        "--schema",
        "https://cem.dev/ns/cem-ml/1",
        "--format",
        "ast",
        "--no-color"
      ],
      "expectedText": [
        "https://cem.dev/ns/projection/ast/1",
        "@name=input",
        "@value=\"Sign in\"",
        "@byte-offset="
      ]
    },
    {
      "id": "validate",
      "name": "Validate login",
      "kind": "validation",
      "source": "login-cem",
      "argv": [
        "validate",
        "$source",
        "--content-type",
        "application/cem",
        "--schema",
        "https://cem.dev/ns/cem-ml/1",
        "--format",
        "json",
        "--no-color"
      ],
      "expectedValidation": {
        "errorCount": 0,
        "warningCount": 3,
        "warningCode": "cem.ast.unresolved_reference"
      }
    },
    {
      "id": "inspect",
      "name": "Inspect login",
      "kind": "inspection",
      "source": "login-cem",
      "argv": [
        "inspect",
        "$source",
        "--content-type",
        "application/cem",
        "--schema",
        "https://cem.dev/ns/cem-ml/1",
        "--show",
        "ast",
        "--no-color"
      ],
      "expectedText": [
        "https://cem.dev/ns/projection/ast/1",
        "@name=input",
        "@value=\"Sign in\"",
        "@byte-offset="
      ]
    },
    {
      "id": "html-conversion",
      "name": "Convert HTML to CEM-ML",
      "kind": "conversion",
      "source": "login-html",
      "argv": [
        "convert",
        "$source",
        "--content-type",
        "text/html",
        "--schema",
        "https://cem.dev/ns/data/html/1",
        "--to-content-type",
        "application/cem",
        "--to-schema",
        "https://cem.dev/ns/cem-ml/1",
        "--output-color-type",
        "none"
      ],
      "expectedText": [
        "@name=email",
        "@name=password",
        "@method=post",
        "@required",
        "Sign in"
      ]
    },
    {
      "id": "validation-repair",
      "name": "Validate form method",
      "kind": "validation",
      "source": "login-invalid",
      "dependencies": [
        "login-schema-package",
        "login-schema"
      ],
      "description": "Validate the form method using the project-owned teaching schema.",
      "argv": [
        "validate",
        "$source",
        "--content-type",
        "application/cem",
        "--schema",
        "urn:demo:login",
        "--schema-package",
        "$login-schema-package",
        "--format",
        "json",
        "--no-color"
      ],
      "expectedExit": 1,
      "expectedValidation": {
        "errorCount": 1,
        "warningCount": 3,
        "warningCode": "cem.ast.unresolved_reference",
        "errorCode": "demo.login.method_required"
      },
      "repair": {
        "find": "@cem:form=\"sign-in\"",
        "replace": "@cem:form=\"sign-in\" @method=post"
      }
    },
    {
      "id": "semantics-html",
      "name": "Login semantics from HTML",
      "kind": "query",
      "source": "login-html",
      "dependencies": [
        "login-semantics-query",
        "login-semantic-contract"
      ],
      "description": "Run the shared 21-field Login contract and compare with expected/semantics.json. Source wrappers and HTML mirrors are mapped explicitly by the query.",
      "argv": [
        "query",
        "$source",
        "--content-type",
        "text/html",
        "--schema",
        "https://cem.dev/ns/data/html/1",
        "--query-file",
        "$login-semantics-query",
        "--query-content-type",
        "application/vnd.cem.xpath",
        "--query-schema",
        "https://cem.dev/ns/query/xpath/1",
        "--output",
        "json"
      ],
      "expectedSemanticContract": "login-semantic-contract"
    },
    {
      "id": "semantics-cem",
      "name": "Login semantics from CEM-ML",
      "kind": "query",
      "source": "login-cem",
      "dependencies": [
        "login-semantics-query",
        "login-semantic-contract"
      ],
      "description": "Run the shared 21-field Login contract and compare with expected/semantics.json. Source wrappers and HTML mirrors are mapped explicitly by the query.",
      "argv": [
        "query",
        "$source",
        "--content-type",
        "application/cem",
        "--schema",
        "https://cem.dev/ns/cem-ml/1",
        "--query-file",
        "$login-semantics-query",
        "--query-content-type",
        "application/vnd.cem.xpath",
        "--query-schema",
        "https://cem.dev/ns/query/xpath/1",
        "--output",
        "json"
      ],
      "expectedSemanticContract": "login-semantic-contract"
    },
    {
      "id": "semantics-html-cemql",
      "name": "Login semantics from HTML (CEM-QL)",
      "kind": "query",
      "source": "login-html",
      "dependencies": [
        "login-semantics-cemql",
        "login-semantic-contract"
      ],
      "description": "Run the equivalent CEM-QL module against the same 21-field contract. Consume ready namespace names explicitly with a bounded navigation budget; source declarations remain inert.",
      "argv": [
        "query",
        "$source",
        "--content-type",
        "text/html",
        "--schema",
        "https://cem.dev/ns/data/html/1",
        "--query-file",
        "$login-semantics-cemql",
        "--query-content-type",
        "application/vnd.cem.query+cem-ql",
        "--query-schema",
        "https://cem.dev/ns/query/cem-ql/1",
        "--ready-names",
        "--scope-budget",
        "queueSize=1024",
        "--output",
        "json"
      ],
      "expectedSemanticContract": "login-semantic-contract"
    },
    {
      "id": "semantics-cem-cemql",
      "name": "Login semantics from CEM-ML (CEM-QL)",
      "kind": "query",
      "source": "login-cem",
      "dependencies": [
        "login-semantics-cemql",
        "login-semantic-contract"
      ],
      "description": "Run the equivalent CEM-QL module against the same 21-field contract. Consume ready namespace names explicitly with a bounded navigation budget; source declarations remain inert.",
      "argv": [
        "query",
        "$source",
        "--content-type",
        "application/cem",
        "--schema",
        "https://cem.dev/ns/cem-ml/1",
        "--query-file",
        "$login-semantics-cemql",
        "--query-content-type",
        "application/vnd.cem.query+cem-ql",
        "--query-schema",
        "https://cem.dev/ns/query/cem-ql/1",
        "--ready-names",
        "--scope-budget",
        "queueSize=1024",
        "--output",
        "json"
      ],
      "expectedSemanticContract": "login-semantic-contract"
    }
  ]
}
