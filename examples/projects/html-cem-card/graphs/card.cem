@doc cem-ml 1
{run |
    {import @id=data @src=../data/card.html @content-type=text/html
        @schema=https://cem.dev/ns/data/html/1 |
        {transform @id=card @src=../templates/card.cemt @entrypoint=main
            @template-content-type="application/vnd.cem.template+cem"
            @template-schema=https://cem.dev/ns/template/cem-native/1 |
            {export @id=page @out=../generated/card.html @content-type=text/html
                @schema=https://cem.dev/ns/data/html/1}
        }
    }
}
