@doc cem-ml 1
@ns template = "https://cem.dev/ns/template/cem-native/1"
@ns cem = "https://cem.dev/ns/core/1"
@default template
{param @name=input @required=true}
{template @name=main @visibility=public @cem:whitespace=layout |
    {cem:variable @name=diagram
        @select='seq:first(seq:where(input.descendants, fn(node) => node.kind == "element" && node.namespace == "http://www.w3.org/2000/svg" && node.name == "svg"))'}
    {element @name=section @namespace=http://www.w3.org/1999/xhtml |
        {attribute @name=aria-label @value="SVG diagram preview"}
        {element @name=h1 @namespace=http://www.w3.org/1999/xhtml |
            {$ | str:normalize_space(dom:text(seq:first(seq:where(diagram.children, fn(node) => node.kind == "element" && node.namespace == diagram.namespace && node.name == "title"))))}
        }
        {element @name=p @namespace=http://www.w3.org/1999/xhtml | Rendered from retained SVG data.}
        {$ | diagram}
}   }
