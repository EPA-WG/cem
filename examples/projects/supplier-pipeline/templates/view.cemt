@doc cem-ml 1
@ns template = "https://cem.dev/ns/template/cem-native/1"
@ns cem = "https://cem.dev/ns/core/1"
@default template
{param @name=input @required=true}
{template @name=main @visibility=public @cem:whitespace=layout |
    {element @name=section @namespace=http://www.w3.org/1999/xhtml |
        {attribute @name=aria-label @value="Supplier availability"}
        {element @name=h1 @namespace=http://www.w3.org/1999/xhtml | Supplier availability}
        {element @name=p @namespace=http://www.w3.org/1999/xhtml | Stock is matched by product ID. Unknown and ambiguous stock cannot be ordered.}
        {element @name=ul @namespace=http://www.w3.org/1999/xhtml |
            {cem:for-each @as=product
                @select='seq:where(seq:flat_map(seq:where(input, fn(root) => root.kind == "element" && root.name == "array"), fn(root) => root.children), fn(node) => node.kind == "element" && node.namespace == "cem:generic-data" && node.name == "object")' |
                {element @name=li @namespace=http://www.w3.org/1999/xhtml |
                    {cem:for-each @as=field @select='("id", "name", "quantity", "status")' |
                        {cem:if @test='field != "id"' | ``` — ```}
                        {$ | str:normalize_space(dom:text(seq:where(product.children, fn(property) => dom:text(dom:attribute(property, "name")) == field)))}
                    }
                }
            }
        }
    }
}
