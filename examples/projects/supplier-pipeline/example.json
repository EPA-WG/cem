{
  "id": "supplier-pipeline",
  "name": "Supplier pipeline",
  "version": "1.1.0",
  "description": "Namespace-aware XML catalog validation and selection, then XML products and CSV stock reconciled through explicit native domain rules into JSON, YAML and HTML, with failure/repair and source provenance.",
  "collections": [
    "amsterdam-2026",
    "content-types-data",
    "content-types-queries-transformations"
  ],
  "sources": [
    {
      "id": "supplier-catalog",
      "source": "examples/projects/supplier-pipeline/data/catalog.xml",
      "path": "data/catalog.xml",
      "contentType": "application/xml",
      "schema": "https://cem.dev/ns/data/xml/1",
      "role": "data"
    },
    {
      "id": "supplier-stock",
      "source": "examples/projects/supplier-pipeline/data/stock.csv",
      "path": "data/stock.csv",
      "contentType": "text/csv;header=present",
      "schema": "https://cem.dev/ns/data/csv/1",
      "role": "data"
    },
    {
      "id": "supplier-reconcile",
      "source": "examples/projects/supplier-pipeline/templates/reconcile.cemt",
      "path": "templates/reconcile.cemt",
      "contentType": "application/vnd.cem.template+cem",
      "schema": "https://cem.dev/ns/template/cem-native/1",
      "role": "template"
    },
    {
      "id": "supplier-view",
      "source": "examples/projects/supplier-pipeline/templates/view.cemt",
      "path": "templates/view.cemt",
      "contentType": "application/vnd.cem.template+cem",
      "schema": "https://cem.dev/ns/template/cem-native/1",
      "role": "template"
    },
    {
      "id": "supplier-graph",
      "source": "examples/projects/supplier-pipeline/graphs/availability.cem",
      "path": "graphs/availability.cem",
      "contentType": "application/cem",
      "schema": "https://cem.dev/ns/cli/transform-config/1",
      "role": "transform-config"
    },
    {
      "id": "supplier-expected-json",
      "source": "examples/projects/supplier-pipeline/expected/availability.json",
      "path": "expected/availability.json",
      "contentType": "application/json",
      "schema": "https://cem.dev/ns/data/json/1",
      "role": "data"
    },
    {
      "id": "supplier-expected-yaml",
      "source": "examples/projects/supplier-pipeline/expected/availability.yaml",
      "path": "expected/availability.yaml",
      "contentType": "application/yaml",
      "schema": "https://cem.dev/ns/data/yaml/1",
      "role": "data"
    },
    {
      "id": "supplier-expected-html",
      "source": "examples/projects/supplier-pipeline/expected/availability.html",
      "path": "expected/availability.html",
      "contentType": "text/html",
      "schema": "https://cem.dev/ns/data/html/1",
      "role": "data"
    },
    {
      "id": "supplier-products-query",
      "source": "examples/projects/supplier-pipeline/queries/products.xpath",
      "path": "queries/products.xpath",
      "contentType": "application/vnd.cem.xpath",
      "schema": "https://cem.dev/ns/query/xpath/1",
      "role": "query"
    },
    {
      "id": "supplier-expected-products",
      "source": "examples/projects/supplier-pipeline/expected/products.json",
      "path": "expected/products.json",
      "contentType": "application/json",
      "schema": "https://cem.dev/ns/data/json/1",
      "role": "data"
    },
    {
      "id": "supplier-invalid-catalog",
      "source": "examples/projects/supplier-pipeline/data/catalog-invalid.xml",
      "path": "data/catalog-invalid.xml",
      "contentType": "application/xml",
      "schema": "https://cem.dev/ns/data/xml/1",
      "role": "data"
    },
    {
      "id": "readme",
      "source": "examples/projects/supplier-pipeline/README.md",
      "path": "README.md",
      "contentType": "text/markdown",
      "schema": "https://cem.dev/ns/data/markdown/1",
      "role": "data"
    }
  ],
  "configurations": [
    {
      "id": "catalog-source",
      "name": "Inspect supplier catalog",
      "kind": "inspection",
      "source": "supplier-catalog",
      "argv": [
        "parse",
        "$source",
        "--content-type",
        "application/xml",
        "--schema",
        "https://cem.dev/ns/data/xml/1",
        "--format",
        "ast",
        "--no-color"
      ]
    },
    {
      "id": "validate-catalog",
      "name": "Validate supplier catalog",
      "kind": "validation",
      "source": "supplier-catalog",
      "description": "Validate native XML source syntax and namespace bindings; business rules remain in the availability templates.",
      "argv": [
        "validate",
        "$source",
        "--content-type",
        "application/xml",
        "--schema",
        "https://cem.dev/ns/data/xml/1",
        "--format",
        "json",
        "--no-color"
      ],
      "expectedValidation": {
        "errorCount": 0,
        "warningCount": 0
      }
    },
    {
      "id": "query-products",
      "name": "Select namespaced supplier products",
      "kind": "query",
      "source": "supplier-catalog",
      "dependencies": [
        "supplier-products-query",
        "supplier-expected-products"
      ],
      "description": "Select product IDs and names by expanded XML namespace, independently of the source prefix spelling.",
      "argv": [
        "query",
        "$source",
        "--content-type",
        "application/xml",
        "--schema",
        "https://cem.dev/ns/data/xml/1",
        "--query-file",
        "$supplier-products-query",
        "--query-content-type",
        "application/vnd.cem.xpath",
        "--query-schema",
        "https://cem.dev/ns/query/xpath/1",
        "--namespace",
        "supplier=urn:demo:supplier",
        "--output",
        "json"
      ],
      "expectedSemanticContract": "supplier-expected-products"
    },
    {
      "id": "repair-catalog",
      "name": "Repair malformed supplier XML",
      "kind": "validation",
      "source": "supplier-invalid-catalog",
      "description": "Run the deliberate mismatched-tag failure, inspect the original source range, then repair the closing product tag and rerun.",
      "argv": [
        "validate",
        "$source",
        "--content-type",
        "application/xml",
        "--schema",
        "https://cem.dev/ns/data/xml/1",
        "--format",
        "json",
        "--no-color"
      ],
      "expectedExit": 1,
      "expectedValidation": {
        "errorCount": 2,
        "warningCount": 0,
        "errorCode": "cem.xml.parse_error"
      },
      "repair": {
        "find": "</product-broken>",
        "replace": "</product>"
      }
    },
    {
      "id": "stock-source",
      "name": "Inspect supplier stock",
      "kind": "inspection",
      "source": "supplier-stock",
      "argv": [
        "parse",
        "$source",
        "--content-type",
        "text/csv;header=present",
        "--schema",
        "https://cem.dev/ns/data/csv/1",
        "--format",
        "ast",
        "--no-color"
      ]
    },
    {
      "id": "availability",
      "name": "Supplier availability pipeline",
      "kind": "transformation-graph",
      "source": "supplier-graph",
      "dependencies": [
        "supplier-catalog",
        "supplier-stock",
        "supplier-reconcile",
        "supplier-view",
        "supplier-expected-json",
        "supplier-expected-yaml",
        "supplier-expected-html"
      ],
      "description": "Match saved XML products and CSV stock by ID; generate an HTML view, JSON service payload and YAML partner feed. Edit stock through Resources, save and rerun.",
      "argv": [
        "transform",
        "--config",
        "$source",
        "--config-content-type",
        "application/cem",
        "--config-schema",
        "https://cem.dev/ns/cli/transform-config/1",
        "--scope-budget",
        "queueSize=1024"
      ],
      "expectedGraphOutputs": {
        "generated/availability.json": "supplier-expected-json",
        "generated/availability.yaml": "supplier-expected-yaml",
        "generated/availability.html": "supplier-expected-html"
      },
      "entryArtifact": "generated/availability.html"
    }
  ]
}
