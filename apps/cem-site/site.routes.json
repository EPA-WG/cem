    {
      "kind": "page",
      "route": "/releases/cem-elements/",
      "output": "releases/cem-elements/index.html",
      "source": "packages/cem-elements/CHANGELOG.md",
      "sourceKind": "authored",
      "contentRole": "release-notes",
      "relativeLinkPolicy": "none",
      "owner": "cem-elements",
      "upstreamTarget": null,
      "importId": "cem-elements-releases-source",
      "exportId": "cem-elements-releases"
    },
    {
      "kind": "page",
      "route": "/releases/cem-theme/",
      "output": "releases/cem-theme/index.html",
      "source": "packages/cem-theme/CHANGELOG.md",
      "sourceKind": "authored",
      "contentRole": "release-notes",
      "relativeLinkPolicy": "none",
      "owner": "@epa-wg/cem-theme",
      "upstreamTarget": null,
      "importId": "theme-releases-source",
      "exportId": "theme-releases"
    },
    {
      "kind": "page",
      "route": "/releases/custom-element/",
      "output": "releases/custom-element/index.html",
      "source": "packages/custom-element/CHANGELOG.md",
      "sourceKind": "authored",
      "contentRole": "release-notes",
      "relativeLinkPolicy": "none",
      "owner": "@epa-wg/custom-element",
      "upstreamTarget": null,
      "importId": "custom-element-releases-source",
      "exportId": "custom-element-releases"
    }
  ]
}
