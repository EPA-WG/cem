{
  "version": 1,
  "exclusions": [
    "docs/archive/**",
    "docs/todo.md",
    "roadmap.md",
    "**/*.tmp.md",
    "**/figma/**",
    "**/cem.tokens.intermediate.json",
    "**/cem.tokens.resolved.json"
  ],
  "entries": [
    {
      "kind": "page",
      "route": "/",
      "output": "index.html",
      "source": "apps/cem-site/content/_index.md",
      "sourceKind": "authored",
      "contentRole": "landing",
      "relativeLinkPolicy": "site-routes",
      "owner": "cem-site",
      "upstreamTarget": null,
      "importId": "home-source",
      "exportId": "home"
    },
    {
      "kind": "page",
      "route": "/guides/",
      "output": "guides/index.html",
      "source": "apps/cem-site/content/guides/_index.md",
      "sourceKind": "authored",
      "contentRole": "guide-index",
      "relativeLinkPolicy": "site-routes",
      "owner": "cem-site",
      "upstreamTarget": null,
      "importId": "guides-source",
      "exportId": "guides"
    },
    {
      "kind": "page",
      "route": "/guides/cem-ml/cli/",
      "output": "guides/cem-ml/cli/index.html",
      "source": "packages/cem-ml-cli-npm/README.md",
      "sourceKind": "authored",
      "contentRole": "guide",
      "relativeLinkPolicy": "none",
      "owner": "@epa-wg/cem-ml-cli",
      "upstreamTarget": null,
      "importId": "cli-guide-source",
      "exportId": "cli-guide"
    },
    {
      "kind": "page",
      "route": "/reference/cem-ml/transform-config/",
      "output": "reference/cem-ml/transform-config/index.html",
      "source": "packages/cem_ml/dist/cli/transform-config.md",
      "sourceKind": "generated",
      "contentRole": "generated-reference",
      "relativeLinkPolicy": "none",
      "owner": "cem_ml",
      "upstreamTarget": "cem_ml:build:docs",
      "importId": "transform-reference-source",
      "exportId": "transform-reference"
    },
    {
      "kind": "page",
      "route": "/reference/cem-ml/wasm-runtime/",
      "output": "reference/cem-ml/wasm-runtime/index.html",
      "source": "packages/cem-ml-npm/README.md",
      "sourceKind": "authored",
      "contentRole": "authored-reference",
      "relativeLinkPolicy": "none",
      "owner": "@epa-wg/cem-ml",
      "upstreamTarget": null,
      "importId": "wasm-reference-source",
      "exportId": "wasm-reference"
    },
    {
      "kind": "page",
      "route": "/tokens/",
      "output": "tokens/index.html",
      "source": "packages/cem-theme/dist/lib/tokens/cem.tokens.catalog.json",
      "sourceKind": "generated",
      "contentRole": "catalog",
      "relativeLinkPolicy": "none",
      "owner": "@epa-wg/cem-theme",
      "upstreamTarget": "@epa-wg/cem-theme:build:tokens",
      "importId": "token-catalog-source",
      "exportId": "token-browser",
      "canonicalSources": [
        "packages/cem-theme/src/lib/tokens/cem-colors.md",
        "packages/cem-theme/src/lib/tokens/cem-dimension.md",
        "packages/cem-theme/src/lib/tokens/cem-timing.md",
        "packages/cem-theme/src/lib/tokens/cem-breakpoints.md",
        "packages/cem-theme/src/lib/tokens/cem-coupling.md",
        "packages/cem-theme/src/lib/tokens/cem-controls.md",
        "packages/cem-theme/src/lib/tokens/cem-shape.md",
        "packages/cem-theme/src/lib/tokens/cem-stroke.md",
        "packages/cem-theme/src/lib/tokens/cem-layering.md",
        "packages/cem-theme/src/lib/tokens/cem-voice-fonts-typography.md"
      ]
    },
    {
      "kind": "page",
      "route": "/components/",
      "output": "components/index.html",
      "source": "packages/cem-components/dist/catalog/cem.components.catalog.json",
      "sourceKind": "generated",
      "contentRole": "catalog",
      "relativeLinkPolicy": "none",
      "owner": "@epa-wg/cem-components",
      "upstreamTarget": "@epa-wg/cem-components:build:catalog",
      "importId": "component-catalog-source",
      "exportId": "component-gallery",
      "canonicalSources": [
        "docs/component-mvp.md",
        "packages/cem-components/src/lib/primitives.ts",
        "packages/cem-components/docs/component-reference.md",
        "packages/cem-components/docs/conventions.md",
        "packages/cem-components/docs/accessibility.md"
      ],
      "evidenceSources": [
        "packages/cem-components/dist/reports/component-state-matrix.json"
      ]
    },
    {
      "kind": "page",
      "route": "/examples/cem-ml/",
      "output": "examples/cem-ml/index.html",
      "source": "examples/cem-ml/README.md",
      "sourceKind": "authored",
      "contentRole": "example-index",
      "relativeLinkPolicy": "canonical-source",
      "canonicalSourceBase": "https://github.com/EPA-WG/cem/blob/develop/examples/cem-ml/",
      "owner": "@epa-wg/cem",
      "upstreamTarget": null,
      "importId": "cem-ml-examples-source",
      "exportId": "cem-ml-examples"
    },
    {
      "kind": "page",
      "route": "/examples/components/",
      "output": "examples/components/index.html",
      "source": "packages/cem-components/examples/README.md",
      "sourceKind": "authored",
      "contentRole": "example-index",
      "relativeLinkPolicy": "canonical-source",
      "canonicalSourceBase": "https://github.com/EPA-WG/cem/blob/develop/packages/cem-components/examples/",
      "owner": "@epa-wg/cem-components",
      "upstreamTarget": null,
      "importId": "component-examples-source",
      "exportId": "component-examples"
    },
    {
      "kind": "page",
      "route": "/reference/components/",
      "output": "reference/components/index.html",
      "source": "packages/cem-components/docs/component-reference.md",
      "sourceKind": "authored",
      "contentRole": "authored-reference",
      "relativeLinkPolicy": "canonical-source",
      "canonicalSourceBase": "https://github.com/EPA-WG/cem/blob/develop/packages/cem-components/docs/",
      "owner": "@epa-wg/cem-components",
      "upstreamTarget": null,
      "importId": "component-reference-source",
      "exportId": "component-reference"
    },
    {
      "kind": "page",
      "route": "/releases/",
      "output": "releases/index.html",
      "source": "CHANGELOG.md",
      "sourceKind": "authored",
      "contentRole": "release-notes",
      "relativeLinkPolicy": "canonical-source",
      "canonicalSourceBase": "https://github.com/EPA-WG/cem/blob/develop/",
      "owner": "@epa-wg/cem",
      "upstreamTarget": null,
      "importId": "workspace-releases-source",
      "exportId": "workspace-releases"
    },
    {
      "kind": "page",
      "route": "/releases/cem-components/",
      "output": "releases/cem-components/index.html",
      "source": "packages/cem-components/CHANGELOG.md",
      "sourceKind": "authored",
      "contentRole": "release-notes",
      "relativeLinkPolicy": "none",
      "owner": "@epa-wg/cem-components",
      "upstreamTarget": null,
