@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
  // Imported inputs use the retained cem:generic-data vocabulary.
  {param @name="input" @type="object" @required=true}
  {template @name="comparison" @visibility="public" |
    {body |
      {element @name="html" @namespace="http://www.w3.org/1999/xhtml" |
        {attribute @name="lang" @value="en"}
        {element @name="head" @namespace="http://www.w3.org/1999/xhtml" |
          {element @name="meta" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="charset" @value="utf-8"}
          }
          {element @name="meta" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="name" @value="viewport"}
            {attribute @name="content" @value="width=device-width, initial-scale=1"}
          }
          {element @name="title" @namespace="http://www.w3.org/1999/xhtml" |
            Angular Material coverage comparison
          }
        }
        {element @name="body" @namespace="http://www.w3.org/1999/xhtml" |
          {element @name="header" @namespace="http://www.w3.org/1999/xhtml" |
            {element @name="nav" @namespace="http://www.w3.org/1999/xhtml" |
              {attribute @name="aria-label" @value="Primary"}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/"}
                CEM Site
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/guides/"}
                Guides
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/packages/"}
                Packages
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/guides/cem-ml/cli/"}
                CLI guide
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/reference/cem-ml/transform-config/"}
                CEM-ML reference
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/tokens/"}
                Tokens
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/components/"}
                Components
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/components/angular-material/"}
                Material comparison
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/examples/interactive/"}
                Interactive examples
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/search/"}
                Search
              }
            }
          }
          {element @name="main" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="id" @value="content"}
            {element @name="h1" @namespace="http://www.w3.org/1999/xhtml" |
              {attribute @name="id" @value="angular-material-comparison"}
              Angular Material coverage comparison
            }
            {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
              This static projection maps the complete pinned Angular Material catalog to CEM component and behavior owners. Angular Material is a coverage benchmark, not a runtime dependency or API-compatibility target.
            }
            {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
              Browse the
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/components/"}
                public component gallery
              }
              or read the
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/reference/components/"}
                CEM component reference
              }.
            }
            {element @name="section" @namespace="http://www.w3.org/1999/xhtml" |
              {element @name="h2" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="id" @value="pinned-benchmark"}
                Pinned benchmark
              }
              {element @name="dl" @namespace="http://www.w3.org/1999/xhtml" |
                {element @name="dt" @namespace="http://www.w3.org/1999/xhtml" | Product}
                {element @name="dd" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "benchmark").children.children, fn(member) => member.attributes.value == "product").children.children.value}}
                {element @name="dt" @namespace="http://www.w3.org/1999/xhtml" | Version}
                {element @name="dd" @namespace="http://www.w3.org/1999/xhtml" |
                  {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "benchmark").children.children, fn(member) => member.attributes.value == "tag").children.children.value}}
                }
                {element @name="dt" @namespace="http://www.w3.org/1999/xhtml" | Commit}
                {element @name="dd" @namespace="http://www.w3.org/1999/xhtml" |
                  {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "benchmark").children.children, fn(member) => member.attributes.value == "commit").children.children.value}}
                }
                {element @name="dt" @namespace="http://www.w3.org/1999/xhtml" | Captured}
                {element @name="dd" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "benchmark").children.children, fn(member) => member.attributes.value == "capturedAt").children.children.value}}
              }
              {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
                {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                  {attribute @name="href" @value='{seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "benchmark").children.children, fn(member) => member.attributes.value == "catalogUrl").children.children.value}'}
                  Official catalog
                }
                and
                {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                  {attribute @name="href" @value='{seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "benchmark").children.children, fn(member) => member.attributes.value == "sourceUrl").children.children.value}'}
                  pinned catalog source
                }
              }
            }
            {element @name="section" @namespace="http://www.w3.org/1999/xhtml" |
              {element @name="h2" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="id" @value="coverage-summary"}
                Coverage summary
              }
              {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="data-parity-total" @value='{seq:count(seq:where(input.children.children, fn(member) => member.attributes.value == "components").children.children)}'}
                {attribute @name="data-parity-covered" @value="18"}
                {attribute @name="data-parity-partial" @value="19"}
                {$ seq:count(seq:where(input.children.children, fn(member) => member.attributes.value == "components").children.children)} retained catalog rows: 18 covered and 19 partial.
              }
              {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
                Covered means the bounded CEM behavioral capability is owned. Partial means the mapping is useful but a named behavior or deliberately excluded framework surface remains visible in the notes.
              }
            }
            {element @name="section" @namespace="http://www.w3.org/1999/xhtml" |
              {element @name="h2" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="id" @value="catalog-mappings"}
                Catalog mappings
              }
              {cem:for-each @select='seq:where(input.children.children, fn(member) => member.attributes.value == "components").children.children' @as="component" |
                {element @name="article" @namespace="http://www.w3.org/1999/xhtml" |
                  {attribute @name="data-parity-id" @value='{seq:where(component.children, fn(member) => member.attributes.value == "id").children.children.value}'}
                  {attribute @name="data-parity-status" @value='{seq:where(component.children, fn(member) => member.attributes.value == "status").children.children.value}'}
                  {attribute @name="data-mapping-kind" @value='{seq:where(seq:where(component.children, fn(member) => member.attributes.value == "mapping").children.children, fn(member) => member.attributes.value == "kind").children.children.value}'}
                  {element @name="h3" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="id" @value='{str:concat(("angular-material-", seq:where(component.children, fn(member) => member.attributes.value == "id").children.children.value))}'}
                    {$seq:where(component.children, fn(member) => member.attributes.value == "name").children.children.value}
                  }
                  {element @name="dl" @namespace="http://www.w3.org/1999/xhtml" |
                    {element @name="dt" @namespace="http://www.w3.org/1999/xhtml" | Coverage}
                    {element @name="dd" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(component.children, fn(member) => member.attributes.value == "status").children.children.value}}
                    {element @name="dt" @namespace="http://www.w3.org/1999/xhtml" | Mapping kind}
                    {element @name="dd" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(seq:where(component.children, fn(member) => member.attributes.value == "mapping").children.children, fn(member) => member.attributes.value == "kind").children.children.value}}
                    {element @name="dt" @namespace="http://www.w3.org/1999/xhtml" | CEM owners}
                    {element @name="dd" @namespace="http://www.w3.org/1999/xhtml" |
                      {element @name="ul" @namespace="http://www.w3.org/1999/xhtml" |
                        {cem:for-each @select='seq:where(seq:where(component.children, fn(member) => member.attributes.value == "mapping").children.children, fn(member) => member.attributes.value == "owners").children.children' @as="owner" |
                          {element @name="li" @namespace="http://www.w3.org/1999/xhtml" |
                            {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$owner.children.value}}
                          }
                        }
                      }
                    }
                    {element @name="dt" @namespace="http://www.w3.org/1999/xhtml" | States}
                    {element @name="dd" @namespace="http://www.w3.org/1999/xhtml" |
                      {element @name="ul" @namespace="http://www.w3.org/1999/xhtml" |
                        {cem:for-each @select='seq:where(seq:where(component.children, fn(member) => member.attributes.value == "mapping").children.children, fn(member) => member.attributes.value == "states").children.children' @as="state" |
                          {element @name="li" @namespace="http://www.w3.org/1999/xhtml" | {$state.children.value}}
                        }
                      }
                    }
                    {element @name="dt" @namespace="http://www.w3.org/1999/xhtml" | Keyboard}
                    {element @name="dd" @namespace="http://www.w3.org/1999/xhtml" |
                      {element @name="ul" @namespace="http://www.w3.org/1999/xhtml" |
                        {cem:for-each @select='seq:where(seq:where(component.children, fn(member) => member.attributes.value == "mapping").children.children, fn(member) => member.attributes.value == "keyboard").children.children' @as="keyboard" |
                          {element @name="li" @namespace="http://www.w3.org/1999/xhtml" | {$keyboard.children.value}}
                        }
                      }
                    }
                    {element @name="dt" @namespace="http://www.w3.org/1999/xhtml" | Accessibility}
                    {element @name="dd" @namespace="http://www.w3.org/1999/xhtml" |
                      {element @name="ul" @namespace="http://www.w3.org/1999/xhtml" |
                        {cem:for-each @select='seq:where(seq:where(component.children, fn(member) => member.attributes.value == "mapping").children.children, fn(member) => member.attributes.value == "accessibility").children.children' @as="accessibility" |
                          {element @name="li" @namespace="http://www.w3.org/1999/xhtml" | {$accessibility.children.value}}
                        }
                      }
                    }
                    {element @name="dt" @namespace="http://www.w3.org/1999/xhtml" | Evidence}
                    {element @name="dd" @namespace="http://www.w3.org/1999/xhtml" |
                      {element @name="ul" @namespace="http://www.w3.org/1999/xhtml" |
                        {cem:for-each @select='seq:where(seq:where(component.children, fn(member) => member.attributes.value == "mapping").children.children, fn(member) => member.attributes.value == "evidence").children.children' @as="evidence" |
                          {element @name="li" @namespace="http://www.w3.org/1999/xhtml" |
                            {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$evidence.children.value}}
                          }
                        }
                      }
                    }
                  }
                  {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
                    {element @name="strong" @namespace="http://www.w3.org/1999/xhtml" | Scope:}
                    {$seq:where(seq:where(component.children, fn(member) => member.attributes.value == "mapping").children.children, fn(member) => member.attributes.value == "notes").children.children.value}
                  }
                }
              }
            }
          }
          {element @name="footer" @namespace="http://www.w3.org/1999/xhtml" |
            Generated by the native CEM-ML transformation graph.
          }
        }
      }
    }
  }
}
