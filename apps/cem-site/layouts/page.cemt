@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" @cem:whitespace=layout |
  {param @name="input" @type="object" @required=true}
  {template @name="page" @visibility="public" |
    {param @name="title" @type="string" @required=true}
    {param @name="canonicalSourceBase" @type="string" @default=""}
    {body |
      {element @name="html" @namespace="http://www.w3.org/1999/xhtml" |
        {attribute @name="lang" @value="en"}
        {attribute @name="data-theme" @value="cem-theme-projector"}
        {element @name="head" @namespace="http://www.w3.org/1999/xhtml" |
          {element @name="meta" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="charset" @value="utf-8"}
          }
          {element @name="meta" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="name" @value="viewport"}
            {attribute @name="content" @value="width=device-width, initial-scale=1"}
          }
          {element @name="title" @namespace="http://www.w3.org/1999/xhtml" | {$title}}
          {element @name="link" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="rel" @value="stylesheet"}
            {attribute @name="href" @value="/packages/cem-theme/dist/lib/css/cem-combined.css"}
          }
          {element @name="script" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="type" @value="importmap"}
            ```{"imports":{"@epa-wg/cem-ml/wasm":"/packages/cem-ml-npm/dist/wasm/browser/cem_ml.js"}}```
          }
          {element @name="script" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="type" @value="module"}
            {attribute @name="src" @value="/packages/cem-demo-element/dist/index.js"}
          }
        }
        {element @name="body" @namespace="http://www.w3.org/1999/xhtml" |
          {element @name="header" @namespace="http://www.w3.org/1999/xhtml" |
            {element @name="nav" @namespace="http://www.w3.org/1999/xhtml" |
              {attribute @name="aria-label" @value="Primary"}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/"}
                CEM Site
              }
              {element @name="span" @namespace="http://www.w3.org/1999/xhtml" | {attribute @name="aria-hidden" @value="true"} {$ " • "}}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/guides/"}
                Guides
              }
              {element @name="span" @namespace="http://www.w3.org/1999/xhtml" | {attribute @name="aria-hidden" @value="true"} {$ " • "}}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/packages/"}
                Packages
              }
              {element @name="span" @namespace="http://www.w3.org/1999/xhtml" | {attribute @name="aria-hidden" @value="true"} {$ " • "}}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/guides/cem-ml/cli/"}
                CLI guide
              }
              {element @name="span" @namespace="http://www.w3.org/1999/xhtml" | {attribute @name="aria-hidden" @value="true"} {$ " • "}}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/reference/cem-ml/transform-config/"}
                CEM-ML reference
              }
              {element @name="span" @namespace="http://www.w3.org/1999/xhtml" | {attribute @name="aria-hidden" @value="true"} {$ " • "}}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/tokens/"}
                Tokens
              }
              {element @name="span" @namespace="http://www.w3.org/1999/xhtml" | {attribute @name="aria-hidden" @value="true"} {$ " • "}}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/packages/cem-components/"}
                CEM Components
              }
              {element @name="span" @namespace="http://www.w3.org/1999/xhtml" | {attribute @name="aria-hidden" @value="true"} {$ " • "}}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/components/angular-material/"}
                Material comparison
              }
              {element @name="span" @namespace="http://www.w3.org/1999/xhtml" | {attribute @name="aria-hidden" @value="true"} {$ " • "}}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/examples/interactive/"}
                Interactive examples
              }
              {element @name="span" @namespace="http://www.w3.org/1999/xhtml" | {attribute @name="aria-hidden" @value="true"} {$ " • "}}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/search/"}
                Search
              }
              {element @name="span" @namespace="http://www.w3.org/1999/xhtml" | {attribute @name="aria-hidden" @value="true"} {$ " • "}}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="https://green-morning-fd6e.trans-acf.workers.dev/studio/"}
                Studio
              }
              {element @name="span" @namespace="http://www.w3.org/1999/xhtml" | {attribute @name="aria-hidden" @value="true"} {$ " • "}}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="https://green-morning-fd6e.trans-acf.workers.dev/packages/cem-demo-element/demo/playground"}
                Playground
              }
            }
          }
          {element @name="main" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="id" @value="content"}
            {cem:for-each @select="$input.children" @as="node" |
              {call @template="emit-node" @with:node="{$node}"
                  @with:nodePath='{str:concat(("", position))}'
                  @with:canonicalSourceBase="{$canonicalSourceBase}"}
            }
          }
          {element @name="footer" @namespace="http://www.w3.org/1999/xhtml" |
            Generated by the native CEM-ML transformation graph.
          }
        }
      }
    }
  }
  {template @name="emit-node" |
    {param @name="node" @type="object" @required=true}
    {param @name="nodePath" @type="string" @required=true}
    {param @name="canonicalSourceBase" @type="string" @default=""}
    {body |
      {cem:choose |
        {cem:when @test='node.kind == "element" && node.name == "pre" && seq:count(seq:where(node.children, fn(child) => child.name == "code")) == 1' |
          {cem:variable @name=codeNode @select='seq:where(node.children, fn(child) => child.name == "code")'}
          {cem:variable @name=language @select='str:replace(str:concat(seq:where(codeNode.attributes, fn(attribute) => attribute.name == "class").value), "language-", "")'}
          {element @name="cem-demo-element" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="demo" @value="false"}
            {attribute @name="type" @value='{if language != "" { language } else { "text" }}'}
            {attribute @name="source" @value='{str:trim(str:concat(codeNode.children.data))}'}
          }
        }
        {cem:when @test='node.kind == "element"' |
          {cem:variable @name=isHeading @select='node.name == "h1" || node.name == "h2" || node.name == "h3" || node.name == "h4" || node.name == "h5" || node.name == "h6"'}
          {element @name="{$node.name}" @namespace="{$node.namespace}" |
            {cem:if @test=isHeading |
              {attribute @name="id" @value='{str:concat(("heading-", nodePath))}'}
            }
            {cem:for-each @select='seq:where(node.attributes, fn(attribute) => !(isHeading && attribute.name == "id"))' @as="attribute" |
              {cem:choose |
                {cem:when @test='attribute.name == "href" && canonicalSourceBase != "" && str:starts_with(attribute.value, "#") == false && str:starts_with(attribute.value, "/") == false && str:starts_with(attribute.value, "http:") == false && str:starts_with(attribute.value, "https:") == false && str:starts_with(attribute.value, "mailto:") == false' |
                  {attribute @name="{$attribute.name}" @namespace="{$attribute.namespace}"
                      @value="{str:concat((canonicalSourceBase, attribute.value))}"}
                }
                {cem:otherwise |
                  {attribute @name="{$attribute.name}" @namespace="{$attribute.namespace}"
                      @value="{$attribute.value}"}
                }
              }
            }
            {cem:for-each @select="$node.children" @as="child" |
              {call @template="emit-node" @with:node="{$child}"
                  @with:nodePath='{str:concat((nodePath, "-", position))}'
                  @with:canonicalSourceBase="{$canonicalSourceBase}"}
            }
          }
        }
        {cem:when @test='node.kind == "text" || node.kind == "whitespace"' | {$node.data}}
        {cem:when @test='node.kind == "comment"' | {comment @value="{$node.data}"}}
      }
    }
  }
}
