@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
  // Imported inputs use the retained cem:generic-data vocabulary.
  {param @name="input" @type="object" @required=true}
  {template @name="tokens" @visibility="public" |
    {body |
      {element @name="html" @namespace="http://www.w3.org/1999/xhtml" |
        {attribute @name="lang" @value="en"}
        {element @name="head" @namespace="http://www.w3.org/1999/xhtml" |
          {element @name="meta" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="charset" @value="utf-8"}
          }
          {element @name="meta" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="name" @value="viewport"}
            {attribute @name="content" @value="width=device-width, initial-scale=1"}
          }
          {element @name="title" @namespace="http://www.w3.org/1999/xhtml" | CEM token browser}
        }
        {element @name="body" @namespace="http://www.w3.org/1999/xhtml" |
          {element @name="header" @namespace="http://www.w3.org/1999/xhtml" |
            {element @name="nav" @namespace="http://www.w3.org/1999/xhtml" |
              {attribute @name="aria-label" @value="Primary"}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/"}
                CEM Site
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/guides/"}
                Guides
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/packages/"}
                Packages
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/guides/cem-ml/cli/"}
                CLI guide
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/reference/cem-ml/transform-config/"}
                CEM-ML reference
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/tokens/"}
                Tokens
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/components/"}
                Components
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/components/angular-material/"}
                Material comparison
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/examples/interactive/"}
                Interactive examples
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/search/"}
                Search
              }
            }
          }
          {element @name="main" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="id" @value="content"}
            {element @name="h1" @namespace="http://www.w3.org/1999/xhtml" |
              {attribute @name="id" @value="token-browser"}
              CEM token browser
            }
            {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
              These read-only values are generated from the canonical CEM theme Markdown token tables.
            }
            {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
              Source specifications remain authoritative; this catalog is a build projection for browsing and tooling.
            }
            {element @name="table" @namespace="http://www.w3.org/1999/xhtml" |
              {element @name="caption" @namespace="http://www.w3.org/1999/xhtml" |
                Public visual and voice token metadata
              }
              {element @name="thead" @namespace="http://www.w3.org/1999/xhtml" |
                {element @name="tr" @namespace="http://www.w3.org/1999/xhtml" |
                  {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="scope" @value="col"}
                    Name
                  }
                  {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="scope" @value="col"}
                    Type
                  }
                  {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="scope" @value="col"}
                    Tier
                  }
                  {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="scope" @value="col"}
                    Source
                  }
                  {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="scope" @value="col"}
                    Bucket
                  }
                  {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="scope" @value="col"}
                    Portability
                  }
                  {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="scope" @value="col"}
                    Raw value
                  }
                  {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="scope" @value="col"}
                    Light
                  }
                  {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="scope" @value="col"}
                    Dark
                  }
                  {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="scope" @value="col"}
                    Native
                  }
                }
              }
              {element @name="tbody" @namespace="http://www.w3.org/1999/xhtml" |
                {cem:for-each @select='seq:where(input.children.children, fn(member) => member.attributes.value == "tokens").children.children' @as="token" |
                  {element @name="tr" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="data-token-name" @value='{seq:where(token.children, fn(member) => member.attributes.value == "name").children.children.value}'}
                    {attribute @name="data-token-spec" @value='{seq:where(token.children, fn(member) => member.attributes.value == "spec").children.children.value}'}
                    {attribute @name="data-token-table" @value='{seq:where(token.children, fn(member) => member.attributes.value == "sourceTable").children.children.value}'}
                    {attribute @name="data-token-bucket" @value='{seq:where(token.children, fn(member) => member.attributes.value == "bucket").children.children.value}'}
                    {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                      {attribute @name="scope" @value="row"}
                      {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(token.children, fn(member) => member.attributes.value == "name").children.children.value}}
                    }
                    {element @name="td" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(token.children, fn(member) => member.attributes.value == "type").children.children.value}}
                    {element @name="td" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(token.children, fn(member) => member.attributes.value == "tier").children.children.value}}
                    {element @name="td" @namespace="http://www.w3.org/1999/xhtml" |
                      {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(token.children, fn(member) => member.attributes.value == "spec").children.children.value}}
                      /
                      {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(token.children, fn(member) => member.attributes.value == "sourceTable").children.children.value}}
                    }
                    {element @name="td" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(token.children, fn(member) => member.attributes.value == "bucket").children.children.value}}
                    {element @name="td" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(token.children, fn(member) => member.attributes.value == "portability").children.children.value}}
                    {element @name="td" @namespace="http://www.w3.org/1999/xhtml" |
                      {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(token.children, fn(member) => member.attributes.value == "rawValue").children.children.value}}
                    }
                    {element @name="td" @namespace="http://www.w3.org/1999/xhtml" |
                      {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(seq:where(token.children, fn(member) => member.attributes.value == "modes").children.children, fn(member) => member.attributes.value == "light").children.children.value}}
                    }
                    {element @name="td" @namespace="http://www.w3.org/1999/xhtml" |
                      {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(seq:where(token.children, fn(member) => member.attributes.value == "modes").children.children, fn(member) => member.attributes.value == "dark").children.children.value}}
                    }
                    {element @name="td" @namespace="http://www.w3.org/1999/xhtml" |
                      {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(seq:where(token.children, fn(member) => member.attributes.value == "modes").children.children, fn(member) => member.attributes.value == "native").children.children.value}}
                    }
                  }
                }
              }
            }
          }
          {element @name="footer" @namespace="http://www.w3.org/1999/xhtml" |
            Generated by the native CEM-ML transformation graph.
          }
        }
      }
    }
  }
}
