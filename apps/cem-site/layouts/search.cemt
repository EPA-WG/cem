@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
  // Imported inputs use the retained cem:generic-data vocabulary.
  {param @name="input" @type="object" @required=true}
  {template @name="search" @visibility="public" |
    {body |
      {element @name="html" @namespace="http://www.w3.org/1999/xhtml" |
        {attribute @name="lang" @value="en"}
        {element @name="head" @namespace="http://www.w3.org/1999/xhtml" |
          {element @name="meta" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="charset" @value="utf-8"}
          }
          {element @name="meta" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="name" @value="viewport"}
            {attribute @name="content" @value="width=device-width, initial-scale=1"}
          }
          {element @name="title" @namespace="http://www.w3.org/1999/xhtml" | Search CEM Site}
          {element @name="link" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="rel" @value="stylesheet"}
            {attribute @name="href" @value="./assets/theme/cem-combined.css"}
          }
          {element @name="link" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="rel" @value="stylesheet"}
            {attribute @name="href" @value="./assets/cem-components/styles.css"}
          }
          {element @name="script" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="type" @value="importmap"}
            {$seq:where(input.children.children, fn(member) => member.attributes.value == "searchImportMap").children.children.value}
          }
          {element @name="script" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="type" @value="module"}
            import "@epa-wg/cem-site/search";
          }
        }
        {element @name="body" @namespace="http://www.w3.org/1999/xhtml" |
          {element @name="header" @namespace="http://www.w3.org/1999/xhtml" |
            {element @name="nav" @namespace="http://www.w3.org/1999/xhtml" |
              {attribute @name="aria-label" @value="Primary"}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/"}
                CEM Site
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/guides/"}
                Guides
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/packages/"}
                Packages
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/guides/cem-ml/cli/"}
                CLI guide
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/reference/cem-ml/transform-config/"}
                CEM-ML reference
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/tokens/"}
                Tokens
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/components/"}
                Components
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/components/angular-material/"}
                Material comparison
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/examples/interactive/"}
                Interactive examples
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/search/"}
                Search
              }
            }
          }
          {element @name="custom-element" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="hidden" @value="hidden"}
            {attribute @name="tag" @value="cem-action"}
            {attribute @name="src" @value="./assets/cem-components/cem-action.xhtml#cem-action"}
          }
          {element @name="main" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="id" @value="content"}
            {attribute @name="data-search-index" @value="route-manifest"}
            {element @name="h1" @namespace="http://www.w3.org/1999/xhtml" |
              {attribute @name="id" @value="site-search"}
              Search CEM Site
            }
            {element @name="form" @namespace="http://www.w3.org/1999/xhtml" |
              {attribute @name="action" @value="/search/"}
              {attribute @name="method" @value="get"}
              {element @name="cem-field" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="data-search-field" @value=""}
                {attribute @name="label" @value="Search routes and headings"}
                {attribute @name="name" @value="q"}
                {attribute @name="type" @value="search"}
              }
              {element @name="cem-action" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="data-search-action" @value=""}
                {attribute @name="label" @value="Search"}
                Search
              }
            }
            {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
              {attribute @name="data-search-status" @value=""}
              {attribute @name="role" @value="status"}
              {attribute @name="aria-live" @value="polite"}
              {$ seq:count(seq:where(input.children.children, fn(member) => member.attributes.value == "searchDocuments").children.children)} searchable documents
            }
            {element @name="ol" @namespace="http://www.w3.org/1999/xhtml" |
              {attribute @name="id" @value="search-results"}
              {attribute @name="data-search-results" @value=""}
              {cem:for-each @select='seq:where(input.children.children, fn(member) => member.attributes.value == "searchDocuments").children.children' @as="document" |
                {element @name="li" @namespace="http://www.w3.org/1999/xhtml" |
                  {attribute @name="data-search-document" @value='{seq:where(document.children, fn(member) => member.attributes.value == "route").children.children.value}'}
                  {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                    {attribute @name="href" @value='{seq:where(document.children, fn(member) => member.attributes.value == "route").children.children.value}'}
                    {$seq:where(document.children, fn(member) => member.attributes.value == "title").children.children.value}
                  }
                  {element @name="p" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(document.children, fn(member) => member.attributes.value == "summary").children.children.value}}
                  {element @name="ul" @namespace="http://www.w3.org/1999/xhtml" |
                    {cem:for-each @select='seq:where(document.children, fn(member) => member.attributes.value == "headings").children.children' @as="heading" |
                      {element @name="li" @namespace="http://www.w3.org/1999/xhtml" |
                        {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                          {attribute @name="href" @value='{str:concat((seq:where(document.children, fn(member) => member.attributes.value == "route").children.children.value, "#", seq:where(heading.children, fn(member) => member.attributes.value == "id").children.children.value))}'}
                          {$seq:where(heading.children, fn(member) => member.attributes.value == "text").children.children.value}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          {element @name="footer" @namespace="http://www.w3.org/1999/xhtml" |
            Generated by the native CEM-ML transformation graph.
          }
        }
      }
    }
  }
}
