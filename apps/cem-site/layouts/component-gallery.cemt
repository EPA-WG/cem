@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
  // Imported inputs use the retained cem:generic-data vocabulary.
  {param @name="input" @type="object" @required=true}
  {template @name="components" @visibility="public" |
    {body |
      {element @name="html" @namespace="http://www.w3.org/1999/xhtml" |
        {attribute @name="lang" @value="en"}
        {element @name="head" @namespace="http://www.w3.org/1999/xhtml" |
          {element @name="meta" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="charset" @value="utf-8"}
          }
          {element @name="meta" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="name" @value="viewport"}
            {attribute @name="content" @value="width=device-width, initial-scale=1"}
          }
          {element @name="title" @namespace="http://www.w3.org/1999/xhtml" | CEM component gallery}
        }
        {element @name="body" @namespace="http://www.w3.org/1999/xhtml" |
          {element @name="header" @namespace="http://www.w3.org/1999/xhtml" |
            {element @name="nav" @namespace="http://www.w3.org/1999/xhtml" |
              {attribute @name="aria-label" @value="Primary"}
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/"}
                CEM Site
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/guides/"}
                Guides
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/packages/"}
                Packages
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/guides/cem-ml/cli/"}
                CLI guide
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/reference/cem-ml/transform-config/"}
                CEM-ML reference
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/tokens/"}
                Tokens
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/components/"}
                Components
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/components/angular-material/"}
                Material comparison
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/examples/interactive/"}
                Interactive examples
              }
              {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="href" @value="/search/"}
                Search
              }
            }
          }
          {element @name="main" @namespace="http://www.w3.org/1999/xhtml" |
            {attribute @name="id" @value="content"}
            {element @name="h1" @namespace="http://www.w3.org/1999/xhtml" |
              {attribute @name="id" @value="component-gallery"}
              CEM component gallery
            }
            {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
              This static catalog presents package-owned component semantics and verified state coverage without copying executable fixtures.
            }
            {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
              State requirements:
              {$seq:where(seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "stateCoverage").children.children, fn(member) => member.attributes.value == "summary").children.children, fn(member) => member.attributes.value == "total").children.children.value}; browser-covered:
              {$seq:where(seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "stateCoverage").children.children, fn(member) => member.attributes.value == "summary").children.children, fn(member) => member.attributes.value == "covered").children.children.value}; static-only:
              {$seq:where(seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "stateCoverage").children.children, fn(member) => member.attributes.value == "summary").children.children, fn(member) => member.attributes.value == "staticOnly").children.children.value}; gaps:
              {$seq:where(seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "stateCoverage").children.children, fn(member) => member.attributes.value == "summary").children.children, fn(member) => member.attributes.value == "gaps").children.children.value}.
            }
            {element @name="section" @namespace="http://www.w3.org/1999/xhtml" |
              {element @name="h2" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="id" @value="public-components"}
                Public components
              }
              {element @name="table" @namespace="http://www.w3.org/1999/xhtml" |
                {element @name="caption" @namespace="http://www.w3.org/1999/xhtml" |
                  Component semantics, token families, and category state coverage
                }
                {element @name="thead" @namespace="http://www.w3.org/1999/xhtml" |
                  {element @name="tr" @namespace="http://www.w3.org/1999/xhtml" |
                    {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                      {attribute @name="scope" @value="col"}
                      Component
                    }
                    {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                      {attribute @name="scope" @value="col"}
                      Category
                    }
                    {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                      {attribute @name="scope" @value="col"}
                      Primary use
                    }
                    {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                      {attribute @name="scope" @value="col"}
                      Token families
                    }
                    {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                      {attribute @name="scope" @value="col"}
                      Category states
                    }
                    {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                      {attribute @name="scope" @value="col"}
                      Reference
                    }
                  }
                }
                {element @name="tbody" @namespace="http://www.w3.org/1999/xhtml" |
                  {cem:for-each @select='seq:where(input.children.children, fn(member) => member.attributes.value == "components").children.children' @as="component" |
                    {element @name="tr" @namespace="http://www.w3.org/1999/xhtml" |
                      {attribute @name="data-component-tag" @value='{seq:where(component.children, fn(member) => member.attributes.value == "tag").children.children.value}'}
                      {attribute @name="data-component-category" @value='{seq:where(component.children, fn(member) => member.attributes.value == "category").children.children.value}'}
                      {element @name="th" @namespace="http://www.w3.org/1999/xhtml" |
                        {attribute @name="scope" @value="row"}
                        {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(component.children, fn(member) => member.attributes.value == "tag").children.children.value}}
                      }
                      {element @name="td" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(component.children, fn(member) => member.attributes.value == "category").children.children.value}}
                      {element @name="td" @namespace="http://www.w3.org/1999/xhtml" | {$seq:where(component.children, fn(member) => member.attributes.value == "primaryUse").children.children.value}}
                      {element @name="td" @namespace="http://www.w3.org/1999/xhtml" |
                        {element @name="ul" @namespace="http://www.w3.org/1999/xhtml" |
                          {cem:for-each @select='seq:where(component.children, fn(member) => member.attributes.value == "tokenFamilies").children.children' @as="family" |
                            {element @name="li" @namespace="http://www.w3.org/1999/xhtml" |
                              {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | {$family.children.value}}
                            }
                          }
                        }
                      }
                      {element @name="td" @namespace="http://www.w3.org/1999/xhtml" |
                        {element @name="ul" @namespace="http://www.w3.org/1999/xhtml" |
                          {cem:for-each @select='seq:where(component.children, fn(member) => member.attributes.value == "categoryStates").children.children' @as="state" |
                            {element @name="li" @namespace="http://www.w3.org/1999/xhtml" |
                              {$seq:where(state.children, fn(member) => member.attributes.value == "name").children.children.value}: {$seq:where(state.children, fn(member) => member.attributes.value == "status").children.children.value}
                            }
                          }
                        }
                      }
                      {element @name="td" @namespace="http://www.w3.org/1999/xhtml" |
                        {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                          {attribute @name="href" @value='{seq:where(seq:where(component.children, fn(member) => member.attributes.value == "documentation").children.children, fn(member) => member.attributes.value == "referenceHref").children.children.value}'}
                          Component reference
                        }
                      }
                    }
                  }
                }
              }
            }
            {element @name="section" @namespace="http://www.w3.org/1999/xhtml" |
              {element @name="h2" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="id" @value="storybook"}
                Storybook
              }
              {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
                Interactive stories remain a separately owned local build. Run
                {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | yarn nx run {$seq:where(seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "relatedSurfaces").children.children, fn(member) => member.attributes.value == "storybook").children.children, fn(member) => member.attributes.value == "devTarget").children.children.value}}
                or build them with
                {element @name="code" @namespace="http://www.w3.org/1999/xhtml" | yarn nx run {$seq:where(seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "relatedSurfaces").children.children, fn(member) => member.attributes.value == "storybook").children.children, fn(member) => member.attributes.value == "buildTarget").children.children.value}}.
              }
              {element @name="p" @namespace="http://www.w3.org/1999/xhtml" |
                {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                  {attribute @name="href" @value='{seq:where(seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "relatedSurfaces").children.children, fn(member) => member.attributes.value == "storybook").children.children, fn(member) => member.attributes.value == "sourceHref").children.children.value}'}
                  Browse the separately owned Storybook source
                }
              }
            }
            {element @name="section" @namespace="http://www.w3.org/1999/xhtml" |
              {element @name="h2" @namespace="http://www.w3.org/1999/xhtml" |
                {attribute @name="id" @value="workflow-example-sources"}
                Workflow example sources
              }
              {element @name="ul" @namespace="http://www.w3.org/1999/xhtml" |
                {cem:for-each @select='seq:where(seq:where(input.children.children, fn(member) => member.attributes.value == "relatedSurfaces").children.children, fn(member) => member.attributes.value == "examples").children.children' @as="example" |
                  {element @name="li" @namespace="http://www.w3.org/1999/xhtml" |
                    {element @name="a" @namespace="http://www.w3.org/1999/xhtml" |
                      {attribute @name="href" @value='{seq:where(example.children, fn(member) => member.attributes.value == "sourceHref").children.children.value}'}
                      {$seq:where(example.children, fn(member) => member.attributes.value == "name").children.children.value}
                    }
                    — {$seq:where(example.children, fn(member) => member.attributes.value == "purpose").children.children.value}
                  }
                }
              }
            }
          }
          {element @name="footer" @namespace="http://www.w3.org/1999/xhtml" |
            Generated by the native CEM-ML transformation graph.
          }
        }
      }
    }
  }
}
