{
    "name": "cem-site",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/cem-site/content",
    "targets": {
        "build": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": ["cem_ml_cli"],
                    "target": "build"
                },
                {
                    "projects": ["cem_ml"],
                    "target": "build:docs"
                },
                {
                    "projects": ["@epa-wg/cem-theme"],
                    "target": "build:tokens"
                },
                {
                    "projects": ["@epa-wg/cem-components"],
                    "target": "build:catalog"
                },
                {
                    "projects": ["@epa-wg/cem-components"],
                    "target": "verify-material-parity"
                },
                {
                    "projects": ["@epa-wg/cem-components"],
                    "target": "build"
                },
                {
                    "projects": ["@epa-wg/custom-element"],
                    "target": "build"
                }
            ],
            "options": {
                "command": "node apps/cem-site/scripts/build.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/content/**/*.md",
                "{projectRoot}/fixtures/**/*",
                "{projectRoot}/layouts/**/*.cemt",
                "{projectRoot}/runtime/**/*",
                "{projectRoot}/README.md",
                "{projectRoot}/site.cem",
                "{projectRoot}/site.routes.json",
                "{projectRoot}/scripts/build.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/packages/**/Cargo.toml",
                "{workspaceRoot}/packages/*/package.json",
                "{workspaceRoot}/packages/*/README.md",
                "{workspaceRoot}/packages/cem-elements/README.md",
                "{workspaceRoot}/packages/custom-element/README.md",
                "{workspaceRoot}/packages/trang-native/README.md",
                "{workspaceRoot}/packages/cem_ml/README.md",
                "{workspaceRoot}/packages/cem_ml_cli/README.md",
                "{workspaceRoot}/packages/cem_ml_transform_cem_ql/README.md",
                "{workspaceRoot}/packages/cem_ql/README.md",
                "{workspaceRoot}/packages/cem-ml-npm/README.md",
                "{workspaceRoot}/packages/cem-ml-cli-npm/README.md",
                "{workspaceRoot}/examples/cem-ml/README.md",
                "{workspaceRoot}/packages/cem-components/examples/README.md",
                "{workspaceRoot}/packages/cem-components/docs/component-reference.md",
                "{workspaceRoot}/packages/cem-components/docs/angular-material-parity.md",
                "{workspaceRoot}/packages/cem-components/src/lib/primitives.ts",
                "{workspaceRoot}/packages/cem-components/tests/angular-material-parity.json",
                "{workspaceRoot}/CHANGELOG.md",
                "{workspaceRoot}/packages/cem-components/CHANGELOG.md",
                "{workspaceRoot}/packages/cem-elements/CHANGELOG.md",
                "{workspaceRoot}/packages/cem-theme/CHANGELOG.md",
                "{workspaceRoot}/packages/custom-element/CHANGELOG.md",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": false
                }
            ],
            "outputs": ["{workspaceRoot}/dist/apps/cem-site"]
        },
        "verify": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build", "verify:determinism", "verify:interactive", "verify:production", "verify:search"],
            "options": {
                "command": "node apps/cem-site/scripts/verify.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/site.cem",
                "{projectRoot}/site.routes.json",
                "{projectRoot}/scripts/verify.mjs",
                "{projectRoot}/runtime/*.module-map.json",
                "{workspaceRoot}/nx.json",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/apps/*/project.json",
                "{workspaceRoot}/packages/**/Cargo.toml",
                "{workspaceRoot}/packages/*/project.json",
                "{workspaceRoot}/packages/*/package.json",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": false
                }
            ],
            "outputs": ["{workspaceRoot}/dist/reports/cem-site/verification.json"]
        },
        "verify:interactive": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["verify:determinism"],
            "options": {
                "command": "node apps/cem-site/scripts/verify-interactive.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/site.routes.json",
                "{projectRoot}/scripts/verify-interactive.mjs",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": false
                }
            ],
            "outputs": ["{workspaceRoot}/dist/reports/cem-site/interactive.json"]
        },
        "verify:search": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["verify:determinism"],
            "options": {
                "command": "node apps/cem-site/scripts/verify-search.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/site.routes.json",
                "{projectRoot}/scripts/verify-search.mjs",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": false
                }
            ],
            "outputs": ["{workspaceRoot}/dist/reports/cem-site/search.json"]
        },
        "verify:production": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["verify:determinism"],
            "options": {
                "command": "node apps/cem-site/scripts/verify-production.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/site.routes.json",
                "{projectRoot}/scripts/verify-production.mjs",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": false
                }
            ],
            "outputs": ["{workspaceRoot}/dist/reports/cem-site/production.json"]
        },
        "verify:determinism": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "options": {
                "command": "node apps/cem-site/scripts/verify-determinism.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/site.routes.json",
                "{projectRoot}/runtime/*destination.module-map.json",
                "{projectRoot}/scripts/build.mjs",
                "{projectRoot}/scripts/verify-determinism.mjs",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": false
                }
            ],
            "outputs": ["{workspaceRoot}/dist/reports/cem-site/determinism.json"]
        }
    },
    "tags": ["scope:cem-site", "type:application", "lang:cem"]
}
