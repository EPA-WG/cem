{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cem.dev/schema/cli/run-config.schema.json",
  "title": "CEM-ML CLI RunConfig",
  "description": "JSON configuration surface for CEM-ML CLI/library runs. The schema identity is https://cem.dev/ns/cli/run-config/1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputSpec"
      },
      "default": []
    },
    "outputs": {
      "description": "Output specs for conversion/export routes. A destination receives primary target-native bytes for the selected content type and schema; JSON is primary output only when JSON is the requested target.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/outputSpec"
      },
      "default": []
    },
    "schemaPackages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputSpec"
      },
      "default": []
    },
    "resolvers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resolverSpec"
      },
      "default": []
    },
    "scheduler": {
      "$ref": "#/$defs/schedulerConfig",
      "default": {}
    }
  },
  "$defs": {
    "inputSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "rootScope": {
          "$ref": "#/$defs/scopeConfig",
          "default": {}
        }
      }
    },
    "outputSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputRef": {
          "type": "string"
        },
        "destination": {
          "description": "Destination path or URI for primary output. The written bytes are in the requested target format; debug JSON artifacts are separate sidecars such as convert --artifact-json.",
          "type": "string"
        },
        "rootScope": {
          "$ref": "#/$defs/scopeConfig",
          "default": {}
        }
      }
    },
    "resolverSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uriPrefix", "localRoot"],
      "properties": {
        "uriPrefix": {
          "type": "string",
          "minLength": 1
        },
        "localRoot": {
          "type": "string",
          "minLength": 1
        },
        "read": {
          "type": "boolean",
          "default": false
        },
        "write": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "scopeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultContentType": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "outputColorType": {
          "type": "string"
        },
        "cemtFormatter": {
          "type": "string",
          "description": "Explicit CEMT formatter function for formatted CEM tree output. Use this to resolve schema-package ambiguity when more than one formatter artifact matches the selected formatter profile."
        },
        "cemtFormatterProfile": {
          "type": "string",
          "description": "Formatter profile expected from the CEMT formatter. If multiple package artifacts provide this profile, set cemtFormatter to select the function explicitly."
        },
        "cemtColorizer": {
          "type": "string",
          "description": "Explicit CEMT colorizer function for colored CEM tree output. Use this to resolve schema-package ambiguity when more than one colorizer artifact matches the selected color profile."
        },
        "cemtColorProfile": {
          "type": "string",
          "description": "Color profile expected from the CEMT colorizer. If multiple package artifacts provide this profile, set cemtColorizer to select the function explicitly."
        },
        "versionPins": {
          "$ref": "#/$defs/stringMap",
          "default": {}
        },
        "defaultNamespace": {
          "type": "string"
        },
        "namespaces": {
          "$ref": "#/$defs/stringMap",
          "default": {}
        },
        "moduleMap": {
          "type": "string"
        },
        "baseUri": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "budgets": {
          "$ref": "#/$defs/stringMap",
          "default": {}
        }
      }
    },
    "schedulerConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threadPool": {
          "type": "string"
        },
        "maxParallelDocuments": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
