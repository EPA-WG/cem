{
    "name": "cem_ml",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ml/src",
    "targets": {
        "build": {
            "executor": "@monodon/rust:check",
            "dependsOn": ["build:docs"],
            "outputs": ["{options.target-dir}"],
            "options": {
                "package": "cem-ml",
                "target-dir": "dist/target/cem_ml"
            }
        },
        "build:docs": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/compile-markdown.mjs --project packages/cem_ml --src-dir schema",
                "cwd": "{workspaceRoot}"
            },
            "cache": true,
            "inputs": [
                "{projectRoot}/schema/**/*.md",
                "{projectRoot}/schema/**/*.json",
                "{workspaceRoot}/tools/scripts/compile-markdown.mjs"
            ],
            "outputs": [
                "{projectRoot}/dist/**/*.md",
                "{projectRoot}/dist/**/*.xhtml",
                "{projectRoot}/dist/**/*.json"
            ]
        },
        "build:schema-artifacts": {
            "executor": "nx:run-commands",
            "dependsOn": ["build:docs"],
            "cache": true,
            "options": {
                "command": "cargo run --package cem-ml --bin cem-ml-schema-emit --target-dir dist/target/cem_ml -- --out packages/cem_ml/dist/lib/schema",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/schema/**/*.md",
                "{projectRoot}/src/schema/compiler/**/*.rs",
                "{projectRoot}/src/bin/cem-ml-schema-emit.rs"
            ],
            "outputs": [
                "{projectRoot}/dist/lib/schema/**"
            ]
        },
        "test": {
            "cache": true,
            "executor": "@monodon/rust:test",
            "dependsOn": [
                "test:observability-schema",
                "test:cli-schema-artifacts",
                "test:command-types"
            ],
            "outputs": ["{options.target-dir}"],
            "options": {
                "package": "cem-ml",
                "target-dir": "dist/target/cem_ml"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/**/*.rs",
                "{projectRoot}/Cargo.toml",
                "{projectRoot}/grammar/tree-sitter-cem/**/*",
                "{workspaceRoot}/packages/custom-element/material/components/**/*.html",
                "{workspaceRoot}/packages/custom-element/test-fixtures/legacy-compat-manifest.json",
                "{workspaceRoot}/packages/cem_ml_transform_cem_ql/src/lib.rs",
                "{workspaceRoot}/packages/cem_ml_cli/src/dispatch.rs"
            ],
            "configurations": {
                "production": {
                    "release": true
                }
            }
        },
        "test:command-types": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --locked --package cem-ml --no-default-features --features typescript-projections --test command_types --target-dir dist/target/cem_ml_typescript",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/command_types.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ml_typescript"]
        },
        "build:stripped": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo build --locked --package cem-ml --lib --no-default-features --target-dir dist/target/cem_ml_stripped",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ml_stripped"]
        },
        "test:stripped": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["test:observability-schema", "test:cli-schema-artifacts"],
            "options": {
                "command": "cargo test --locked --package cem-ml --no-default-features --target-dir dist/target/cem_ml_stripped",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/**/*.rs",
                "{projectRoot}/Cargo.toml",
                "{projectRoot}/grammar/tree-sitter-cem/**/*",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/custom-element/material/components/**/*.html",
                "{workspaceRoot}/packages/custom-element/test-fixtures/legacy-compat-manifest.json",
                "{workspaceRoot}/packages/cem_ml_transform_cem_ql/src/lib.rs",
                "{workspaceRoot}/packages/cem_ml_cli/src/dispatch.rs"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ml_stripped"]
        },
        "test:scss": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "cargo test --package cem-ml --lib scss --target-dir dist/target/cem_ml -- --nocapture",
                    "cargo test --package cem-ml --test scss --target-dir dist/target/cem_ml -- --nocapture"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/scss.rs",
                "{projectRoot}/Cargo.toml",
                "{projectRoot}/schema-packages/css/v1/package.cem",
                "{projectRoot}/schema-packages/css/v1/schema/**/*.cem",
                "{projectRoot}/schema-packages/css/v1/formatters/**/*.cemt",
                "{projectRoot}/schema-packages/css/v1/colorizers/**/*.cemt",
                "{projectRoot}/schema-packages/scss/v1/package.cem",
                "{projectRoot}/schema-packages/scss/v1/schema/**/*.cem",
                "{projectRoot}/schema-packages/scss/v1/examples/*.scss",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ml"]
        },
        "test:observability-schema": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/validate-observability-schema.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/schema/observability/report-event.schema.json",
                "{projectRoot}/src/observability.rs",
                "{projectRoot}/src/source_map.rs",
                "{workspaceRoot}/tools/scripts/validate-observability-schema.mjs"
            ]
        },
        "test:cli-schema-artifacts": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build:docs"],
            "options": {
                "command": "node tools/scripts/validate-cli-schema-artifacts.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/schema/cli/run-config.schema.json",
                "{projectRoot}/schema/cli/report.schema.json",
                "{projectRoot}/schema/cli/transform-config.md",
                "{workspaceRoot}/packages/cem_ml_cli/docs/examples/*.report.expected.json",
                "{workspaceRoot}/tools/scripts/compile-markdown.mjs",
                "{workspaceRoot}/tools/scripts/validate-cli-schema-artifacts.mjs"
            ],
            "outputs": []
        },
        "test:schema-package-structure": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ml --test schema_package_structure --target-dir dist/target/cem_ml -- --nocapture",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/tests/schema_package_structure.rs",
                "{projectRoot}/schema-packages/**/*",
                "{projectRoot}/src/events/**/*.rs",
                "{projectRoot}/src/parser/**/*.rs",
                "{projectRoot}/src/schema/package_sources.rs",
                "{projectRoot}/Cargo.toml"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ml"]
        },
        "lint": {
            "cache": true,
            "executor": "@monodon/rust:lint",
            "outputs": ["{options.target-dir}"],
            "options": {
                "package": "cem-ml",
                "target-dir": "dist/target/cem_ml"
            }
        },
        "build:wasm": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo build --lib --target wasm32-unknown-unknown",
                "cwd": "packages/cem_ml"
            },
            "outputs": ["{workspaceRoot}/dist/target/wasm32-unknown-unknown"]
        },
        "build:wasm:stripped": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo build --locked --package cem-ml --lib --target wasm32-unknown-unknown --no-default-features --target-dir dist/target/cem_ml_wasm_stripped",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ml_wasm_stripped"]
        },
        "bench": {
            "cache": false,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --release --test perf_budgets --target-dir ../../dist/target/cem_ml -- --nocapture",
                "cwd": "packages/cem_ml"
            },
            "outputs": ["{workspaceRoot}/dist/target/cem_ml/release"]
        },
        "tree-sitter:generate": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "tree-sitter generate",
                "cwd": "packages/cem_ml/grammar/tree-sitter-cem"
            },
            "inputs": [
                "{projectRoot}/grammar/tree-sitter-cem/grammar.js"
            ],
            "outputs": [
                "{projectRoot}/grammar/tree-sitter-cem/src/parser.c",
                "{projectRoot}/grammar/tree-sitter-cem/src/grammar.json",
                "{projectRoot}/grammar/tree-sitter-cem/src/node-types.json"
            ]
        }
    },
    "tags": ["scope:cem-ml", "type:lib", "lang:rust"]
}
