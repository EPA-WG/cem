{
    "name": "cem_ml",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ml/src",
    "targets": {
        "verify:platform": {
            "cache": false,
            "executor": "nx:run-commands",
            "dependsOn": [
                "lint",
                "test",
                "build:wasm",
                "verify:platform-version",
                "test:platform-release",
                {
                    "projects": ["cem_ml_cli"],
                    "target": "lint"
                },
                {
                    "projects": ["cem_ml_cli"],
                    "target": "test"
                },
                {
                    "projects": ["cem_ml_cli"],
                    "target": "test:command-schema"
                },
                {
                    "projects": ["cem_ml_cli"],
                    "target": "validate-fixtures"
                },
                {
                    "projects": ["cem_ml_cli"],
                    "target": "validate-converter-parity"
                },
                {
                    "projects": ["cem_ml_cli"],
                    "target": "e2e"
                },
                {
                    "projects": ["@epa-wg/cem-ml"],
                    "target": "check"
                },
                {
                    "projects": ["@epa-wg/cem-ml-cli"],
                    "target": "check"
                },
                {
                    "projects": ["@epa-wg/cem-ml-cli"],
                    "target": "verify:platform-parity"
                }
            ],
            "options": {
                "command": "node tools/scripts/cem-ml-phase25-native-gates.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/cem-ml-phase25-native-gates.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-linux-amd64/deployment.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-brew-arm64/deployment.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-windows-amd64/deployment.json"
            ],
            "outputs": ["{workspaceRoot}/dist/reports/cem-ml-phase25-native-gates.json"]
        },
        "sync:platform-version": {
            "cache": false,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/cem-ml-platform-version.mjs --write",
                "cwd": "{workspaceRoot}"
            },
            "outputs": []
        },
        "verify:platform-version": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/cem-ml-platform-version.mjs --check",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/cem-ml-platform-version.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-nx-version-actions.cjs",
                "{workspaceRoot}/nx.json",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/yarn.lock",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_transform_cem_ql/Cargo.toml",
                "{workspaceRoot}/packages/cem_ql/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml/grammar/tree-sitter-cem/Cargo.toml",
                "{workspaceRoot}/packages/cem-ml-npm/package.json",
                "{workspaceRoot}/packages/cem-ml-cli-npm/package.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-linux-amd64/deployment.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-brew-arm64/deployment.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-windows-amd64/deployment.json"
            ],
            "outputs": []
        },
        "test:platform-release": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["verify:platform-version", "lint:platform-release"],
            "options": {
                "command": "node --test tools/scripts/cem-ml-platform-version.test.mjs tools/scripts/cem-ml-platform-release.test.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/cem-ml-platform-version.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-platform-version.test.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-npm-release-evidence.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-platform-release.test.mjs",
                "{workspaceRoot}/.github/workflows/cem-ml-release.yml",
                "{workspaceRoot}/.github/workflows/cem-ml-native-release.yml",
                "{workspaceRoot}/.github/workflows/publish.yml",
                "{workspaceRoot}/packages/cem_ml/project.json",
                "{workspaceRoot}/packages/cem-ml-npm/project.json",
                "{workspaceRoot}/packages/cem-ml-cli-npm/project.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-linux-amd64/project.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-linux-amd64/deployment.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-linux-amd64/scripts/lib.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-linux-amd64/scripts/sign.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-linux-amd64/scripts/publish.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-brew-arm64/project.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-brew-arm64/deployment.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-brew-arm64/scripts/finalize.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-brew-arm64/scripts/publish.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-windows-amd64/project.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-windows-amd64/deployment.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-windows-amd64/scripts/finalize.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-windows-amd64/scripts/publish.mjs"
            ],
            "outputs": []
        },
        "lint:platform-release": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "node --check tools/scripts/cem-ml-nx-version-actions.cjs",
                    "yarn eslint tools/scripts/cem-ml-npm-release-evidence.mjs tools/scripts/cem-ml-platform-version.mjs tools/scripts/cem-ml-platform-version.test.mjs tools/scripts/cem-ml-platform-release.mjs tools/scripts/cem-ml-platform-release.test.mjs tools/scripts/cem-ml-phase25-native-gates.mjs packages/cem-ml-cli-native-linux-amd64/scripts/lib.mjs packages/cem-ml-cli-native-linux-amd64/scripts/sign.mjs packages/cem-ml-cli-native-linux-amd64/scripts/publish.mjs packages/cem-ml-cli-native-brew-arm64/scripts/finalize.mjs packages/cem-ml-cli-native-brew-arm64/scripts/publish.mjs packages/cem-ml-cli-native-windows-amd64/scripts/finalize.mjs packages/cem-ml-cli-native-windows-amd64/scripts/publish.mjs"
                ],
                "cwd": "{workspaceRoot}",
                "parallel": false
            },
            "inputs": [
                "{workspaceRoot}/eslint.config.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-nx-version-actions.cjs",
                "{workspaceRoot}/tools/scripts/cem-ml-npm-release-evidence.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-platform-version.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-platform-version.test.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-platform-release.test.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-phase25-native-gates.mjs",
                "{workspaceRoot}/packages/cem_ml/project.json",
                "{workspaceRoot}/packages/cem-ml-npm/project.json",
                "{workspaceRoot}/packages/cem-ml-cli-npm/project.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-linux-amd64/project.json",
                "{workspaceRoot}/packages/cem-ml-cli-native-linux-amd64/scripts/lib.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-linux-amd64/scripts/sign.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-linux-amd64/scripts/publish.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-brew-arm64/scripts/finalize.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-brew-arm64/scripts/publish.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-windows-amd64/scripts/finalize.mjs",
                "{workspaceRoot}/packages/cem-ml-cli-native-windows-amd64/scripts/publish.mjs"
            ],
            "outputs": []
        },
        "release:create-draft": {
            "cache": false,
            "executor": "nx:run-commands",
            "dependsOn": ["verify:platform-version"],
            "options": {
                "command": "node tools/scripts/cem-ml-platform-release.mjs create-draft",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                { "runtime": "git rev-parse HEAD" },
                { "env": "CEM_ML_RELEASE_TAG" },
                { "env": "CEM_ML_PLATFORM_DRAFT" }
            ],
            "outputs": []
        },
        "release:upload-ci-units": {
            "cache": false,
            "executor": "nx:run-commands",
            "dependsOn": ["verify:platform-version"],
            "options": {
                "command": "node tools/scripts/cem-ml-platform-release.mjs upload-ci-units",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
                "{workspaceRoot}/dist/packages/cem-ml-npm/artifacts/**/*",
                "{workspaceRoot}/dist/packages/cem-ml-cli-npm/artifacts/**/*",
                "{workspaceRoot}/dist/packages/cem-ml-cli-native-linux-amd64/artifacts/**/*",
                { "runtime": "git rev-parse HEAD" },
                { "env": "CEM_ML_RELEASE_TAG" },
                { "env": "CEM_ML_PLATFORM_UPLOAD" }
            ],
            "outputs": []
        },
        "release:collect-draft": {
            "cache": false,
            "executor": "nx:run-commands",
            "dependsOn": ["verify:platform-version"],
            "options": {
                "command": "node tools/scripts/cem-ml-platform-release.mjs collect-draft",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                { "runtime": "git rev-parse HEAD" },
                { "env": "CEM_ML_RELEASE_TAG" }
            ],
            "outputs": [
                "{workspaceRoot}/dist/packages/cem-ml-npm/artifacts",
                "{workspaceRoot}/dist/packages/cem-ml-cli-npm/artifacts",
                "{workspaceRoot}/dist/packages/cem-ml-cli-native-linux-amd64/artifacts"
            ]
        },
        "release:stage": {
            "cache": false,
            "executor": "nx:run-commands",
            "dependsOn": ["verify:platform-version"],
            "options": {
                "command": "node tools/scripts/cem-ml-platform-release.mjs stage",
                "cwd": "{workspaceRoot}"
            },
            "configurations": {
                "publication": {
                    "command": "node tools/scripts/cem-ml-platform-release.mjs stage --publication"
                }
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
                "{workspaceRoot}/dist/packages/cem-ml-npm/artifacts/**/*",
                "{workspaceRoot}/dist/packages/cem-ml-cli-npm/artifacts/**/*",
                "{workspaceRoot}/dist/packages/cem-ml-cli-native-linux-amd64/artifacts/**/*",
                { "runtime": "git rev-parse HEAD" }
            ],
            "outputs": ["{workspaceRoot}/dist/releases/cem-ml-platform"]
        },
        "release:verify": {
            "cache": false,
            "executor": "nx:run-commands",
            "dependsOn": ["verify:platform-version"],
            "options": {
                "command": "node tools/scripts/cem-ml-platform-release.mjs verify",
                "cwd": "{workspaceRoot}"
            },
            "configurations": {
                "publication": {
                    "command": "node tools/scripts/cem-ml-platform-release.mjs verify --publication"
                }
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
                "{workspaceRoot}/dist/releases/cem-ml-platform/**/*",
                { "runtime": "git rev-parse HEAD" }
            ],
            "outputs": []
        },
        "release:upload-draft": {
            "cache": false,
            "executor": "nx:run-commands",
            "dependsOn": ["verify:platform-version"],
            "options": {
                "command": "node tools/scripts/cem-ml-platform-release.mjs upload-draft",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
                "{workspaceRoot}/dist/releases/cem-ml-platform/**/*",
                { "runtime": "git rev-parse HEAD" },
                { "env": "CEM_ML_PLATFORM_UPLOAD" }
            ],
            "outputs": []
        },
        "build": {
            "executor": "@monodon/rust:check",
            "dependsOn": ["build:docs"],
            "outputs": ["{options.target-dir}"],
            "options": {
                "package": "cem-ml",
                "target-dir": "dist/target/cem_ml"
            }
        },
        "build:docs": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/compile-markdown.mjs --project packages/cem_ml --src-dir schema",
                "cwd": "{workspaceRoot}"
            },
            "cache": true,
            "inputs": [
                "{projectRoot}/schema/**/*.md",
                "{projectRoot}/schema/**/*.json",
                "{workspaceRoot}/tools/scripts/compile-markdown.mjs"
            ],
            "outputs": ["{projectRoot}/dist/**/*.md", "{projectRoot}/dist/**/*.xhtml", "{projectRoot}/dist/**/*.json"]
        },
        "build:schema-artifacts": {
            "executor": "nx:run-commands",
            "dependsOn": ["build:docs"],
            "cache": true,
            "options": {
                "command": "cargo run --package cem-ml --bin cem-ml-schema-emit --target-dir dist/target/cem_ml -- --out packages/cem_ml/dist/lib/schema",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/schema/**/*.md",
                "{projectRoot}/src/schema/compiler/**/*.rs",
                "{projectRoot}/src/bin/cem-ml-schema-emit.rs"
            ],
            "outputs": ["{projectRoot}/dist/lib/schema/**"]
        },
        "test": {
            "cache": true,
            "executor": "@monodon/rust:test",
            "dependsOn": ["test:observability-schema", "test:cli-schema-artifacts", "test:command-types"],
            "outputs": [],
            "options": {
                "package": "cem-ml",
                "target-dir": "dist/target/cem_ml"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/**/*.rs",
                "{projectRoot}/Cargo.toml",
                "{projectRoot}/grammar/tree-sitter-cem/**/*",
                "{workspaceRoot}/packages/custom-element/material/components/**/*.html",
                "{workspaceRoot}/packages/custom-element/test-fixtures/legacy-compat-manifest.json",
                "{workspaceRoot}/packages/cem_ml_transform_cem_ql/src/lib.rs",
                "{workspaceRoot}/packages/cem_ml_cli/src/dispatch.rs"
            ],
            "configurations": {
                "production": {
                    "release": true
                }
            }
        },
        "test:command-types": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --locked --package cem-ml --no-default-features --features typescript-projections --test command_types --target-dir dist/target/cem_ml_typescript",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/command_types.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock"
            ],
            "outputs": []
        },
        "build:stripped": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo build --locked --package cem-ml --lib --no-default-features --target-dir dist/target/cem_ml_stripped",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ml_stripped"]
        },
        "test:stripped": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["test:observability-schema", "test:cli-schema-artifacts"],
            "options": {
                "command": "cargo test --locked --package cem-ml --no-default-features --target-dir dist/target/cem_ml_stripped",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/**/*.rs",
                "{projectRoot}/Cargo.toml",
                "{projectRoot}/grammar/tree-sitter-cem/**/*",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/custom-element/material/components/**/*.html",
                "{workspaceRoot}/packages/custom-element/test-fixtures/legacy-compat-manifest.json",
                "{workspaceRoot}/packages/cem_ml_transform_cem_ql/src/lib.rs",
                "{workspaceRoot}/packages/cem_ml_cli/src/dispatch.rs"
            ],
            "outputs": []
        },
        "test:scss": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "cargo test --package cem-ml --lib scss --target-dir dist/target/cem_ml -- --nocapture",
                    "cargo test --package cem-ml --test scss --target-dir dist/target/cem_ml -- --nocapture"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/scss.rs",
                "{projectRoot}/Cargo.toml",
                "{projectRoot}/schema-packages/css/v1/package.cem",
                "{projectRoot}/schema-packages/css/v1/schema/**/*.cem",
                "{projectRoot}/schema-packages/css/v1/formatters/**/*.cemt",
                "{projectRoot}/schema-packages/css/v1/colorizers/**/*.cemt",
                "{projectRoot}/schema-packages/scss/v1/package.cem",
                "{projectRoot}/schema-packages/scss/v1/schema/**/*.cem",
                "{projectRoot}/schema-packages/scss/v1/examples/*.scss",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock"
            ],
            "outputs": []
        },
        "test:observability-schema": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/validate-observability-schema.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/schema/observability/report-event.schema.json",
                "{projectRoot}/src/observability.rs",
                "{projectRoot}/src/source_map.rs",
                "{workspaceRoot}/tools/scripts/validate-observability-schema.mjs"
            ]
        },
        "test:cli-schema-artifacts": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build:docs"],
            "options": {
                "command": "node tools/scripts/validate-cli-schema-artifacts.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/schema/cli/run-config.schema.json",
                "{projectRoot}/schema/cli/report.schema.json",
                "{projectRoot}/schema/cli/transform-config.md",
                "{workspaceRoot}/packages/cem_ml_cli/docs/examples/*.report.expected.json",
                "{workspaceRoot}/tools/scripts/compile-markdown.mjs",
                "{workspaceRoot}/tools/scripts/validate-cli-schema-artifacts.mjs"
            ],
            "outputs": []
        },
        "test:schema-package-structure": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ml --test schema_package_structure --target-dir dist/target/cem_ml -- --nocapture",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/tests/schema_package_structure.rs",
                "{projectRoot}/schema-packages/**/*",
                "{projectRoot}/src/events/**/*.rs",
                "{projectRoot}/src/parser/**/*.rs",
                "{projectRoot}/src/schema/package_sources.rs",
                "{projectRoot}/Cargo.toml"
            ],
            "outputs": []
        },
        "lint": {
            "cache": true,
            "executor": "@monodon/rust:lint",
            "outputs": [],
            "options": {
                "package": "cem-ml",
                "target-dir": "dist/target/cem_ml"
            }
        },
        "build:wasm": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo build --lib --target wasm32-unknown-unknown",
                "cwd": "packages/cem_ml"
            },
            "outputs": ["{workspaceRoot}/dist/target/wasm32-unknown-unknown"]
        },
        "build:wasm:stripped": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo build --locked --package cem-ml --lib --target wasm32-unknown-unknown --no-default-features --target-dir dist/target/cem_ml_wasm_stripped",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ml_wasm_stripped"]
        },
        "bench": {
            "cache": false,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --release --test perf_budgets --target-dir ../../dist/target/cem_ml -- --nocapture",
                "cwd": "packages/cem_ml"
            },
            "outputs": ["{workspaceRoot}/dist/target/cem_ml/release"]
        },
        "tree-sitter:generate": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "tree-sitter generate",
                "cwd": "packages/cem_ml/grammar/tree-sitter-cem"
            },
            "inputs": ["{projectRoot}/grammar/tree-sitter-cem/grammar.js"],
            "outputs": [
                "{projectRoot}/grammar/tree-sitter-cem/src/parser.c",
                "{projectRoot}/grammar/tree-sitter-cem/src/grammar.json",
                "{projectRoot}/grammar/tree-sitter-cem/src/node-types.json"
            ]
        }
    },
    "tags": ["scope:cem-ml", "type:lib", "lang:rust"]
}
