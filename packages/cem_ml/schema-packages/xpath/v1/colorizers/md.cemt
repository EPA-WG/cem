@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function @name="xpath.color-expression" @visibility="public" @category="xpath-expression" @subject="cem-tree" @produces="cem-tree" @content-type="application/vnd.cem.xpath" @schema="https://cem.dev/ns/query/xpath/1" @profile="md" @extends="cem.color-tree" @canonical=false @deterministic=true @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body | {$ merge(call("xpath.color-expression.tree", { subject: $subject, profile: "md", output: "md" }), {}) } }
    }
}
