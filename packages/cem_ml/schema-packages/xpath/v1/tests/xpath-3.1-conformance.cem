@doc cem-ml 1
@ns xpath = "https://cem.dev/ns/query/xpath/1"
@default xpath

{conformance-profile
    @xpath-version="3.1"
    @destination="full"
    @delivery="staged"
    @qt3-version="3.1"
|
    {normative-reference
        @id="xpath31"
        @role="language"
        @version="3.1"
        @uri="https://www.w3.org/TR/xpath-31/"
    }
    {normative-reference
        @id="xdm31"
        @role="data-model"
        @version="3.1"
        @uri="https://www.w3.org/TR/xpath-datamodel-31/"
    }
    {normative-reference
        @id="fo31"
        @role="functions-and-operators"
        @version="3.1"
        @uri="https://www.w3.org/TR/xpath-functions-31/"
    }
    {normative-reference
        @id="qt3-31"
        @role="conformance-suite"
        @version="3.1"
        @uri="https://www.w3.org/2011/QT3-test-suite/"
    }

    {implementation-reference
        @name="Xee"
        @uri="https://github.com/Paligo/xee"
        @commit="200b1e3356ea9d6dd2901d67bd941b779df7e5b7"
        @license="MIT"
        @usage="reference-only"
    }

    {conformance-slice
        @id="syntax-and-static-context"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 2, 3.1"
        @gap="The CEM-owned lossless scanner and recursive-descent parser are production-owned and Xee is test-only, but remaining XPath 3.1 grammar and static-context productions are not yet fully covered or mapped to QT3"
        @todo="xpath-compiler-evaluator"
    }
    {conformance-slice
        @id="expressions-and-control-flow"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 3.8 through 3.14"
        @gap="Typed for expressions accept comma-separated bindings lowered into nested typed nodes with dependent lexical scope, Cartesian binding order, exact outer and binding-suffix ranges, retained native owners and source maps, empty-binding short-circuiting, and cumulative sequence-item budgets. Typed let expressions use the same nested range and dependent-scope model while binding complete sequences once and evaluating returns once even for empty bindings. Typed conditional expressions retain an owned condition sequence, apply native effective-boolean-value rules once, and evaluate exactly one typed branch while preserving focus, bindings, native owners, source maps, exact diagnostics, and evaluated-work budgets. Typed some and every expressions lower comma-separated bindings into nested same-quantifier nodes, bind retained singletons in dependent scope, apply native effective-boolean-value rules to required satisfies tuples, short-circuit decisive results, and preserve vacuous truth, focus, shadowing, native owners, exact diagnostics, and evaluated-work budgets. The XPath 3.1 control-flow expressions in this slice are executable, while QT3 mapping remains incomplete; XQuery-only switch and typeswitch inputs remain explicit fail-closed exclusions"
        @todo="xpath-control-flow"
    }
    {conformance-slice
        @id="paths-and-node-tests"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 3.2, 3.3"
        @gap="The evaluator traverses every non-namespace axis over exact native XML AST owners; applies forward- and reverse-axis predicate focus plus order-preserving postfix filters with numeric position and effective boolean value rules; and returns identity-deduplicated document-ordered node paths. The optional deprecated namespace axis is an explicit host-language omission; non-XML-family owners and QT3 mapping remain incomplete"
        @todo="xpath-native-path-evaluator"
    }
    {conformance-slice
        @id="operators"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 3.4 through 3.7"
        @gap="All general and value comparison operators execute for supported string, URI, boolean, untyped XML, integer, decimal, float, and double values with direct node atomization, exact unbounded decimal comparison, existential or singleton cardinality, untyped conversion, numeric promotion, and NaN semantics. Logical and/or execute with typed EBV and deterministic left-to-right short-circuiting. Node identity comparisons execute across retained owners, and node-order comparisons execute within one retained owner. Union, intersect, and except validate retained node operands, combine by native identity, and normalize same-owner results; stable ordering for results spanning owners remains undefined. Other atomic families plus arithmetic and range operators and QT3 mapping remain incomplete"
        @todo="xpath-operators"
    }
    {conformance-slice
        @id="type-system"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 2.5, 2.6, 3.16 through 3.18"
        @gap="The native comparison kernel executes supported primitive atomic values, untyped conversion, and numeric promotion; derived atomic types, general casting syntax, sequence-type matching, promotion outside comparisons, and QT3 mapping remain incomplete"
        @todo="xpath-type-system"
    }
    {conformance-slice
        @id="function-items"
        @status="contract-only"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 3.1.5, 3.1.6"
        @gap="Function result handles exist, but named references, inline functions, partial application, and dynamic calls are not executable"
        @todo="xpath-function-items"
    }
    {conformance-slice
        @id="maps-and-arrays"
        @status="contract-only"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 3.11, 3.12"
        @gap="Typed result artifacts exist, but constructors, lookup, and map or array function semantics are not executable"
        @todo="xpath-maps-arrays"
    }
    {conformance-slice
        @id="functions-and-operators"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="Functions and Operators 3.1"
        @gap="The native focus functions position() and last() plus supported general, value-comparison, and logical operator mappings are implemented; the remaining standard function library, non-comparison operators, other atomic families, and QT3 mapping are incomplete"
        @todo="xpath-functions-operators"
    }
    {conformance-slice
        @id="dynamic-context-and-resources"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 section 2.1.2 and Functions and Operators resource functions"
        @gap="Standalone transform execution injects the exact lifecycle XML document context plus explicit resolver and safety capabilities; the shared host request carries an already parsed AST, a separate native context item, and expanded-QName typed sequence bindings, and CEMT, CEM-QL, and XSLT adapters enforce typed AST ownership without serialization or reparse. CEMT has a schema-owned authored XPath body and host-selected dispatcher; CEM-QL has a schema-owned programmatic XPath expression slot; XSLT invokes the ASTs already fused into direct expression attributes and AVT segments. Step and filter predicates carry item, position, and size focus consumed by native position() and last(). Additional input AST families, resource functions, and broader host instruction semantics remain incomplete"
        @todo="xpath-dynamic-context"
    }
    {conformance-slice
        @id="schema-aware-evaluation"
        @status="planned"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 schema-aware feature and XDM 3.1 typed values"
        @gap="Schema-aware node typing, type derivation, and schema element or attribute tests are not implemented"
        @todo="xpath-schema-aware"
    }
    {conformance-slice
        @id="xdm-results-and-serialization"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XDM 3.1 and explicit serialization edges"
        @gap="Native transform evaluation now produces typed ordered scalar and node results that retain lifecycle AST owners, and JSON export runs only through the registered result exporter; full XDM semantics plus XML, CEM, and text exporters remain incomplete"
        @todo="xpath-xdm-results"
    }
}
