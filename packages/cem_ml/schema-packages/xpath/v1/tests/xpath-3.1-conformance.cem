@doc cem-ml 1
@ns xpath = "https://cem.dev/ns/query/xpath/1"
@default xpath

{conformance-profile
    @xpath-version="3.1"
    @destination="full"
    @delivery="staged"
    @qt3-version="3.1"
|
    {normative-reference
        @id="xpath31"
        @role="language"
        @version="3.1"
        @uri="https://www.w3.org/TR/xpath-31/"
    }
    {normative-reference
        @id="xdm31"
        @role="data-model"
        @version="3.1"
        @uri="https://www.w3.org/TR/xpath-datamodel-31/"
    }
    {normative-reference
        @id="fo31"
        @role="functions-and-operators"
        @version="3.1"
        @uri="https://www.w3.org/TR/xpath-functions-31/"
    }
    {normative-reference
        @id="qt3-31"
        @role="conformance-suite"
        @version="3.1"
        @uri="https://www.w3.org/2011/QT3-test-suite/"
    }

    {implementation-reference
        @name="Xee"
        @uri="https://github.com/Paligo/xee"
        @commit="200b1e3356ea9d6dd2901d67bd941b779df7e5b7"
        @license="MIT"
        @usage="reference-only"
    }

    {conformance-slice
        @id="syntax-and-static-context"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 2, 3.1"
        @gap="The CEM-owned lossless scanner and recursive-descent parser are production-owned and Xee is test-only, but remaining XPath 3.1 grammar and static-context productions are not yet fully covered or mapped to QT3"
        @todo="xpath-compiler-evaluator"
    }
    {conformance-slice
        @id="expressions-and-control-flow"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 3.8 through 3.14"
        @gap="Typed for expressions accept comma-separated bindings lowered into nested typed nodes with dependent lexical scope, Cartesian binding order, exact outer and binding-suffix ranges, retained native owners and source maps, empty-binding short-circuiting, and cumulative sequence-item budgets. Typed let expressions use the same nested range and dependent-scope model while binding complete sequences once and evaluating returns once even for empty bindings. Typed conditional expressions retain an owned condition sequence, apply native effective-boolean-value rules once, and evaluate exactly one typed branch while preserving focus, bindings, native owners, source maps, exact diagnostics, and evaluated-work budgets. Typed some and every expressions lower comma-separated bindings into nested same-quantifier nodes, bind retained singletons in dependent scope, apply native effective-boolean-value rules to required satisfies tuples, short-circuit decisive results, and preserve vacuous truth, focus, shadowing, native owners, exact diagnostics, and evaluated-work budgets. The XPath 3.1 control-flow expressions in this slice are executable, while QT3 mapping remains incomplete; XQuery-only switch and typeswitch inputs remain explicit fail-closed exclusions"
        @todo="xpath-control-flow"
    }
    {conformance-slice
        @id="paths-and-node-tests"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 3.2, 3.3"
        @gap="The evaluator traverses every non-namespace axis over retained typed CEM trees imported from XML, JSON, YAML and CSV; applies forward- and reverse-axis predicate focus plus order-preserving postfix filters with numeric position and effective boolean value rules; and returns identity-deduplicated document-ordered node paths. Typed simple maps retain one input path plus ordered mapping paths, execute each stage with item, position, and size focus, concatenate atomic or native-node results without path normalization, preserve duplicates and input order, skip remaining paths after an empty stage, and enforce evaluated intermediate/output budgets. The optional deprecated namespace axis is an explicit host-language omission; additional import formats and QT3 mapping remain incomplete"
        @todo="xpath-native-path-evaluator"
    }
    {conformance-slice
        @id="operators"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 3.4 through 3.7"
        @gap="All general and value comparison operators execute for supported string, URI, boolean, untyped node values, integer, decimal, float, and double values with direct node atomization, exact unbounded decimal comparison, existential or singleton cardinality, untyped conversion, numeric promotion, and NaN semantics. Logical and/or execute with typed EBV and deterministic left-to-right short-circuiting. Node identity comparisons execute across retained owners, and node-order comparisons execute within one retained owner. Union, intersect, and except validate retained node operands, combine by native identity, and normalize same-owner results; stable ordering for results spanning owners remains undefined. Unary and binary numeric arithmetic (+, -, *, div, idiv, mod), bounded integer to ranges and string concatenation also execute with typed atomization/conversion, empty-input behavior and source maps; ranges require an explicit item limit and decimal division uses the existing fixed precision policy. Other atomic families and QT3 mapping remain incomplete"
        @todo="xpath-operators"
    }
    {conformance-slice
        @id="type-system"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 2.5, 2.6, and 3.14"
        @gap="CEM-owned typed sequence and single types retain empty-sequence(), item(), parenthesized item types, supported XML Schema atomic EQNames, unconstrained native node-kind tests, occurrence/optional-empty indicators, grammar precedence, and exact ranges. Native instance of and treat as execute cardinality, supported atomic subtype, generic-item, and retained node-kind matching without parsing result display strings; successful treats preserve original items and unsupported atomic, constrained/schema-aware, function, map, or array declarations fail before operands. Native cast as and castable as plus the matching one-argument XML Schema constructor functions atomize retained nodes and execute the closed untypedAtomic/string/boolean/integer/decimal/float/double/anyURI primitive matrix with exact numeric, lexical, source-map, cardinality, error-propagation, and pre-operand/signature-validation semantics. Derived atomic families, constrained and higher-order type matching, namespace-sensitive/schema/list/union casting and constructors, broader function-conversion coverage, and QT3 mapping remain incomplete"
        @todo="xpath-type-system"
    }
    {conformance-slice
        @id="function-items"
        @status="contract-only"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 3.1.5, 3.1.6"
        @gap="Named arrow expressions lower canonically to executable static function calls with their left operand inserted as argument zero. Variable and parenthesized arrow specifiers lower to typed postfix calls for maps, arrays and native inline closures. Inline functions retain typed parameters/results, lexical captures, native owners and source maps; dynamic calls apply the supported primitive function conversions with absent focus, shared limits, a 32-call ceiling and a 32-expression-frame ceiling during inline execution. Function-valued CEM-QL bindings/results remain rejected. Named references, partial application, function lookup and higher-order type coercion are not implemented"
        @todo="xpath-function-items"
    }
    {conformance-slice
        @id="maps-and-arrays"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 sections 3.11, 3.12"
        @gap="Native map and square/curly array constructors, unary/postfix lookup with typed keys and wildcard, and single-key container calls execute after source-free artifact reload. Map contains/get/keys and array size/get preserve nested and empty member sequences, one-based access, exact same-key numeric equality, duplicate-key errors, retained owners and shared text/work bounds including empty member visits. CEM-QL named functions retain opaque maps and arrays; scalar and XML demos cover that route. Higher-order type matching, other map/array functions, JSON input/null mapping and QT3 coverage remain incomplete"
        @todo="xpath-maps-arrays"
    }
    {conformance-slice
        @id="functions-and-operators"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="Functions and Operators 3.1"
        @gap="One expanded-QName-and-arity dispatcher executes the native focus functions position() and last(), the pure sequence functions count(), exists(), empty(), boolean(), and not(), the zero-argument boolean constants true() and false(), and the one-argument XML Schema constructor functions for the closed untypedAtomic/string/boolean/integer/decimal/float/double/anyURI matrix with native atomization, conversion, empty-input, EBV, source-map, namespace-isolation, deterministic unsupported-signature, and evaluated-work semantics. The non-regex text slice also executes normalize-space and string-length at arities zero/one, string-join at arities one/two, and tokenize at arity one with XML whitespace, codepoints, native atomization, typed arguments, and shared intermediate/output UTF-8 text and cumulative work limits. The explicit regex subset executes matches, replace and regex tokenize with XPath syntax validation, XML/Unicode classes, s/x/q flags, numbered replacement captures and bounded NFA/search/output work. Backreferences, class subtraction, XML name/block escapes and i/m modes fail explicitly; full regex and QT3 coverage remain incomplete. Native node local-name and namespace-uri execute at arities zero/one with node-only arguments, retained namespace metadata, typed string/anyURI results and shared text/work limits; node-name and QName values/comparisons remain unsupported. The sequence slice executes head, tail, reverse, and two/three-argument subsequence while preserving opaque items, native owners and source maps, with typed double bounds and standard rounding/NaN/infinity behavior. Distinct-values atomizes native nodes/arrays, supports the existing string/untyped/URI/boolean/numeric matrix with numeric promotion and NaN equality, and accepts only the Unicode codepoint collation; duplicate comparisons share the work budget and display order remains explicitly authored. Numeric sum/avg/min/max execute with whole-sequence float/double promotion, untyped-to-double conversion, exact integer/decimal sums, existing bounded decimal-average division, NaN propagation, empty-input and sum-fallback behavior and shared input/intermediate/work limits. Nonnumeric extrema and duration aggregates remain explicit unsupported slices. The existing dispatcher also executes string/data/number at arities zero/one, abs/ceiling/floor at arity one, round/round-half-to-even at arities one/two, and format-integer/format-number at arities two/three using the CEM numbering and static decimal-format policies. Supported general/value comparisons, logical operations, numeric arithmetic, bounded integer ranges and string concatenation are implemented. Stable fn:sort at arities one/two/three evaluates inline/map/array key functions, atomizes lexicographic keys and preserves source items with the supported numeric/boolean/string matrix, codepoint collation, empty/NaN ordering and shared key-storage/comparison budgets. Missing/invalid-last policies remain authored. Remaining standard-library functions, other atomic families and constructors, and QT3 mapping are incomplete; native execution does not imply browser demo coverage for every signature"
        @todo="xpath-functions-operators"
    }
    {conformance-slice
        @id="dynamic-context-and-resources"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 section 2.1.2 and Functions and Operators resource functions"
        @gap="Standalone transform execution injects the exact lifecycle XML document context plus explicit resolver and safety capabilities; the shared host request carries an already parsed AST, a separate native context item, optional validated host position/size with singleton defaults, and expanded-QName typed sequence bindings, and CEMT, CEM-QL, and XSLT adapters enforce typed AST ownership without serialization or reparse. CEMT has a schema-owned authored XPath body and host-selected dispatcher; CEM-QL has a schema-owned programmatic XPath expression slot; XSLT invokes the ASTs already fused into direct expression attributes and AVT segments. Step and filter predicates carry item, position, and size focus consumed by native position() and last(). CEM data imports also supply a shared retained node view for XML, JSON, YAML and CSV; standard parsing/resource functions and broader host instruction semantics remain incomplete"
        @todo="xpath-dynamic-context"
    }
    {conformance-slice
        @id="schema-aware-evaluation"
        @status="planned"
        @qt3-status="unmapped"
        @spec-sections="XPath 3.1 schema-aware feature and XDM 3.1 typed values"
        @gap="Schema-aware node typing, type derivation, and schema element or attribute tests are not implemented"
        @todo="xpath-schema-aware"
    }
    {conformance-slice
        @id="xdm-results-and-serialization"
        @status="partial"
        @qt3-status="unmapped"
        @spec-sections="XDM 3.1 and explicit serialization edges"
        @gap="Native transform evaluation now produces typed ordered scalar and node results that retain lifecycle AST owners, and JSON export runs only through the registered result exporter; full XDM semantics plus XML, CEM, and text exporters remain incomplete"
        @todo="xpath-xdm-results"
    }
}
