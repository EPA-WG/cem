{
    "name": "cem_ml_schema_package_cem_ml_v1",
    "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ml/schema-packages/cem-ml/v1",
    "targets": {
        "verify": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "cem_ml_cli"
                    ],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "mkdir -p packages/cem_ml/schema-packages/cem-ml/v1/dist",
                    "./dist/target/cem_ml_cli/debug/cem-ml --quiet validate --fail-level parse --format json --content-type application/vnd.cem.schema-package+cem --schema https://cem.dev/ns/schema-package/1 --report-json packages/cem_ml/schema-packages/cem-ml/v1/dist packages/cem_ml/schema-packages/cem-ml/v1/package.cem",
                    "cargo test -p cem-ml cem_ml_package_examples_are_manifest_indexed --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml-cli schema_owned_cem_ml_examples_validate_through_cli --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml cem_tree_output_templates_are_schema_package_assets --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml conversion_output_pipeline_applies_literal_baseline_formatter_profiles --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml convert_target_cem_pretty_aligns_block_closing_braces_with_opening_indent --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml conversion_output_pipeline_applies_literal_baseline_colorizer_profiles --target-dir dist/target/cem_ml_cli",
                    "node packages/cem_ml/schema-packages/cem-ml/v1/scripts/verify-previews.mjs"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/tests/schema_validation_examples.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/dist/cem-ml.report.json",
                "{projectRoot}/dist/previews"
            ]
        }
    },
    "tags": [
        "scope:cem-ml",
        "type:schema-package",
        "lang:cem"
    ]
}
