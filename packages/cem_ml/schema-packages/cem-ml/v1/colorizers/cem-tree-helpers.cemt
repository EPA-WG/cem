@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function
        @name="cemml.cem-tree.color-node"
        @visibility="private"
        @category="cem-tree-node"
        @subject="object"
        @produces="cem-tree"
        @content-type="application/cem"
        @schema="https://cem.dev/ns/cem-ml/1"
        @profile="classes"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {param @name="role" @type="string" @default="syntax.string"}
        {param @name="className" @type="string" @default="cem-color cem-color-syntax-string"}
        {param @name="colorProfile" @type="string" @default="classes"}
        {body |
            {$ match($subject.kind, {
                element: call("cemml.cem-tree.color-element", { subject: $subject, colorProfile: $colorProfile }),
                text: call("cemml.cem-tree.color-text", { subject: $subject, role: $role, className: $className, colorProfile: $colorProfile }),
                default: $subject
            }) }
        }
    }

    {color-function
        @name="cemml.cem-tree.color-element"
        @visibility="private"
        @category="cem-tree-node"
        @subject="object"
        @produces="cem-tree"
        @content-type="application/cem"
        @schema="https://cem.dev/ns/cem-ml/1"
        @profile="classes"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {param @name="colorProfile" @type="string" @default="classes"}
        {body |
            {$ {
                kind: "element",
                name: $subject.name,
                sourceMap: $subject.sourceMap,
                attributes: $subject.attributes,
                formatLayout: $subject.formatLayout,
                colorRole: match($subject.name, { strong: "syntax.keyword", default: "syntax.name" }),
                style: {
                    colorRole: match($subject.name, { strong: "syntax.keyword", default: "syntax.name" }),
                    colorProfile: $colorProfile
                },
                writerAttributeNodes: [{
                    kind: "writer-attribute",
                    name: "class",
                    value: match($subject.name, { strong: "cem-color cem-color-syntax-keyword", default: "cem-color cem-color-syntax-name" }),
                    colorizerOwned: true,
                    colorizerRole: "colorizer.writer-attribute",
                    colorProfile: $colorProfile
                }],
                children: map($subject.children, call("cemml.cem-tree.color-node", {
                    subject: $item,
                    role: match($subject.name, { strong: "syntax.keyword", default: "syntax.string" }),
                    className: match($subject.name, { strong: "cem-color cem-color-syntax-keyword", default: "cem-color cem-color-syntax-string" }),
                    colorProfile: $colorProfile
                }))
            } }
        }
    }

    {color-function
        @name="cemml.cem-tree.color-text"
        @visibility="private"
        @category="cem-tree-node"
        @subject="object"
        @produces="cem-tree"
        @content-type="application/cem"
        @schema="https://cem.dev/ns/cem-ml/1"
        @profile="classes"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {param @name="role" @type="string" @required=true}
        {param @name="className" @type="string" @required=true}
        {param @name="colorProfile" @type="string" @default="classes"}
        {body |
            {$ {
                kind: "element",
                name: "span",
                colorRole: $role,
                style: {
                    colorRole: $role,
                    colorProfile: $colorProfile
                },
                writerAttributeNodes: [{
                    kind: "writer-attribute",
                    name: "class",
                    value: $className,
                    colorizerOwned: true,
                    colorizerRole: "colorizer.writer-attribute",
                    colorProfile: $colorProfile
                }],
                colorWrapperNodes: [
                    {
                        kind: "color-wrapper",
                        name: "span",
                        colorizerOwned: true,
                        colorizerRole: "colorizer.text-wrapper",
                        colorProfile: $colorProfile
                    },
                    {
                        kind: "color-decision",
                        name: "wrapped-role",
                        value: $role,
                        colorizerOwned: true,
                        colorizerRole: "colorizer.wrapped-role",
                        colorProfile: $colorProfile
                    }
                ],
                children: [$subject]
            } }
        }
    }

    {color-function
        @name="cemml.cem-tree.color-tree-base"
        @visibility="private"
        @category="cem-tree"
        @subject="cem-tree"
        @produces="cem-tree"
        @content-type="application/cem"
        @schema="https://cem.dev/ns/cem-ml/1"
        @extends="cem.color-tree"
        @profile="classes"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {param @name="colorProfile" @type="string" @default="classes"}
        {param @name="colorDecision" @type="object" @required=true}
        {param @name="writerBoundary" @type="object" @required=true}
        {param @name="queuedEditPath" @type="string" @required=true}
        {param @name="queuedEditNode" @type="object" @required=true}
        {body |
            {$ applyEdits(
                appendWriterBoundary(
                    appendColorNode(
                        merge($subject, {
                            colored: true,
                            colorProfile: $colorProfile,
                            colorNodes: [{
                                kind: "color-marker",
                                name: "cem.color-tree",
                                colorizerRole: "colorizer.boundary",
                                colorProfile: $colorProfile
                            }],
                            nodes: map($subject.nodes, call("cemml.cem-tree.color-node", { subject: $item, colorProfile: $colorProfile }))
                        }),
                        $colorDecision
                    ),
                    $writerBoundary
                ),
                drainQueue(
                    defer([],
                        appendEdit(
                            $queuedEditPath,
                            $queuedEditNode
                        )
                    ),
                    [],
                    append($acc, $item)
                )
            ) }
        }
    }
}
