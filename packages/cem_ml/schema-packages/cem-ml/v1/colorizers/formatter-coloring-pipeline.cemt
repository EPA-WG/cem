@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function
        @name="acme.showcase.color-tree"
        @visibility="public"
        @category="cem-tree"
        @subject="cem-tree"
        @produces="cem-tree"
        @content-type="application/cem"
        @schema="https://cem.dev/ns/cem-ml/1"
        @extends="cem.color-tree"
        @profile="classes"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body |
            {$ call("cemml.cem-tree.color-tree-base", {
                subject: $subject,
                colorProfile: "classes",
                colorDecision: {
                    kind: "color-decision",
                    name: "showcase",
                    colorizerRole: "colorizer.showcase",
                    value: "colored tree before writer"
                },
                writerBoundary: {
                    kind: "writer-boundary",
                    stage: "after-color",
                    value: "writer consumes colored CEM tree"
                },
                queuedEditPath: "nodes.0.children.1.children.0.colorWrapperNodes",
                queuedEditNode: {
                    kind: "color-decision",
                    name: "queued-edit",
                    colorizerOwned: true,
                    colorizerRole: "colorizer.queued-edit",
                    colorProfile: "classes",
                    value: "queued edit replay before writer"
                }
            }) }
        }
    }
}
