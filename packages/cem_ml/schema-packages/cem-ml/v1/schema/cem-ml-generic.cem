@doc cem-ml 1
@ns schema = "https://cem.dev/ns/schema/1"
@default schema

{schema @name="cem-ml-generic" @namespace="https://cem.dev/ns/cem-ml/1" @version="1.0.0" |
    {summary |
        {text | Generic CEM-ML document and content model. This schema owns CEM-ML syntax, root directives, lexical node forms, namespace binding, and content-type handoff boundaries. Domain vocabularies such as CEM core annotations, HTML, SVG, templates, and schema-package manifests are separate schema packages layered on top of this generic model.}
    }

    {content-types |
        {content-type @value="application/cem" @primary=true}
        {content-type @value="text/cem-ml" @alias=true}
        {content-type @value="text/cem" @alias=true}
        {content-type @value="application/cem+xml" @alias=true}
    }

    {directives |
        {directive @name="doc" @required="persisted-document" @value="cem-ml semver-constraint"}
        {directive @name="ns" @value="prefix uri"}
        {directive @name="default" @value="prefix-or-uri"}
        {directive @name="schema" @value="schema-uri"}
    }

    {nodes |
        {node @name="document" @children="directive* content*"}
        {node @name="element" @children="attribute* content*"}
        {node @name="attribute" @children="value?"}
        {node @name="text"}
        {node @name="whitespace"}
        {node @name="comment"}
        {node @name="cdata"}
        {node @name="raw-text"}
        {node @name="expression" @children="text"}
        {node @name="content-scope" @children="content*"}
    }

    {lexical |
        {rule @name="qualified-name" @value="prefix:local-name | local-name"}
        {rule @name="local-name" @value="identifier with hyphen support"}
        {rule @name="symbol-reference" @value="local-name segments separated by dots"}
        {rule @name="wildcard-name" @value="local-name | local-name:*"}
        {rule @name="wildcard-type-reference" @value="prefix:local-name | prefix:* | prefix:local-name:*"}
        {rule @name="attribute-name" @value="@ qualified-name"}
        {rule @name="bare-value" @value="identifier | number | boolean"}
        {rule @name="quoted-value" @value="single-quoted or double-quoted text"}
        {rule @name="expression-node" @value="dollar expression content scope"}
        {rule @name="anonymous-content-scope" @value="typed content handoff scope"}
    }

    {types |
        {type @name="identifier" @kind="lexical" @rule="local-name"}
        {type @name="qualified-name" @kind="lexical" @rule="qualified-name"}
        {type @name="symbol-reference" @kind="lexical" @rule="symbol-reference"}
        {type @name="wildcard-name" @kind="lexical" @rule="wildcard-name"}
        {type @name="string" @kind="scalar" @rule="quoted-value | raw-text"}
        {type @name="boolean" @kind="scalar" @values="true false"}
        {type @name="integer" @kind="scalar" @rule="signed decimal integer"}
        {type @name="number" @kind="scalar" @rule="decimal number"}
        {type @name="uri" @kind="scalar" @rule="absolute or relative URI reference"}
        {type @name="semver" @kind="scalar" @rule="major.minor.patch with optional prerelease and build metadata"}
        {type @name="media-type" @kind="scalar" @rule="type slash subtype with optional structured suffix and parameters"}
        {type @name="path" @kind="scalar" @rule="scope-context path: ./context-relative, protocol URI, or module-map specifier"}
        {type @name="name-list" @kind="list" @base="identifier"}
        {type @name="wildcard-name-list" @kind="list" @base="wildcard-name"}
        {type @name="content-model" @kind="grammar" @base="string"}
        {type @name="type-reference" @kind="reference" @base="qualified-name"}
        {type @name="wildcard-type-reference" @kind="reference" @rule="wildcard-type-reference"}
    }

    {namespace-semantics |
        {binding @directive="ns" @scope="document-or-subtree"}
        {binding @directive="default" @scope="document-or-subtree"}
        {resolution @target="element-name" @mode="default-namespace-aware"}
        {resolution @target="attribute-name" @mode="prefix-aware"}
        {handoff @attribute="type" @target="content-scope"}
    }

    {constraints |
        {constraint @kind="ast-unbalanced-close" @target="document" @diagnostic="cem.ast.unbalanced_close" @behavior="cem-ml-ast-report-fact" @fact-kind="ast-unbalanced-close" @policy="close-scope events must match an open element frame"}
        {constraint @kind="ast-unclosed-scope" @target="document" @diagnostic="cem.ast.unclosed_scope" @behavior="cem-ml-ast-report-fact" @fact-kind="ast-unclosed-scope" @policy="open element frames must close before end of input"}
        {constraint @kind="ast-unresolved-reference" @target="attribute" @diagnostic="cem.ast.unresolved_reference" @behavior="cem-ml-ast-report-fact" @fact-kind="ast-unresolved-reference" @policy="AST reference slots remain neutral facts until schema policy decides their diagnostic disposition"}
        {constraint @kind="doc-version-missing" @target="document" @diagnostic="cem.doc.version_missing" @behavior="cem-ml-doc-report-fact" @fact-kind="doc-version-missing" @policy="persisted top-level CEM-ML documents must begin with an @doc directive"}
        {constraint @kind="doc-semver-invalid" @target="directive" @diagnostic="cem.doc.semver_invalid" @behavior="cem-ml-doc-report-fact" @fact-kind="doc-semver-invalid" @policy="@doc directive values must be a format id followed by a valid SemVer constraint"}
        {constraint @kind="doc-format-unknown" @target="directive" @diagnostic="cem.doc.format_unknown" @behavior="cem-ml-doc-report-fact" @fact-kind="doc-format-unknown" @policy="@doc format identity must be cem-ml for this schema package"}
        {constraint @kind="doc-version-unsupported" @target="directive" @diagnostic="cem.doc.version_unsupported" @behavior="cem-ml-doc-report-fact" @fact-kind="doc-version-unsupported" @policy="@doc version constraints must resolve against the embedded CEM-ML document profile"}
        {constraint @kind="doc-prerelease-unmatched" @target="directive" @diagnostic="cem.doc.prerelease_unmatched" @behavior="cem-ml-doc-report-fact" @fact-kind="doc-prerelease-unmatched" @policy="@doc prerelease constraints require an exact embedded prerelease match"}
        {constraint @kind="doc-version-resolved" @target="directive" @diagnostic="cem.doc.version_resolved" @behavior="cem-ml-doc-report-fact" @fact-kind="doc-version-resolved" @policy="successful @doc resolution records the canonical document format identity"}
    }

    {diagnostics |
        {diagnostic @code="cem.doc.version_missing" @severity="error"}
        {diagnostic @code="cem.doc.semver_invalid" @severity="error"}
        {diagnostic @code="cem.doc.format_unknown" @severity="error"}
        {diagnostic @code="cem.doc.version_unsupported" @severity="error"}
        {diagnostic @code="cem.doc.prerelease_unmatched" @severity="error"}
        {diagnostic @code="cem.doc.version_resolved" @severity="info"}
        {diagnostic @code="cem.ast.unbalanced_close" @severity="error"}
        {diagnostic @code="cem.ast.unclosed_scope" @severity="error"}
        {diagnostic @code="cem.ast.unresolved_reference" @severity="warning"}
        {diagnostic @code="cem.syntax.unclosed_scope" @severity="error"}
        {diagnostic @code="cem.syntax.invalid_name" @severity="error"}
        {diagnostic @code="cem.namespace.unbound_prefix" @severity="error"}
        {diagnostic @code="cem.schema.unclosed_scope" @severity="error"}
        {diagnostic @code="cem.schema.unresolved_namespace" @severity="error"}
        {diagnostic @code="cem.handoff.xslt_dispatched" @severity="info"}
        {diagnostic @code="cem.handoff.child_parser_deferred" @severity="warning"}
        {diagnostic @code="cem.handoff.unsupported_content_type" @severity="error"}
        {diagnostic @code="cem.content_type.unsupported_handoff" @severity="error"}
    }

    {open-content |
        {accept @kind="host-element" @policy="delegate-to-active-schema"}
        {accept @kind="host-attribute" @policy="delegate-to-active-schema"}
        {accept @kind="text" @policy="preserve"}
        {accept @kind="comment" @policy="preserve"}
        {accept @kind="expression" @policy="delegate-to-cem-ql-expression-schema"}
    }
}
