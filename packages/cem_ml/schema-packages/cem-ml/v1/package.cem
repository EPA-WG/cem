@doc cem-ml 1
@ns pkg = "https://cem.dev/ns/schema-package/1"
@default pkg

{package @id="cem-ml" @version="1.0.0" |
    {schema
        @uri="https://cem.dev/ns/cem-ml/1"
        @source="schema/cem-ml-generic.cem"
    }

    {content-type @value="application/cem" @primary=true}
    {content-type @value="text/cem-ml" @alias=true}
    {content-type @value="text/cem" @alias=true}
    {content-type @value="application/cem+xml" @alias=true}

    {namespace @prefix="cemml" @uri="https://cem.dev/ns/cem-ml/1"}
    {namespace @prefix="schema" @uri="https://cem.dev/ns/schema/1"}

    {converter
        @id="cem-ml-to-dom-projection-rust"
        @implementation="rust"
        @rust-symbol="CemMlDomProjectionConverter"
        @streamable=true
        @lossiness="lossless"
        @implicit=true
        @readiness="ready"
        @cost=100 |
        {from @content-type="application/cem" @schema="https://cem.dev/ns/cem-ml/1"}
        {to @content-type="application/vnd.cem.dom+cem-bin" @schema="https://cem.dev/ns/projection/dom/1"}
    }

    {converter
        @id="cem-ml-to-ast-projection-rust"
        @implementation="rust"
        @rust-symbol="CemMlAstProjectionConverter"
        @streamable=true
        @lossiness="lossless"
        @implicit=true
        @readiness="ready"
        @cost=100 |
        {from @content-type="application/cem" @schema="https://cem.dev/ns/cem-ml/1"}
        {to @content-type="application/vnd.cem.ast+cem-bin" @schema="https://cem.dev/ns/projection/ast/1"}
    }

    {converter
        @id="cem-ml-to-events-projection-rust"
        @implementation="rust"
        @rust-symbol="CemMlEventsProjectionConverter"
        @streamable=true
        @lossiness="lossless"
        @implicit=true
        @readiness="ready"
        @cost=100 |
        {from @content-type="application/cem" @schema="https://cem.dev/ns/cem-ml/1"}
        {to @content-type="application/vnd.cem.events+cem-bin" @schema="https://cem.dev/ns/projection/events/1"}
    }

    {artifact
        @kind="formatter"
        @path="formatters/cem-format-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/cem-color-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
    }
}
