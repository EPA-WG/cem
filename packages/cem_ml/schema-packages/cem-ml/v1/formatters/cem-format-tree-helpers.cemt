@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {format-function
        @name="cem.format-tree.apply-stage"
        @visibility="private"
        @category="cem-tree"
        @subject="cem-ast-node"
        @produces="cem-tree"
        @content-type="application/cem"
        @schema="https://cem.dev/ns/cem-ml/1"
        @extends="cem.format-tree"
        @profile="cem.format-tree"
        @canonical=true
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="json" @required=true}
        {body |
            {$ applyEdits(
                appendFormatNode(
                    call("cem.format-tree.build-envelope", {
                        subject: call("cem.format-tree.build-nodes", { subject: $subject }),
                        mode: $mode,
                        formatterProfile: $formatterProfile,
                        lineEnding: $lineEnding,
                        indent: $indent,
                        ordering: $ordering,
                        wrapColumn: $wrapColumn
                    }),
                    {
                        kind: "format-decision",
                        name: "cemt-tree-patches",
                        formatterRole: "formatter.cemt.patch",
                        value: "applyEdits"
                    }
                ),
                [{ kind: "set", path: "canonical", value: true }]
            ) }
        }
    }

    {function
        @name="cem.format-tree.build-nodes"
        @visibility="private"
        @returns="array"
        @deterministic=true
        |
        {param @name="subject" @type="json" @required=true}
        {body |
            {$ call(cem.format-tree.inter-node-whitespace, {
                subject: call("cem.format-tree.build-node-list", { subject: $subject })
            }) }
        }
    }

    {function
        @name="cem.format-tree.build-node-list"
        @visibility="private"
        @returns="array"
        @deterministic=true
        |
        {param @name="subject" @type="json" @required=true}
        {body |
            {$ match(typeOf($subject), {
                array: map($subject, call("cem.format-tree.format-node", { subject: $item, depth: 0 })),
                object: match(exists($subject.kind), {
                    true: match($subject.kind, {
                        "cem-tree": call("cem.format-tree.build-tree-nodes", { subject: $subject }),
                        element: [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })],
                        text: [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })],
                        content: [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })],
                        string: [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })],
                        directive: [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })],
                        comment: [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })],
                        cdata: [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })],
                        "processing-instruction": [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })],
                        "raw-text": [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })],
                        whitespace: [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })],
                        raw: [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })],
                        default: $subject.__unsupportedCemAstKind
                    }),
                    false: [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })]
                }),
                default: $subject.__unsupportedCemAstSubject
            }) }
        }
    }

    {function
        @name="cem.format-tree.build-tree-nodes"
        @visibility="private"
        @returns="array"
        @deterministic=true
        |
        {param @name="subject" @type="object" @required=true}
        {body |
            {$ match(exists($subject.nodes), {
                true: map($subject.nodes, call("cem.format-tree.format-node", { subject: $item, depth: 0 })),
                false: match(exists($subject.node), {
                    true: [call("cem.format-tree.format-node", { subject: $subject.node, depth: 0 })],
                    false: match(exists($subject.root), {
                        true: [call("cem.format-tree.format-node", { subject: $subject.root, depth: 0 })],
                        false: [call("cem.format-tree.format-node", { subject: $subject, depth: 0 })]
                    })
                })
            }) }
        }
    }

    {function
        @name="cem.format-tree.format-node"
        @visibility="private"
        @returns="json"
        @deterministic=true
        |
        {param @name="subject" @type="json" @required=true}
        {param @name="depth" @type="integer" @default="0"}
        {body |
            {$ call("cem.format-tree.format-node-children", {
                subject: call("cem.format-tree.format-node-attributes", { subject: $subject }),
                depth: $depth
            }) }
        }
    }

    {function
        @name="cem.format-tree.format-node-attributes"
        @visibility="private"
        @returns="json"
        @deterministic=true
        |
        {param @name="subject" @type="json" @required=true}
        {body |
            {$ match(exists($subject.attributes), {
                true: match(length($subject.attributes), {
                    0: $subject,
                    1: set($subject, "formatBeforeAttributes", call("cem.format-tree.attribute-prefix", { subject: $subject })),
                    default: set(
                        set($subject, "formatBeforeAttributes", call("cem.format-tree.attribute-prefix", { subject: $subject })),
                        "formatBetweenAttributes",
                        call("cem.format-tree.attribute-spacing", { subject: $subject })
                    )
                }),
                false: $subject
            }) }
        }
    }

    {function
        @name="cem.format-tree.format-node-children"
        @visibility="private"
        @returns="json"
        @deterministic=true
        |
        {param @name="subject" @type="json" @required=true}
        {param @name="depth" @type="integer" @default="0"}
        {body |
            {$ match(exists($subject.children), {
                true: match(length($subject.children), {
                    0: $subject,
                    default: call("cem.format-tree.format-node-with-children", {
                        subject: $subject,
                        depth: $depth,
                        layout: call("cem.format-tree.node-child-layout", { subject: $subject })
                    })
                }),
                false: $subject
            }) }
        }
    }

    {function
        @name="cem.format-tree.format-node-with-children"
        @visibility="private"
        @returns="object"
        @deterministic=true
        |
        {param @name="subject" @type="object" @required=true}
        {param @name="depth" @type="integer" @default="0"}
        {param @name="layout" @type="string" @required=true}
        {body |
            {$ call("cem.format-tree.add-close-format", {
                subject: set(
                    set(
                        set(
                            $subject,
                            "children",
                            call("cem.format-tree.format-children", {
                                subject: $subject.children,
                                depth: $depth,
                                layout: $layout
                            })
                        ),
                        "formatLayout",
                        {
                            kind: "format-decision",
                            name: "layout",
                            formatterRole: "formatter.layout",
                            value: $layout
                        }
                    ),
                    "formatContentBoundary",
                    call("cem.format-tree.build-content-boundary", {
                        subject: $subject,
                        layout: $layout,
                        lineEnding: $lineEnding
                    })
                ),
                layout: $layout
            }) }
        }
    }

    {function
        @name="cem.format-tree.format-children"
        @visibility="private"
        @returns="array"
        @deterministic=true
        |
        {param @name="subject" @type="array" @required=true}
        {param @name="depth" @type="integer" @default="0"}
        {param @name="layout" @type="string" @required=true}
        {body |
            {$ match($layout, {
                block: call(cem.format-tree.block-children, {
                    subject: {
                        nodes: map($subject, call("cem.format-tree.format-node", { subject: $item, depth: add($depth, 1) })),
                        depth: add($depth, 1)
                    }
                }),
                default: map($subject, call("cem.format-tree.format-node", { subject: $item, depth: $depth }))
            }) }
        }
    }

    {function
        @name="cem.format-tree.node-child-layout"
        @visibility="private"
        @returns="string"
        @deterministic=true
        |
        {param @name="subject" @type="object" @required=true}
        {body |
            {$ match($subject.name, {
                "cem:if": "block",
                "cem:for": "block",
                "cem:choose": "block",
                default: "inline"
            }) }
        }
    }

    {function
        @name="cem.format-tree.children-all-text"
        @visibility="private"
        @returns="boolean"
        @deterministic=true
        |
        {param @name="subject" @type="array" @required=true}
        {body |
            {$ fold($subject, true, match($acc, {
                true: match($item.kind, {
                    text: true,
                    content: true,
                    string: true,
                    default: false
                }),
                false: false
            })) }
        }
    }

    {function
        @name="cem.format-tree.build-content-boundary"
        @visibility="private"
        @returns="array"
        @deterministic=true
        |
        {param @name="subject" @type="object" @required=true}
        {param @name="layout" @type="string" @required=true}
        {param @name="lineEnding" @type="string" @required=true}
        {body |
            {$ match(exists($subject.sourceMap), {
                true: match($layout, {
                    block: [
                        {
                            kind: "whitespace",
                            value: " ",
                            formatterOwned: true,
                            formatterRole: "formatter.boundary-spacing",
                            colorRole: "syntax.raw",
                            sourceMap: $subject.sourceMap
                        },
                        {
                            kind: "raw",
                            value: "|",
                            formatterOwned: true,
                            formatterRole: "formatter.content-boundary",
                            colorRole: "syntax.raw",
                            sourceMap: $subject.sourceMap
                        },
                        {
                            kind: "whitespace",
                            value: match($lineEnding, { crlf: "\r\n", default: "\n" }),
                            formatterOwned: true,
                            formatterRole: "formatter.line-ending",
                            colorRole: "syntax.raw",
                            sourceMap: $subject.sourceMap
                        }
                    ],
                    default: [
                        {
                            kind: "whitespace",
                            value: " ",
                            formatterOwned: true,
                            formatterRole: "formatter.boundary-spacing",
                            colorRole: "syntax.raw",
                            sourceMap: $subject.sourceMap
                        },
                        {
                            kind: "raw",
                            value: "|",
                            formatterOwned: true,
                            formatterRole: "formatter.content-boundary",
                            colorRole: "syntax.raw",
                            sourceMap: $subject.sourceMap
                        },
                        {
                            kind: "whitespace",
                            value: " ",
                            formatterOwned: true,
                            formatterRole: "formatter.boundary-spacing",
                            colorRole: "syntax.raw",
                            sourceMap: $subject.sourceMap
                        }
                    ]
                }),
                false: match($layout, {
                    block: [
                        {
                            kind: "whitespace",
                            value: " ",
                            formatterOwned: true,
                            formatterRole: "formatter.boundary-spacing",
                            colorRole: "syntax.raw"
                        },
                        {
                            kind: "raw",
                            value: "|",
                            formatterOwned: true,
                            formatterRole: "formatter.content-boundary",
                            colorRole: "syntax.raw"
                        },
                        {
                            kind: "whitespace",
                            value: match($lineEnding, { crlf: "\r\n", default: "\n" }),
                            formatterOwned: true,
                            formatterRole: "formatter.line-ending",
                            colorRole: "syntax.raw"
                        }
                    ],
                    default: [
                        {
                            kind: "whitespace",
                            value: " ",
                            formatterOwned: true,
                            formatterRole: "formatter.boundary-spacing",
                            colorRole: "syntax.raw"
                        },
                        {
                            kind: "raw",
                            value: "|",
                            formatterOwned: true,
                            formatterRole: "formatter.content-boundary",
                            colorRole: "syntax.raw"
                        },
                        {
                            kind: "whitespace",
                            value: " ",
                            formatterOwned: true,
                            formatterRole: "formatter.boundary-spacing",
                            colorRole: "syntax.raw"
                        }
                    ]
                })
            }) }
        }
    }

    {function
        @name="cem.format-tree.add-close-format"
        @visibility="private"
        @returns="object"
        @deterministic=true
        |
        {param @name="subject" @type="object" @required=true}
        {param @name="layout" @type="string" @required=true}
        {body |
            {$ match($layout, {
                block: set($subject, "formatBeforeClose", {
                    kind: "whitespace",
                    value: "",
                    formatterOwned: true,
                    formatterRole: "formatter.close-indent",
                    colorRole: "syntax.raw"
                }),
                default: $subject
            }) }
        }
    }

    {function
        @name="cem.format-tree.attribute-prefix"
        @visibility="private"
        @returns="object"
        @deterministic=true
        |
        {param @name="subject" @type="json" @required=true}
        {body |
            {$ {
                kind: "whitespace",
                value: " ",
                formatterOwned: true,
                formatterRole: "formatter.attribute-prefix",
                colorRole: "syntax.raw"
            } }
        }
    }

    {function
        @name="cem.format-tree.attribute-spacing"
        @visibility="private"
        @returns="object"
        @deterministic=true
        |
        {param @name="subject" @type="json" @required=true}
        {body |
            {$ {
                kind: "whitespace",
                value: " ",
                formatterOwned: true,
                formatterRole: "formatter.attribute-spacing",
                colorRole: "syntax.raw"
            } }
        }
    }

    {function
        @name="cem.format-tree.build-envelope"
        @visibility="private"
        @returns="object"
        @deterministic=true
        |
        {param @name="subject" @type="array" @required=true}
        {param @name="mode" @type="string" @required=true}
        {param @name="formatterProfile" @type="string" @required=true}
        {param @name="lineEnding" @type="string" @required=true}
        {param @name="indent" @type="string" @required=true}
        {param @name="ordering" @type="string" @required=true}
        {param @name="wrapColumn" @type="string" @required=true}
        {body |
            {$ call("cem.format-tree.add-format-nodes", {
                subject: {
                    kind: "cem-tree",
                    contentType: "application/cem",
                    schema: "https://cem.dev/ns/cem-ml/1",
                    category: "cem-tree",
                    mode: $mode,
                    canonical: true,
                    formatterProfile: $formatterProfile,
                    nodes: $subject
                },
                formatterProfile: $formatterProfile,
                lineEnding: $lineEnding,
                indent: $indent,
                ordering: $ordering,
                wrapColumn: $wrapColumn
            }) }
        }
    }

    {function
        @name="cem.format-tree.add-format-nodes"
        @visibility="private"
        @returns="object"
        @deterministic=true
        |
        {param @name="subject" @type="object" @required=true}
        {param @name="formatterProfile" @type="string" @required=true}
        {param @name="lineEnding" @type="string" @required=true}
        {param @name="indent" @type="string" @required=true}
        {param @name="ordering" @type="string" @required=true}
        {param @name="wrapColumn" @type="string" @required=true}
        {body |
            {$ appendFormatNode(
                appendFormatNode(
                    appendFormatNode(
                        appendFormatNode(
                            appendFormatNode(
                                appendFormatNode(
                                    $subject,
                                    {
                                        kind: "format-marker",
                                        name: "cem.format-tree",
                                        formatterRole: "formatter.boundary",
                                        colorRole: "source.gutter",
                                        formatterProfile: $formatterProfile
                                    }
                                ),
                                {
                                    kind: "format-decision",
                                    name: "line-ending",
                                    formatterRole: "formatter.line-ending",
                                    value: $lineEnding,
                                    colorRole: "source.gutter",
                                    formatterProfile: $formatterProfile
                                }
                            ),
                            {
                                kind: "format-decision",
                                name: "indent",
                                formatterRole: "formatter.indent",
                                value: $indent,
                                colorRole: "source.gutter",
                                formatterProfile: $formatterProfile
                            }
                        ),
                        {
                            kind: "format-decision",
                            name: "ordering",
                            formatterRole: "formatter.ordering",
                            value: $ordering,
                            colorRole: "source.gutter",
                            formatterProfile: $formatterProfile
                        }
                    ),
                    {
                        kind: "format-decision",
                        name: "wrapping",
                        formatterRole: "formatter.wrapping",
                        value: $wrapColumn,
                        colorRole: "source.gutter",
                        formatterProfile: $formatterProfile
                    }
                ),
                {
                    kind: "format-decision",
                    name: "whitespace",
                    formatterRole: "formatter.whitespace",
                    value: "formatter-owned",
                    colorRole: "source.gutter",
                    formatterProfile: $formatterProfile
                }
            ) }
        }
    }
}
