@doc cem-ml 1
@ns pkg = "https://cem.dev/ns/schema-package/1"
@default pkg

{package @id="cem-native-template" @version="1.0.0" |
    {schema
        @uri="https://cem.dev/ns/template/cem-native/1"
        @source="schema/cem-native-template.cem"
    }

    {content-type @value="application/vnd.cem.template+cem" @primary=true}
    {content-type @value="application/cem" @alias=true}
    {content-type @value="application/cem+xml" @alias=true}
    {content-type @value="text/cem" @alias=true}
    {content-type @value="text/cem-ml" @alias=true}

    {namespace @prefix="template" @uri="https://cem.dev/ns/template/cem-native/1"}
    {namespace @prefix="cem" @uri="https://cem.dev/ns/core/1"}

    {artifact
        @kind="formatter"
        @path="formatters/template-format-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.template+cem"
        @target-schema="https://cem.dev/ns/template/cem-native/1"
        @target-category="cem-tree"
        @function-name="template.format-tree"
        @formatter-profile="compact"
    }

    {artifact
        @kind="formatter"
        @path="formatters/template-format-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.template+cem"
        @target-schema="https://cem.dev/ns/template/cem-native/1"
        @target-category="cem-tree"
        @function-name="template.format-tree"
        @formatter-profile="pretty"
    }

    {artifact
        @kind="formatter"
        @path="formatters/template-format-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.template+cem"
        @target-schema="https://cem.dev/ns/template/cem-native/1"
        @target-category="cem-tree"
        @function-name="template.format-tree"
        @formatter-profile="tabular"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/template-color-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.template+cem"
        @target-schema="https://cem.dev/ns/template/cem-native/1"
        @target-category="cem-tree"
        @function-name="template.color-tree"
        @color-profile="terminal"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/template-color-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.template+cem"
        @target-schema="https://cem.dev/ns/template/cem-native/1"
        @target-category="cem-tree"
        @function-name="template.color-tree"
        @color-profile="html"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/template-color-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.template+cem"
        @target-schema="https://cem.dev/ns/template/cem-native/1"
        @target-category="cem-tree"
        @function-name="template.color-tree"
        @color-profile="md"
    }

    {example
        @id="basic-template"
        @path="examples/basic-template.cem"
        @content-type="application/vnd.cem.template+cem"
        @schema="https://cem.dev/ns/template/cem-native/1"
        @expected-result="pass"
    }

    {example
        @id="module-template"
        @path="examples/module-template.cem"
        @content-type="application/vnd.cem.template+cem"
        @schema="https://cem.dev/ns/template/cem-native/1"
        @expected-result="pass"
    }

    {example
        @id="invalid-missing-required-attribute"
        @path="examples/invalid-missing-required-attribute.cem"
        @content-type="application/vnd.cem.template+cem"
        @schema="https://cem.dev/ns/template/cem-native/1"
        @expected-result="fail"
        @expected-diagnostics="cem.schema_model.missing_required_attribute"
    }

    {example
        @id="invalid-duplicate-import-alias"
        @path="examples/invalid-duplicate-import-alias.cem"
        @content-type="application/vnd.cem.template+cem"
        @schema="https://cem.dev/ns/template/cem-native/1"
        @expected-result="fail"
        @expected-diagnostics="cem.template.import_alias_duplicate"
    }

    {example
        @id="invalid-duplicate-template-entrypoint"
        @path="examples/invalid-duplicate-template-entrypoint.cem"
        @content-type="application/vnd.cem.template+cem"
        @schema="https://cem.dev/ns/template/cem-native/1"
        @expected-result="fail"
        @expected-diagnostics="cem.template.entrypoint_duplicate"
    }

    {example
        @id="invalid-duplicate-param"
        @path="examples/invalid-duplicate-param.cem"
        @content-type="application/vnd.cem.template+cem"
        @schema="https://cem.dev/ns/template/cem-native/1"
        @expected-result="fail"
        @expected-diagnostics="cem.template.param_duplicate"
    }

    {example
        @id="invalid-duplicate-let"
        @path="examples/invalid-duplicate-let.cem"
        @content-type="application/vnd.cem.template+cem"
        @schema="https://cem.dev/ns/template/cem-native/1"
        @expected-result="fail"
        @expected-diagnostics="cem.template.let_duplicate"
    }

    {example
        @id="invalid-unknown-call"
        @path="examples/invalid-unknown-call.cem"
        @content-type="application/vnd.cem.template+cem"
        @schema="https://cem.dev/ns/template/cem-native/1"
        @expected-result="fail"
        @expected-diagnostics="cem.template.call_unknown"
    }

    {example
        @id="invalid-default-expr-reserved"
        @path="examples/invalid-default-expr-reserved.cem"
        @content-type="application/vnd.cem.template+cem"
        @schema="https://cem.dev/ns/template/cem-native/1"
        @expected-result="fail"
        @expected-diagnostics="cem.template.param_default_expr_reserved"
    }
}
