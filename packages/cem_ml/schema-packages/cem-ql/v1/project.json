{
    "name": "cem_ml_schema_package_cem_ql_v1",
    "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ml/schema-packages/cem-ql/v1",
    "targets": {
        "verify": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "cem_ml_cli"
                    ],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "mkdir -p packages/cem_ml/schema-packages/cem-ql/v1/dist",
                    "./dist/target/cem_ml_cli/debug/cem-ml --quiet validate --fail-level parse --format json --content-type application/vnd.cem.schema-package+cem --schema https://cem.dev/ns/schema-package/1 --report-json packages/cem_ml/schema-packages/cem-ql/v1/dist packages/cem_ml/schema-packages/cem-ql/v1/package.cem",
                    "cargo test -p cem-ml-transform-cem-ql real_engine_convert_uses_registered_cem_ql_source_output_handler --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml cem_ql_output_templates_are_schema_package_assets --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml cem_ql_package_examples_are_manifest_indexed --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml-cli schema_owned_cem_ql_examples_validate_through_cli --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ql --test compiled_artifact_reload --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ql --test transport_protocol --target-dir dist/target/cem_ml_cli",
                    "node packages/cem_ml/schema-packages/cem-ql/v1/scripts/verify-previews.mjs"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml/grammar/tree-sitter-cem/**/*",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/tests/schema_validation_examples.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml",
                "{workspaceRoot}/packages/cem_ql/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ql/tests/compiled_artifact_reload.rs",
                "{workspaceRoot}/packages/cem_ql/tests/transport_protocol.rs",
                "{workspaceRoot}/packages/cem_ql/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_transform_cem_ql/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_transform_cem_ql/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/dist/cem-ml.report.json",
                "{projectRoot}/dist/previews"
            ]
        }
    },
    "tags": [
        "scope:cem-ml",
        "type:schema-package",
        "lang:cem"
    ]
}
