@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function
        @name="cem-ql.color-tree"
        @visibility="public"
        @category="cem-tree"
        @subject="cem-tree"
        @produces="cem-tree"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @extends="cem.color-tree"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body |
            {$ {
                kind: "cem-tree",
                contentType: "application/vnd.cem.query+cem-ql",
                schema: "https://cem.dev/ns/query/cem-ql/1",
                category: "cem-tree",
                formatterProfile: match(exists($subject.formatterProfile), {
                    true: $subject.formatterProfile,
                    false: "unknown"
                }),
                formatNodes: match(exists($subject.formatNodes), {
                    true: $subject.formatNodes,
                    false: []
                }),
                colorProfile: call("cem-ql.color-tree.profile", {}),
                colorOutput: call("cem-ql.color-tree.output", {
                    profile: call("cem-ql.color-tree.profile", {})
                }),
                colored: true,
                colorNodes: [
                    {
                        kind: "color-marker",
                        name: "cem-ql.color-tree",
                        colorizerRole: "colorizer.boundary",
                        colorProfile: call("cem-ql.color-tree.profile", {}),
                        colorOutput: call("cem-ql.color-tree.output", {
                            profile: call("cem-ql.color-tree.profile", {})
                        })
                    },
                    {
                        kind: "color-decision",
                        name: "cem-ql.role-map",
                        colorizerRole: "colorizer.role",
                        colorProfile: call("cem-ql.color-tree.profile", {}),
                        colorOutput: call("cem-ql.color-tree.output", {
                            profile: call("cem-ql.color-tree.profile", {})
                        })
                    }
                ],
                nodes: map(
                    match(exists($subject.nodes), {
                        true: $subject.nodes,
                        false: []
                    }),
                    call("cem-ql.color-tree.token", {
                        token: $item,
                        profile: call("cem-ql.color-tree.profile", {})
                    })
                )
            } }
        }
    }

    {function
        @name="cem-ql.color-tree.profile"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {body |
            {$ match(exists($colorProfile), {
                true: $colorProfile,
                false: match(exists($functionProfile), {
                    true: $functionProfile,
                    false: "none"
                })
            }) }
        }
    }

    {function
        @name="cem-ql.color-tree.output"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match($profile, {
                html: "html",
                md: "md",
                none: "none",
                default: "terminal"
            }) }
        }
    }

    {function
        @name="cem-ql.color-tree.token"
        @visibility="private"
        @returns="object"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match(call("cem-ql.color-tree.should-style", {
                token: $token,
                profile: $profile,
                role: call("cem-ql.color-tree.token-role", { token: $token })
            }), {
                true: merge(
                    set($token, "value", call("cem-ql.color-tree.token-value", {
                        token: $token,
                        profile: $profile,
                        role: call("cem-ql.color-tree.token-role", { token: $token })
                    })),
                    {
                        style: call("cem-ql.color-tree.style", {
                            profile: $profile,
                            role: call("cem-ql.color-tree.token-role", { token: $token })
                        })
                    }
                ),
                false: set($token, "value", call("cem-ql.color-tree.token-value", {
                    token: $token,
                    profile: $profile,
                    role: call("cem-ql.color-tree.token-role", { token: $token })
                }))
            }) }
        }
    }

    {function
        @name="cem-ql.color-tree.token-value"
        @visibility="private"
        @returns="object"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {param @name="role" @type="string" @required=true}
        {body |
            {$ merge(
                match(exists($token.value), {
                    true: $token.value,
                    false: {}
                }),
                {
                    colorProfile: $profile,
                    colorRole: $role,
                    colorOutput: call("cem-ql.color-tree.output", { profile: $profile })
                }
            ) }
        }
    }

    {function
        @name="cem-ql.color-tree.should-style"
        @visibility="private"
        @returns="boolean"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {param @name="role" @type="string" @required=true}
        {body |
            {$ match($profile, {
                none: false,
                default: match($role, {
                    "source.whitespace": false,
                    default: true
                })
            }) }
        }
    }

    {function
        @name="cem-ql.color-tree.token-role"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {body |
            {$ match(exists($token.value.diagnostic), {
                true: "diagnostic.error",
                false: match(exists($token.value.legacy), {
                    true: call("cem-ql.color-tree.legacy-role", { token: $token.value.legacy }),
                    false: match(exists($token.value.cemQlRole), {
                        true: call("cem-ql.color-tree.role", { role: $token.value.cemQlRole }),
                        false: match(exists($token.value.operator), {
                            true: call("cem-ql.color-tree.operator-role", { operator: $token.value.operator }),
                            false: match(exists($token.role), {
                                true: call("cem-ql.color-tree.role", { role: $token.role }),
                                false: "syntax.token"
                            })
                        })
                    })
                })
            }) }
        }
    }

    {function
        @name="cem-ql.color-tree.operator-role"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="operator" @type="string" @required=true}
        {body |
            {$ call("cem-ql.color-tree.role", {
                role: call("cem-ql.color-tree.operator-cem-role", { operator: $operator })
            }) }
        }
    }

    {function
        @name="cem-ql.color-tree.operator-cem-role"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="operator" @type="string" @required=true}
        {body |
            {$ match($operator, {
                "==": "cem-ql.operator.comparison",
                "!=": "cem-ql.operator.comparison",
                "<": "cem-ql.operator.comparison",
                "<=": "cem-ql.operator.comparison",
                ">": "cem-ql.operator.comparison",
                ">=": "cem-ql.operator.comparison",
                "+": "cem-ql.operator.arithmetic",
                "-": "cem-ql.operator.arithmetic-or-set",
                "*": "cem-ql.operator.arithmetic",
                "/": "cem-ql.operator.arithmetic-or-child",
                "%": "cem-ql.operator.arithmetic",
                "&&": "cem-ql.operator.boolean",
                "||": "cem-ql.operator.boolean",
                "!": "cem-ql.operator.boolean",
                "??": "cem-ql.operator.coalesce",
                "|": "cem-ql.operator.set",
                "&": "cem-ql.operator.set",
                "^": "cem-ql.operator.set",
                ".": "cem-ql.operator.pipeline",
                "is": "cem-ql.operator.type-test",
                "as": "cem-ql.operator.cast",
                "treat_as": "cem-ql.operator.type-guard",
                "same_node": "cem-ql.operator.node-identity",
                default: "syntax.punctuation"
            }) }
        }
    }

    {function
        @name="cem-ql.color-tree.legacy-role"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="token" @type="string" @required=true}
        {body |
            {$ match($token, {
                "eq": "diagnostic.error",
                "ne": "diagnostic.error",
                "lt": "diagnostic.error",
                "le": "diagnostic.error",
                "gt": "diagnostic.error",
                "ge": "diagnostic.error",
                "div": "diagnostic.error",
                "mod": "diagnostic.error",
                "and": "diagnostic.error",
                "or": "diagnostic.error",
                "not": "diagnostic.error",
                "then": "diagnostic.error",
                "return": "diagnostic.error",
                "some": "diagnostic.error",
                "every": "diagnostic.error",
                "satisfies": "diagnostic.error",
                "instance": "diagnostic.error",
                "cast": "diagnostic.error",
                "treat": "diagnostic.error",
                "True": "diagnostic.error",
                "False": "diagnostic.error",
                "None": "diagnostic.error",
                "lambda": "diagnostic.error",
                default: "diagnostic.error"
            }) }
        }
    }

    {function
        @name="cem-ql.color-tree.role"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="role" @type="string" @required=true}
        {body |
            {$ match($role, {
                "cem-ql.operator.comparison": "syntax.punctuation",
                "cem-ql.operator.arithmetic": "syntax.punctuation",
                "cem-ql.operator.arithmetic-or-set": "syntax.punctuation",
                "cem-ql.operator.arithmetic-or-child": "syntax.punctuation",
                "cem-ql.operator.boolean": "syntax.punctuation",
                "cem-ql.operator.coalesce": "syntax.punctuation",
                "cem-ql.operator.set": "syntax.punctuation",
                "cem-ql.operator.pipeline": "syntax.punctuation",
                "cem-ql.operator.type-test": "syntax.keyword",
                "cem-ql.operator.cast": "syntax.keyword",
                "cem-ql.operator.type-guard": "syntax.keyword",
                "cem-ql.operator.node-identity": "syntax.keyword",
                "cem-ql.legacy.syntax": "diagnostic.error",
                default: $role
            }) }
        }
    }

    {function
        @name="cem-ql.color-tree.style"
        @visibility="private"
        @returns="object"
        @deterministic=true |
        {param @name="profile" @type="string" @required=true}
        {param @name="role" @type="string" @required=true}
        {body |
            {$ {
                colorRole: $role,
                colorProfile: $profile,
                colorOutput: call("cem-ql.color-tree.output", { profile: $profile })
            } }
        }
    }
}
