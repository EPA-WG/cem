@doc cem-ml 1
@ns schema = "https://cem.dev/ns/schema/1"
@ns cemml = "https://cem.dev/ns/cem-ml/1"
@ns xpath = "https://cem.dev/ns/query/xpath/1"
@default schema

{schema @name="cem-ql" @namespace="https://cem.dev/ns/query/cem-ql/1" @version="1.0.0" |
    {summary |
        {text | CEM-QL query module, shared expression, and compiled artifact resource schema. CEM-QL source is plain UTF-8 parsed by the cem-ql crate, while this schema provides registry identity, loader metadata, standalone expression reports, expression slot ownership, and cache artifact validation hooks for modules, imports, declarations, expressions, and compiled query artifacts.}
    }

    {uses |
        {use @schema="https://cem.dev/ns/schema/1" @as="schema"}
        {use @schema="https://cem.dev/ns/cem-ml/1" @as="cemml"}
        {use @schema="https://cem.dev/ns/query/xpath/1" @as="xpath"}
    }

    {content-types |
        {content-type @value="application/vnd.cem.query+cem-ql" @primary=true}
        {content-type @value="text/cem-ql" @alias=true}
        {content-type @value="application/vnd.cem.query-expression+cem-ql" @alias=true}
        {content-type @value="application/vnd.cem.query-artifact+cem-bin" @alias=true}
        {content-type @value="cem-ql/1" @alias=true}
        {content-type @value="cem-ql/module" @alias=true}
    }

    {namespaces |
        {namespace @prefix="ql" @uri="https://cem.dev/ns/query/cem-ql/1"}
    }

    {elements |
        {element @name="module" @required-attributes="uri" @children="source? encoding-report? token-stream? parse-facts? import declare expression"}
        {element @name="source" @optional-attributes="uri content-type media-type byte-length line-ending"}
        {element @name="encoding-report" @optional-attributes="declared-charset normalized-charset decoder-status invalid-byte-offset"}
        {element @name="token-stream" @children="token*"}
        {element @name="token" @required-attributes="index token-kind role" @optional-attributes="lexeme cooked operator legacy replacement source-id byte-offset byte-length line column end-line end-column"}
        {element @name="parse-facts" @children="parse-fact*"}
        {element @name="parse-fact" @required-attributes="kind" @optional-attributes="contract behavior diagnostic-code diagnostic-severity recoverable fatal token-index byte-offset byte-length line column message replacement"}
        {element @name="import" @required-attributes="src as" @optional-attributes="scheme policy"}
        {element @name="declare" @required-attributes="kind name" @optional-attributes="type visibility" @children="param body"}
        {element @name="param" @required-attributes="name" @optional-attributes="type"}
        {element @name="body" @children="expression"}
        {element @name="expression" @optional-attributes="kind type streaming"}
        {element @name="expression-resource" @required-attributes="content-type schema-uri" @optional-attributes="uri source-hash source-map-mode resolver-policy-stamp host-capability-profile evaluation-phase" @children="source? encoding-report? token-stream? parse-facts? expression-context? expression-result?"}
        {element @name="expression-context" @optional-attributes="data-uri data-content-type data-schema context-binding context-source context-item binding-profile" @children="expression-binding* expression-helper*"}
        {element @name="expression-binding" @required-attributes="name" @optional-attributes="type nullable binding-source"}
        {element @name="expression-helper" @required-attributes="name arity" @optional-attributes="param-types return-type binding-source"}
        {element @name="expression-result" @required-attributes="type" @optional-attributes="nullable item-count serialization source-map"}
        {element @name="expression-slot" @required-attributes="host-package slot-kind" @optional-attributes="slot-path expected-type expected-nullable evaluation-phase resolver-policy-stamp byte-offset byte-length line column end-line end-column"}
        {element @name="artifact" @required-attributes="content-type format hash mode source-hash schema-uri schema-version compiler-version policy-stamp stdlib-overlay-fingerprint type-profile source-map-mode" @optional-attributes="source-uri module-uri source-map import-closure"}
    }

    {attributes |
        {attribute @name="uri" @type="schema:uri"}
        {attribute @name="content-type" @type="schema:string"}
        {attribute @name="media-type" @type="schema:string"}
        {attribute @name="byte-length" @type="cemml:integer"}
        {attribute @name="line-ending" @type="schema:identifier" @values="crlf lf cr mixed"}
        {attribute @name="declared-charset" @type="schema:string"}
        {attribute @name="normalized-charset" @type="schema:identifier" @values="utf-8 other"}
        {attribute @name="decoder-status" @type="schema:identifier" @values="decoded unsupported invalid"}
        {attribute @name="invalid-byte-offset" @type="cemml:integer"}
        {attribute @name="src" @type="schema:uri"}
        {attribute @name="as" @type="schema:identifier"}
        {attribute @name="scheme" @type="schema:identifier" @values="platform network package local"}
        {attribute @name="policy" @type="schema:identifier"}
        {attribute @name="kind" @type="schema:identifier" @values="variable function expression module artifact parse-error invalid-utf8 module-uri-missing legacy-syntax import-alias-duplicate declaration-duplicate unresolved-import type-error expression-context-invalid data-binding-missing result-type-mismatch host-capability-denied artifact-hash-mismatch policy-mismatch source-map-unavailable"}
        {attribute @name="name" @type="schema:identifier"}
        {attribute @name="type" @type="schema:string"}
        {attribute @name="nullable" @type="schema:boolean"}
        {attribute @name="visibility" @type="schema:identifier" @values="private public"}
        {attribute @name="streaming" @type="schema:boolean"}
        {attribute @name="format" @type="schema:identifier" @values="cem-ql-ir-v1 cem-bin"}
        {attribute @name="hash" @type="schema:string"}
        {attribute @name="mode" @type="schema:identifier" @values="dev prod"}
        {attribute @name="index" @type="cemml:integer"}
        {attribute @name="token-index" @type="cemml:integer"}
        {attribute @name="token-kind" @type="schema:identifier"}
        {attribute @name="role" @type="schema:string"}
        {attribute @name="lexeme" @type="schema:string"}
        {attribute @name="cooked" @type="schema:string"}
        {attribute @name="operator" @type="schema:string"}
        {attribute @name="legacy" @type="schema:string"}
        {attribute @name="replacement" @type="schema:string"}
        {attribute @name="contract" @type="schema:identifier"}
        {attribute @name="behavior" @type="schema:identifier"}
        {attribute @name="diagnostic-code" @type="schema:identifier"}
        {attribute @name="diagnostic-severity" @type="schema:identifier" @values="info warning error fatal"}
        {attribute @name="recoverable" @type="schema:boolean"}
        {attribute @name="fatal" @type="schema:boolean"}
        {attribute @name="source-id" @type="schema:identifier"}
        {attribute @name="byte-offset" @type="cemml:integer"}
        {attribute @name="line" @type="cemml:integer"}
        {attribute @name="column" @type="cemml:integer"}
        {attribute @name="end-line" @type="cemml:integer"}
        {attribute @name="end-column" @type="cemml:integer"}
        {attribute @name="message" @type="schema:string"}
        {attribute @name="source-uri" @type="schema:uri"}
        {attribute @name="module-uri" @type="schema:uri"}
        {attribute @name="source-hash" @type="schema:string"}
        {attribute @name="schema-uri" @type="schema:uri"}
        {attribute @name="schema-version" @type="schema:semver"}
        {attribute @name="compiler-version" @type="schema:semver"}
        {attribute @name="policy-stamp" @type="schema:string"}
        {attribute @name="resolver-policy-stamp" @type="schema:string"}
        {attribute @name="host-capability-profile" @type="schema:string"}
        {attribute @name="evaluation-phase" @type="schema:identifier" @values="validate compile render runtime"}
        {attribute @name="data-uri" @type="schema:uri"}
        {attribute @name="data-content-type" @type="schema:media-type"}
        {attribute @name="data-schema" @type="schema:uri"}
        {attribute @name="context-binding" @type="schema:identifier"}
        {attribute @name="context-source" @type="schema:identifier" @values="input binding none"}
        {attribute @name="context-item" @type="schema:string"}
        {attribute @name="binding-profile" @type="schema:string"}
        {attribute @name="binding-source" @type="schema:identifier" @values="input literal resource host"}
        {attribute @name="arity" @type="cemml:integer"}
        {attribute @name="param-types" @type="schema:string"}
        {attribute @name="return-type" @type="schema:string"}
        {attribute @name="item-count" @type="cemml:integer"}
        {attribute @name="serialization" @type="schema:identifier" @values="json text cem-tree none"}
        {attribute @name="host-package" @type="schema:string"}
        {attribute @name="slot-kind" @type="schema:identifier"}
        {attribute @name="slot-path" @type="schema:string"}
        {attribute @name="expected-type" @type="schema:string"}
        {attribute @name="expected-nullable" @type="schema:boolean"}
        {attribute @name="stdlib-overlay-fingerprint" @type="schema:string"}
        {attribute @name="type-profile" @type="schema:string"}
        {attribute @name="source-map-mode" @type="schema:identifier" @values="none dev"}
        {attribute @name="source-map" @type="schema:uri"}
        {attribute @name="import-closure" @type="schema:string"}
    }

    {constraints |
        {constraint @kind="query-source-parser" @target="module" @diagnostic="cem.ql.parse_error" @behavior="cem-ql-parse-report-fact" @fact-kind="parse-error" @policy="delegate-to-cem-ql-crate"}
        {constraint @kind="utf-8-decode" @target="module" @diagnostic="cem.ql.invalid_utf8" @behavior="cem-ql-parse-report-fact" @fact-kind="invalid-utf8" @policy="CEM-QL source bytes must be valid UTF-8 before parsing"}
        {constraint @kind="module-uri-required" @target="module" @diagnostic="cem.ql.module_uri_missing" @behavior="cem-ql-parse-report-fact" @fact-kind="module-uri-missing" @policy="module URI declaration is required"}
        {constraint @kind="legacy-syntax-policy" @target="token" @diagnostic="cem.ql.use_rust_boolean_ops" @behavior="cem-ql-parse-report-fact" @fact-kind="legacy-syntax" @policy="XPath XQuery and Python compatibility spellings are diagnostics with Rust-first replacements"}
        {constraint @kind="unique-import-alias" @target="module" @diagnostic="cem.ql.import_alias_duplicate" @behavior="cem-ql-parse-report-fact" @fact-kind="import-alias-duplicate" @policy="required"}
        {constraint @kind="unique-declaration-name-per-scope" @target="module" @diagnostic="cem.ql.declaration_duplicate" @behavior="cem-ql-parse-report-fact" @fact-kind="declaration-duplicate" @policy="required"}
        {constraint @kind="unresolved-import-policy" @target="import" @diagnostic="cem.ql.import_unresolved" @behavior="cem-ql-resolution-fact" @fact-kind="unresolved-import" @policy="imports must resolve through the active module resolver"}
        {constraint @kind="type-check-policy" @target="expression" @diagnostic="cem.ql.type_error" @behavior="cem-ql-type-report-fact" @fact-kind="type-error" @policy="typed evaluator IR rejects incompatible operands and declarations"}
        {constraint @kind="standalone-expression-parser" @target="expression-resource" @diagnostic="cem.ql.parse_error" @behavior="cem-ql-expression-report-fact" @fact-kind="parse-error" @policy="standalone expression source uses the shared CEM-QL expression parser without requiring a module declaration"}
        {constraint @kind="standalone-expression-context-valid" @target="expression-context" @diagnostic="cem.ql.expression_context_invalid" @behavior="cem-ql-expression-report-fact" @fact-kind="expression-context-invalid" @policy="data and named bindings must lower to CEM-QL ItemStream values before evaluation"}
        {constraint @kind="standalone-expression-data-binding-required" @target="expression-binding" @diagnostic="cem.ql.data_binding_missing" @behavior="cem-ql-expression-report-fact" @fact-kind="data-binding-missing" @policy="referenced data bindings must be present unless the type profile declares them optional"}
        {constraint @kind="standalone-expression-result-type" @target="expression-result" @diagnostic="cem.ql.result_type_mismatch" @behavior="cem-ql-expression-report-fact" @fact-kind="result-type-mismatch" @policy="typed expression result must match the requested output type and nullability"}
        {constraint @kind="standalone-expression-host-capability-policy" @target="expression-resource" @diagnostic="cem.ql.host_capability_denied" @behavior="cem-ql-expression-report-fact" @fact-kind="host-capability-denied" @policy="resource-sensitive helpers require explicit host capability policy before evaluation"}
        {constraint @kind="xpath-expression-slot-owned" @target="expression-slot" @policy="slot-kind xpath compiles its lexical island once into a CEM-QL-owned XPath AST and delegates grammar and evaluation to the XPath schema"}
        {constraint @kind="xpath-expression-slot-native-bindings" @target="expression-slot" @policy="CEM-QL XPath invocation accepts only a native XPath context item and expanded-QName XPath sequences without a CEM-QL ItemStream or JSON bridge"}
        {constraint @kind="artifact-hash-required" @target="artifact" @diagnostic="cem.ql.artifact_hash_mismatch" @behavior="cem-ql-artifact-report-fact" @fact-kind="artifact-hash-mismatch" @policy="artifact hash covers the full identity envelope and IR bytes"}
        {constraint @kind="artifact-source-identity-validated" @target="artifact" @diagnostic="cem.ql.artifact_hash_mismatch" @behavior="cem-ql-artifact-report-fact" @fact-kind="artifact-source-mismatch" @policy="source URI and source byte hash must match the active source context when provided"}
        {constraint @kind="artifact-policy-stamps-validated" @target="artifact" @diagnostic="cem.cc.policy_mismatch" @behavior="cem-ql-artifact-report-fact" @fact-kind="policy-mismatch" @policy="import policy stdlib overlay type profile cache mode and source-map mode must match the active compile context on load"}
        {constraint @kind="artifact-source-map-dev-only" @target="artifact" @policy="dev mode only"}
        {constraint @kind="source-map-preferred" @target="token" @diagnostic="cem.ql.source_map_unavailable" @behavior="cem-ql-parse-report-fact" @fact-kind="source-map-unavailable" @policy="required when parser exposes source ranges"}
    }

    {diagnostics |
        {diagnostic @code="cem.ql.invalid_utf8" @severity="error"}
        {diagnostic @code="cem.ql.module_uri_missing" @severity="error"}
        {diagnostic @code="cem.ql.import_alias_duplicate" @severity="error"}
        {diagnostic @code="cem.ql.import_unresolved" @severity="error"}
        {diagnostic @code="cem.ql.import_denied" @severity="warning"}
        {diagnostic @code="cem.ql.reserved_scheme" @severity="error"}
        {diagnostic @code="cem.ql.declaration_duplicate" @severity="error"}
        {diagnostic @code="cem.ql.parse_error" @severity="error"}
        {diagnostic @code="cem.ql.use_rust_boolean_ops" @severity="error"}
        {diagnostic @code="cem.ql.type_error" @severity="error"}
        {diagnostic @code="cem.ql.expression_context_invalid" @severity="error"}
        {diagnostic @code="cem.ql.data_binding_missing" @severity="error"}
        {diagnostic @code="cem.ql.result_type_mismatch" @severity="error"}
        {diagnostic @code="cem.ql.host_capability_denied" @severity="error"}
        {diagnostic @code="cem.ql.artifact_hash_mismatch" @severity="error"}
        {diagnostic @code="cem.ql.source_map_unavailable" @severity="info"}
        {diagnostic @code="cem.cc.policy_mismatch" @severity="error"}
    }

    {open-content |
        {accept @kind="query-extension" @policy="reject-unless-declared"}
        {accept @kind="compiled-artifact-section" @policy="reject-unless-declared"}
        {accept @kind="xpath-expression" @policy="delegate-to-https://cem.dev/ns/query/xpath/1 through a slot-kind xpath expression-slot"}
    }
}
