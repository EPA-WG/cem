@doc cem-ml 1
@ns pkg = "https://cem.dev/ns/schema-package/1"
@default pkg

{package @id="cem-ql" @version="1.0.0" |
    {schema
        @uri="https://cem.dev/ns/query/cem-ql/1"
        @source="schema/cem-ql.cem"
    }

    {content-type @value="application/vnd.cem.query+cem-ql" @primary=true}
    {content-type @value="text/cem-ql" @alias=true}
    {content-type @value="application/vnd.cem.query-artifact+cem-bin" @alias=true}
    {content-type @value="cem-ql/1" @alias=true}
    {content-type @value="cem-ql/module" @alias=true}

    {namespace @prefix="ql" @uri="https://cem.dev/ns/query/cem-ql/1"}

    {artifact
        @kind="formatter"
        @path="formatters/cem-ql-format-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query+cem-ql"
        @target-schema="https://cem.dev/ns/query/cem-ql/1"
        @target-category="cem-tree"
        @function-name="cem-ql.format-tree"
        @formatter-profile="compact"
    }

    {artifact
        @kind="formatter"
        @path="formatters/cem-ql-format-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query+cem-ql"
        @target-schema="https://cem.dev/ns/query/cem-ql/1"
        @target-category="cem-tree"
        @function-name="cem-ql.format-tree"
        @formatter-profile="pretty"
    }

    {artifact
        @kind="formatter"
        @path="formatters/cem-ql-format-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query+cem-ql"
        @target-schema="https://cem.dev/ns/query/cem-ql/1"
        @target-category="cem-tree"
        @function-name="cem-ql.format-tree"
        @formatter-profile="tabular"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/cem-ql-color-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query+cem-ql"
        @target-schema="https://cem.dev/ns/query/cem-ql/1"
        @target-category="cem-tree"
        @function-name="cem-ql.color-tree"
        @color-profile="terminal"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/cem-ql-color-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query+cem-ql"
        @target-schema="https://cem.dev/ns/query/cem-ql/1"
        @target-category="cem-tree"
        @function-name="cem-ql.color-tree"
        @color-profile="html"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/cem-ql-color-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query+cem-ql"
        @target-schema="https://cem.dev/ns/query/cem-ql/1"
        @target-category="cem-tree"
        @function-name="cem-ql.color-tree"
        @color-profile="md"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/cem-ql-color-tree.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query+cem-ql"
        @target-schema="https://cem.dev/ns/query/cem-ql/1"
        @target-category="cem-tree"
        @function-name="cem-ql.color-tree"
        @color-profile="none"
    }

    {example
        @id="basic-query"
        @path="examples/basic-query.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="pass"
    }

    {example
        @id="module-query"
        @path="examples/module-query.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="pass"
    }

    {example
        @id="operators-and-control"
        @path="examples/operators-and-control.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="pass"
    }

    {example
        @id="collections-and-pipelines"
        @path="examples/collections-and-pipelines.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="pass"
    }

    {example
        @id="stdlib-data-helpers"
        @path="examples/stdlib-data-helpers.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="pass"
    }

    {example
        @id="host-resource-helpers"
        @path="examples/host-resource-helpers.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="pass"
    }

    {example
        @id="alias-content-type"
        @path="examples/alias-content-type.cemql"
        @content-type="text/cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="pass"
    }

    {example
        @id="line-ending-lf"
        @path="examples/line-ending-lf.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="pass"
    }

    {example
        @id="line-ending-crlf"
        @path="examples/line-ending-crlf.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="pass"
    }

    {example
        @id="comments-and-whitespace"
        @path="examples/comments-and-whitespace.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="pass"
    }

    {example
        @id="source-token-ranges"
        @path="examples/source-token-ranges.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="pass"
    }

    {example
        @id="invalid-parse"
        @path="examples/invalid-parse.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="fail"
        @expected-diagnostics="cem.ql.parse_error"
    }

    {example
        @id="invalid-missing-module"
        @path="examples/invalid-missing-module.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="fail"
        @expected-diagnostics="cem.ql.module_uri_missing"
    }

    {example
        @id="invalid-old-syntax"
        @path="examples/invalid-old-syntax.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="fail"
        @expected-diagnostics="cem.ql.use_rust_boolean_ops"
    }

    {example
        @id="invalid-utf8"
        @path="examples/invalid-utf8.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="fail"
        @expected-diagnostics="cem.ql.invalid_utf8"
    }

    {example
        @id="invalid-duplicate-import-alias"
        @path="examples/invalid-duplicate-import-alias.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="fail"
        @expected-diagnostics="cem.ql.import_alias_duplicate"
    }

    {example
        @id="invalid-unresolved-import"
        @path="examples/invalid-unresolved-import.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="fail"
        @expected-diagnostics="cem.ql.import_unresolved"
    }

    {example
        @id="invalid-type-error"
        @path="examples/invalid-type-error.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="fail"
        @expected-diagnostics="cem.ql.type_error"
    }

    {example
        @id="invalid-duplicate-declaration"
        @path="examples/invalid-duplicate-declaration.cemql"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @expected-result="fail"
        @expected-diagnostics="cem.ql.declaration_duplicate"
    }
}
