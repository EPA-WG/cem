@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {format-function
        @name="cem-ql.format-tree"
        @visibility="public"
        @category="cem-tree"
        @subject="cem-ast-node"
        @produces="cem-tree"
        @content-type="application/vnd.cem.query+cem-ql"
        @schema="https://cem.dev/ns/query/cem-ql/1"
        @extends="cem.format-tree"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body |
            {$ {
                kind: "cem-tree",
                contentType: "application/vnd.cem.query+cem-ql",
                schema: "https://cem.dev/ns/query/cem-ql/1",
                category: "cem-tree",
                formatterProfile: call("cem-ql.format-tree.profile", {}),
                formatNodes: [
                    {
                        kind: "format-marker",
                        name: "cem-ql.format-tree",
                        formatterRole: "formatter.boundary",
                        formatterProfile: call("cem-ql.format-tree.profile", {})
                    },
                    {
                        kind: "format-decision",
                        name: "cem-ql.layout",
                        formatterRole: "formatter.layout",
                        formatterProfile: call("cem-ql.format-tree.profile", {}),
                        value: {
                            layout: concat(call("cem-ql.format-tree.profile", {}), "-token-stream"),
                            lineEnding: $lineEnding,
                            sourcePreserving: true
                        }
                    }
                ],
                nodes: extend(
                    [
                        {
                            kind: "cem-ql.format-marker",
                            writerKind: "token",
                            text: "",
                            role: "formatter.boundary",
                            value: {
                                name: "cem-ql.format-tree",
                                formatterProfile: call("cem-ql.format-tree.profile", {})
                            }
                        },
                        {
                            kind: "cem-ql.format-decision",
                            writerKind: "token",
                            text: "",
                            role: "formatter.layout",
                            value: {
                                layout: concat(call("cem-ql.format-tree.profile", {}), "-token-stream"),
                                lineEnding: $lineEnding,
                                sourcePreserving: true
                            }
                        }
                    ],
                    call("cem-ql.format-tree.tokens", {
                        tokens: match(exists($subject.tokens), {
                            true: $subject.tokens,
                            false: []
                        }),
                        profile: call("cem-ql.format-tree.profile", {})
                    })
                )
            } }
        }
    }

    {function
        @name="cem-ql.format-tree.profile"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {body |
            {$ match(exists($formatterProfile), {
                true: $formatterProfile,
                false: match(exists($functionProfile), {
                    true: $functionProfile,
                    false: "compact"
                })
            }) }
        }
    }

    {function
        @name="cem-ql.format-tree.tokens"
        @visibility="private"
        @returns="array"
        @deterministic=true |
        {param @name="tokens" @type="array" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ map($tokens, call("cem-ql.format-tree.token-node", {
                token: $item,
                profile: $profile
            })) }
        }
    }

    {function
        @name="cem-ql.format-tree.token-node"
        @visibility="private"
        @returns="object"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ merge(
                {
                    kind: match(exists($token.kind), {
                        true: $token.kind,
                        false: "cem-ql.token"
                    }),
                    writerKind: "token",
                    text: call("cem-ql.format-tree.token-text", { token: $token }),
                    role: match(exists($token.role), {
                        true: $token.role,
                        false: "syntax.token"
                    }),
                    outputSpan: match(exists($token.outputSpan), {
                        true: $token.outputSpan,
                        false: null
                    }),
                    value: match(exists($token.value), {
                        true: merge(
                            merge(
                                {
                                    tokenKind: $token.value.tokenKind,
                                    lexeme: $token.value.lexeme,
                                    byteOffset: $token.value.byteOffset,
                                    byteLength: $token.value.byteLength,
                                    index: $token.value.index,
                                    role: $token.value.role,
                                    formatterProfile: $profile
                                },
                                match(exists($token.value.operator), {
                                    true: {
                                        operator: $token.value.operator,
                                        cemQlRole: $token.value.cemQlRole
                                    },
                                    false: {}
                                })
                            ),
                            match(exists($token.value.legacy), {
                                true: {
                                    legacy: $token.value.legacy,
                                    diagnostic: $token.value.diagnostic,
                                    replacement: $token.value.replacement
                                },
                                false: {}
                            })
                        ),
                        false: { formatterProfile: $profile }
                    })
                },
                match(exists($token.sourceMap), {
                    true: { sourceMap: $token.sourceMap },
                    false: {}
                })
            ) }
        }
    }

    {function
        @name="cem-ql.format-tree.token-text"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {body |
            {$ match(exists($token.text), {
                true: match($token.kind, {
                    "cem-ql.whitespace": call("cem-ql.format-tree.whitespace-text", {
                        value: $token.text
                    }),
                    default: $token.text
                }),
                false: ""
            }) }
        }
    }

    {function
        @name="cem-ql.format-tree.whitespace-text"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="value" @type="string" @required=true}
        {body |
            {$ match($lineEnding, {
                preserve: $value,
                crlf: replace(call("cem-ql.format-tree.whitespace-lf", { value: $value }), "\n", "\r\n"),
                default: call("cem-ql.format-tree.whitespace-lf", { value: $value })
            }) }
        }
    }

    {function
        @name="cem-ql.format-tree.whitespace-lf"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="value" @type="string" @required=true}
        {body |
            {$ replace(replace($value, "\r\n", "\n"), "\r", "\n") }
        }
    }

    {function
        @name="cem-ql.format-tree.operator-role"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="operator" @type="string" @required=true}
        {body |
            {$ match($operator, {
                "==": "cem-ql.operator.comparison",
                "!=": "cem-ql.operator.comparison",
                "<": "cem-ql.operator.comparison",
                "<=": "cem-ql.operator.comparison",
                ">": "cem-ql.operator.comparison",
                ">=": "cem-ql.operator.comparison",
                "+": "cem-ql.operator.arithmetic",
                "-": "cem-ql.operator.arithmetic-or-set",
                "*": "cem-ql.operator.arithmetic",
                "/": "cem-ql.operator.arithmetic-or-child",
                "%": "cem-ql.operator.arithmetic",
                "&&": "cem-ql.operator.boolean",
                "||": "cem-ql.operator.boolean",
                "!": "cem-ql.operator.boolean",
                "??": "cem-ql.operator.coalesce",
                "|": "cem-ql.operator.set",
                "&": "cem-ql.operator.set",
                "^": "cem-ql.operator.set",
                ".": "cem-ql.operator.pipeline",
                "is": "cem-ql.operator.type-test",
                "as": "cem-ql.operator.cast",
                "treat_as": "cem-ql.operator.type-guard",
                "same_node": "cem-ql.operator.node-identity",
                default: "syntax.punctuation"
            }) }
        }
    }

    {function
        @name="cem-ql.format-tree.legacy-replacement"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="token" @type="string" @required=true}
        {body |
            {$ match($token, {
                "eq": "==",
                "ne": "!=",
                "lt": "<",
                "le": "<=",
                "gt": ">",
                "ge": ">=",
                "div": "/",
                "mod": "%",
                "and": "&&",
                "or": "||",
                "not": "!",
                "then": "if condition { then_expr } else { else_expr }",
                "return": "for name in stream { expr }",
                "some": "any(stream, fn)",
                "every": "all(stream, fn)",
                "satisfies": "any(stream, fn) or all(stream, fn)",
                "instance": "expr is Type",
                "cast": "expr as Type",
                "treat": "treat_as(expr, Type)",
                "True": "true",
                "False": "false",
                "None": "null",
                "lambda": "fn(...) => expression",
                default: ""
            }) }
        }
    }

    {function
        @name="cem-ql.format-tree.legacy-diagnostic-code"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="token" @type="string" @required=true}
        {body |
            {$ match($token, {
                "and": "cem.ql.use_rust_boolean_ops",
                "or": "cem.ql.use_rust_boolean_ops",
                "not": "cem.ql.use_rust_boolean_ops",
                default: "cem.ql.parse_error"
            }) }
        }
    }

    {function
        @name="cem-ql.format-tree.legacy-diagnostic"
        @visibility="private"
        @returns="object"
        @deterministic=true |
        {param @name="token" @type="string" @required=true}
        {body |
            {$ {
                code: call("cem-ql.format-tree.legacy-diagnostic-code", { token: $token }),
                severity: "error",
                role: "diagnostic.error",
                canonical: false,
                replacement: call("cem-ql.format-tree.legacy-replacement", { token: $token })
            } }
        }
    }
}
