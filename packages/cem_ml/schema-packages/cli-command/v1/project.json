{
    "name": "cem_ml_schema_package_cli_command_v1",
    "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ml/schema-packages/cli-command/v1",
    "targets": {
        "build": {
            "cache": true,
            "executor": "nx:noop",
            "dependsOn": ["samples2readme"],
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/schema/**/*",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{workspaceRoot}/dist/cem_ml/schema-packages/cli-command/v1/examples/*.html",
                "{projectRoot}/examples/previews/*.svg"
            ]
        },
        "samples2readme": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [{ "projects": ["cem_ml_cli"], "target": "build" }],
            "options": {
                "commands": ["node packages/cem_ml/schema-packages/scripts/samples2readme.mjs {projectRoot}"],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/README.md",
                "{workspaceRoot}/dist/cem_ml/schema-packages/cli-command/v1/examples/*.html",
                "{projectRoot}/examples/previews/*.svg"
            ]
        },
        "verify": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                { "projects": ["cem_ml_cli"], "target": "build" },
                { "projects": ["@epa-wg/cem-ml-cli"], "target": "build" }
            ],
            "options": {
                "commands": [
                    "mkdir -p packages/cem_ml/schema-packages/cli-command/v1/dist",
                    "./dist/target/cem_ml_cli/debug/cem-ml --quiet validate --fail-level parse --format json --content-type application/vnd.cem.schema-package+cem --schema https://cem.dev/ns/schema-package/1 --report-json packages/cem_ml/schema-packages/cli-command/v1/dist packages/cem_ml/schema-packages/cli-command/v1/package.cem",
                    "cargo test -p cem-ml --test cli_command -- --nocapture",
                    "cargo test -p cem-ml builtins_validate_cli_command_json_without_cem_tokenizer_fallback --lib -- --nocapture",
                    "cargo test -p cem-ml built_in_schema_package_structure_audit_reports_folder_contract --test schema_package_structure -- --nocapture",
                    "node --test packages/cem-ml-cli-npm/tests/command-schema.test.mjs"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/schema/**/*.json",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/examples/**/*",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/tests/**/*.rs",
                "{workspaceRoot}/packages/cem-ml-cli-npm/src/**/*.ts",
                "{workspaceRoot}/packages/cem-ml-cli-npm/tests/**/*",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": ["{projectRoot}/dist/cem-ml.report.json"]
        }
    },
    "tags": ["scope:cem-ml", "type:schema-package", "lang:cem"]
}
