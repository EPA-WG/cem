@doc cem-ml 1
@ns pkg = "https://cem.dev/ns/schema-package/1"
@default pkg

{package @id="cem-dom-projection" @version="1.0.0" |
    {schema
        @uri="https://cem.dev/ns/projection/dom/1"
        @source="schema/cem-dom-projection.cem"
    }

    {content-type @value="application/vnd.cem.dom+cem-bin" @primary=true}
    {content-type @value="application/vnd.cem.dom+json" @alias=true}

    {namespace @prefix="cemdom" @uri="https://cem.dev/ns/projection/dom/1"}

    {converter
        @id="cem-dom-projection-to-html-cemt"
        @implementation="cemt"
        @template="converters/dom-to-html.cemt"
        @template-content-type="application/vnd.cem.transform+cem"
        @template-schema="https://cem.dev/ns/transform/cem/1"
        @template-entrypoint="main"
        @rust-symbol="HtmlExportConverter"
        @streamable=true
        @lossiness="serialization"
        @output-syntax="html"
        @encoding-category="html-document"
        @formatter-profile="compact"
        @color-profile="classes"
        @parity="parse-equivalent"
        @implicit=true
        @readiness="ready"
        @cost=100
        @fallback-reason="Rust fallback remains available when an executable CEMT adapter is unavailable" |
        {from @content-type="application/vnd.cem.dom+cem-bin" @schema="https://cem.dev/ns/projection/dom/1"}
        {to @content-type="text/html" @schema="https://cem.dev/ns/data/html/1"}
        {parity-fixture
            @id="basic-dom"
            @path="examples/basic-dom.cem-bin"
            @content-type="application/vnd.cem.dom+cem-bin"
            @schema="https://cem.dev/ns/projection/dom/1"}
    }

    {converter
        @id="cem-dom-projection-to-xml-cemt"
        @implementation="cemt"
        @template="converters/dom-to-xml.cemt"
        @template-content-type="application/vnd.cem.transform+cem"
        @template-schema="https://cem.dev/ns/transform/cem/1"
        @template-entrypoint="main"
        @rust-symbol="XmlExportConverter"
        @streamable=true
        @lossiness="serialization"
        @output-syntax="xml"
        @encoding-category="xml-document"
        @formatter-profile="compact"
        @parity="parse-equivalent"
        @implicit=true
        @readiness="ready"
        @cost=100
        @fallback-reason="Rust fallback remains available when an executable CEMT adapter is unavailable" |
        {from @content-type="application/vnd.cem.dom+cem-bin" @schema="https://cem.dev/ns/projection/dom/1"}
        {to @content-type="application/xml" @schema="https://cem.dev/ns/data/xml/1"}
        {parity-fixture
            @id="basic-dom"
            @path="examples/basic-dom.cem-bin"
            @content-type="application/vnd.cem.dom+cem-bin"
            @schema="https://cem.dev/ns/projection/dom/1"}
    }

    {converter
        @id="cem-dom-projection-to-html-rust"
        @implementation="rust"
        @rust-symbol="HtmlExportConverter"
        @streamable=true
        @lossiness="serialization"
        @implicit=true
        @readiness="ready"
        @cost=100 |
        {from @content-type="application/vnd.cem.dom+cem-bin" @schema="https://cem.dev/ns/projection/dom/1"}
        {to @content-type="text/html" @schema="https://cem.dev/ns/data/html/1"}
    }

    {converter
        @id="cem-dom-projection-to-xml-rust"
        @implementation="rust"
        @rust-symbol="XmlExportConverter"
        @streamable=true
        @lossiness="serialization"
        @implicit=true
        @readiness="ready"
        @cost=100 |
        {from @content-type="application/vnd.cem.dom+cem-bin" @schema="https://cem.dev/ns/projection/dom/1"}
        {to @content-type="application/xml" @schema="https://cem.dev/ns/data/xml/1"}
    }

    {converter
        @id="cem-dom-projection-to-json-debug-rust"
        @implementation="rust"
        @rust-symbol="DomJsonDebugProjectionConverter"
        @streamable=true
        @lossiness="debug-view"
        @implicit=true
        @readiness="ready"
        @cost=150 |
        {from @content-type="application/vnd.cem.dom+cem-bin" @schema="https://cem.dev/ns/projection/dom/1"}
        {to @content-type="application/vnd.cem.dom+json" @schema="https://cem.dev/ns/projection/dom/1"}
    }
}
