@doc cem-ml 1
@ns pkg = "https://cem.dev/ns/schema-package/1"
@default pkg

{package @id="cem-dom-projection" @version="1.0.0" |
    {schema
        @uri="https://cem.dev/ns/projection/dom/1"
        @source="schema/cem-dom-projection.cem"
    }

    {content-type @value="application/vnd.cem.dom+cem-bin" @primary=true}
    {content-type @value="application/vnd.cem.dom+json" @alias=true}

    {namespace @prefix="cemdom" @uri="https://cem.dev/ns/projection/dom/1"}

    {converter
        @id="cem-dom-projection-to-html-cemt"
        @implementation="cemt"
        @template="converters/dom-to-html.cemt"
        @template-content-type="application/vnd.cem.transform+cem"
        @template-schema="https://cem.dev/ns/transform/cem/1"
        @rust-symbol="HtmlExportConverter"
        @streamable=true
        @lossiness="serialization"
        @implicit=true
        @readiness="planned"
        @fallback-reason="CEMT DOM-to-HTML serialization edge is registered before execution is wired" |
        {from @content-type="application/vnd.cem.dom+cem-bin" @schema="https://cem.dev/ns/projection/dom/1"}
        {to @content-type="text/html" @schema="https://cem.dev/ns/data/html/1"}
    }

    {converter
        @id="cem-dom-projection-to-xml-cemt"
        @implementation="cemt"
        @template="converters/dom-to-xml.cemt"
        @template-content-type="application/vnd.cem.transform+cem"
        @template-schema="https://cem.dev/ns/transform/cem/1"
        @rust-symbol="XmlExportConverter"
        @streamable=true
        @lossiness="serialization"
        @implicit=true
        @readiness="planned"
        @fallback-reason="CEMT DOM-to-XML serialization edge is registered before execution is wired" |
        {from @content-type="application/vnd.cem.dom+cem-bin" @schema="https://cem.dev/ns/projection/dom/1"}
        {to @content-type="application/xml" @schema="https://cem.dev/ns/data/xml/1"}
    }
}
