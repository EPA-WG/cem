@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function
        @name="relax-ng.color-schema"
        @category="relax-ng-schema"
        @subject="tokens"
        @produces="tokens"
        @content-type="application/relax-ng+xml"
        @schema="https://cem.dev/ns/data/relax-ng/1"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="array" @required=true}
    }
}
