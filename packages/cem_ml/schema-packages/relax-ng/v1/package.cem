@doc cem-ml 1
@ns pkg = "https://cem.dev/ns/schema-package/1"
@default pkg

{package @id="relax-ng" @version="1.0.0" |
    {schema
        @uri="https://cem.dev/ns/data/relax-ng/1"
        @source="schema/relax-ng.cem"
    }

    {content-type @value="application/relax-ng+xml" @primary=true}
    {content-type @value="application/relax-ng-compact-syntax" @alias=true}

    {namespace @prefix="cemrng" @uri="https://cem.dev/ns/data/relax-ng/1"}
    {namespace @prefix="rng" @uri="http://relaxng.org/ns/structure/1.0"}

    {artifact @kind="formatter" @path="formatters/xml-compact.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng+xml" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-xml-document" @function-name="relax-ng.format-xml-document" @formatter-profile="compact"}
    {artifact @kind="formatter" @path="formatters/xml-pretty.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng+xml" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-xml-document" @function-name="relax-ng.format-xml-document" @formatter-profile="pretty"}
    {artifact @kind="formatter" @path="formatters/xml-tabular.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng+xml" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-xml-document" @function-name="relax-ng.format-xml-document" @formatter-profile="tabular"}
    {artifact @kind="formatter" @path="formatters/compact-compact.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng-compact-syntax" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-compact-document" @function-name="relax-ng.format-compact-document" @formatter-profile="compact"}
    {artifact @kind="formatter" @path="formatters/compact-pretty.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng-compact-syntax" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-compact-document" @function-name="relax-ng.format-compact-document" @formatter-profile="pretty"}
    {artifact @kind="formatter" @path="formatters/compact-tabular.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng-compact-syntax" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-compact-document" @function-name="relax-ng.format-compact-document" @formatter-profile="tabular"}
    {artifact @kind="formatter-helper" @path="formatters/relax-ng-format-schema.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng+xml" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-xml-document"}
    {artifact @kind="formatter-helper" @path="formatters/relax-ng-format-schema.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng-compact-syntax" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-compact-document"}

    {artifact @kind="colorizer" @path="colorizers/xml-terminal.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng+xml" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-xml-document" @function-name="relax-ng.color-xml-document" @color-profile="terminal"}
    {artifact @kind="colorizer" @path="colorizers/xml-html.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng+xml" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-xml-document" @function-name="relax-ng.color-xml-document" @color-profile="html"}
    {artifact @kind="colorizer" @path="colorizers/xml-md.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng+xml" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-xml-document" @function-name="relax-ng.color-xml-document" @color-profile="md"}
    {artifact @kind="colorizer" @path="colorizers/compact-terminal.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng-compact-syntax" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-compact-document" @function-name="relax-ng.color-compact-document" @color-profile="terminal"}
    {artifact @kind="colorizer" @path="colorizers/compact-html.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng-compact-syntax" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-compact-document" @function-name="relax-ng.color-compact-document" @color-profile="html"}
    {artifact @kind="colorizer" @path="colorizers/compact-md.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng-compact-syntax" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-compact-document" @function-name="relax-ng.color-compact-document" @color-profile="md"}
    {artifact @kind="colorizer-helper" @path="colorizers/relax-ng-color-schema.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng+xml" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-xml-document"}
    {artifact @kind="colorizer-helper" @path="colorizers/relax-ng-color-schema.cemt" @content-type="application/vnd.cem.transform+cem" @schema="https://cem.dev/ns/transform/cem/1" @target-content-type="application/relax-ng-compact-syntax" @target-schema="https://cem.dev/ns/data/relax-ng/1" @target-category="relax-ng-compact-document"}

    {example
        @id="basic-schema-xml"
        @path="examples/basic-schema.rng"
        @content-type="application/relax-ng+xml"
        @schema="https://cem.dev/ns/data/relax-ng/1"
        @expected-result="pass"
    }

    {example
        @id="datatype-schema"
        @path="examples/datatype-schema.rng"
        @content-type="application/relax-ng+xml"
        @schema="https://cem.dev/ns/data/relax-ng/1"
        @expected-result="pass"
    }

    {example
        @id="basic-schema-compact"
        @path="examples/basic-schema.rnc"
        @content-type="application/relax-ng-compact-syntax"
        @schema="https://cem.dev/ns/data/relax-ng/1"
        @expected-result="pass"
    }

    {example
        @id="invalid-missing-start"
        @path="examples/invalid-missing-start.rng"
        @content-type="application/relax-ng+xml"
        @schema="https://cem.dev/ns/data/relax-ng/1"
        @expected-result="fail"
        @expected-diagnostics="cem.relax_ng.missing_start"
    }

    {example
        @id="invalid-unknown-element"
        @path="examples/invalid-unknown-element.rng"
        @content-type="application/relax-ng+xml"
        @schema="https://cem.dev/ns/data/relax-ng/1"
        @expected-result="fail"
        @expected-diagnostics="cem.relax_ng.unknown_element"
    }

    {example
        @id="invalid-unclosed-compact"
        @path="examples/invalid-unclosed-compact.rnc"
        @content-type="application/relax-ng-compact-syntax"
        @schema="https://cem.dev/ns/data/relax-ng/1"
        @expected-result="fail"
        @expected-diagnostics="cem.relax_ng.compact_parse_error"
    }
}
