{
    "name": "cem_ml_schema_package_relax_ng_v1",
    "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ml/schema-packages/relax-ng/v1",
    "targets": {
        "build": {
            "cache": true,
            "executor": "nx:noop",
            "dependsOn": ["samples2readme"],
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{workspaceRoot}/dist/cem_ml/schema-packages/relax-ng/v1/examples/*.html",
                "{projectRoot}/examples/previews/*.svg"
            ]
        },
        "samples2readme": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": ["cem_ml_cli"],
                    "target": "build"
                }
            ],
            "options": {
                "commands": ["node packages/cem_ml/schema-packages/scripts/samples2readme.mjs {projectRoot}"],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/README.md",
                "{workspaceRoot}/dist/cem_ml/schema-packages/relax-ng/v1/examples/*.html",
                "{projectRoot}/examples/previews/*.svg"
            ]
        },
        "verify": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": ["cem_ml_cli"],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "mkdir -p packages/cem_ml/schema-packages/relax-ng/v1/dist",
                    "./dist/target/cem_ml_cli/debug/cem-ml --quiet validate --fail-level parse --format json --content-type application/vnd.cem.schema-package+cem --schema https://cem.dev/ns/schema-package/1 --report-json packages/cem_ml/schema-packages/relax-ng/v1/dist packages/cem_ml/schema-packages/relax-ng/v1/package.cem",
                    "cargo test -p cem-ml relax_ng_package_examples_are_manifest_indexed -- --nocapture",
                    "cargo test -p cem-ml catalog_exposes_relax_ng_output_artifact_sources -- --nocapture",
                    "cargo test -p cem-ml 'validation::relax_ng::tests' -- --nocapture",
                    "cargo test -p cem-ml builtins_load_relax_ng -- --nocapture",
                    "cargo test -p cem-ml relax_ng_target_content_types_select_dedicated_export -- --nocapture",
                    "cargo test -p cem-ml validate_relax_ng_sources_consume_typed_lifecycle_ast_without_cem_parse -- --nocapture",
                    "cargo test -p cem-ml builtin_relax_ng_dual_syntax_ -- --nocapture",
                    "cargo test -p cem-ml convert_relax_ng_ -- --nocapture",
                    "cargo test -p cem-ml-cli validate_relax_ng_ -- --nocapture",
                    "cargo test -p cem-ml-cli convert_relax_ng_ -- --nocapture",
                    "cargo test -p cem-ml-cli --test schema_validation_examples schema_owned_relax_ng_examples_validate_through_cli -- --nocapture",
                    "node packages/cem_ml/schema-packages/relax-ng/v1/scripts/verify-previews.mjs"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": ["{projectRoot}/dist/cem-ml.report.json"]
        }
    },
    "tags": ["scope:cem-ml", "type:schema-package", "lang:cem"]
}
