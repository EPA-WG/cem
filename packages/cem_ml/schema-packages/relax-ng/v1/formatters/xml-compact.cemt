@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {format-function @name="relax-ng.format-xml-document" @visibility="public" @category="relax-ng-xml-document" @subject="relax-ng-document" @produces="cem-tree" @content-type="application/relax-ng+xml" @schema="https://cem.dev/ns/data/relax-ng/1" @profile="compact" @canonical=true @deterministic=true @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body | {$ merge(call("relax-ng.format-xml-document.tree", { subject: $subject, profile: "compact" }), {}) } }
    }
}
