                                    call("yaml.format-document.comments-between-lines", {
                                        comments: $comments,
                                        afterLine: call("yaml.format-document.node-line", { node: $node }),
                                        beforeLine: $endLine,
                                        indent: $indent,
                                        sourceIndent: call("yaml.format-document.sequence-source-indent", { node: $node, fallback: $sourceIndent }),
                                        profile: $profile
