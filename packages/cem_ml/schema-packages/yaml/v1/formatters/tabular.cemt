    }

    {function @name="yaml.format-document.plain-string-keeps-kind" @visibility="private" @returns="boolean" @deterministic=true |
        {param @name="value" @type="string" @required=true}
        {body |
            {$ match(length(trim($value)), {
                0: false,
                default: match(trim($value), {
                    "~": false,
                    null: false,
                    Null: false,
                    NULL: false,
                    true: false,
                    True: false,
                    TRUE: false,
                    false: false,
                    False: false,
                    FALSE: false,
                    default: match(isAsciiInteger($value), {
                        true: false,
                        false: match(isAsciiDecimal($value), {
                            true: false,
                            false: true
