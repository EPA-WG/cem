    {function @name="yaml.format-document.node-inline" @visibility="private" @returns="array" @deterministic=true |
        {param @name="node" @type="any" @required=true @nullable=true}
        {param @name="scalarRole" @type="string" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ extend(
                call("yaml.format-document.node-prefix", { node: $node, profile: $profile }),
