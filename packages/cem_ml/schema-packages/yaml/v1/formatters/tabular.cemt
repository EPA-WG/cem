                alias: true,
                mapping: match(length(match(typeOf($node.mapping), { array: $node.mapping, default: [] })), {
                    0: true,
                    default: false
                }),
                sequence: match(length(match(typeOf($node.sequence), { array: $node.sequence, default: [] })), {
                    0: true,
                    default: false
                }),
                default: true
            }) }
        }
    }

    {function @name="yaml.format-document.stream-end-line" @visibility="private" @returns="integer" @deterministic=true |
