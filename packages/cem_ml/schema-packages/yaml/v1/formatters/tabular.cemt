    }

    {function @name="yaml.format-document.plain-has-unsafe-leading" @visibility="private" @returns="boolean" @deterministic=true |
        {param @name="value" @type="string" @required=true}
        {body |
            {$ match(get($value, 0), {
                "-": true,
                "?": true,
                ":": true,
                ",": true,
                "[": true,
                "]": true,
                "{": true,
                "}": true,
                "#": true,
                "&": true,
                "*": true,
                "!": true,
                "|": true,
                ">": true,
                "'": true,
                "\"": true,
                "%": true,
                "@": true,
                "`": true,
                default: false
            }) }
        }
    }

    {function @name="yaml.format-document.plain-has-unsafe-char" @visibility="private" @returns="boolean" @deterministic=true |
        {param @name="value" @type="string" @required=true}
        {body |
            {$ match(contains($value, ":"), {
                true: true,
                false: match(contains($value, "#"), {
                    true: true,
                    false: match(contains($value, "["), {
                        true: true,
                        false: match(contains($value, "]"), {
                            true: true,
                            false: match(contains($value, "{"), {
                                true: true,
                                false: match(contains($value, "}"), {
                                    true: true,
                                    false: match(contains($value, ","), {
                                        true: true,
                                        false: contains($value, "\t")
                                    })
                                })
                            })
                        })
                    })
                })
            }) }
        }
    }

    {function @name="yaml.format-document.double-quoted" @visibility="private" @returns="string" @deterministic=true |
        {param @name="value" @type="string" @required=true}
        {body |
            {$ concat("\"", concat(
                replace(
                    replace(
                        replace(
                            replace(
                                replace($value, "\\", "\\\\"),
                                "\"",
                                "\\\""
                            ),
                            "\n",
                            "\\n"
                        ),
                        "\r",
                        "\\r"
                    ),
                    "\t",
                    "\\t"
                ),
                "\""
            )) }
        }
    }

    {function @name="yaml.format-document.indent" @visibility="private" @returns="array" @deterministic=true |
        {param @name="indent" @type="string" @required=true}
        {body |
            {$ match(length($indent), {
                0: [],
                default: [call("yaml.format-document.token", {
                    kind: "yaml.indent",
                    text: $indent,
                    role: "syntax.raw",
                    sourceMap: null,
                    profile: $formatterProfile
                })]
            }) }
        }
    }

    {function @name="yaml.format-document.null-line" @visibility="private" @returns="array" @deterministic=true |
        {param @name="sourceMap" @type="any" @required=true @nullable=true}
        {body |
            {$ [
                call("yaml.format-document.token", {
                    kind: "yaml.scalar",
                    text: "null",
                    role: "syntax.keyword",
                    sourceMap: $sourceMap,
                    profile: $formatterProfile
                }),
                call("yaml.format-document.line-ending", { profile: $formatterProfile })
            ] }
        }
    }

    {function @name="yaml.format-document.line-ending" @visibility="private" @returns="object" @deterministic=true |
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ call("yaml.format-document.token", {
                kind: "yaml.line-ending",
                text: match($lineEnding, { crlf: "\r\n", default: "\n" }),
                role: "syntax.punctuation",
                sourceMap: null,
                profile: $profile
            }) }
        }
    }

    {function @name="yaml.format-document.token" @visibility="private" @returns="object" @deterministic=true |
        {param @name="kind" @type="string" @required=true}
        {param @name="text" @type="string" @required=true}
        {param @name="role" @type="string" @required=true}
        {param @name="sourceMap" @type="any" @required=true @nullable=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ {
                kind: $kind,
                writerKind: "token",
                text: $text,
                role: $role,
                style: { colorRole: $role },
                outputSpan: call("yaml.format-document.output-span", { sourceMap: $sourceMap }),
                value: {
                    formatterProfile: $profile
                }
            } }
        }
    }

    {function @name="yaml.format-document.output-span" @visibility="private" @returns="any" @nullable=true @deterministic=true |
        {param @name="sourceMap" @type="any" @required=true @nullable=true}
        {body |
            {$ match(typeOf($sourceMap), {
                null: null,
                default: {
                    outputRange: {
                        start: 0,
                        len: 0
                    },
                    origin: $sourceMap
                }
            }) }
        }
    }
}
