@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {format-function
        @name="yaml.format-document"
        @visibility="public"
        @category="yaml-document"
        @subject="yaml-document"
        @produces="cem-tree"
        @content-type="application/yaml"
        @schema="https://cem.dev/ns/data/yaml/1"
        @profile="tabular"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="any" @required=true}
        {body |
            {$ {
                kind: "cem-tree",
                contentType: "application/yaml",
                schema: "https://cem.dev/ns/data/yaml/1",
                category: "yaml-document",
                formatterProfile: $formatterProfile,
                formatNodes: [
                    {
                        kind: "format-marker",
                        name: "yaml.format-document",
                        formatterRole: "formatter.boundary",
                        formatterProfile: $formatterProfile
                    },
                    {
                        kind: "format-decision",
                        name: "yaml.layout",
                        formatterRole: "formatter.layout",
                        formatterProfile: $formatterProfile,
                        value: {
                            layout: call("yaml.format-document.layout", { profile: $formatterProfile }),
                            lineEnding: $lineEnding,
                            indent: $indent
                        }
                    }
                ],
                nodes: extend(
                    [
                        {
                            kind: "yaml.format-marker",
                            writerKind: "token",
                            text: "",
                            role: "formatter.boundary",
                            value: {
                                name: "yaml.format-document",
                                formatterProfile: $formatterProfile
                            }
                        },
                        {
                            kind: "yaml.format-decision",
                            writerKind: "token",
                            text: "",
                            role: "formatter.layout",
                            value: {
                                layout: call("yaml.format-document.layout", { profile: $formatterProfile }),
                                lineEnding: $lineEnding,
                                indent: $indent
                            }
                        }
                    ],
                    extend(
                        call("yaml.format-document.directives", {
                            directives: match(typeOf($subject.directives), {
                                array: $subject.directives,
                                default: []
                            }),
                            profile: $formatterProfile
                        }),
                        extend(
                            call("yaml.format-document.comments-unpositioned", {
                                comments: match(typeOf($subject.comments), {
                                    array: $subject.comments,
                                    default: []
                                }),
                                profile: $formatterProfile
                            }),
                            call("yaml.format-document.documents", {
                                documents: match(typeOf($subject.documents), {
                                    array: $subject.documents,
                                    default: []
                                }),
                                comments: match(typeOf($subject.comments), {
                                    array: $subject.comments,
                                    default: []
                                }),
                                directiveCount: length(match(typeOf($subject.directives), {
                                    array: $subject.directives,
                                    default: []
                                })),
                                profile: $formatterProfile
                            })
                        )
                    )
                )
            } }
        }
    }

    {function @name="yaml.format-document.layout" @visibility="private" @returns="string" @deterministic=true |
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match($profile, {
                compact: "compact-block-document",
                pretty: "pretty-block-document",
                "yaml.pretty": "pretty-block-document",
                tabular: "tabular-block-document",
                default: "block-document"
            }) }
        }
    }

    {function @name="yaml.format-document.documents" @visibility="private" @returns="array" @deterministic=true |
        {param @name="documents" @type="array" @required=true}
        {param @name="comments" @type="array" @required=true}
        {param @name="directiveCount" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match(length($documents), {
                0: extend(
                    call("yaml.format-document.comments-between-lines", {
                        comments: $comments,
                        afterLine: 0,
                        beforeLine: call("yaml.format-document.stream-end-line", {}),
                        indent: "",
                        sourceIndent: "",
                        profile: $profile
                    }),
                    call("yaml.format-document.null-line", { sourceMap: null })
                ),
                default: fold($documents, [], extend(
                    $acc,
                    call("yaml.format-document.document", {
                        document: $item,
                        documentCount: length($documents),
                        forceDocumentStart: gt($directiveCount, 0),
                        comments: $comments,
                        profile: $profile
                    })
                ))
            }) }
        }
    }

    {function @name="yaml.format-document.directives" @visibility="private" @returns="array" @deterministic=true |
        {param @name="directives" @type="array" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ fold($directives, [], extend(
                $acc,
                call("yaml.format-document.directive", {
                    directive: $item,
                    profile: $profile
                })
            )) }
        }
    }

    {function @name="yaml.format-document.directive" @visibility="private" @returns="array" @deterministic=true |
        {param @name="directive" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ extend(
                [
                    call("yaml.format-document.token", {
                        kind: "yaml.directive-marker",
                        text: "%",
                        role: "syntax.punctuation",
                        sourceMap: match(exists($directive.sourceMap), { true: $directive.sourceMap, false: null }),
                        profile: $profile
                    }),
                    call("yaml.format-document.token", {
                        kind: "yaml.directive-name",
                        text: match(typeOf($directive.name), { string: trim($directive.name), default: "" }),
                        role: "syntax.keyword",
                        sourceMap: match(exists($directive.sourceMap), { true: $directive.sourceMap, false: null }),
                        profile: $profile
                    })
                ],
                extend(
                    match(typeOf($directive.value), {
                        string: match(length(trim($directive.value)), {
                            0: [],
                            default: [
                                call("yaml.format-document.token", {
                                    kind: "yaml.space",
                                    text: " ",
                                    role: "syntax.raw",
                                    sourceMap: null,
                                    profile: $profile
                                }),
                                call("yaml.format-document.token", {
                                    kind: "yaml.directive-value",
                                    text: trim($directive.value),
                                    role: "syntax.string",
                                    sourceMap: match(exists($directive.sourceMap), { true: $directive.sourceMap, false: null }),
                                    profile: $profile
                                })
                            ]
                        }),
                        default: []
                    }),
                    [call("yaml.format-document.line-ending", { profile: $profile })]
                )
            ) }
        }
    }

    {function @name="yaml.format-document.comments-unpositioned" @visibility="private" @returns="array" @deterministic=true |
        {param @name="comments" @type="array" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ fold($comments, [], match(call("yaml.format-document.same-value", {
                left: call("yaml.format-document.comment-line", { comment: $item }),
                right: 0
            }), {
                true: extend(
                    $acc,
                    call("yaml.format-document.comment", {
                        comment: $item,
                        indent: call("yaml.format-document.comment-indent", { comment: $item }),
                        profile: $profile
                    })
                ),
                false: $acc
            })) }
        }
    }

    {function @name="yaml.format-document.comments-between-lines" @visibility="private" @returns="array" @deterministic=true |
        {param @name="comments" @type="array" @required=true}
        {param @name="afterLine" @type="integer" @required=true}
        {param @name="beforeLine" @type="integer" @required=true}
        {param @name="indent" @type="string" @required=true}
        {param @name="sourceIndent" @type="string" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ fold($comments, [], match(call("yaml.format-document.comment-is-line-between", {
                comment: $item,
                afterLine: $afterLine,
                beforeLine: $beforeLine,
                sourceIndent: $sourceIndent
            }), {
                true: extend(
                    $acc,
                    call("yaml.format-document.comment", {
                        comment: $item,
                        indent: $indent,
                        profile: $profile
                    })
                ),
                false: $acc
            })) }
        }
    }

    {function @name="yaml.format-document.inline-comments-for-line" @visibility="private" @returns="array" @deterministic=true |
        {param @name="comments" @type="array" @required=true}
        {param @name="line" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ fold($comments, [], match(call("yaml.format-document.comment-is-inline-on-line", {
                comment: $item,
                line: $line
            }), {
                true: extend(
                    $acc,
                    [
                        call("yaml.format-document.token", {
                            kind: "yaml.space",
                            text: " ",
                            role: "syntax.raw",
                            sourceMap: null,
                            profile: $profile
                        }),
                        call("yaml.format-document.token", {
                            kind: "yaml.comment",
                            text: match(typeOf($item.text), {
                                string: $item.text,
                                default: concat("# ", match(typeOf($item.value), { string: $item.value, default: "" }))
                            }),
                            role: "syntax.comment",
                            sourceMap: match(exists($item.sourceMap), { true: $item.sourceMap, false: null }),
                            profile: $profile
                        })
                    ]
                ),
                false: $acc
            })) }
        }
    }

    {function @name="yaml.format-document.comment" @visibility="private" @returns="array" @deterministic=true |
        {param @name="comment" @type="object" @required=true}
        {param @name="indent" @type="string" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ extend(
                call("yaml.format-document.indent", {
                    indent: match($comment.placement, {
                        line: $indent,
                        default: ""
                    })
                }),
                [
                    call("yaml.format-document.token", {
                        kind: "yaml.comment",
                        text: match(typeOf($comment.text), {
                            string: $comment.text,
                            default: concat("# ", match(typeOf($comment.value), { string: $comment.value, default: "" }))
                        }),
                        role: "syntax.comment",
                        sourceMap: match(exists($comment.sourceMap), { true: $comment.sourceMap, false: null }),
                        profile: $profile
                    }),
                    call("yaml.format-document.line-ending", { profile: $profile })
                ]
            ) }
        }
    }

    {function @name="yaml.format-document.document" @visibility="private" @returns="array" @deterministic=true |
        {param @name="document" @type="object" @required=true}
        {param @name="documentCount" @type="integer" @required=true}
        {param @name="forceDocumentStart" @type="boolean" @required=true}
        {param @name="comments" @type="array" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ extend(
                match(match($forceDocumentStart, { true: true, false: gt($documentCount, 1) }), {
                    true: [
                        call("yaml.format-document.token", {
                            kind: "yaml.document-start",
                            text: "---",
                            role: "syntax.punctuation",
                            sourceMap: match(exists($document.sourceMap), { true: $document.sourceMap, false: null }),
                            profile: $profile
                        }),
                        call("yaml.format-document.line-ending", { profile: $profile })
                    ],
                    false: []
                }),
                match(typeOf($document.root), {
                    object: call("yaml.format-document.node-block", {
                        node: $document.root,
                        indent: "",
                        indentUnit: $indent,
                        sourceIndent: "",
                        comments: $comments,
                        previousLine: 0,
                        endLine: call("yaml.format-document.stream-end-line", {}),
                        profile: $profile
                    }),
                    default: call("yaml.format-document.null-line", { sourceMap: null })
                })
            ) }
        }
    }

    {function @name="yaml.format-document.node-block" @visibility="private" @returns="array" @deterministic=true |
        {param @name="node" @type="object" @required=true}
        {param @name="indent" @type="string" @required=true}
        {param @name="indentUnit" @type="string" @required=true}
        {param @name="sourceIndent" @type="string" @required=true}
        {param @name="comments" @type="array" @required=true}
        {param @name="previousLine" @type="integer" @required=true}
        {param @name="endLine" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match($node.kind, {
                mapping: call("yaml.format-document.mapping-block", {
                    node: $node,
                    indent: $indent,
                    indentUnit: $indentUnit,
                    sourceIndent: $sourceIndent,
                    comments: $comments,
                    previousLine: $previousLine,
                    endLine: $endLine,
                    profile: $profile
                }),
                sequence: call("yaml.format-document.sequence-block", {
                    node: $node,
                    indent: $indent,
                    indentUnit: $indentUnit,
                    sourceIndent: $sourceIndent,
                    comments: $comments,
                    previousLine: $previousLine,
                    endLine: $endLine,
                    profile: $profile
                }),
                scalar: extend(
                    extend(
                        call("yaml.format-document.comments-between-lines", {
                            comments: $comments,
                            afterLine: $previousLine,
                            beforeLine: call("yaml.format-document.node-line", { node: $node }),
                            indent: $indent,
                            sourceIndent: $sourceIndent,
                            profile: $profile
                        }),
                        extend(
                            call("yaml.format-document.indent", { indent: $indent }),
                            extend(
                                call("yaml.format-document.node-inline", { node: $node, scalarRole: "syntax.string", profile: $profile }),
                                extend(
                                    call("yaml.format-document.inline-comments-for-line", {
                                        comments: $comments,
                                        line: call("yaml.format-document.node-line", { node: $node }),
                                        profile: $profile
                                    }),
                                    extend(
                                        [call("yaml.format-document.line-ending", { profile: $profile })],
                                        call("yaml.format-document.comments-between-lines", {
                                            comments: $comments,
                                            afterLine: call("yaml.format-document.node-line", { node: $node }),
                                            beforeLine: $endLine,
                                            indent: $indent,
                                            sourceIndent: $sourceIndent,
                                            profile: $profile
                                        })
                                    )
                                )
                            )
                        )
                    )
                ),
                alias: extend(
                    extend(
                        call("yaml.format-document.comments-between-lines", {
                            comments: $comments,
                            afterLine: $previousLine,
                            beforeLine: call("yaml.format-document.node-line", { node: $node }),
                            indent: $indent,
                            sourceIndent: $sourceIndent,
                            profile: $profile
                        }),
                        extend(
                            call("yaml.format-document.indent", { indent: $indent }),
                            extend(
                                call("yaml.format-document.node-inline", { node: $node, scalarRole: "syntax.string", profile: $profile }),
                                extend(
                                    call("yaml.format-document.inline-comments-for-line", {
                                        comments: $comments,
                                        line: call("yaml.format-document.node-line", { node: $node }),
                                        profile: $profile
                                    }),
                                    extend(
                                        [call("yaml.format-document.line-ending", { profile: $profile })],
                                        call("yaml.format-document.comments-between-lines", {
                                            comments: $comments,
                                            afterLine: call("yaml.format-document.node-line", { node: $node }),
                                            beforeLine: $endLine,
                                            indent: $indent,
                                            sourceIndent: $sourceIndent,
                                            profile: $profile
                                        })
                                    )
                                )
                            )
                        )
                    )
                ),
                default: extend(
                    call("yaml.format-document.comments-between-lines", {
                        comments: $comments,
                        afterLine: $previousLine,
                        beforeLine: call("yaml.format-document.node-line", { node: $node }),
                        indent: $indent,
                        sourceIndent: $sourceIndent,
                        profile: $profile
                    }),
                    extend(
                        call("yaml.format-document.indent", { indent: $indent }),
                        extend(
                            call("yaml.format-document.null-line", {
                                sourceMap: match(exists($node.sourceMap), { true: $node.sourceMap, false: null })
                            }),
                            call("yaml.format-document.comments-between-lines", {
                                comments: $comments,
                                afterLine: call("yaml.format-document.node-line", { node: $node }),
                                beforeLine: $endLine,
                                indent: $indent,
                                sourceIndent: $sourceIndent,
                                profile: $profile
                            })
                        )
                    )
                )
            }) }
        }
    }

    {function @name="yaml.format-document.mapping-block" @visibility="private" @returns="array" @deterministic=true |
        {param @name="node" @type="object" @required=true}
        {param @name="indent" @type="string" @required=true}
        {param @name="indentUnit" @type="string" @required=true}
        {param @name="sourceIndent" @type="string" @required=true}
        {param @name="comments" @type="array" @required=true}
        {param @name="previousLine" @type="integer" @required=true}
        {param @name="endLine" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match(length(match(typeOf($node.mapping), { array: $node.mapping, default: [] })), {
                0: extend(
                    call("yaml.format-document.comments-between-lines", {
                        comments: $comments,
                        afterLine: $previousLine,
                        beforeLine: call("yaml.format-document.node-line", { node: $node }),
                        indent: $indent,
                        sourceIndent: call("yaml.format-document.mapping-source-indent", { node: $node, fallback: $sourceIndent }),
                        profile: $profile
                    }),
                    extend(
                        call("yaml.format-document.indent", { indent: $indent }),
                        extend(
                            call("yaml.format-document.empty-collection-inline", { node: $node, profile: $profile }),
                            extend(
                                call("yaml.format-document.inline-comments-for-line", {
                                    comments: $comments,
                                    line: call("yaml.format-document.node-line", { node: $node }),
                                    profile: $profile
                                }),
                                extend(
                                    [call("yaml.format-document.line-ending", { profile: $profile })],
                                    call("yaml.format-document.comments-between-lines", {
                                        comments: $comments,
                                        afterLine: call("yaml.format-document.node-line", { node: $node }),
                                        beforeLine: $endLine,
                                        indent: $indent,
                                        sourceIndent: call("yaml.format-document.mapping-source-indent", { node: $node, fallback: $sourceIndent }),
                                        profile: $profile
                                    })
                                )
                            )
                        )
                    )
                ),
                default: extend(
                    fold(match(typeOf($node.mapping), { array: $node.mapping, default: [] }), [], extend(
                        $acc,
                        extend(
                            call("yaml.format-document.comments-between-lines", {
                                comments: $comments,
                                afterLine: call("yaml.format-document.mapping-previous-line", {
                                    pairs: match(typeOf($node.mapping), { array: $node.mapping, default: [] }),
                                    index: $index,
                                    previousLine: $previousLine
                                }),
                                beforeLine: call("yaml.format-document.mapping-pair-line", { pair: $item }),
                                indent: $indent,
                                sourceIndent: call("yaml.format-document.mapping-source-indent", { node: $node, fallback: $sourceIndent }),
                                profile: $profile
                            }),
                            call("yaml.format-document.mapping-pair", {
                                pair: $item,
                                indent: $indent,
                                indentUnit: $indentUnit,
                                sourceIndent: call("yaml.format-document.mapping-source-indent", { node: $node, fallback: $sourceIndent }),
                                comments: $comments,
                                pairLine: call("yaml.format-document.mapping-pair-line", { pair: $item }),
                                nextLine: call("yaml.format-document.mapping-next-line", {
                                    pairs: match(typeOf($node.mapping), { array: $node.mapping, default: [] }),
                                    index: $index,
                                    endLine: $endLine
                                }),
                                profile: $profile
                            })
                        )
                    )),
                    call("yaml.format-document.comments-between-lines", {
                        comments: $comments,
                        afterLine: call("yaml.format-document.mapping-pair-line", {
                            pair: last(match(typeOf($node.mapping), { array: $node.mapping, default: [] }))
                        }),
                        beforeLine: $endLine,
                        indent: $indent,
                        sourceIndent: call("yaml.format-document.mapping-source-indent", { node: $node, fallback: $sourceIndent }),
                        profile: $profile
                    })
                )
            }) }
        }
    }

    {function @name="yaml.format-document.mapping-pair" @visibility="private" @returns="array" @deterministic=true |
        {param @name="pair" @type="object" @required=true}
        {param @name="indent" @type="string" @required=true}
        {param @name="indentUnit" @type="string" @required=true}
        {param @name="sourceIndent" @type="string" @required=true}
        {param @name="comments" @type="array" @required=true}
        {param @name="pairLine" @type="integer" @required=true}
        {param @name="nextLine" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match(call("yaml.format-document.node-can-inline", { node: $pair.key }), {
                true: extend(
                    call("yaml.format-document.indent", { indent: $indent }),
                    extend(
                        call("yaml.format-document.node-inline", { node: $pair.key, scalarRole: "syntax.name", profile: $profile }),
                        call("yaml.format-document.mapping-value", {
                            value: $pair.value,
                            indent: $indent,
                            indentUnit: $indentUnit,
                            sourceIndent: $sourceIndent,
                            comments: $comments,
                            line: $pairLine,
                            nextLine: $nextLine,
                            profile: $profile
                        })
                    )
                ),
                false: extend(
                    call("yaml.format-document.indent", { indent: $indent }),
                    extend(
                        [
                            call("yaml.format-document.token", {
                                kind: "yaml.complex-key",
                                text: "?",
                                role: "syntax.punctuation",
                                sourceMap: null,
                                profile: $profile
                            }),
                            call("yaml.format-document.line-ending", { profile: $profile })
                        ],
                        extend(
                                call("yaml.format-document.node-block", {
                                    node: $pair.key,
                                    indent: concat($indent, $indentUnit),
                                    indentUnit: $indentUnit,
                                    sourceIndent: call("yaml.format-document.node-source-indent", { node: $pair.key }),
                                    comments: $comments,
                                    previousLine: $pairLine,
                                    endLine: $nextLine,
                                    profile: $profile
                                }),
                                extend(
                                    call("yaml.format-document.indent", { indent: $indent }),
                                    call("yaml.format-document.mapping-value", {
                                        value: $pair.value,
                                        indent: $indent,
                                        indentUnit: $indentUnit,
                                        sourceIndent: $sourceIndent,
                                        comments: $comments,
                                        line: $pairLine,
                                        nextLine: $nextLine,
                                        profile: $profile
                                    })
                                )
                            )
                    )
                )
            }) }
        }
    }

    {function @name="yaml.format-document.mapping-value" @visibility="private" @returns="array" @deterministic=true |
        {param @name="value" @type="any" @required=true @nullable=true}
        {param @name="indent" @type="string" @required=true}
        {param @name="indentUnit" @type="string" @required=true}
        {param @name="sourceIndent" @type="string" @required=true}
        {param @name="comments" @type="array" @required=true}
        {param @name="line" @type="integer" @required=true}
        {param @name="nextLine" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ extend(
                [call("yaml.format-document.token", {
                    kind: "yaml.mapping-separator",
                    text: ":",
                    role: "syntax.punctuation",
                    sourceMap: null,
                    profile: $profile
                })],
                match(call("yaml.format-document.node-can-inline", { node: $value }), {
                    true: extend(
                        [call("yaml.format-document.token", {
                            kind: "yaml.space",
                            text: " ",
                            role: "syntax.raw",
                            sourceMap: null,
                            profile: $profile
                        })],
                        extend(
                            call("yaml.format-document.node-inline", { node: $value, scalarRole: "syntax.string", profile: $profile }),
                            extend(
                                call("yaml.format-document.inline-comments-for-line", {
                                    comments: $comments,
                                    line: $line,
                                    profile: $profile
                                }),
                                [call("yaml.format-document.line-ending", { profile: $profile })]
                            )
                        )
                    ),
                    false: extend(
                        extend(
                            call("yaml.format-document.inline-comments-for-line", {
                                comments: $comments,
                                line: $line,
                                profile: $profile
                            }),
                            [call("yaml.format-document.line-ending", { profile: $profile })]
                        ),
                        call("yaml.format-document.node-block", {
                            node: $value,
                            indent: concat($indent, $indentUnit),
                            indentUnit: $indentUnit,
                            sourceIndent: call("yaml.format-document.node-source-indent", { node: $value }),
                            comments: $comments,
