{
    "name": "cem_ml_schema_package_mathml_v1",
    "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ml/schema-packages/mathml/v1",
    "targets": {
        "build": {
            "cache": true,
            "executor": "nx:noop",
            "dependsOn": [
                "samples2readme"
            ],
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{workspaceRoot}/dist/cem_ml/schema-packages/mathml/v1/examples/*.html",
                "{projectRoot}/examples/previews/*.svg"
            ]
        },
        "samples2readme": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "cem_ml_cli"
                    ],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "node packages/cem_ml/schema-packages/scripts/samples2readme.mjs {projectRoot}"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/README.md",
                "{workspaceRoot}/dist/cem_ml/schema-packages/mathml/v1/examples/*.html",
                "{projectRoot}/examples/previews/*.svg"
            ]
        },
        "verify": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "cem_ml_cli"
                    ],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "mkdir -p packages/cem_ml/schema-packages/mathml/v1/dist",
                    "./dist/target/cem_ml_cli/debug/cem-ml --quiet validate --fail-level parse --format json --content-type application/vnd.cem.schema-package+cem --schema https://cem.dev/ns/schema-package/1 --report-json packages/cem_ml/schema-packages/mathml/v1/dist packages/cem_ml/schema-packages/mathml/v1/package.cem",
                    "cargo test -p cem-ml mathml_package_examples_are_manifest_indexed -- --nocapture",
                    "cargo test -p cem-ml catalog_exposes_mathml_output_artifact_sources -- --nocapture",
                    "cargo test -p cem-ml 'validation::mathml::tests' -- --nocapture",
                    "cargo test -p cem-ml builtins_load_mathml_content_types_as_dedicated_internal_ast_stream -- --nocapture",
                    "cargo test -p cem-ml mathml_target_content_types_select_dedicated_mathml_export -- --nocapture",
                    "cargo test -p cem-ml validate_mathml_source_consumes_dedicated_lifecycle_ast_without_html_xml_or_cem_parse -- --nocapture",
                    "cargo test -p cem-ml convert_mathml_same_schema_preserves_all_media_profiles_and_final_newline -- --nocapture",
                    "cargo test -p cem-ml builtin_mathml_lifecycle_output_pipeline_executes_package_cemt_assets -- --nocapture",
                    "cargo test -p cem-ml builtin_mathml_colorizer_profiles_execute_package_cemt_assets -- --nocapture",
                    "cargo test -p cem-ml-cli mathml -- --nocapture",
                    "cargo test -p cem-ml-cli --test schema_validation_examples schema_owned_mathml_examples_validate_through_cli -- --nocapture",
                    "node packages/cem_ml/schema-packages/mathml/v1/scripts/verify-previews.mjs"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/dist/cem-ml.report.json"
            ]
        }
    },
    "tags": [
        "scope:cem-ml",
        "type:schema-package",
        "lang:cem"
    ]
}
