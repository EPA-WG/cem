@doc cem-ml 1
@ns schema = "https://cem.dev/ns/schema/1"
@ns cemml = "https://cem.dev/ns/cem-ml/1"
@ns xml = "https://cem.dev/ns/data/xml/1"
@default schema

{schema @name="mathml" @namespace="https://cem.dev/ns/data/mathml/1" @version="1.0.0" |
    {summary |
        {text | MathML resource schema. This schema is XML-backed and declares the MathML document identity, media types, namespace, and normalized semantic areas for presentation, content, semantics, and annotations.}
    }

    {uses |
        {use @schema="https://cem.dev/ns/schema/1" @as="schema"}
        {use @schema="https://cem.dev/ns/cem-ml/1" @as="cemml"}
        {use @schema="https://cem.dev/ns/data/xml/1" @as="xml"}
    }

    {content-types |
        {content-type @value="application/mathml+xml" @primary=true}
        {content-type @value="application/mathml-presentation+xml" @alias=true}
        {content-type @value="application/mathml-content+xml" @alias=true}
    }

    {namespaces |
        {namespace @prefix="cemmathml" @uri="https://cem.dev/ns/data/mathml/1" @role="schema"}
        {namespace @prefix="mathml" @uri="http://www.w3.org/1998/Math/MathML" @role="document-namespace"}
        {namespace @prefix="xml" @uri="https://cem.dev/ns/data/xml/1" @role="base-format"}
    }

    {elements |
        {element @name="document" @base="xml:document" @required-attributes="encoding" @optional-attributes="charset profile source-id byte-offset byte-length" @children="math"}
        {element @name="math" @base="xml:element" @required-attributes="namespace-uri" @optional-attributes="display dir alttext altimg profile source-id byte-offset byte-length" @children="semantics? presentation* content*"}
        {element @name="presentation" @base="xml:element" @required-attributes="kind" @optional-attributes="mathvariant mathsize mathcolor mathbackground href id class source-id byte-offset byte-length" @children="presentation* token* script* table* enclosure? action? semantics?"}
        {element @name="token" @base="xml:element" @required-attributes="kind" @optional-attributes="value mathvariant mathsize mathcolor mathbackground source-id byte-offset byte-length"}
        {element @name="script" @base="xml:element" @required-attributes="kind" @children="presentation*"}
        {element @name="table" @base="xml:element" @required-attributes="kind" @children="table-row*"}
        {element @name="table-row" @base="xml:element" @children="table-cell*"}
        {element @name="table-cell" @base="xml:element" @children="presentation*"}
        {element @name="enclosure" @base="xml:element" @optional-attributes="notation" @children="presentation*"}
        {element @name="action" @base="xml:element" @optional-attributes="actiontype selection" @children="presentation*"}
        {element @name="content" @base="xml:element" @required-attributes="kind" @optional-attributes="definitionURL encoding cd source-id byte-offset byte-length" @children="content* token*"}
        {element @name="semantics" @base="xml:element" @children="presentation* content* annotation*"}
        {element @name="annotation" @base="xml:element" @required-attributes="kind" @optional-attributes="encoding src source-id byte-offset byte-length" @children="presentation* content* foreign-content*"}
        {element @name="foreign-content" @base="xml:element" @required-attributes="namespace-uri local-name" @optional-attributes="source-id byte-offset byte-length" @children="foreign-content*"}
    }

    {attributes |
        {attribute @name="encoding" @base="xml:encoding"}
        {attribute @name="charset" @base="xml:charset"}
        {attribute @name="profile" @type="schema:identifier" @values="generic presentation content"}
        {attribute @name="source-id" @base="xml:source-id"}
        {attribute @name="byte-offset" @base="xml:byte-offset"}
        {attribute @name="byte-length" @base="xml:byte-length"}
        {attribute @name="namespace-uri" @base="xml:namespace-uri"}
        {attribute @name="local-name" @base="xml:local-name"}
        {attribute @name="display" @type="schema:identifier" @values="block inline"}
        {attribute @name="dir" @type="schema:identifier" @values="ltr rtl"}
        {attribute @name="alttext" @type="schema:string"}
        {attribute @name="altimg" @type="schema:string"}
        {attribute @name="kind" @type="schema:identifier" @values="mi mn mo mtext mspace ms mrow mfrac msqrt mroot mstyle merror mpadded mphantom mfenced menclose msub msup msubsup munder mover munderover mmultiscripts mtable mtr mlabeledtr mtd maction apply bind ci cn csymbol lambda piecewise piece otherwise interval list set vector matrix matrixrow declare annotation annotation-xml semantics"}
        {attribute @name="value" @type="schema:string"}
        {attribute @name="mathvariant" @type="schema:identifier"}
        {attribute @name="mathsize" @type="schema:string"}
        {attribute @name="mathcolor" @type="schema:string"}
        {attribute @name="mathbackground" @type="schema:string"}
        {attribute @name="href" @type="schema:string"}
        {attribute @name="id" @type="schema:identifier"}
        {attribute @name="class" @type="schema:string"}
        {attribute @name="notation" @type="schema:string"}
        {attribute @name="actiontype" @type="schema:identifier"}
        {attribute @name="selection" @type="schema:integer"}
        {attribute @name="definitionURL" @type="schema:string"}
        {attribute @name="cd" @type="schema:identifier"}
        {attribute @name="src" @type="schema:string"}
    }

    {constraints |
        {constraint @kind="mathml-source-parser" @target="document" @diagnostic="cem.mathml.not_well_formed_xml" @behavior="mathml-report-fact" @fact-kind="not-well-formed-xml" @policy="delegate to the generic XML event parser while retaining MathML schema and media-profile identity"}
        {constraint @kind="mathml-source-encoding" @target="document" @diagnostic="cem.mathml.unsupported_encoding" @behavior="mathml-report-fact" @fact-kind="unsupported-encoding" @policy="inherit the XML package UTF-8 and US-ASCII decoder policy"}
        {constraint @kind="mathml-encoding-conflict" @target="document" @diagnostic="cem.mathml.encoding_conflict" @behavior="mathml-report-fact" @fact-kind="encoding-conflict" @policy="MIME charset and XML declaration encoding must not conflict"}
        {constraint @kind="mathml-namespace-prefix-binding" @target="document" @diagnostic="cem.mathml.unbound_namespace_prefix" @behavior="mathml-report-fact" @fact-kind="unbound-namespace-prefix" @policy="inherit XML namespace prefix binding rules"}
        {constraint @kind="mathml-attribute-namespace-uniqueness" @target="document" @diagnostic="cem.mathml.duplicate_attribute" @behavior="mathml-report-fact" @fact-kind="duplicate-attribute" @policy="inherit XML expanded-name attribute uniqueness rules"}
        {constraint @kind="application-mathml-primary" @target="document" @policy="application/mathml+xml is the canonical media type; presentation and content aliases select their corresponding expression profiles"}
        {constraint @kind="presentation-content-profiles" @target="document" @diagnostic="cem.mathml.malformed_expression" @behavior="mathml-report-fact" @fact-kind="malformed-expression" @policy="profile-specific media types must contain presentation or content expression subtrees respectively"}
        {constraint @kind="profile-parameter" @target="document" @diagnostic="cem.mathml.unsupported_profile" @behavior="mathml-report-fact" @fact-kind="unsupported-profile" @policy="profile parameter values are generic presentation or content"}
        {constraint @kind="xml-base-compatible" @target="document" @policy="preserve XML namespace attributes entity boundaries lexical events and source identity"}
        {constraint @kind="mathml-root-element" @target="math" @diagnostic="cem.mathml.root_not_math" @behavior="mathml-report-fact" @fact-kind="root-not-math" @policy="root element must be math"}
        {constraint @kind="mathml-namespace-required" @target="math" @diagnostic="cem.mathml.namespace_missing" @behavior="mathml-report-fact" @fact-kind="namespace-missing" @policy="root math element must use http://www.w3.org/1998/Math/MathML"}
        {constraint @kind="presentation-and-content-mixed-model" @target="semantics" @policy="generic MathML semantics may pair presentation content and annotation subtrees"}
        {constraint @kind="annotation-external-policy" @target="annotation" @diagnostic="cem.mathml.external_annotation_rejected" @behavior="mathml-report-fact" @fact-kind="external-annotation-rejected" @policy="external src and definitionURL references require explicit resolver policy; fragments and data URIs remain lexical references"}
        {constraint @kind="foreign-content-policy" @target="foreign-content" @diagnostic="cem.mathml.foreign_content_rejected" @behavior="mathml-report-fact" @fact-kind="foreign-content-rejected" @policy="foreign annotation namespaces require their own registered schema package or explicit converter profile"}
        {constraint @kind="accessibility-text" @target="math" @policy="preserve alttext semantics and annotation accessibility material when provided"}
        {constraint @kind="doctype-policy" @target="document" @diagnostic="cem.mathml.dtd_rejected" @behavior="mathml-report-fact" @fact-kind="dtd-rejected" @policy="preserve doctype lexemes but inherit XML rejection of DTD declarations until an explicit resolver policy enables them"}
        {constraint @kind="external-entity-policy" @target="document" @diagnostic="cem.mathml.external_entity_rejected" @behavior="mathml-report-fact" @fact-kind="external-entity-rejected" @policy="inherit XML rejection of non-built-in entity references"}
        {constraint @kind="entity-expansion-limit" @target="document" @diagnostic="cem.mathml.entity_expansion_limit" @behavior="mathml-report-fact" @fact-kind="entity-expansion-limit" @policy="inherit XML entity expansion safety limits"}
        {constraint @kind="source-map" @target="document" @diagnostic="cem.mathml.source_map" @behavior="mathml-report-fact" @fact-kind="source-map-unavailable" @policy="source ranges and source maps are required when the XML parser exposes source identity"}
    }

    {diagnostics |
        {diagnostic @code="cem.mathml.parse_error" @severity="error" @message="MathML could not be parsed as XML."}
        {diagnostic @code="cem.mathml.not_well_formed_xml" @severity="error" @message="MathML input is not well-formed XML."}
        {diagnostic @code="cem.mathml.unsupported_encoding" @severity="error" @message="MathML source encoding is not supported."}
        {diagnostic @code="cem.mathml.encoding_conflict" @severity="error" @message="MathML MIME charset conflicts with its XML declaration encoding."}
        {diagnostic @code="cem.mathml.unbound_namespace_prefix" @severity="error" @message="MathML contains an unbound XML namespace prefix."}
        {diagnostic @code="cem.mathml.duplicate_attribute" @severity="error" @message="MathML contains duplicate attributes by expanded XML name."}
        {diagnostic @code="cem.mathml.dtd_rejected" @severity="error" @message="MathML DTD declarations are rejected by the default XML safety policy."}
        {diagnostic @code="cem.mathml.external_entity_rejected" @severity="error" @message="MathML external entity references are rejected by the default XML safety policy."}
        {diagnostic @code="cem.mathml.entity_expansion_limit" @severity="error" @message="MathML entity expansion exceeded the XML safety limit."}
        {diagnostic @code="cem.mathml.root_not_math" @severity="error" @message="MathML document root must be math."}
        {diagnostic @code="cem.mathml.namespace_missing" @severity="error" @message="MathML root must use the MathML namespace."}
        {diagnostic @code="cem.mathml.unsupported_profile" @severity="warning" @message="MathML media profile is not supported by the selected adapter."}
        {diagnostic @code="cem.mathml.malformed_expression" @severity="error" @message="MathML expression violates the selected profile constraints."}
        {diagnostic @code="cem.mathml.external_annotation_rejected" @severity="warning" @message="External MathML annotation was rejected by loader policy."}
        {diagnostic @code="cem.mathml.foreign_content_rejected" @severity="error" @message="MathML foreign content requires an explicit schema or converter policy."}
        {diagnostic @code="cem.mathml.source_map" @severity="info" @message="MathML source map information is incomplete."}
    }

    {compatibility |
        {note | MathML is XML-backed. The package owns application/mathml+xml as the primary resource type and application/mathml-presentation+xml and application/mathml-content+xml as registered profile-specific aliases.}
        {note | The registered MathML namespace is http://www.w3.org/1998/Math/MathML. The preferred file extension is .mml; .mathml is accepted as a compatibility spelling.}
        {note | Standalone MathML content type, package schema, and MathML namespace identities select the dedicated MathML lifecycle adapter. MathML embedded in HTML or XHTML remains part of the containing document lifecycle.}
        {note | DTD declarations and external entities inherit the reject-only XML safety policy. External annotation src and definitionURL references require explicit resolver approval; local fragments and data URIs remain lexical references.}
    }
}
