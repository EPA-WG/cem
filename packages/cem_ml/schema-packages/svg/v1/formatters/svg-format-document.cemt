@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {format-function
        @name="svg.format-document"
        @category="svg-document"
        @subject="json"
        @produces="tokens"
        @content-type="image/svg+xml"
        @schema="https://cem.dev/ns/data/svg/1"
        @canonical=true
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="json" @required=true}
    }
}
