{
  "name": "cem_ml_schema_package_module_map_v1",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/cem_ml/schema-packages/module-map/v1",
  "targets": {
    "build": {
      "cache": true,
      "executor": "nx:noop",
      "inputs": [
        "{projectRoot}/package.cem",
        "{projectRoot}/README.md",
        "{projectRoot}/schema/**/*.cem",
        "{projectRoot}/examples/**/*"
      ],
      "outputs": []
    },
    "verify": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["cem_ml_cli"],
          "target": "build"
        }
      ],
      "options": {
        "commands": [
          "mkdir -p packages/cem_ml/schema-packages/module-map/v1/dist",
          "./dist/target/cem_ml_cli/debug/cem-ml --quiet validate --fail-level parse --format json --content-type application/vnd.cem.schema-package+cem --schema https://cem.dev/ns/schema-package/1 --report-json packages/cem_ml/schema-packages/module-map/v1/dist packages/cem_ml/schema-packages/module-map/v1/package.cem",
          "cargo test -p cem-ml module_map_package_examples_are_manifest_indexed -- --nocapture",
          "cargo test -p cem-ml dedicated_module_maps_lower_declared_javascript_as_graph_artifacts -- --nocapture",
          "cargo test -p cem-ml-cli transform_config_module_maps_copy_only_declared_javascript_to_dist -- --nocapture"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{projectRoot}/package.cem",
        "{projectRoot}/README.md",
        "{projectRoot}/schema/**/*.cem",
        "{projectRoot}/formatters/**/*.cemt",
        "{projectRoot}/colorizers/**/*.cemt",
        "{projectRoot}/converters/**/*.cemt",
        "{projectRoot}/examples/**/*",
        "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
        "{workspaceRoot}/packages/cem_ml/tests/**/*.rs",
        "{workspaceRoot}/packages/cem_ml/Cargo.toml",
        "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
        "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
      ],
      "outputs": ["{projectRoot}/dist/cem-ml.report.json"]
    }
  },
  "tags": ["scope:cem-ml", "type:schema-package", "lang:cem"]
}
