@doc cem-ml 1
@ns pkg = "https://cem.dev/ns/schema-package/1"
@default pkg

{package @id="csv" @version="1.0.0" |
    {schema
        @uri="https://cem.dev/ns/data/csv/1"
        @source="schema/csv.cem"
    }

    {content-type @value="text/csv" @primary=true}

    {namespace @prefix="csv" @uri="https://cem.dev/ns/data/csv/1"}

    {artifact
        @kind="formatter"
        @path="formatters/compact.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="text/csv"
        @target-schema="https://cem.dev/ns/data/csv/1"
        @target-category="csv-document"
        @function-name="csv.format-document"
        @function-profile="compact"
        @formatter-profile="compact"
    }

    {artifact
        @kind="formatter"
        @path="formatters/pretty.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="text/csv"
        @target-schema="https://cem.dev/ns/data/csv/1"
        @target-category="csv-document"
        @function-name="csv.format-document"
        @function-profile="pretty"
        @formatter-profile="pretty"
    }

    {artifact
        @kind="formatter"
        @path="formatters/tabular.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="text/csv"
        @target-schema="https://cem.dev/ns/data/csv/1"
        @target-category="csv-document"
        @function-name="csv.format-document"
        @function-profile="tabular"
        @formatter-profile="tabular"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/terminal.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="text/csv"
        @target-schema="https://cem.dev/ns/data/csv/1"
        @target-category="csv-document"
        @function-name="csv.color-document"
        @function-profile="terminal"
        @color-profile="terminal"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/html.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="text/csv"
        @target-schema="https://cem.dev/ns/data/csv/1"
        @target-category="csv-document"
        @function-name="csv.color-document"
        @function-profile="html"
        @color-profile="html"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/md.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="text/csv"
        @target-schema="https://cem.dev/ns/data/csv/1"
        @target-category="csv-document"
        @function-name="csv.color-document"
        @function-profile="md"
        @color-profile="md"
    }

    {example
        @id="basic-table"
        @path="examples/basic-table.csv"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="pass"
    }

    {example
        @id="quoted-fields"
        @path="examples/quoted-fields.csv"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="pass"
    }

    {example
        @id="header-absent"
        @path="examples/header-absent.csv"
        @content-type="text/csv; header=absent"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="pass"
    }

    {example
        @id="line-ending-lf"
        @path="examples/line-ending-lf.csv"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="pass"
    }

    {example
        @id="line-ending-crlf"
        @path="examples/line-ending-crlf.csv"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="pass"
    }

    {example
        @id="utf8-bom"
        @path="examples/utf8-bom.csv"
        @content-type="text/csv; charset=utf-8"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="pass"
    }

    {example
        @id="spaced-fields"
        @path="examples/spaced-fields.csv"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="pass"
    }

    {example
        @id="tabs-and-empty-fields"
        @path="examples/tabs-and-empty-fields.csv"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="pass"
    }

    {example
        @id="formula-looking-values"
        @path="examples/formula-looking-values.csv"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="pass"
    }

    {example
        @id="wide-unicode"
        @path="examples/wide-unicode.csv"
        @content-type="text/csv; charset=utf-8"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="pass"
    }

    {example
        @id="invalid-unclosed-quote"
        @path="examples/invalid-unclosed-quote.csv"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="fail"
        @expected-diagnostics="cem.csv.unclosed_quote"
    }

    {example
        @id="invalid-quote-escape"
        @path="examples/invalid-quote-escape.csv"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="fail"
        @expected-diagnostics="cem.csv.invalid_quote_escape"
    }

    {example
        @id="ragged-row"
        @path="examples/ragged-row.csv"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="pass"
        @expected-diagnostics="cem.csv.inconsistent_field_count"
    }

    {example
        @id="unsupported-charset"
        @path="examples/unsupported-charset.csv"
        @content-type="text/csv; charset=iso-8859-1"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="fail"
        @expected-diagnostics="cem.csv.unsupported_encoding"
    }

    {example
        @id="us-ascii-non-ascii-byte"
        @path="examples/us-ascii-non-ascii-byte.csv"
        @content-type="text/csv; charset=us-ascii"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="fail"
        @expected-diagnostics="cem.csv.unsupported_encoding"
    }

    {example
        @id="invalid-header-parameter"
        @path="examples/invalid-header-parameter.csv"
        @content-type="text/csv; header=maybe"
        @schema="https://cem.dev/ns/data/csv/1"
        @expected-result="pass"
        @expected-diagnostics="cem.csv.invalid_header_parameter"
    }
}
