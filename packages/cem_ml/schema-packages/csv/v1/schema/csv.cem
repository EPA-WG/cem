@doc cem-ml 1
@ns schema = "https://cem.dev/ns/schema/1"
@ns cemml = "https://cem.dev/ns/cem-ml/1"
@default schema

{schema @name="csv" @namespace="https://cem.dev/ns/data/csv/1" @version="1.0.0" |
    {summary |
        {text | Generic CSV resource schema. CSV source is parsed by a CSV parser or adapter, while this schema provides registry identity, tabular metadata, header-row disposition, row and field structure, lexical quoting state, source offsets, and validation hooks for comma-separated value resources.}
    }

    {uses |
        {use @schema="https://cem.dev/ns/schema/1" @as="schema"}
        {use @schema="https://cem.dev/ns/cem-ml/1" @as="cemml"}
    }

    {content-types |
        {content-type @value="text/csv" @primary=true}
    }

    {namespaces |
        {namespace @prefix="csv" @uri="https://cem.dev/ns/data/csv/1"}
    }

    {elements |
        {element @name="table" @required-attributes="encoding delimiter" @optional-attributes="header line-ending" @children="source? encoding-report? dialect? metadata? parse-facts? header? row*"}
        {element @name="source" @optional-attributes="uri content-type media-type byte-length"}
        {element @name="encoding-report" @optional-attributes="declared-charset normalized-charset decoder-status invalid-byte-offset"}
        {element @name="dialect" @optional-attributes="delimiter quote escape header line-ending"}
        {element @name="metadata" @children="column*"}
        {element @name="column" @required-attributes="index" @optional-attributes="name"}
        {element @name="parse-facts" @children="parse-fact*"}
        {element @name="parse-fact" @required-attributes="kind" @optional-attributes="contract behavior diagnostic-code diagnostic-severity recoverable fatal parameter actual expected row-index field-index expected-count actual-count line column byte-offset byte-length message"}
        {element @name="header" @children="field*"}
        {element @name="row" @required-attributes="index" @optional-attributes="field-count source-id byte-offset byte-length line column end-line end-column" @children="field*"}
        {element @name="field" @required-attributes="index" @optional-attributes="name value quoted source-id byte-offset byte-length line column end-line end-column"}
    }

    {attributes |
        {attribute @name="uri" @type="schema:string"}
        {attribute @name="content-type" @type="schema:string"}
        {attribute @name="media-type" @type="schema:string"}
        {attribute @name="encoding" @type="schema:identifier" @values="utf-8 us-ascii other"}
        {attribute @name="declared-charset" @type="schema:string"}
        {attribute @name="normalized-charset" @type="schema:identifier" @values="utf-8 us-ascii other"}
        {attribute @name="decoder-status" @type="schema:identifier" @values="decoded unsupported invalid"}
        {attribute @name="invalid-byte-offset" @type="cemml:integer"}
        {attribute @name="delimiter" @type="schema:string"}
        {attribute @name="quote" @type="schema:string"}
        {attribute @name="escape" @type="schema:identifier" @values="double-quote other"}
        {attribute @name="header" @type="schema:identifier" @values="present absent unknown"}
        {attribute @name="line-ending" @type="schema:identifier" @values="crlf lf cr mixed"}
        {attribute @name="kind" @type="schema:identifier" @values="parse-error unsupported-charset unsupported-encoding declared-us-ascii-non-ascii-byte invalid-header-parameter invalid-quote-escape unclosed-quote ragged-row"}
        {attribute @name="contract" @type="schema:identifier"}
        {attribute @name="behavior" @type="schema:identifier"}
        {attribute @name="diagnostic-code" @type="schema:identifier"}
        {attribute @name="diagnostic-severity" @type="schema:identifier" @values="info warning error fatal"}
        {attribute @name="recoverable" @type="schema:boolean"}
        {attribute @name="fatal" @type="schema:boolean"}
        {attribute @name="parameter" @type="schema:identifier"}
        {attribute @name="actual" @type="schema:string"}
        {attribute @name="expected" @type="schema:string"}
        {attribute @name="row-index" @type="cemml:integer"}
        {attribute @name="field-index" @type="cemml:integer"}
        {attribute @name="expected-count" @type="cemml:integer"}
        {attribute @name="actual-count" @type="cemml:integer"}
        {attribute @name="line" @type="cemml:integer"}
        {attribute @name="column" @type="cemml:integer"}
        {attribute @name="end-line" @type="cemml:integer"}
        {attribute @name="end-column" @type="cemml:integer"}
        {attribute @name="index" @type="cemml:integer"}
        {attribute @name="field-count" @type="cemml:integer"}
        {attribute @name="name" @type="schema:string"}
        {attribute @name="value" @type="schema:string"}
        {attribute @name="quoted" @type="schema:boolean"}
        {attribute @name="source-id" @type="schema:identifier"}
        {attribute @name="byte-offset" @type="cemml:integer"}
        {attribute @name="byte-length" @type="cemml:integer"}
        {attribute @name="message" @type="schema:string"}
    }

    {constraints |
        {constraint @kind="csv-source-parser" @target="table" @diagnostic="cem.csv.parse_error" @behavior="csv-parse-report-fact" @policy="delegate-to-csv-parser"}
        {constraint @kind="text-csv-primary" @target="table" @policy="text/csv is the canonical media type for CSV resources"}
        {constraint @kind="comma-delimiter-default" @target="table" @policy="delimiter defaults to comma for text/csv"}
        {constraint @kind="header-parameter-preserved" @target="table" @policy="preserve MIME header parameter as present absent or unknown"}
        {constraint @kind="header-parameter-values" @target="table" @diagnostic="cem.csv.invalid_header_parameter" @behavior="csv-parse-report-fact" @policy="header parameter values must be present or absent; other values are reported as metadata drift"}
        {constraint @kind="charset-parameter-supported" @target="table" @diagnostic="cem.csv.unsupported_encoding" @behavior="csv-parse-report-fact" @policy="text/csv charset parameters are accepted for utf-8 and us-ascii; other encodings require an explicit converter"}
        {constraint @kind="utf-8-decode" @target="table" @diagnostic="cem.csv.unsupported_encoding" @behavior="csv-parse-report-fact" @policy="CSV bytes must be valid UTF-8 after accepted charset handling"}
        {constraint @kind="us-ascii-byte-compatibility" @target="table" @diagnostic="cem.csv.unsupported_encoding" @behavior="csv-parse-report-fact" @policy="US-ASCII declarations reject non-ASCII bytes"}
        {constraint @kind="field-order-preserved" @target="row" @policy="required"}
        {constraint @kind="row-order-preserved" @target="table" @policy="required"}
        {constraint @kind="field-count-policy" @target="table" @diagnostic="cem.csv.inconsistent_field_count" @behavior="csv-parse-report-fact" @policy="report inconsistent row width unless schema explicitly permits ragged rows"}
        {constraint @kind="quote-escape-policy" @target="field" @diagnostic="cem.csv.invalid_quote_escape" @behavior="csv-parse-report-fact" @policy="double quote inside quoted field is represented by two double quotes"}
        {constraint @kind="quote-closure-policy" @target="field" @diagnostic="cem.csv.unclosed_quote" @behavior="csv-parse-report-fact" @policy="quoted fields must close before the CSV source ends"}
        {constraint @kind="source-map-preferred" @target="field" @policy="required when parser exposes source ranges"}
    }

    {diagnostics |
        {diagnostic @code="cem.csv.parse_error" @severity="error"}
        {diagnostic @code="cem.csv.unsupported_encoding" @severity="error"}
        {diagnostic @code="cem.csv.inconsistent_field_count" @severity="warning"}
        {diagnostic @code="cem.csv.unclosed_quote" @severity="error"}
        {diagnostic @code="cem.csv.invalid_quote_escape" @severity="error"}
        {diagnostic @code="cem.csv.invalid_header_parameter" @severity="warning"}
        {diagnostic @code="cem.csv.source_map_unavailable" @severity="info"}
    }

    {compatibility |
        {note @version="1.0.0" @value="RFC 4180 registers text/csv with optional charset and header parameters; RFC 7111 defines row, column, and cell fragment identifiers for text/csv."}
    }

    {open-content |
        {accept @kind="csv-extension" @policy="reject-unless-declared"}
    }
}
