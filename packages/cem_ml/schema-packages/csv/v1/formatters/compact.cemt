@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {format-function
        @name="csv.format-document"
        @visibility="public"
        @category="csv-document"
        @subject="json"
        @produces="cem-tree"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @profile="compact"
        @canonical=true
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="json" @required=true}
        {body |
            {$ {
	                kind: "cem-tree",
	                contentType: "text/csv",
	                schema: "https://cem.dev/ns/data/csv/1",
	                category: "csv-document",
	                formatterProfile: "compact",
	                formatNodes: [
	                    {
	                        kind: "format-marker",
	                        name: "csv.format-document",
	                        formatterRole: "formatter.boundary",
	                        formatterProfile: "compact"
	                    },
	                    {
	                        kind: "format-decision",
	                        name: "csv.layout",
	                        formatterRole: "formatter.layout",
	                        formatterProfile: "compact",
	                        value: {
	                            layout: "compact-records",
	                            delimiter: ",",
	                            lineEnding: $lineEnding
	                        }
	                    }
	                ],
	                nodes: extend(
                    [
	                        {
	                            kind: "csv.format-marker",
	                            writerKind: "token",
	                            text: "",
	                            role: "formatter.boundary",
                            value: {
                                name: "csv.format-document",
                                formatterProfile: "compact"
                            }
                        },
	                        {
	                            kind: "csv.format-decision",
	                            writerKind: "token",
	                            text: "",
                            role: "formatter.layout",
                            value: {
                                layout: "compact-records",
                                delimiter: ",",
                                lineEnding: $lineEnding
                            }
                        }
                    ],
                    call("csv.format-document.rows", {
                        rows: $subject.rows,
                        profile: "compact"
                    })
                )
            } }
        }
    }

    {function
        @name="csv.format-document.rows"
        @visibility="private"
        @returns="array"
        @deterministic=true |
        {param @name="rows" @type="array" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ fold($rows, [], extend(
                extend($acc, call("csv.format-document.row-tokens", {
                    row: $item,
                    rowIndex: $index,
                    profile: $profile
                })),
                [{
		                    kind: "csv.record-ending",
		                    writerKind: "token",
		                    text: match($lineEnding, { crlf: "\r\n", default: "\n" }),
	                    outputSpan: match(exists($item.recordEndingSourceMap), {
	                        true: call("csv.format-document.output-span", {
	                            sourceMap: $item.recordEndingSourceMap
	                        }),
	                        false: null
	                    }),
	                    role: "syntax.punctuation",
                    value: {
                        rowIndex: $index,
                        rowSourceRange: match(exists($item.sourceRange), {
                            true: $item.sourceRange,
                            false: null
                        }),
                        rowByteOffset: match(exists($item.byteOffset), {
                            true: $item.byteOffset,
                            false: null
                        }),
                        rowByteLength: match(exists($item.byteLength), {
                            true: $item.byteLength,
                            false: null
                        }),
                        fieldCount: match(exists($item.fieldCount), {
                            true: $item.fieldCount,
                            false: length($item.fields)
                        }),
                        formatterProfile: $profile
                    }
                }]
            )) }
        }
    }

    {function
        @name="csv.format-document.output-span"
        @visibility="private"
        @returns="json"
        @deterministic=true |
        {param @name="sourceMap" @type="json" @required=true}
        {body |
            {$ match(typeOf($sourceMap), {
                null: null,
                default: {
                    outputRange: {
                        start: 0,
                        len: 0
                    },
                    origin: $sourceMap
                }
            }) }
        }
    }

    {function
        @name="csv.format-document.row-tokens"
        @visibility="private"
        @returns="array"
        @deterministic=true |
        {param @name="row" @type="object" @required=true}
        {param @name="rowIndex" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ fold($row.fields, [], extend(
                extend(
                    $acc,
                    match($index, {
                        0: [],
                        default: [{
		                            kind: "csv.delimiter",
		                            writerKind: "token",
		                            text: ",",
	                            outputSpan: match(exists($item.delimiterBeforeSourceMap), {
	                                true: call("csv.format-document.output-span", {
	                                    sourceMap: $item.delimiterBeforeSourceMap
	                                }),
	                                false: null
	                            }),
	                            role: "syntax.punctuation",
                            value: {
                                rowIndex: $rowIndex,
                                fieldIndex: $index,
                                formatterProfile: $profile
                            }
                        }]
                    })
                ),
                [call("csv.format-document.field-token", {
                    field: $item,
                    rowIndex: $rowIndex,
                    fieldIndex: $index,
                    profile: $profile
                })]
            )) }
        }
    }

    {function
        @name="csv.format-document.field-token"
        @visibility="private"
        @returns="object"
        @deterministic=true |
        {param @name="field" @type="object" @required=true}
        {param @name="rowIndex" @type="integer" @required=true}
        {param @name="fieldIndex" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ {
		                kind: "csv.field",
		                writerKind: "token",
		                text: call("csv.format-document.field-text", { field: $field }),
	                outputSpan: match(exists($field.sourceMap), {
	                    true: call("csv.format-document.output-span", {
	                        sourceMap: $field.sourceMap
	                    }),
	                    false: null
	                }),
	                role: "syntax.string",
                value: {
                    rowIndex: $rowIndex,
                    fieldIndex: $fieldIndex,
                    raw: match(exists($field.value), {
                        true: $field.value,
                        false: ""
                    }),
                    quoted: match(exists($field.quoted), {
                        true: $field.quoted,
                        false: false
                    }),
                    sourceRange: match(exists($field.sourceRange), {
                        true: $field.sourceRange,
                        false: null
                    }),
                    byteOffset: match(exists($field.byteOffset), {
                        true: $field.byteOffset,
                        false: null
                    }),
                    byteLength: match(exists($field.byteLength), {
                        true: $field.byteLength,
                        false: null
                    }),
                    formatterProfile: $profile
                }
            } }
        }
    }

    {function
        @name="csv.format-document.field-text"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="field" @type="object" @required=true}
        {body |
            {$ call("csv.format-document.quote-field", {
                value: match(exists($field.value), {
                    true: $field.value,
                    false: ""
                })
            }) }
        }
    }

    {function
        @name="csv.format-document.quote-field"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="value" @type="string" @required=true}
        {body |
            {$ match(call("csv.format-document.needs-quotes", { value: $value }), {
                true: concat("\"", concat(replace($value, "\"", "\"\""), "\"")),
                false: $value
            }) }
        }
    }

    {function
        @name="csv.format-document.needs-quotes"
        @visibility="private"
        @returns="boolean"
        @deterministic=true |
        {param @name="value" @type="string" @required=true}
        {body |
            {$ match(contains($value, ","), {
                true: true,
                false: match(contains($value, "\""), {
                    true: true,
                    false: match(contains($value, "\n"), {
                        true: true,
                        false: match(contains($value, "\r"), {
                            true: true,
                            false: match(startsWith($value, " "), {
                                true: true,
                                false: endsWith($value, " ")
                            })
                        })
                    })
                })
            }) }
        }
    }
}
