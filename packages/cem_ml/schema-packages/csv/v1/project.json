{
    "name": "cem_ml_schema_package_csv_v1",
    "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ml/schema-packages/csv/v1",
    "targets": {
        "build": {
            "cache": true,
            "executor": "nx:noop",
            "dependsOn": [
                "samples2readme"
            ],
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{workspaceRoot}/dist/cem_ml/schema-packages/csv/v1/examples/*.html",
                "{projectRoot}/examples/previews/*.svg"
            ]
        },
        "samples2readme": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "cem_ml_cli"
                    ],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "node packages/cem_ml/schema-packages/scripts/samples2readme.mjs {projectRoot}"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/README.md",
                "{workspaceRoot}/dist/cem_ml/schema-packages/csv/v1/examples/*.html",
                "{projectRoot}/examples/previews/*.svg"
            ]
        },
        "verify": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "cem_ml_cli"
                    ],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "mkdir -p packages/cem_ml/schema-packages/csv/v1/dist",
                    "./dist/target/cem_ml_cli/debug/cem-ml --quiet validate --fail-level parse --format json --content-type application/vnd.cem.schema-package+cem --schema https://cem.dev/ns/schema-package/1 --report-json packages/cem_ml/schema-packages/csv/v1/dist packages/cem_ml/schema-packages/csv/v1/package.cem",
                    "cargo test -p cem-ml csv_package_examples_are_manifest_indexed --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml csv_output_assets_follow_schema_package_readme_contract --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml-cli schema_owned_csv_examples_validate_through_cli --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml-cli schema_owned_csv_examples_emit_schema_owned_contract_details --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml builtin_csv_formatter_profiles_execute_package_cemt_assets --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml builtin_csv_tabular_formatter_applies_max_field_width_options --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml builtin_csv_formatter_applies_line_ending_options --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml builtin_csv_colorizer_profiles_execute_package_cemt_assets --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml builtin_csv_output_pipeline_renders_html_color_backend_with_terminal_text_parity --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml builtin_csv_output_pipeline_generates_output_spans_from_formatter_tokens --target-dir dist/target/cem_ml_cli",
                    "cargo test -p cem-ml data_format_cross_conversions_require_generic_ast_stream_boundary --target-dir dist/target/cem_ml_cli",
                    "node packages/cem_ml/schema-packages/csv/v1/scripts/verify-previews.mjs"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/tests/schema_validation_examples.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/dist/cem-ml.report.json",
                "{workspaceRoot}/dist/cem_ml/schema-packages/csv/v1/examples"
            ]
        }
    },
    "tags": [
        "scope:cem-ml",
        "type:schema-package",
        "lang:cem"
    ]
}
