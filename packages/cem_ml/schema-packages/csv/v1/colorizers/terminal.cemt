@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function
        @name="csv.color-document"
        @visibility="public"
        @category="csv-document"
        @subject="cem-tree"
        @produces="cem-tree"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @profile="terminal"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body |
            {$ {
	                kind: "cem-tree",
	                contentType: "text/csv",
	                schema: "https://cem.dev/ns/data/csv/1",
	                category: "csv-document",
	                formatterProfile: match(exists($subject.formatterProfile), {
	                    true: $subject.formatterProfile,
	                    false: "unknown"
	                }),
	                formatNodes: match(exists($subject.formatNodes), {
	                    true: $subject.formatNodes,
	                    false: []
	                }),
	                colorProfile: "terminal",
	                colorOutput: "terminal",
	                colored: true,
	                colorNodes: [
	                    {
	                        kind: "color-marker",
	                        name: "csv.color-document",
	                        colorizerRole: "colorizer.boundary",
	                        colorProfile: "terminal",
	                        colorOutput: "terminal"
	                    },
	                    {
	                        kind: "color-decision",
	                        name: "csv.role-palette",
	                        colorizerRole: "colorizer.role",
	                        colorProfile: "terminal",
	                        colorOutput: "terminal"
	                    }
	                ],
	                nodes: map(
	                    match(exists($subject.nodes), {
	                        true: $subject.nodes,
	                        false: []
	                    }),
                    call("csv.color-document.token", {
                        token: $item,
                        profile: "terminal"
                    })
                )
            } }
        }
    }

    {function
        @name="csv.color-document.token"
        @visibility="private"
        @returns="object"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ merge(
                set($token, "value", merge(
                    match(exists($token.value), {
                        true: $token.value,
                        false: {}
                    }),
                    {
                        colorProfile: $profile,
                        colorRole: call("csv.color-document.role", { token: $token }),
                        colorOutput: "terminal"
                    }
                )),
                {
                    style: call("csv.color-document.style", {
                        token: $token,
                        profile: $profile,
                        role: call("csv.color-document.role", { token: $token })
                    })
                }
            ) }
        }
    }

    {function
        @name="csv.color-document.role"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {body |
            {$ match(contains($token.kind, "field"), {
                true: call("csv.color-document.field-role", { token: $token }),
                false: call("csv.color-document.syntax-role", { token: $token })
            }) }
        }
    }

    {function
        @name="csv.color-document.syntax-role"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {body |
            {$ match(contains($token.kind, "record-ending"), {
                true: "formatter.boundary",
                false: match(contains($token.kind, "delimiter"), {
                    true: "syntax.punctuation",
                    false: match(exists($token.role), {
                        true: $token.role,
                        false: "source.gutter"
                    })
                })
            }) }
        }
    }

    {function
        @name="csv.color-document.field-role"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {body |
            {$ call("csv.color-document.field-palette-role", {
                paletteIndex: mod(call("csv.color-document.field-index", { token: $token }), 8)
            }) }
        }
    }

    {function
        @name="csv.color-document.field-index"
        @visibility="private"
        @returns="integer"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {body |
            {$ match(exists($token.value.fieldIndex), {
                true: $token.value.fieldIndex,
                false: 0
            }) }
        }
    }

    {function
        @name="csv.color-document.field-palette-role"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="paletteIndex" @type="integer" @required=true}
        {body |
            {$ match($paletteIndex, {
                0: "data.field.1",
                1: "data.field.2",
                2: "data.field.3",
                3: "data.field.4",
                4: "data.field.5",
                5: "data.field.6",
                6: "data.field.7",
                7: "data.field.8",
                default: "syntax.string"
            }) }
        }
    }

    {function
        @name="csv.color-document.style"
        @visibility="private"
        @returns="object"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {param @name="role" @type="string" @required=true}
        {body |
            {$ {
                colorRole: $role,
                colorProfile: $profile,
                colorOutput: "terminal",
                terminalCapability: "auto",
                color: concat("terminal.", $role)
            } }
        }
    }
}
