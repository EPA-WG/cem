@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function
        @name="csv.color-document"
        @visibility="public"
        @category="csv-document"
        @subject="cem-tree"
        @produces="cem-tree"
        @content-type="text/csv"
        @schema="https://cem.dev/ns/data/csv/1"
        @profile="html"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body |
            {$ {
	                kind: "cem-tree",
	                contentType: "text/csv",
	                schema: "https://cem.dev/ns/data/csv/1",
	                category: "csv-document",
	                formatterProfile: match(exists($subject.formatterProfile), {
	                    true: $subject.formatterProfile,
	                    false: "unknown"
	                }),
	                formatNodes: match(exists($subject.formatNodes), {
	                    true: $subject.formatNodes,
	                    false: []
	                }),
	                colorProfile: "html",
	                colorOutput: "html",
	                colored: true,
	                colorNodes: [
	                    {
	                        kind: "color-marker",
	                        name: "csv.color-document",
	                        colorizerRole: "colorizer.boundary",
	                        colorProfile: "html",
	                        colorOutput: "html"
	                    },
	                    {
	                        kind: "color-decision",
	                        name: "csv.role-classes",
	                        colorizerRole: "colorizer.role",
	                        colorProfile: "html",
	                        colorOutput: "html"
	                    }
	                ],
	                nodes: map(
	                    match(exists($subject.nodes), {
	                        true: $subject.nodes,
	                        false: []
	                    }),
                    call("csv.color-document.token", {
                        token: $item,
                        profile: "html"
                    })
                )
            } }
        }
    }

    {function
        @name="csv.color-document.token"
        @visibility="private"
        @returns="object"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ merge(
                set($token, "value", merge(
                    match(exists($token.value), {
                        true: $token.value,
                        false: {}
                    }),
                    {
                        colorProfile: $profile,
                        colorRole: call("csv.color-document.role", { token: $token }),
                        colorOutput: "html"
                    }
                )),
                {
                    style: call("csv.color-document.style", {
                        token: $token,
                        profile: $profile,
                        role: call("csv.color-document.role", { token: $token })
                    })
                }
            ) }
        }
    }

    {function
        @name="csv.color-document.role"
        @visibility="private"
        @returns="string"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {body |
            {$ match(exists($token.role), {
                true: $token.role,
                false: match(contains($token.kind, "field"), {
                    true: "syntax.string",
                    false: match(contains($token.kind, "delimiter"), {
                        true: "syntax.punctuation",
                        false: match(contains($token.kind, "record-ending"), {
                            true: "syntax.punctuation",
                            false: "source.gutter"
                        })
                    })
                })
            }) }
        }
    }

    {function
        @name="csv.color-document.style"
        @visibility="private"
        @returns="object"
        @deterministic=true |
        {param @name="token" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {param @name="role" @type="string" @required=true}
        {body |
            {$ {
                colorRole: $role,
                colorProfile: $profile,
                colorOutput: "html",
                htmlMode: "classes",
                class: concat("cem-color cem-color-", replace($role, ".", "-")),
                color: concat("var(--cem-color-", concat(replace($role, ".", "-"), ")"))
            } }
        }
    }
}
