                {detail @name="element" @type="schema:identifier" @required=true}
                {detail @name="constraint" @type="schema:identifier" @required=true}
                {detail @name="diagnostic" @type="schema:diagnostic-code" @required=true}
                {detail @name="behavior" @type="schema:behavior-reference" @required=true}
                {detail @name="checkKind" @type="schema:identifier" @required=true}
                {detail @name="expectedValues" @type="schema:object"}
                {detail @name="invalidValues" @type="schema:object"}
                {detail @name="sourceRange" @type="schema:object" @source="candidate"}
            }
        }
    }

    {constraints |
        {constraint @kind="streamable" @target="schema" @policy="required"}
        {constraint @kind="schema-dependency-resolvable" @target="use" @policy="required"}
        {constraint @kind="qualified-type-reference-resolvable" @target="attribute" @policy="required"}
        {constraint @kind="diagnostic-behavior-reference-resolvable" @target="diagnostic" @policy="required when behavior is present"}
        {constraint @kind="diagnostic-code-behavior-contract-identity" @target="diagnostic" @policy="code is the stable behavior-contract identity bound to behavior severity message and result construction"}
        {constraint @kind="engine-behavior-primitive-resolvable" @target="behavior" @policy="required when implementation is engine"}
        {constraint @kind="function-behavior-binding-resolvable" @target="behavior" @policy="required when implementation is function"}
        {constraint @kind="field-contract-diagnostic-reference-resolvable" @target="field-contract" @policy="required when diagnostic is present"}
        {constraint @kind="unique-child-name" @target="elements" @policy="required"}
        {constraint @kind="unique-attribute-name" @target="attributes" @policy="required"}
        {constraint @kind="diagnostic-code-format" @target="diagnostic" @policy="required"}
    }

    {diagnostics |
        {diagnostic @code="cem.schema_definition.missing_required_attribute" @severity="error"}
        {diagnostic @code="cem.schema_definition.duplicate_element" @severity="error"}
        {diagnostic @code="cem.schema_definition.duplicate_attribute" @severity="error"}
        {diagnostic @code="cem.schema_definition.invalid_content_model" @severity="error"}
        {diagnostic @code="cem.schema_definition.unresolved_schema_dependency" @severity="error"}
        {diagnostic @code="cem.schema_definition.unresolved_type_reference" @severity="error"}
        {diagnostic @code="cem.schema_definition.unresolved_diagnostic_reference" @severity="error"}
        {diagnostic @code="cem.schema_definition.unknown_diagnostic_behavior" @severity="error"}
        {diagnostic @code="cem.schema_definition.unresolved_behavior_function" @severity="error"}
        {diagnostic @code="cem.schema_definition.invalid_diagnostic_behavior_contract" @severity="error"}
        {diagnostic @code="cem.schema_definition.invalid_field_contract" @severity="error"}
        {diagnostic @code="cem.schema_behavior.query_invalid" @severity="error"}
        {diagnostic @code="cem.schema_behavior.query_failed" @severity="error"}
        {diagnostic @code="cem.schema_behavior.result_invalid" @severity="error"}
        {diagnostic @code="cem.schema_behavior.function_failed" @severity="error"}
        {diagnostic @code="cem.schema_definition.non_streamable_constraint" @severity="error"}
    }

    {open-content |
        {accept @kind="extension-element" @policy="reject-unless-declared"}
        {accept @kind="extension-attribute" @policy="reject-unless-declared"}
    }
}
