@doc cem-ml 1
@ns schema = "https://cem.dev/ns/schema/1"
@default schema

{schema @name="cem-schema-definition" @namespace="https://cem.dev/ns/schema/1" @version="1.0.0" |
    {summary |
        {text | Schema definition language expressed in CEM-ML. This schema owns the declaration vocabulary used to describe validation schemas for input content. It defines schema metadata, owned content types, namespace claims, structural vocabulary, diagnostics, and open-content policy.}
    }

    {content-types |
        {content-type @value="application/vnd.cem.schema+cem" @primary=true}
    }

    {elements |
        {element @name="schema" @required-attributes="name namespace version" @children="summary content-types namespaces elements attributes directives nodes lexical constraints diagnostics open-content compatibility"}
        {element @name="summary" @children="text"}
        {element @name="text"}
        {element @name="content-types" @children="content-type"}
        {element @name="content-type" @required-attributes="value" @optional-attributes="primary alias"}
        {element @name="namespaces" @children="namespace"}
        {element @name="namespace" @required-attributes="uri" @optional-attributes="prefix role"}
        {element @name="elements" @children="element"}
        {element @name="element" @required-attributes="name" @optional-attributes="required-attributes optional-attributes children"}
        {element @name="attributes" @children="attribute"}
        {element @name="attribute" @required-attributes="name" @optional-attributes="type required values"}
        {element @name="directives" @children="directive"}
        {element @name="directive" @required-attributes="name" @optional-attributes="required value"}
        {element @name="nodes" @children="node"}
        {element @name="node" @required-attributes="name" @optional-attributes="children fields"}
        {element @name="lexical" @children="rule"}
        {element @name="rule" @required-attributes="name value"}
        {element @name="constraints" @children="constraint"}
        {element @name="constraint" @required-attributes="kind" @optional-attributes="target value policy"}
        {element @name="diagnostics" @children="diagnostic"}
        {element @name="diagnostic" @required-attributes="code severity"}
        {element @name="open-content" @children="accept"}
        {element @name="accept" @required-attributes="kind policy"}
        {element @name="compatibility" @children="note source"}
        {element @name="note" @optional-attributes="version value"}
        {element @name="source" @optional-attributes="schema content-type"}
    }

    {attributes |
        {attribute @name="name" @type="identifier"}
        {attribute @name="namespace" @type="uri"}
        {attribute @name="version" @type="semver"}
        {attribute @name="value" @type="string"}
        {attribute @name="uri" @type="uri"}
        {attribute @name="prefix" @type="identifier"}
        {attribute @name="primary" @type="boolean"}
        {attribute @name="alias" @type="boolean"}
        {attribute @name="required-attributes" @type="name-list"}
        {attribute @name="optional-attributes" @type="name-list"}
        {attribute @name="children" @type="content-model"}
        {attribute @name="type" @type="type-reference"}
        {attribute @name="required" @type="boolean-or-policy"}
        {attribute @name="severity" @type="diagnostic-severity"}
        {attribute @name="kind" @type="identifier"}
        {attribute @name="policy" @type="identifier"}
        {attribute @name="fields" @type="name-list"}
        {attribute @name="target" @type="identifier"}
        {attribute @name="role" @type="identifier"}
        {attribute @name="content-type" @type="media-type"}
        {attribute @name="schema" @type="uri"}
    }

    {constraints |
        {constraint @kind="streamable" @target="schema" @policy="required"}
        {constraint @kind="unique-child-name" @target="elements" @policy="required"}
        {constraint @kind="unique-attribute-name" @target="attributes" @policy="required"}
        {constraint @kind="diagnostic-code-format" @target="diagnostic" @policy="required"}
    }

    {diagnostics |
        {diagnostic @code="cem.schema_definition.missing_required_attribute" @severity="error"}
        {diagnostic @code="cem.schema_definition.duplicate_element" @severity="error"}
        {diagnostic @code="cem.schema_definition.duplicate_attribute" @severity="error"}
        {diagnostic @code="cem.schema_definition.invalid_content_model" @severity="error"}
        {diagnostic @code="cem.schema_definition.non_streamable_constraint" @severity="error"}
    }

    {open-content |
        {accept @kind="extension-element" @policy="reject-unless-declared"}
        {accept @kind="extension-attribute" @policy="reject-unless-declared"}
    }
}
