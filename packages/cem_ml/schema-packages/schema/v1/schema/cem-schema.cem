        {element @name="resolution" @required-attributes="target mode"}
        {element @name="handoff" @required-attributes="attribute target"}
        {element @name="behaviors" @children="behavior"}
        {element @name="behavior" @required-attributes="name implementation execution" @optional-attributes="primitive function select match" @children="inputs parameters result function"}
        {element @name="inputs" @children="input-binding"}
        {element @name="input-binding" @required-attributes="name type source" @optional-attributes="required source-range"}
        {element @name="parameters" @children="parameter"}
        {element @name="parameter" @required-attributes="name type" @optional-attributes="required default values"}
        {element @name="result" @required-attributes="type" @optional-attributes="severity message source-range" @children="detail"}
        {element @name="detail" @required-attributes="name type" @optional-attributes="required source"}
        {element @name="function" @required-attributes="name returns" @optional-attributes="visibility nullable deterministic trusted" @children="param body"}
        {element @name="param" @required-attributes="name type" @optional-attributes="required default nullable"}
        {element @name="body" @children="*"}
        {element @name="field-contracts" @children="field-contract"}
        {element @name="field-contract" @required-attributes="name target" @optional-attributes="diagnostic behavior check-kind required-attributes optional-attributes forbidden-attributes forbidden-attribute-values required-one-attributes max-one-attributes accepted-children forbidden-children required-children max-one-children required-one-child max-one-child selected-children ordered-children forbidden-ordered-children first-child last-child forbidden-first-child forbidden-last-child required-child-sequence forbidden-child-sequence exact-child-sequence prefix-child-sequence suffix-child-sequence forbidden-prefix-child-sequence forbidden-suffix-child-sequence exact-children min-children max-children exact-total-children min-total-children max-total-children exact-distinct-children min-distinct-children max-distinct-children exact-selected-children min-selected-children max-selected-children exact-selected-distinct-children min-selected-distinct-children max-selected-distinct-children path-layout-attributes path-layout-prefix path-layout-directory-names path-layout-forbidden-directory-names path-layout-extension path-layout-basenames path-layout-forbidden-basenames when-attribute when-values when-present-attributes when-absent-attributes when-any-present-attributes when-any-absent-attributes when-present-children when-absent-children when-any-present-children when-any-absent-children" @children="choice*"}
