            @implementation="engine"
            @execution="ast-validation"
            @primitive="schema:scalar-type" |
            {inputs |
                {input-binding @name="candidate" @type="schema:node" @source="candidate" @required=true @source-range="candidate"}
                {input-binding @name="diagnostic" @type="schema:diagnostic" @source="diagnostic" @required=true}
            }
            {parameters |
                {parameter @name="attribute" @type="schema:attribute" @required=true}
            }
            {result
                @type="schema:diagnostic-result"
                @severity="error"
                @message="diagnostic"
                @source-range="candidate" |
                {detail @name="schemaUri" @type="schema:uri" @required=true}
                {detail @name="element" @type="schema:identifier" @required=true}
                {detail @name="attribute" @type="schema:identifier" @required=true}
                {detail @name="diagnostic" @type="schema:diagnostic-code" @required=true}
                {detail @name="behavior" @type="schema:behavior-reference" @required=true}
                {detail @name="checkKind" @type="schema:identifier" @required=true}
                {detail @name="expectedType" @type="schema:type-reference" @required=true}
                {detail @name="expectedPattern" @type="schema:string"}
                {detail @name="actualValue" @type="schema:string" @required=true}
                {detail @name="sourceRange" @type="schema:object" @source="candidate"}
            }
        }
        {behavior
            @name="datatype-param"
            @implementation="engine"
            @execution="ast-validation"
            @primitive="schema:datatype-param" |
            {inputs |
                {input-binding @name="candidate" @type="schema:node" @source="candidate" @required=true @source-range="candidate"}
                {input-binding @name="diagnostic" @type="schema:diagnostic" @source="diagnostic" @required=true}
            }
            {parameters |
                {parameter @name="attribute" @type="schema:attribute" @required=true}
            }
            {result
                @type="schema:diagnostic-result"
                @severity="error"
                @message="diagnostic"
                @source-range="candidate" |
                {detail @name="schemaUri" @type="schema:uri" @required=true}
                {detail @name="element" @type="schema:identifier" @required=true}
                {detail @name="attribute" @type="schema:identifier" @required=true}
                {detail @name="diagnostic" @type="schema:diagnostic-code" @required=true}
                {detail @name="behavior" @type="schema:behavior-reference" @required=true}
                {detail @name="checkKind" @type="schema:identifier" @required=true}
                {detail @name="datatypeParam" @type="schema:identifier" @required=true}
                {detail @name="paramValue" @type="schema:string" @required=true}
                {detail @name="expectedValues" @type="schema:array"}
                {detail @name="actualValue" @type="schema:string" @required=true}
                {detail @name="actualLength" @type="schema:integer"}
                {detail @name="actualTotalDigits" @type="schema:integer"}
                {detail @name="actualFractionDigits" @type="schema:integer"}
                {detail @name="actualScheme" @type="schema:string"}
                {detail @name="actualMediaTypeEssence" @type="schema:media-type"}
                {detail @name="sourceRange" @type="schema:object" @source="candidate"}
            }
        }
        {behavior
            @name="resource-readable"
            @implementation="engine"
            @execution="ast-validation"
            @primitive="schema:resource-readable" |
            {inputs |
                {input-binding @name="candidate" @type="schema:node" @source="candidate" @required=true @source-range="candidate"}
                {input-binding @name="diagnostic" @type="schema:diagnostic" @source="diagnostic" @required=true}
            }
            {parameters |
                {parameter @name="constraint" @type="schema:constraint" @required=true}
            }
            {result
                @type="schema:diagnostic-result"
                @severity="error"
                @message="diagnostic"
                @source-range="candidate" |
                {detail @name="schemaUri" @type="schema:uri" @required=true}
                {detail @name="element" @type="schema:identifier" @required=true}
                {detail @name="constraint" @type="schema:identifier" @required=true}
                {detail @name="diagnostic" @type="schema:diagnostic-code" @required=true}
                {detail @name="behavior" @type="schema:behavior-reference" @required=true}
                {detail @name="checkKind" @type="schema:identifier" @required=true}
                {detail @name="path" @type="schema:path" @required=true}
                {detail @name="error" @type="schema:string"}
                {detail @name="sourceRange" @type="schema:object" @source="candidate"}
            }
        }
        {behavior
            @name="resource-parse"
            @implementation="engine"
            @execution="ast-validation"
            @primitive="schema:resource-parse" |
            {inputs |
                {input-binding @name="candidate" @type="schema:node" @source="candidate" @required=true @source-range="candidate"}
                {input-binding @name="diagnostic" @type="schema:diagnostic" @source="diagnostic" @required=true}
            }
            {parameters |
                {parameter @name="constraint" @type="schema:constraint" @required=true}
            }
            {result
                @type="schema:diagnostic-result"
                @severity="error"
                @message="diagnostic"
                @source-range="candidate" |
                {detail @name="schemaUri" @type="schema:uri" @required=true}
                {detail @name="element" @type="schema:identifier" @required=true}
                {detail @name="constraint" @type="schema:identifier" @required=true}
                {detail @name="diagnostic" @type="schema:diagnostic-code" @required=true}
                {detail @name="behavior" @type="schema:behavior-reference" @required=true}
                {detail @name="checkKind" @type="schema:identifier" @required=true}
                {detail @name="path" @type="schema:path"}
                {detail @name="sourceDiagnostic" @type="schema:object"}
                {detail @name="sourceRange" @type="schema:object" @source="candidate"}
            }
        }
        {behavior
            @name="reference-resolution"
            @implementation="engine"
            @execution="ast-validation"
            @primitive="schema:reference-resolution" |
            {inputs |
                {input-binding @name="candidate" @type="schema:node" @source="candidate" @required=true @source-range="candidate"}
                {input-binding @name="diagnostic" @type="schema:diagnostic" @source="diagnostic" @required=true}
            }
            {parameters |
                {parameter @name="constraint" @type="schema:constraint" @required=true}
            }
            {result
                @type="schema:diagnostic-result"
                @severity="error"
                @message="diagnostic"
