@doc cem-ml 1
@ns schema = "https://cem.dev/ns/schema/1"
@ns cemml = "https://cem.dev/ns/cem-ml/1"
@default schema

{schema @name="cem-schema-definition" @namespace="https://cem.dev/ns/schema/1" @version="1.0.0" |
    {summary |
        {text | Schema definition language expressed in CEM-ML. This schema owns the declaration vocabulary used to describe validation schemas for input content. It defines schema metadata, owned content types, namespace claims, structural vocabulary, diagnostics, and open-content policy.}
    }

    {uses |
        {use @schema="https://cem.dev/ns/cem-ml/1" @as="cemml"}
    }

    {content-types |
        {content-type @value="application/vnd.cem.schema+cem" @primary=true}
    }

    {elements |
        {element @name="schema" @required-attributes="name namespace version" @children="summary uses content-types namespaces elements attributes directives nodes lexical types namespace-semantics behaviors field-contracts constraints diagnostics open-content compatibility"}
        {element @name="summary" @children="text"}
        {element @name="text"}
        {element @name="uses" @children="use"}
        {element @name="use" @required-attributes="schema as" @optional-attributes="version content-type"}
        {element @name="content-types" @children="content-type"}
        {element @name="content-type" @required-attributes="value" @optional-attributes="primary alias"}
        {element @name="namespaces" @children="namespace"}
        {element @name="namespace" @required-attributes="uri" @optional-attributes="prefix role"}
        {element @name="elements" @children="element"}
        {element @name="element" @required-attributes="name" @optional-attributes="base required-attributes optional-attributes children"}
        {element @name="attributes" @children="attribute"}
        {element @name="attribute" @required-attributes="name" @optional-attributes="base type required values minInclusive maxInclusive minExclusive maxExclusive minLength maxLength length totalDigits fractionDigits pattern uriSchemes mediaTypes values-diagnostic type-diagnostic datatype-param-diagnostic"}
        {element @name="directives" @children="directive"}
        {element @name="directive" @required-attributes="name" @optional-attributes="required value"}
        {element @name="nodes" @children="node"}
        {element @name="node" @required-attributes="name" @optional-attributes="children fields"}
        {element @name="lexical" @children="rule"}
        {element @name="rule" @required-attributes="name value"}
        {element @name="types" @children="type"}
        {element @name="type" @required-attributes="name" @optional-attributes="kind base rule values"}
        {element @name="namespace-semantics" @children="binding resolution handoff"}
        {element @name="binding" @required-attributes="directive scope"}
        {element @name="resolution" @required-attributes="target mode"}
        {element @name="handoff" @required-attributes="attribute target"}
        {element @name="behaviors" @children="behavior"}
        {element @name="behavior" @required-attributes="name implementation execution" @optional-attributes="primitive function select match" @children="inputs parameters result function"}
        {element @name="inputs" @children="input-binding"}
        {element @name="input-binding" @required-attributes="name type source" @optional-attributes="required source-range"}
        {element @name="parameters" @children="parameter"}
        {element @name="parameter" @required-attributes="name type" @optional-attributes="required default values"}
        {element @name="result" @required-attributes="type" @optional-attributes="severity message source-range" @children="detail"}
        {element @name="detail" @required-attributes="name type" @optional-attributes="required source"}
        {element @name="function" @required-attributes="name returns" @optional-attributes="visibility nullable deterministic trusted" @children="param body"}
        {element @name="param" @required-attributes="name type" @optional-attributes="required default nullable"}
        {element @name="body" @children="*"}
        {element @name="field-contracts" @children="field-contract"}
        {element @name="field-contract" @required-attributes="name target" @optional-attributes="diagnostic behavior check-kind required-attributes optional-attributes forbidden-attributes forbidden-attribute-values required-one-attributes max-one-attributes required-children max-one-children min-children max-children path-layout-attributes path-layout-prefix path-layout-extension when-attribute when-values when-present-attributes" @children="choice*"}
        {element @name="choice" @required-attributes="name mode" @children="case*"}
        {element @name="case" @optional-attributes="name attributes children"}
        {element @name="constraints" @children="constraint"}
        {element @name="constraint" @required-attributes="kind" @optional-attributes="target value policy diagnostic behavior"}
        {element @name="diagnostics" @children="diagnostic"}
        {element @name="diagnostic" @required-attributes="code severity" @optional-attributes="behavior message" @children="arguments"}
        {element @name="arguments" @children="argument"}
        {element @name="argument" @required-attributes="name value"}
        {element @name="open-content" @children="accept"}
        {element @name="accept" @required-attributes="kind policy"}
        {element @name="compatibility" @children="note source"}
        {element @name="note" @optional-attributes="version value"}
        {element @name="source" @optional-attributes="schema content-type"}
    }

