@doc cem-ml 1
@ns pkg = "https://cem.dev/ns/schema-package/1"
@default pkg

{package @id="schema" @version="1.0.0" |
    {schema
        @uri="https://cem.dev/ns/schema/1"
        @source="schema/cem-schema.cem"
    }

    {content-type @value="application/vnd.cem.schema+cem" @primary=true}

    {namespace @prefix="schema" @uri="https://cem.dev/ns/schema/1"}

    {example
        @id="basic-schema"
        @path="examples/basic-schema.cem"
        @content-type="application/vnd.cem.schema+cem"
        @schema="https://cem.dev/ns/schema/1"
        @expected-result="pass"
    }

    {example
        @id="typed-resource-schema"
        @path="examples/typed-resource-schema.cem"
        @content-type="application/vnd.cem.schema+cem"
        @schema="https://cem.dev/ns/schema/1"
        @expected-result="pass"
    }

    {example
        @id="invalid-missing-required-attribute"
        @path="examples/invalid-missing-required-attribute.cem"
        @content-type="application/vnd.cem.schema+cem"
        @schema="https://cem.dev/ns/schema/1"
        @expected-result="fail"
        @expected-diagnostics="cem.schema_model.missing_required_attribute"
    }

    {example
        @id="invalid-diagnostic-behavior"
        @path="examples/invalid-diagnostic-behavior.cem"
        @content-type="application/vnd.cem.schema+cem"
        @schema="https://cem.dev/ns/schema/1"
        @expected-result="fail"
        @expected-diagnostics="cem.schema_definition.unknown_diagnostic_behavior"
    }

    {example
        @id="invalid-unclosed-schema"
        @path="examples/invalid-unclosed-schema.cem"
        @content-type="application/vnd.cem.schema+cem"
        @schema="https://cem.dev/ns/schema/1"
        @expected-result="fail"
        @expected-diagnostics="cem.ast.unclosed_scope"
    }
}
