    {example
        @id="invalid-custom-behavior-argument-type"
        @path="examples/invalid-custom-behavior-argument-type.cem"
        @content-type="application/vnd.cem.schema+cem"
        @schema="https://cem.dev/ns/schema/1"
        @expected-result="fail"
