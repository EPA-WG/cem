{
    "name": "cem_ml_schema_package_scss_v1",
    "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ml/schema-packages/scss/v1",
    "targets": {
        "build": {
            "cache": true,
            "executor": "nx:noop",
            "dependsOn": ["samples2readme"],
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{projectRoot}/tests/**/*.cem",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/README.md",
                "{workspaceRoot}/dist/cem_ml/schema-packages/scss/v1/examples/*.html",
                "{projectRoot}/examples/previews/*.svg"
            ]
        },
        "samples2readme": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": ["cem_ml_cli"],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "node packages/cem_ml/schema-packages/scripts/samples2readme.mjs {projectRoot}"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{projectRoot}/tests/**/*.cem",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/README.md",
                "{workspaceRoot}/dist/cem_ml/schema-packages/scss/v1/examples/*.html",
                "{projectRoot}/examples/previews/*.svg"
            ]
        },
        "verify": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": ["cem_ml_cli"],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "mkdir -p packages/cem_ml/schema-packages/scss/v1/dist",
                    "./dist/target/cem_ml_cli/debug/cem-ml --quiet validate --fail-level parse --format json --content-type application/vnd.cem.schema-package+cem --schema https://cem.dev/ns/schema-package/1 --report-json packages/cem_ml/schema-packages/scss/v1/dist packages/cem_ml/schema-packages/scss/v1/package.cem",
                    "./dist/target/cem_ml_cli/debug/cem-ml --quiet validate --fail-level parse --format json --content-type application/vnd.cem.schema+cem --schema https://cem.dev/ns/schema/1 packages/cem_ml/schema-packages/scss/v1/schema/scss.cem",
                    "./dist/target/cem_ml_cli/debug/cem-ml --quiet validate --fail-level parse --format json --content-type application/cem --schema https://cem.dev/ns/data/scss/1 packages/cem_ml/schema-packages/scss/v1/tests/dart-sass-1.101.7-conformance.cem",
                    "cargo test --package cem-ml --lib scss -- --nocapture",
                    "cargo test --package cem-ml --test scss -- --nocapture",
                    "cargo test --package cem-ml-cli --test scss --target-dir dist/target/cem_ml_cli -- --nocapture",
                    "cargo test -p cem-ml --test schema_package_structure scss_package_is_schema_owned_nx_subproject -- --nocapture",
                    "node packages/cem_ml/schema-packages/scss/v1/scripts/verify-previews.mjs"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "{projectRoot}/tests/**/*.cem",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/tests/schema_package_structure.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/tests/scss.rs",
                "{workspaceRoot}/packages/cem_ml_cli/project.json",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": ["{projectRoot}/dist/cem-ml.report.json"]
        }
    },
    "tags": ["scope:cem-ml", "type:schema-package", "lang:cem"]
}
