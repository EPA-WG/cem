@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function @name="scss.color-source" @visibility="public" @category="scss-source" @subject="cem-tree" @produces="cem-tree" @content-type="text/vnd.cem.scss" @schema="https://cem.dev/ns/data/scss/1" @profile="terminal" @extends="cem.color-tree" @canonical=false @deterministic=true @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body | {$ merge(call("scss.color-source.tree", { subject: $subject, profile: "terminal", output: "terminal" }), {}) } }
    }
}
