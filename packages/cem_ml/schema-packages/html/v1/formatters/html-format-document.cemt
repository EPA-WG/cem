@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {format-function
        @name="html.format-document"
        @category="html-document"
        @subject="json"
        @produces="tokens"
        @content-type="text/html"
        @schema="https://cem.dev/ns/data/html/1"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="json" @required=true}
    }
}
