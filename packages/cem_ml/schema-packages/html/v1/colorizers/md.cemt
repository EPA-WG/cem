@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function @name="html.color-document" @visibility="public" @category="html-document" @subject="cem-tree" @produces="cem-tree" @content-type="text/html" @schema="https://cem.dev/ns/data/html/1" @profile="md" @extends="cem.color-tree" @canonical=false @deterministic=true @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body | {$ merge(call("html.color-document.tree", { subject: $subject, profile: "md", output: "md" }), {}) } }
    }
}
