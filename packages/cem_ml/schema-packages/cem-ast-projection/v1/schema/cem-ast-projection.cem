@doc cem-ml 1
@ns schema = "https://cem.dev/ns/schema/1"
@ns cemml = "https://cem.dev/ns/cem-ml/1"
@default schema

{schema @name="cem-ast-projection" @namespace="https://cem.dev/ns/projection/ast/1" @version="1.0.0" |
    {summary |
        {text | Semantic CEM AST projection schema. This schema describes parsed CEM language structure, tokens, normalized syntax nodes, source ranges, parser diagnostics, and sealed stream chunks. The primary runtime and cache artifact is CEM binary or chunk-stream data; JSON is an optional debug and interchange view over the same semantic layer.}
    }

    {uses |
        {use @schema="https://cem.dev/ns/schema/1" @as="schema"}
        {use @schema="https://cem.dev/ns/cem-ml/1" @as="cemml"}
    }

    {content-types |
        {content-type @value="application/vnd.cem.ast+cem-bin" @primary=true}
        {content-type @value="application/vnd.cem.ast+json" @alias=true}
    }

    {namespaces |
        {namespace @prefix="cemast" @uri="https://cem.dev/ns/projection/ast/1"}
    }

    {elements |
        {element @name="ast" @required-attributes="schema content-type hash-scheme" @children="chunk* node* token* diagnostic*"}
        {element @name="chunk" @required-attributes="id sealed" @optional-attributes="parent-id byte-offset byte-length hash"}
        {element @name="node" @required-attributes="id kind" @optional-attributes="parent-id order name value source-id byte-offset byte-length chunk-id"}
        {element @name="token" @required-attributes="id kind lexeme" @optional-attributes="source-id byte-offset byte-length chunk-id"}
        {element @name="diagnostic" @required-attributes="code severity" @optional-attributes="source-id byte-offset byte-length message"}
    }

    {attributes |
        {attribute @name="id" @type="schema:identifier"}
        {attribute @name="parent-id" @type="schema:identifier"}
        {attribute @name="order" @type="cemml:integer"}
        {attribute @name="kind" @type="schema:identifier"}
        {attribute @name="name" @type="schema:qualified-name"}
        {attribute @name="value" @type="schema:string"}
        {attribute @name="lexeme" @type="schema:string"}
        {attribute @name="schema" @type="schema:uri"}
        {attribute @name="content-type" @type="schema:media-type"}
        {attribute @name="hash-scheme" @type="schema:identifier"}
        {attribute @name="hash" @type="schema:string"}
        {attribute @name="source-id" @type="schema:uri"}
        {attribute @name="byte-offset" @type="cemml:integer"}
        {attribute @name="byte-length" @type="cemml:integer"}
        {attribute @name="chunk-id" @type="schema:identifier"}
        {attribute @name="sealed" @type="schema:boolean"}
        {attribute @name="code" @type="schema:string"}
        {attribute @name="severity" @type="schema:diagnostic-severity"}
        {attribute @name="message" @type="schema:string"}
    }

    {constraints |
        {constraint @kind="binary-primary" @target="ast" @policy="application/vnd.cem.ast+cem-bin is canonical for runtime and cache handoff"}
        {constraint @kind="json-debug-view" @target="ast" @policy="application/vnd.cem.ast+json must be derived from the semantic AST projection"}
        {constraint @kind="source-order-preserved" @target="node" @policy="required"}
        {constraint @kind="sealed-chunk-immutable" @target="chunk" @policy="sealed chunks are immutable and may be multicast or replayed"}
        {constraint @kind="source-map-preserved" @target="node" @policy="required when source identity is available"}
    }

    {diagnostics |
        {diagnostic @code="cem.projection.ast.node_id_duplicate" @severity="error"}
        {diagnostic @code="cem.projection.ast.token_range_invalid" @severity="error"}
        {diagnostic @code="cem.projection.ast.chunk_hash_mismatch" @severity="error"}
        {diagnostic @code="cem.projection.ast.source_map_missing" @severity="warning"}
    }

    {compatibility |
        {note @version="1.0.0" @value="The current JSON AST export uses this semantic schema identity as a debug and interchange view until canonical CEM binary output is implemented."}
        {source @schema="https://cem.dev/ns/projection/ast/1" @content-type="application/vnd.cem.ast+json"}
    }

    {open-content |
        {accept @kind="projection-extension" @policy="reject-unless-declared"}
    }
}
