@doc cem-ml 1
@ns pkg = "https://cem.dev/ns/schema-package/1"
@default pkg

{package @id="xml" @version="1.0.0" |
    {schema
        @uri="https://cem.dev/ns/data/xml/1"
        @source="schema/xml.cem"
    }

    {content-type @value="application/xml" @primary=true}
    {content-type @value="text/xml" @alias=true}
    {content-type @value="application/xml-external-parsed-entity" @alias=true}
    {content-type @value="text/xml-external-parsed-entity" @alias=true}
    {content-type @value="application/xml-dtd" @alias=true}

    {namespace @prefix="xml" @uri="https://cem.dev/ns/data/xml/1"}

    {artifact
        @kind="formatter"
        @path="formatters/compact.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/xml"
        @target-schema="https://cem.dev/ns/data/xml/1"
        @target-category="xml-document"
        @function-name="xml.format-document"
        @formatter-profile="compact"
    }

    {artifact
        @kind="formatter"
        @path="formatters/pretty.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/xml"
        @target-schema="https://cem.dev/ns/data/xml/1"
        @target-category="xml-document"
        @function-name="xml.format-document"
        @formatter-profile="pretty"
    }

    {artifact
        @kind="formatter"
        @path="formatters/tabular.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/xml"
        @target-schema="https://cem.dev/ns/data/xml/1"
        @target-category="xml-document"
        @function-name="xml.format-document"
        @formatter-profile="tabular"
    }

    {artifact
        @kind="formatter-helper"
        @path="formatters/xml-format-document.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/xml"
        @target-schema="https://cem.dev/ns/data/xml/1"
        @target-category="xml-document"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/terminal.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/xml"
        @target-schema="https://cem.dev/ns/data/xml/1"
        @target-category="xml-document"
        @function-name="xml.color-document"
        @color-profile="terminal"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/html.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/xml"
        @target-schema="https://cem.dev/ns/data/xml/1"
        @target-category="xml-document"
        @function-name="xml.color-document"
        @color-profile="html"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/md.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/xml"
        @target-schema="https://cem.dev/ns/data/xml/1"
        @target-category="xml-document"
        @function-name="xml.color-document"
        @color-profile="md"
    }

    {artifact
        @kind="colorizer-helper"
        @path="colorizers/xml-color-document.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/xml"
        @target-schema="https://cem.dev/ns/data/xml/1"
        @target-category="xml-document"
    }

    {example
        @id="basic-document"
        @path="examples/basic-document.xml"
        @content-type="application/xml"
        @schema="https://cem.dev/ns/data/xml/1"
        @expected-result="pass"
    }

    {example
        @id="namespaced-document"
        @path="examples/namespaced-document.xml"
        @content-type="text/xml; charset=utf-8"
        @schema="https://cem.dev/ns/data/xml/1"
        @expected-result="pass"
    }

    {example
        @id="invalid-mismatched-tag"
        @path="examples/invalid-mismatched-tag.xml"
        @content-type="application/xml"
        @schema="https://cem.dev/ns/data/xml/1"
        @expected-result="fail"
        @expected-diagnostics="cem.xml.parse_error"
    }

    {example
        @id="invalid-unbound-prefix"
        @path="examples/invalid-unbound-prefix.xml"
        @content-type="application/xml"
        @schema="https://cem.dev/ns/data/xml/1"
        @expected-result="fail"
        @expected-diagnostics="cem.xml.unbound_namespace_prefix"
    }

    {example
        @id="invalid-doctype"
        @path="examples/invalid-doctype.xml"
        @content-type="application/xml"
        @schema="https://cem.dev/ns/data/xml/1"
        @expected-result="fail"
        @expected-diagnostics="cem.xml.dtd_rejected"
    }

    {converter
        @id="xml-to-cem-dom-projection-rust"
        @implementation="rust"
        @rust-symbol="XmlDomProjectionConverter"
        @streamable=true
        @lossiness="lossless"
        @implicit=true
        @readiness="ready"
        @cost=80 |
        {from @content-type="application/xml" @schema="https://cem.dev/ns/data/xml/1"}
        {to @content-type="application/vnd.cem.dom+cem-bin" @schema="https://cem.dev/ns/projection/dom/1"}
    }
}
