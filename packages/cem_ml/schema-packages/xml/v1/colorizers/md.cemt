@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function
        @name="xml.color-document"
        @visibility="public"
        @category="xml-document"
        @subject="cem-tree"
        @produces="cem-tree"
        @content-type="application/xml"
        @schema="https://cem.dev/ns/data/xml/1"
        @profile="md"
        @extends="cem.color-tree"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body | {$ merge(call("xml.color-document.tree", { subject: $subject, profile: "md", output: "md" }), {}) } }
    }
}
