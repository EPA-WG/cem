@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {format-function
        @name="xml.format-document.tree"
        @visibility="private"
        @category="xml-document"
        @subject="xml-document"
        @produces="cem-tree"
        @content-type="application/xml"
        @schema="https://cem.dev/ns/data/xml/1"
        @canonical=true
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ {
                kind: "cem-tree",
                contentType: "application/xml",
                schema: "https://cem.dev/ns/data/xml/1",
                category: "xml-document",
                formatterProfile: $profile,
                formatNodes: [
                    {
                        kind: "format-marker",
                        name: "xml.format-document",
                        formatterRole: "formatter.boundary",
                        formatterProfile: $profile
                    },
                    {
                        kind: "format-decision",
                        name: "xml.lexical-layout",
                        formatterRole: "formatter.layout",
                        formatterProfile: $profile,
                        value: {
                            layout: call("xml.format-document.layout", { profile: $profile }),
                            lineEnding: $lineEnding,
                            indent: $indent,
                            tabSize: $tabSize,
                            sourceBoundary: "xml-document"
                        }
                    }
                ],
                nodes: extend(
                    [
                        call("xml.format-document.token", {
                            kind: "xml.format-marker",
                            text: "",
                            role: "formatter.boundary",
                            sourceMap: null,
                            value: { name: "xml.format-document", formatterProfile: $profile }
                        }),
                        call("xml.format-document.token", {
                            kind: "xml.format-decision",
                            text: "",
                            role: "formatter.layout",
                            sourceMap: null,
                            value: {
                                layout: call("xml.format-document.layout", { profile: $profile }),
                                formatterProfile: $profile,
                                lineEnding: $lineEnding,
                                indent: $indent,
                                tabSize: $tabSize
                            }
                        })
                    ],
                    call("xml.format-document.events", {
                        events: match(typeOf($subject.events), { array: $subject.events, default: [] }),
                        profile: $profile
                    })
                )
            } }
        }
    }

    {function @name="xml.format-document.layout" @visibility="private" @returns="string" @deterministic=true |
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match($profile, {
                compact: "lexical-lossless-compact",
                pretty: "lexical-lossless-pretty",
                "xml.pretty": "lexical-lossless-pretty",
                tabular: "lexical-lossless-tabular",
                default: "lexical-lossless"
            }) }
        }
    }

    {function @name="xml.format-document.events" @visibility="private" @returns="array" @deterministic=true |
        {param @name="events" @type="array" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ fold($events, [], extend(
                $acc,
                [call("xml.format-document.event", { event: $item, profile: $profile })]
            )) }
        }
    }

    {function @name="xml.format-document.event" @visibility="private" @returns="object" @deterministic=true |
        {param @name="event" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ call("xml.format-document.token", {
                kind: concat("xml.", match(typeOf($event.kind), { string: $event.kind, default: "raw" })),
                text: match(typeOf($event.lexeme), { string: $event.lexeme, default: "" }),
                role: call("xml.format-document.role", { event: $event }),
                sourceMap: match(exists($event.sourceMap), { true: $event.sourceMap, false: null }),
                value: {
                    formatterProfile: $profile,
                    eventKind: match(typeOf($event.kind), { string: $event.kind, default: "raw" }),
                    depth: match(typeOf($event.depth), { integer: $event.depth, default: 0 }),
                    sourceRange: match(exists($event.sourceRange), { true: $event.sourceRange, false: null })
                }
            }) }
        }
    }

    {function @name="xml.format-document.role" @visibility="private" @returns="string" @deterministic=true |
        {param @name="event" @type="object" @required=true}
        {body |
            {$ match($event.kind, {
                declaration: "syntax.keyword",
                "start-element": "syntax.name",
                "empty-element": "syntax.name",
                "end-element": "syntax.name",
                text: "syntax.text",
                cdata: "syntax.string",
                comment: "syntax.comment",
                "processing-instruction": "syntax.keyword",
                doctype: "syntax.keyword",
                "entity-reference": "syntax.string",
                default: "syntax.raw"
            }) }
        }
    }

    {function @name="xml.format-document.token" @visibility="private" @returns="object" @deterministic=true |
        {param @name="kind" @type="string" @required=true}
        {param @name="text" @type="string" @required=true}
        {param @name="role" @type="string" @required=true}
        {param @name="sourceMap" @type="any" @required=true @nullable=true}
        {param @name="value" @type="object" @required=true}
        {body |
            {$ {
                kind: $kind,
                writerKind: "token",
                text: $text,
                role: $role,
                style: { colorRole: $role },
                sourceMap: $sourceMap,
                outputSpan: call("xml.format-document.output-span", { sourceMap: $sourceMap }),
                value: $value
            } }
        }
    }

    {function @name="xml.format-document.output-span" @visibility="private" @returns="any" @nullable=true @deterministic=true |
        {param @name="sourceMap" @type="any" @required=true @nullable=true}
        {body |
            {$ match(typeOf($sourceMap), {
                null: null,
                default: {
                    outputRange: { start: 0, len: 0 },
                    origin: $sourceMap
                }
            }) }
        }
    }
}
