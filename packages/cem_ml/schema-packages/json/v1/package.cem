@doc cem-ml 1
@ns pkg = "https://cem.dev/ns/schema-package/1"
@default pkg

{package @id="json" @version="1.0.0" |
    {schema
        @uri="https://cem.dev/ns/data/json/1"
        @source="schema/json.cem"
    }

    {content-type @value="application/json" @primary=true}
    {content-type @value="text/json" @alias=true}

    {namespace @prefix="json" @uri="https://cem.dev/ns/data/json/1"}

    {artifact
        @kind="formatter"
        @path="formatters/compact.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/json"
        @target-schema="https://cem.dev/ns/data/json/1"
        @target-category="json-document"
        @function-name="json.format-document"
        @formatter-profile="compact"
    }

    {artifact
        @kind="formatter"
        @path="formatters/pretty.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/json"
        @target-schema="https://cem.dev/ns/data/json/1"
        @target-category="json-document"
        @function-name="json.format-document"
        @formatter-profile="pretty"
    }

    {artifact
        @kind="formatter"
        @path="formatters/tabular.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/json"
        @target-schema="https://cem.dev/ns/data/json/1"
        @target-category="json-document"
        @function-name="json.format-document"
        @formatter-profile="tabular"
    }

    {artifact
        @kind="formatter-helper"
        @path="formatters/json-format-document.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/json"
        @target-schema="https://cem.dev/ns/data/json/1"
        @target-category="json-document"
        @function-name="json.format-document.tree"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/terminal.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/json"
        @target-schema="https://cem.dev/ns/data/json/1"
        @target-category="json-document"
        @function-name="json.color-document"
        @color-profile="terminal"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/html.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/json"
        @target-schema="https://cem.dev/ns/data/json/1"
        @target-category="json-document"
        @function-name="json.color-document"
        @color-profile="html"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/md.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/json"
        @target-schema="https://cem.dev/ns/data/json/1"
        @target-category="json-document"
        @function-name="json.color-document"
        @color-profile="md"
    }

    {artifact
        @kind="colorizer-helper"
        @path="colorizers/json-color-document.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/json"
        @target-schema="https://cem.dev/ns/data/json/1"
        @target-category="json-document"
        @function-name="json.color-document.tree"
    }

    {example
        @id="basic-object"
        @path="examples/basic-object.json"
        @content-type="application/json"
        @schema="https://cem.dev/ns/data/json/1"
        @expected-result="pass"
    }

    {example
        @id="nested-data"
        @path="examples/nested-data.json"
        @content-type="application/json"
        @schema="https://cem.dev/ns/data/json/1"
        @expected-result="pass"
    }

    {example
        @id="invalid-trailing-comma"
        @path="examples/invalid-trailing-comma.json"
        @content-type="application/json"
        @schema="https://cem.dev/ns/data/json/1"
        @expected-result="fail"
        @expected-diagnostics="cem.json.parse_error"
    }
}
