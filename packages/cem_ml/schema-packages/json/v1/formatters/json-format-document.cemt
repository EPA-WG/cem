@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {function @name="json.format-document.tree" @visibility="private" @returns="object" @deterministic=true |
        {param @name="subject" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ {
                kind: "cem-tree",
                contentType: "application/json",
                schema: "https://cem.dev/ns/data/json/1",
                category: "json-document",
                formatterProfile: $profile,
                formatNodes: [
                    {
                        kind: "format-marker",
                        name: "json.format-document",
                        formatterRole: "formatter.boundary",
                        formatterProfile: $profile
                    },
                    {
                        kind: "format-decision",
                        name: "json.layout",
                        formatterRole: "formatter.layout",
                        formatterProfile: $profile,
                        value: {
                            layout: call("json.format-document.layout", { profile: $profile }),
                            lineEnding: $lineEnding,
                            indent: $indent,
                            leadingComma: call("json.format-document.leading-comma", {}),
                            scopeOpeningNewLine: call("json.format-document.scope-opening-new-line", {})
                        }
                    }
                ],
                nodes: extend(
                    [
                        {
                            kind: "json.format-marker",
                            writerKind: "token",
                            text: "",
                            role: "formatter.boundary",
                            value: {
                                name: "json.format-document",
                                formatterProfile: $profile
                            }
                        },
                        {
                            kind: "json.format-decision",
                            writerKind: "token",
                            text: "",
                            role: "formatter.layout",
                            value: {
                                layout: call("json.format-document.layout", { profile: $profile }),
                                lineEnding: $lineEnding,
                                indent: $indent,
                                leadingComma: call("json.format-document.leading-comma", {}),
                                scopeOpeningNewLine: call("json.format-document.scope-opening-new-line", {})
                            }
                        }
                    ],
                    call("json.format-document.value", {
                        node: match(typeOf($subject.root), { object: $subject.root, default: { kind: "null" } }),
                        depth: 0,
                        profile: $profile
                    })
                )
            } }
        }
    }

    {function @name="json.format-document.layout" @visibility="private" @returns="string" @deterministic=true |
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match($profile, {
                compact: "compact-json-document",
                pretty: "pretty-json-document",
                "json.pretty": "pretty-json-document",
                tabular: "tabular-json-document",
                default: "json-document"
            }) }
        }
    }

    {function @name="json.format-document.value" @visibility="private" @returns="array" @deterministic=true |
        {param @name="node" @type="object" @required=true}
        {param @name="depth" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match($node.kind, {
                object: call("json.format-document.object", { node: $node, depth: $depth, profile: $profile }),
                array: call("json.format-document.array", { node: $node, depth: $depth, profile: $profile }),
                string: [call("json.format-document.scalar-token", {
                    kind: "json.string",
                    text: call("json.format-document.string-lexeme", { node: $node }),
                    role: "syntax.string",
                    node: $node,
                    profile: $profile
                })],
                number: [call("json.format-document.scalar-token", {
                    kind: "json.number",
                    text: match(typeOf($node.lexeme), { string: $node.lexeme, default: "0" }),
                    role: "syntax.number",
                    node: $node,
                    profile: $profile
                })],
                boolean: [call("json.format-document.scalar-token", {
                    kind: "json.boolean",
                    text: match($node.value, { true: "true", false: "false", default: "false" }),
                    role: "syntax.keyword",
                    node: $node,
                    profile: $profile
                })],
                null: [call("json.format-document.scalar-token", {
                    kind: "json.null",
                    text: "null",
                    role: "syntax.keyword",
                    node: $node,
                    profile: $profile
                })],
                default: [call("json.format-document.scalar-token", {
                    kind: "json.null",
                    text: "null",
                    role: "syntax.keyword",
                    node: $node,
                    profile: $profile
                })]
            }) }
        }
    }

    {function @name="json.format-document.object" @visibility="private" @returns="array" @deterministic=true |
        {param @name="node" @type="object" @required=true}
        {param @name="depth" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match(length(match(typeOf($node.members), { array: $node.members, default: [] })), {
                0: [
                    call("json.format-document.token", {
                        kind: "json.object-empty",
                        text: "{}",
                        role: "syntax.punctuation",
                        sourceMap: match(exists($node.sourceMap), { true: $node.sourceMap, false: null }),
                        value: { formatterProfile: $profile }
                    })
                ],
                default: match($profile, {
                    compact: call("json.format-document.object-compact", { node: $node, depth: $depth, profile: $profile }),
                    default: call("json.format-document.object-pretty", { node: $node, depth: $depth, profile: $profile })
                })
            }) }
        }
    }

    {function @name="json.format-document.object-compact" @visibility="private" @returns="array" @deterministic=true |
        {param @name="node" @type="object" @required=true}
        {param @name="depth" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ extend(
                [call("json.format-document.token", {
                    kind: "json.object-open",
                    text: "{",
                    role: "syntax.punctuation",
                    sourceMap: match(exists($node.sourceMap), { true: $node.sourceMap, false: null }),
                    value: { formatterProfile: $profile }
                })],
                extend(
                    fold(match(typeOf($node.members), { array: $node.members, default: [] }), [], extend(
                        $acc,
                        extend(
                            match(length($acc), {
                                0: [],
                                default: [call("json.format-document.comma", { profile: $profile })]
                            }),
                            call("json.format-document.member-compact", { member: $item, depth: $depth, profile: $profile })
                        )
                    )),
                    [call("json.format-document.token", {
                        kind: "json.object-close",
                        text: "}",
                        role: "syntax.punctuation",
                        sourceMap: match(exists($node.sourceMap), { true: $node.sourceMap, false: null }),
                        value: { formatterProfile: $profile }
                    })]
                )
            ) }
        }
    }

    {function @name="json.format-document.object-pretty" @visibility="private" @returns="array" @deterministic=true |
        {param @name="node" @type="object" @required=true}
        {param @name="depth" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ extend(
                [
                    call("json.format-document.token", {
                        kind: "json.object-open",
                        text: "{",
                        role: "syntax.punctuation",
                        sourceMap: match(exists($node.sourceMap), { true: $node.sourceMap, false: null }),
                        value: { formatterProfile: $profile }
                    })
                ],
                extend(
                    fold(match(typeOf($node.members), { array: $node.members, default: [] }), [], extend(
                        $acc,
                        extend(
                            call("json.format-document.item-prefix", {
                                first: match(length($acc), { 0: true, default: false }),
                                depth: $depth,
                                profile: $profile
                            }),
                            call("json.format-document.member-pretty", { member: $item, depth: $depth, profile: $profile })
                        )
                    )),
                    [
                        call("json.format-document.line-ending", { sourceMap: null }),
                        call("json.format-document.indent", { depth: $depth }),
                        call("json.format-document.token", {
                            kind: "json.object-close",
                            text: "}",
                            role: "syntax.punctuation",
                            sourceMap: match(exists($node.sourceMap), { true: $node.sourceMap, false: null }),
                            value: { formatterProfile: $profile }
                        })
                    ]
                )
            ) }
        }
    }

    {function @name="json.format-document.member-compact" @visibility="private" @returns="array" @deterministic=true |
        {param @name="member" @type="object" @required=true}
        {param @name="depth" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ extend(
                [
                    call("json.format-document.member-name", { member: $member, profile: $profile }),
                    call("json.format-document.token", {
                        kind: "json.name-separator",
                        text: ":",
                        role: "syntax.punctuation",
                        sourceMap: match(exists($member.sourceMap), { true: $member.sourceMap, false: null }),
                        value: { formatterProfile: $profile }
                    })
                ],
                call("json.format-document.value", { node: $member.value, depth: add($depth, 1), profile: $profile })
            ) }
        }
    }

    {function @name="json.format-document.member-pretty" @visibility="private" @returns="array" @deterministic=true |
        {param @name="member" @type="object" @required=true}
        {param @name="depth" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ extend(
                [
                    call("json.format-document.member-name", { member: $member, profile: $profile }),
                    call("json.format-document.token", {
                        kind: "json.name-separator",
                        text: ": ",
                        role: "syntax.punctuation",
                        sourceMap: match(exists($member.sourceMap), { true: $member.sourceMap, false: null }),
                        value: { formatterProfile: $profile }
                    })
                ],
                call("json.format-document.value", { node: $member.value, depth: add($depth, 1), profile: $profile })
            ) }
        }
    }

    {function @name="json.format-document.member-name" @visibility="private" @returns="object" @deterministic=true |
        {param @name="member" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ call("json.format-document.token", {
                kind: "json.member-name",
                text: match(typeOf($member.nameLexeme), {
                    string: $member.nameLexeme,
                    default: call("json.format-document.double-quoted", { value: match(typeOf($member.name), { string: $member.name, default: "" }) })
                }),
                role: "syntax.name",
                sourceMap: match(exists($member.nameSourceMap), { true: $member.nameSourceMap, false: null }),
                value: {
                    formatterProfile: $profile,
                    memberIndex: match(exists($member.index), { true: $member.index, false: 0 })
                }
            }) }
        }
    }

    {function @name="json.format-document.array" @visibility="private" @returns="array" @deterministic=true |
        {param @name="node" @type="object" @required=true}
        {param @name="depth" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match(length(match(typeOf($node.items), { array: $node.items, default: [] })), {
                0: [
                    call("json.format-document.token", {
                        kind: "json.array-empty",
                        text: "[]",
                        role: "syntax.punctuation",
                        sourceMap: match(exists($node.sourceMap), { true: $node.sourceMap, false: null }),
                        value: { formatterProfile: $profile }
                    })
                ],
                default: match($profile, {
                    compact: call("json.format-document.array-compact", { node: $node, depth: $depth, profile: $profile }),
                    default: call("json.format-document.array-pretty", { node: $node, depth: $depth, profile: $profile })
                })
            }) }
        }
    }

    {function @name="json.format-document.array-compact" @visibility="private" @returns="array" @deterministic=true |
        {param @name="node" @type="object" @required=true}
        {param @name="depth" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ extend(
                [call("json.format-document.token", {
                    kind: "json.array-open",
                    text: "[",
                    role: "syntax.punctuation",
                    sourceMap: match(exists($node.sourceMap), { true: $node.sourceMap, false: null }),
                    value: { formatterProfile: $profile }
                })],
                extend(
                    fold(match(typeOf($node.items), { array: $node.items, default: [] }), [], extend(
                        $acc,
                        extend(
                            match(length($acc), {
                                0: [],
                                default: [call("json.format-document.comma", { profile: $profile })]
                            }),
                            call("json.format-document.value", { node: $item, depth: add($depth, 1), profile: $profile })
                        )
                    )),
                    [call("json.format-document.token", {
                        kind: "json.array-close",
                        text: "]",
                        role: "syntax.punctuation",
                        sourceMap: match(exists($node.sourceMap), { true: $node.sourceMap, false: null }),
                        value: { formatterProfile: $profile }
                    })]
                )
            ) }
        }
    }

    {function @name="json.format-document.array-pretty" @visibility="private" @returns="array" @deterministic=true |
        {param @name="node" @type="object" @required=true}
        {param @name="depth" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ extend(
                [
                    call("json.format-document.token", {
                        kind: "json.array-open",
                        text: "[",
                        role: "syntax.punctuation",
                        sourceMap: match(exists($node.sourceMap), { true: $node.sourceMap, false: null }),
                        value: { formatterProfile: $profile }
                    })
                ],
                extend(
                    fold(match(typeOf($node.items), { array: $node.items, default: [] }), [], extend(
                        $acc,
                        extend(
                            call("json.format-document.item-prefix", {
                                first: match(length($acc), { 0: true, default: false }),
                                depth: $depth,
                                profile: $profile
                            }),
                            call("json.format-document.value", { node: $item, depth: add($depth, 1), profile: $profile })
                        )
                    )),
                    [
                        call("json.format-document.line-ending", { sourceMap: null }),
                        call("json.format-document.indent", { depth: $depth }),
                        call("json.format-document.token", {
                            kind: "json.array-close",
                            text: "]",
                            role: "syntax.punctuation",
                            sourceMap: match(exists($node.sourceMap), { true: $node.sourceMap, false: null }),
                            value: { formatterProfile: $profile }
                        })
                    ]
                )
            ) }
        }
    }

    {function @name="json.format-document.item-prefix" @visibility="private" @returns="array" @deterministic=true |
        {param @name="first" @type="boolean" @required=true}
        {param @name="depth" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match($first, {
                true: call("json.format-document.first-item-prefix", { depth: $depth, profile: $profile }),
                false: call("json.format-document.next-item-prefix", { depth: $depth, profile: $profile })
            }) }
        }
    }

    {function @name="json.format-document.first-item-prefix" @visibility="private" @returns="array" @deterministic=true |
        {param @name="depth" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match(call("json.format-document.scope-opening-new-line", {}), {
                true: [
                    call("json.format-document.line-ending", { sourceMap: null }),
                    call("json.format-document.indent", { depth: add($depth, 1) })
                ],
                false: call("json.format-document.scope-opening-space", { profile: $profile })
            }) }
        }
    }

    {function @name="json.format-document.next-item-prefix" @visibility="private" @returns="array" @deterministic=true |
        {param @name="depth" @type="integer" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match(call("json.format-document.leading-comma", {}), {
                true: extend(
                    [
                        call("json.format-document.line-ending", { sourceMap: null }),
                        call("json.format-document.indent", { depth: $depth }),
                        call("json.format-document.comma", { profile: $profile })
                    ],
                    call("json.format-document.scope-opening-space", { profile: $profile })
                ),
                false: [
                    call("json.format-document.comma", { profile: $profile }),
                    call("json.format-document.line-ending", { sourceMap: null }),
                    call("json.format-document.indent", { depth: add($depth, 1) })
                ]
            }) }
        }
    }

    {function @name="json.format-document.scope-opening-space" @visibility="private" @returns="array" @deterministic=true |
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ match(call("json.format-document.scope-opening-space-text", {}), {
                "": [],
                default: [call("json.format-document.token", {
                    kind: "json.scope-opening-space",
                    text: call("json.format-document.scope-opening-space-text", {}),
                    role: "syntax.raw",
                    sourceMap: null,
                    value: { formatterProfile: $profile }
                })]
            }) }
        }
    }

    {function @name="json.format-document.scope-opening-space-text" @visibility="private" @returns="string" @deterministic=true |
        {body |
            {$ match(replace($indent, " ", ""), {
                "": repeat(" ", max(sub(length($indent), 1), 0)),
                default: $indent
            }) }
        }
    }

    {function @name="json.format-document.leading-comma" @visibility="private" @returns="boolean" @deterministic=true |
        {body |
            {$ match(exists($formatterOptions.leadingComma), {
                true: call("json.format-document.boolean-option", { value: $formatterOptions.leadingComma, defaultValue: true }),
                false: true
            }) }
        }
    }

    {function @name="json.format-document.scope-opening-new-line" @visibility="private" @returns="boolean" @deterministic=true |
        {body |
            {$ match(exists($formatterOptions.scopeOpeningNewLine), {
                true: call("json.format-document.boolean-option", { value: $formatterOptions.scopeOpeningNewLine, defaultValue: false }),
                false: match(exists($formatterOptions.scopeBeginningNewLine), {
                    true: call("json.format-document.boolean-option", { value: $formatterOptions.scopeBeginningNewLine, defaultValue: false }),
                    false: false
                })
            }) }
        }
    }

    {function @name="json.format-document.boolean-option" @visibility="private" @returns="boolean" @deterministic=true |
        {param @name="value" @type="any" @required=true}
        {param @name="defaultValue" @type="boolean" @required=true}
        {body |
            {$ match($value, {
                true: true,
                false: false,
                "true": true,
                "false": false,
                "1": true,
                "0": false,
                "yes": true,
                "no": false,
                "on": true,
                "off": false,
                default: $defaultValue
            }) }
        }
    }

    {function @name="json.format-document.scalar-token" @visibility="private" @returns="object" @deterministic=true |
        {param @name="kind" @type="string" @required=true}
        {param @name="text" @type="string" @required=true}
        {param @name="role" @type="string" @required=true}
        {param @name="node" @type="object" @required=true}
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ call("json.format-document.token", {
                kind: $kind,
                text: $text,
                role: $role,
                sourceMap: match(exists($node.sourceMap), { true: $node.sourceMap, false: null }),
                value: {
                    formatterProfile: $profile,
                    sourceRange: match(exists($node.sourceRange), { true: $node.sourceRange, false: null })
                }
            }) }
        }
    }

    {function @name="json.format-document.string-lexeme" @visibility="private" @returns="string" @deterministic=true |
        {param @name="node" @type="object" @required=true}
        {body |
            {$ match(typeOf($node.lexeme), {
                string: $node.lexeme,
                default: call("json.format-document.double-quoted", { value: match(typeOf($node.value), { string: $node.value, default: "" }) })
            }) }
        }
    }

    {function @name="json.format-document.comma" @visibility="private" @returns="object" @deterministic=true |
        {param @name="profile" @type="string" @required=true}
        {body |
            {$ call("json.format-document.token", {
                kind: "json.comma",
                text: ",",
                role: "syntax.punctuation",
                sourceMap: null,
                value: { formatterProfile: $profile }
            }) }
        }
    }

    {function @name="json.format-document.line-ending" @visibility="private" @returns="object" @deterministic=true |
        {param @name="sourceMap" @type="any" @required=true @nullable=true}
        {body |
            {$ call("json.format-document.token", {
                kind: "json.line-ending",
                text: match($lineEnding, { crlf: "\r\n", default: "\n" }),
                role: "syntax.raw",
                sourceMap: $sourceMap,
                value: { formatterProfile: $formatterProfile }
            }) }
        }
    }

    {function @name="json.format-document.indent" @visibility="private" @returns="object" @deterministic=true |
        {param @name="depth" @type="integer" @required=true}
        {body |
            {$ call("json.format-document.token", {
                kind: "json.indent",
                text: repeat($indent, $depth),
                role: "syntax.raw",
                sourceMap: null,
                value: { formatterProfile: $formatterProfile }
            }) }
        }
    }

    {function @name="json.format-document.token" @visibility="private" @returns="object" @deterministic=true |
        {param @name="kind" @type="string" @required=true}
        {param @name="text" @type="string" @required=true}
        {param @name="role" @type="string" @required=true}
        {param @name="sourceMap" @type="any" @required=true @nullable=true}
        {param @name="value" @type="object" @required=true}
        {body |
            {$ {
                kind: $kind,
                writerKind: "token",
                text: $text,
                role: $role,
                style: { colorRole: $role },
                sourceMap: $sourceMap,
                outputSpan: call("json.format-document.output-span", { sourceMap: $sourceMap }),
                value: $value
            } }
        }
    }

    {function @name="json.format-document.output-span" @visibility="private" @returns="any" @nullable=true @deterministic=true |
        {param @name="sourceMap" @type="any" @required=true @nullable=true}
        {body |
            {$ match(typeOf($sourceMap), {
                null: null,
                default: {
                    outputRange: {
                        start: 0,
                        len: 0
                    },
                    origin: $sourceMap
                }
            }) }
        }
    }

    {function @name="json.format-document.double-quoted" @visibility="private" @returns="string" @deterministic=true |
        {param @name="value" @type="string" @required=true}
        {body |
            {$ concat("\"", concat(
                replace(
                    replace(
                        replace(
                            replace(
                                replace($value, "\\", "\\\\"),
                                "\"",
                                "\\\""
                            ),
                            "\n",
                            "\\n"
                        ),
                        "\r",
                        "\\r"
                    ),
                    "\t",
                    "\\t"
                ),
                "\""
            )) }
        }
    }
}
