{
    "name": "cem_ml_schema_package_json_v1",
    "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ml/schema-packages/json/v1",
    "targets": {
        "samples2readme": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "cem_ml_cli"
                    ],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "node packages/cem_ml/schema-packages/scripts/samples2readme.mjs {projectRoot}"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/README.md",
                "{projectRoot}/examples/previews",
                "{workspaceRoot}/dist/cem_ml/schema-packages/json/v1/examples"
            ]
        },
        "verify": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "cem_ml_cli"
                    ],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "mkdir -p packages/cem_ml/schema-packages/json/v1/dist",
                    "./dist/target/cem_ml_cli/debug/cem-ml --quiet validate --fail-level parse --format json --content-type application/vnd.cem.schema-package+cem --schema https://cem.dev/ns/schema-package/1 --report-json packages/cem_ml/schema-packages/json/v1/dist packages/cem_ml/schema-packages/json/v1/package.cem"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/examples/**/*",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/dist/cem-ml.report.json"
            ]
        }
    },
    "tags": [
        "scope:cem-ml",
        "type:schema-package",
        "lang:cem"
    ]
}
