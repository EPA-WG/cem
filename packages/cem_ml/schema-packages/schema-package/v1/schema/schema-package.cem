@doc cem-ml 1
@ns schema = "https://cem.dev/ns/schema/1"
@default schema

{schema @name="schema-package" @namespace="https://cem.dev/ns/schema-package/1" @version="1.0.0" |
    {summary |
        {text | Schema package metadata language. This schema defines the format of schema-packages slash schema-name slash version slash package.cem. Package manifests identify the package schema, owned content types, namespace claims, converter edges, generated artifacts, and implementation hooks.}
    }

    {uses |
        {use @schema="https://cem.dev/ns/schema/1" @as="schema"}
    }

    {content-types |
        {content-type @value="application/vnd.cem.schema-package+cem" @primary=true}
    }

    {elements |
        {element @name="package" @required-attributes="id version" @children="schema content-type namespace converter artifact example"}
        {element @name="schema" @required-attributes="uri source" @optional-attributes="version"}
        {element @name="content-type" @required-attributes="value" @optional-attributes="primary alias"}
        {element @name="namespace" @required-attributes="uri" @optional-attributes="prefix"}
        {element @name="converter" @required-attributes="id implementation" @optional-attributes="template template-content-type template-schema template-entrypoint rust-symbol streamable lossiness output-syntax encoding-category formatter-profile color-profile parity implicit explicit-only readiness fallback-reason cost" @children="from to parity-fixture"}
        {element @name="from" @required-attributes="content-type" @optional-attributes="schema"}
        {element @name="to" @required-attributes="content-type" @optional-attributes="schema"}
        {element @name="parity-fixture" @required-attributes="id path" @optional-attributes="content-type schema expected-diagnostics"}
        {element @name="artifact" @required-attributes="kind path" @optional-attributes="content-type schema target-content-type target-schema target-category function-name function-profile formatter-profile color-profile generated"}
        {element @name="example" @optional-attributes="id path content-type schema expected-result expected-diagnostics"}
    }

    {attributes |
        {attribute @name="id" @type="schema:identifier"}
        {attribute @name="version" @type="schema:semver"}
        {attribute @name="uri" @type="schema:uri"}
        {attribute @name="source" @type="schema:path"}
        {attribute @name="value" @type="schema:media-type"}
        {attribute @name="primary" @type="schema:boolean"}
        {attribute @name="alias" @type="schema:boolean"}
        {attribute @name="prefix" @type="schema:identifier"}
        {attribute @name="implementation" @type="schema:identifier" @values="cemt rust"}
        {attribute @name="template" @type="schema:path"}
        {attribute @name="template-content-type" @type="schema:media-type" @values="application/vnd.cem.transform+cem"}
        {attribute @name="template-schema" @type="schema:uri" @values="https://cem.dev/ns/transform/cem/1"}
        {attribute @name="template-entrypoint" @type="schema:identifier"}
        {attribute @name="rust-symbol" @type="schema:identifier"}
        {attribute @name="streamable" @type="schema:boolean"}
        {attribute @name="lossiness" @type="schema:identifier" @values="lossless serialization syntax-normalized debug-view recovery"}
        {attribute @name="output-syntax" @type="schema:identifier" @values="html xml json yaml csv css markdown cemt text binary opaque"}
        {attribute @name="encoding-category" @type="schema:identifier"}
        {attribute @name="formatter-profile" @type="schema:symbol-reference"}
        {attribute @name="color-profile" @type="schema:symbol-reference"}
        {attribute @name="parity" @type="schema:identifier" @values="byte-exact token-equivalent parse-equivalent diagnostic-equivalent"}
        {attribute @name="implicit" @type="schema:boolean"}
        {attribute @name="explicit-only" @type="schema:boolean"}
        {attribute @name="readiness" @type="schema:identifier" @values="ready planned"}
        {attribute @name="fallback-reason" @type="schema:string"}
        {attribute @name="cost" @type="schema:integer" @minInclusive=1}
        {attribute @name="content-type" @type="schema:media-type"}
        {attribute @name="schema" @type="schema:uri"}
        {attribute @name="expected-diagnostics" @type="schema:string"}
        {attribute @name="expected-result" @type="schema:identifier" @values="pass fail"}
        {attribute @name="kind" @type="schema:identifier"}
        {attribute @name="path" @type="schema:path"}
        {attribute @name="target-content-type" @type="schema:media-type"}
        {attribute @name="target-schema" @type="schema:uri"}
        {attribute @name="target-category" @type="schema:identifier"}
        {attribute @name="function-name" @type="schema:symbol-reference"}
        {attribute @name="function-profile" @type="schema:symbol-reference"}
        {attribute @name="generated" @type="schema:boolean"}
    }

    {behaviors |
        {behavior
            @name="single-primary-content-type"
            @implementation="function"
            @execution="ast-validation"
            @function="single-primary-content-type-result"
            @select='if seq:count(content-type.attributes.primary.where(. = "true" or . = "")) = 1 then () else package'
            @match="true" |
            {inputs |
                {input-binding @name="candidate" @type="schema:node" @source="candidate" @required=true @source-range="candidate"}
            }
            {result @type="schema:diagnostic-result" @source-range="candidate" |
                {detail @name="checkKind" @type="schema:identifier" @required=true}
                {detail @name="contract" @type="schema:identifier" @required=true}
                {detail @name="element" @type="schema:identifier" @required=true}
                {detail @name="expectedPrimaryContentTypes" @type="schema:integer" @required=true}
            }
            {function @name="single-primary-content-type-result" @returns="object" @deterministic=true |
                {param @name="candidate" @type="object" @required=true}
                {body | {$ { message: "Schema package must declare exactly one primary content type", details: { checkKind: "single-primary-content-type", contract: "single-primary-content-type", element: $candidate.name, expectedPrimaryContentTypes: 1 } } }}
            }
        }
    }

    {field-contracts |
        {field-contract
            @name="package-required-children"
            @target="package"
            @required-children="schema content-type"
            @diagnostic="cem.schema_package.package_check"
            @behavior="schema:child-occurrence"
            @check-kind="child-occurrence"
        }
        {field-contract
            @name="converter-cemt-template-identity"
            @target="converter"
            @when-attribute="implementation"
            @when-values="cemt"
            @required-attributes="template template-content-type template-schema"
            @diagnostic="cem.schema_package.converter_check"
            @behavior="schema:required-fields"
            @check-kind="required-fields"
        }
        {field-contract
            @name="converter-rust-symbol"
            @target="converter"
            @when-attribute="implementation"
            @when-values="rust"
            @required-attributes="rust-symbol"
            @diagnostic="cem.schema_package.converter_check"
            @behavior="schema:required-fields"
            @check-kind="required-fields"
        }
        {field-contract
            @name="converter-rust-template-forbidden"
            @target="converter"
            @when-attribute="implementation"
            @when-values="rust"
            @forbidden-attributes="template template-content-type template-schema template-entrypoint"
            @diagnostic="cem.schema_package.converter_check"
            @behavior="schema:forbidden-fields"
            @check-kind="forbidden-fields"
        }
        {field-contract
            @name="converter-cemt-fallback-reason"
            @target="converter"
            @when-attribute="implementation"
            @when-values="cemt"
            @when-present-attributes="rust-symbol"
            @required-attributes="fallback-reason"
            @diagnostic="cem.schema_package.converter_check"
            @behavior="schema:dependent-required-fields"
            @check-kind="dependent-required-fields"
        }
        {field-contract
            @name="converter-planner-state"
            @target="converter"
            @when-attribute="explicit-only"
            @when-values="true"
            @forbidden-attribute-values="implicit=true"
            @diagnostic="cem.schema_package.converter_check"
            @behavior="schema:mutual-exclusion"
            @check-kind="mutual-exclusion"
        }
        {field-contract
            @name="converter-from-to-endpoints"
            @target="converter"
            @required-children="from to"
            @max-one-children="from to"
            @diagnostic="cem.schema_package.converter_check"
            @behavior="schema:child-occurrence"
            @check-kind="child-occurrence"
        }
        {field-contract
            @name="artifact-stage-metadata"
            @target="artifact"
            @when-attribute="kind"
            @when-values="formatter colorizer formatter-helper colorizer-helper"
            @required-attributes="content-type schema target-content-type target-schema target-category function-name"
            @diagnostic="cem.schema_package.artifact_check"
            @behavior="schema:required-fields"
            @check-kind="required-fields"
        }
        {field-contract
            @name="artifact-formatter-profile"
            @target="artifact"
            @when-attribute="kind"
            @when-values="formatter"
            @required-attributes="formatter-profile"
            @diagnostic="cem.schema_package.artifact_check"
            @behavior="schema:required-fields"
            @check-kind="required-fields"
        }
        {field-contract
            @name="artifact-colorizer-profile"
            @target="artifact"
            @when-attribute="kind"
            @when-values="colorizer"
            @required-attributes="color-profile"
            @diagnostic="cem.schema_package.artifact_check"
            @behavior="schema:required-fields"
            @check-kind="required-fields"
        }
        {field-contract
            @name="artifact-formatter-layout"
            @target="artifact"
            @when-attribute="kind"
            @when-values="formatter formatter-helper"
            @path-layout-attributes="path"
            @path-layout-prefix="formatters"
            @path-layout-extension="cemt"
            @diagnostic="cem.schema_package.artifact_check"
            @behavior="schema:path-layout"
            @check-kind="path-layout"
        }
        {field-contract
            @name="artifact-colorizer-layout"
            @target="artifact"
            @when-attribute="kind"
            @when-values="colorizer colorizer-helper"
            @path-layout-attributes="path"
            @path-layout-prefix="colorizers"
            @path-layout-extension="cemt"
            @diagnostic="cem.schema_package.artifact_check"
            @behavior="schema:path-layout"
            @check-kind="path-layout"
        }
        {field-contract
            @name="example-required-metadata"
            @target="example"
            @required-attributes="id path content-type schema expected-result"
            @diagnostic="cem.schema_package.example_check"
            @behavior="schema:required-fields"
            @check-kind="required-fields"
        }
        {field-contract
            @name="example-failing-diagnostics"
            @target="example"
            @when-attribute="expected-result"
            @when-values="fail"
            @required-attributes="expected-diagnostics"
            @diagnostic="cem.schema_package.example_check"
            @behavior="schema:field-dependency"
            @check-kind="dependent-required-fields"
        }
    }

    {constraints |
        {constraint @kind="single-primary-content-type" @target="package" @policy="required"}
        {constraint @kind="schema-source-required" @target="schema" @policy="required"}
        {constraint @kind="converter-from-to-required" @target="converter" @policy="required"}
        {constraint @kind="cemt-template-identity-required" @target="converter" @policy="when implementation is cemt"}
        {constraint @kind="rust-symbol-required" @target="converter" @policy="when implementation is rust"}
        {constraint @kind="converter-planner-state-contract" @target="converter" @policy="implicit and explicit-only cannot both be true"}
        {constraint @kind="converter-output-contract" @target="converter" @policy="encoding-category, formatter-profile, and color-profile describe the CEMT tree pipeline and final writer artifact identity"}
        {constraint @kind="converter-template-output-stage-contract" @target="converter" @policy="CEMT converters that declare formatter-profile or color-profile output stages must reference a readable CEMT template that compiles as a formatted CEM-tree producer before writer output"}
        {constraint @kind="converter-endpoint-schema-content-type-match" @target="from to" @policy="when endpoint schema is known, content-type must be registered by that schema"}
        {constraint @kind="planned-cemt-rust-fallback" @target="converter" @policy="planned CEMT converters may declare rust-symbol as fallback hook"}
        {constraint @kind="cemt-native-fallback-reason" @target="converter" @policy="CEMT converters that declare rust-symbol fallback hooks must also declare fallback-reason"}
        {constraint @kind="schema-source-metadata-consistency" @target="package schema content-type namespace" @policy="when package source is local, package schema URI, content type claims, and namespace URI claims must match the referenced schema source"}
        {constraint @kind="artifact-output-stage-contract" @target="artifact" @policy="formatter, colorizer, formatter-helper, and colorizer-helper artifacts that provide runtime CEMT output stages or helpers must use package-relative CEMT paths under formatters/ or colorizers/, declare target-content-type, target-schema, target-category, function-name, function-profile when the CEMT declaration has a profile, and the applicable formatter-profile or color-profile"}
        {constraint @kind="example-contract" @target="example" @policy="schema-package examples must declare source path, content type, schema URL, pass/fail result, and expected diagnostics for failing examples; when example schema is known, content type must be registered by that schema"}
        {constraint @kind="converter-template-source-readable" @target="converter" @diagnostic="cem.schema_package.converter_check" @behavior="schema:resource-readable" @policy="CEMT converter template paths must resolve to readable resources"}
        {constraint @kind="converter-template-contract" @target="converter" @diagnostic="cem.schema_package.converter_check" @behavior="schema:resource-parse" @policy="CEMT converter templates must compile as formatted CEM-tree producers before writer output"}
        {constraint @kind="endpoint-content-type-schema" @target="from to" @diagnostic="cem.schema_package.converter_check" @behavior="schema:reference-resolution" @policy="converter endpoint content type must be registered by the endpoint schema"}
        {constraint @kind="artifact-source-readable" @target="artifact" @diagnostic="cem.schema_package.artifact_check" @behavior="schema:resource-readable" @policy="CEMT artifact paths must resolve to readable resources"}
        {constraint @kind="artifact-cemt-valid" @target="artifact" @diagnostic="cem.schema_package.artifact_check" @behavior="schema:resource-parse" @policy="CEMT artifact source must parse successfully"}
        {constraint @kind="artifact-function-declared" @target="artifact" @diagnostic="cem.schema_package.artifact_check" @behavior="schema:reference-resolution" @policy="CEMT artifact source must declare the referenced function"}
        {constraint @kind="artifact-function-contract" @target="artifact" @diagnostic="cem.schema_package.artifact_check" @behavior="schema:reference-resolution" @policy="CEMT artifact function metadata must match the artifact declaration"}
        {constraint @kind="example-content-type-schema" @target="example" @diagnostic="cem.schema_package.example_check" @behavior="schema:reference-resolution" @policy="example content type must be registered by the example schema"}
        {constraint @kind="example-source-readable" @target="example" @diagnostic="cem.schema_package.example_check" @behavior="schema:resource-readable" @policy="example source paths must resolve to readable resources"}
        {constraint @kind="example-source-validation" @target="example" @diagnostic="cem.schema_package.example_check" @behavior="schema:resource-parse" @policy="example source validation result must match expected-result"}
        {constraint @kind="example-expected-diagnostics" @target="example" @diagnostic="cem.schema_package.example_check" @behavior="schema:reference-resolution" @policy="failing examples must emit the declared expected diagnostics"}
    }

    {diagnostics |
        {diagnostic @code="cem.schema_package.package_check" @severity="error" @behavior="schema:field-contract"}
        {diagnostic @code="cem.schema_package.missing_schema" @severity="error"}
        {diagnostic @code="cem.schema_package.content_type_conflict" @severity="error" @behavior="single-primary-content-type"}
        {diagnostic @code="cem.schema_package.manifest_source_invalid" @severity="error"}
        {diagnostic @code="cem.schema_package.manifest_conversion_metadata_invalid" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_identity_missing" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_identity_mismatch" @severity="error"}
        {diagnostic @code="cem.schema_package.implementation_missing" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_registration_failed" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_check" @severity="error" @behavior="schema:field-contract"}
        {diagnostic @code="cem.schema_package.artifact_check" @severity="error" @behavior="schema:field-contract"}
        {diagnostic @code="cem.schema_package.example_check" @severity="error" @behavior="schema:field-contract"}
        {diagnostic @code="cem.schema_package.schema_source_unreadable" @severity="error"}
        {diagnostic @code="cem.schema_package.schema_source_invalid" @severity="error"}
        {diagnostic @code="cem.schema_package.schema_uri_mismatch" @severity="error"}
        {diagnostic @code="cem.schema_package.schema_content_type_mismatch" @severity="error"}
        {diagnostic @code="cem.schema_package.schema_namespace_mismatch" @severity="error"}
    }

    {open-content |
        {accept @kind="package-extension" @policy="reject-unless-declared"}
    }
}
