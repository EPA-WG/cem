@doc cem-ml 1
@ns schema = "https://cem.dev/ns/schema/1"
@default schema

{schema @name="schema-package" @namespace="https://cem.dev/ns/schema-package/1" @version="1.0.0" |
    {summary |
        {text | Schema package metadata language. This schema defines the format of schema-packages slash schema-name slash version slash package.cem. Package manifests identify the package schema, owned content types, namespace claims, converter edges, generated artifacts, and implementation hooks.}
    }

    {uses |
        {use @schema="https://cem.dev/ns/schema/1" @as="schema"}
    }

    {content-types |
        {content-type @value="application/vnd.cem.schema-package+cem" @primary=true}
    }

    {elements |
        {element @name="package" @required-attributes="id version" @children="schema content-type namespace converter artifact"}
        {element @name="schema" @required-attributes="uri source" @optional-attributes="version"}
        {element @name="content-type" @required-attributes="value" @optional-attributes="primary alias"}
        {element @name="namespace" @required-attributes="uri" @optional-attributes="prefix"}
        {element @name="converter" @required-attributes="id implementation" @optional-attributes="template template-content-type template-schema template-entrypoint rust-symbol streamable lossiness implicit explicit-only readiness fallback-reason cost" @children="from to"}
        {element @name="from" @required-attributes="content-type" @optional-attributes="schema"}
        {element @name="to" @required-attributes="content-type" @optional-attributes="schema"}
        {element @name="artifact" @required-attributes="kind path" @optional-attributes="content-type schema generated"}
    }

    {attributes |
        {attribute @name="id" @type="schema:identifier"}
        {attribute @name="version" @type="schema:semver"}
        {attribute @name="uri" @type="schema:uri"}
        {attribute @name="source" @type="schema:path"}
        {attribute @name="value" @type="schema:media-type"}
        {attribute @name="primary" @type="schema:boolean"}
        {attribute @name="alias" @type="schema:boolean"}
        {attribute @name="prefix" @type="schema:identifier"}
        {attribute @name="implementation" @type="schema:identifier" @values="cemt rust"}
        {attribute @name="template" @type="schema:path"}
        {attribute @name="template-content-type" @type="schema:media-type"}
        {attribute @name="template-schema" @type="schema:uri"}
        {attribute @name="template-entrypoint" @type="schema:identifier"}
        {attribute @name="rust-symbol" @type="schema:identifier"}
        {attribute @name="streamable" @type="schema:boolean"}
        {attribute @name="lossiness" @type="schema:identifier"}
        {attribute @name="implicit" @type="schema:boolean"}
        {attribute @name="explicit-only" @type="schema:boolean"}
        {attribute @name="readiness" @type="schema:identifier" @values="ready planned"}
        {attribute @name="fallback-reason" @type="schema:string"}
        {attribute @name="cost" @type="schema:integer"}
        {attribute @name="content-type" @type="schema:media-type"}
        {attribute @name="schema" @type="schema:uri"}
        {attribute @name="kind" @type="schema:identifier"}
        {attribute @name="path" @type="schema:path"}
        {attribute @name="generated" @type="schema:boolean"}
    }

    {constraints |
        {constraint @kind="single-primary-content-type" @target="package" @policy="required"}
        {constraint @kind="schema-source-required" @target="schema" @policy="required"}
        {constraint @kind="converter-from-to-required" @target="converter" @policy="required"}
        {constraint @kind="cemt-template-identity-required" @target="converter" @policy="when implementation is cemt"}
        {constraint @kind="rust-symbol-required" @target="converter" @policy="when implementation is rust"}
        {constraint @kind="converter-cost-positive" @target="converter" @policy="cost, when present, must be a positive integer"}
        {constraint @kind="converter-endpoint-schema-content-type-match" @target="from to" @policy="when endpoint schema is known, content-type must be registered by that schema"}
        {constraint @kind="planned-cemt-rust-fallback" @target="converter" @policy="planned CEMT converters may declare rust-symbol as fallback hook"}
        {constraint @kind="schema-source-metadata-consistency" @target="package schema content-type namespace" @policy="when package source is local, package schema URI, content type claims, and namespace URI claims must match the referenced schema source"}
    }

    {diagnostics |
        {diagnostic @code="cem.schema_package.missing_schema" @severity="error"}
        {diagnostic @code="cem.schema_package.content_type_conflict" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_identity_missing" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_identity_mismatch" @severity="error"}
        {diagnostic @code="cem.schema_package.implementation_missing" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_endpoint_missing" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_endpoint_duplicate" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_implementation_unknown" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_template_missing" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_template_content_type_missing" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_template_content_type_mismatch" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_template_schema_mismatch" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_rust_symbol_missing" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_readiness_unknown" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_boolean_invalid" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_cost_invalid" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_selection_conflict" @severity="error"}
        {diagnostic @code="cem.schema_package.converter_content_type_mismatch" @severity="error"}
        {diagnostic @code="cem.schema_package.schema_source_unreadable" @severity="error"}
        {diagnostic @code="cem.schema_package.schema_source_invalid" @severity="error"}
        {diagnostic @code="cem.schema_package.schema_uri_mismatch" @severity="error"}
        {diagnostic @code="cem.schema_package.schema_content_type_mismatch" @severity="error"}
        {diagnostic @code="cem.schema_package.schema_namespace_mismatch" @severity="error"}
    }

    {open-content |
        {accept @kind="package-extension" @policy="reject-unless-declared"}
    }
}
