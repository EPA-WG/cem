@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {format-function @name="css-selector.format-expression" @visibility="public" @category="css-selector-expression" @subject="css-selector-expression" @produces="cem-tree" @content-type="application/vnd.cem.query-expression+css-selector" @schema="https://cem.dev/ns/query/css-selector/1" @profile="compact" @canonical=true @deterministic=true @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body | {$ merge(call("css-selector.format-expression.tree", { subject: $subject, profile: "compact" }), {}) } }
    }
}
