@doc cem-ml 1
@ns pkg = "https://cem.dev/ns/schema-package/1"
@default pkg

{package @id="css-selector" @version="1.0.0" |
    {schema
        @uri="https://cem.dev/ns/query/css-selector/1"
        @source="schema/css-selector.cem"
    }

    {content-type @value="application/vnd.cem.query-expression+css-selector" @primary=true}

    {namespace @prefix="csssel" @uri="https://cem.dev/ns/query/css-selector/1"}

    {artifact
        @kind="formatter"
        @path="formatters/compact.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query-expression+css-selector"
        @target-schema="https://cem.dev/ns/query/css-selector/1"
        @target-category="css-selector-expression"
        @function-name="css-selector.format-expression"
        @formatter-profile="compact"
    }

    {artifact
        @kind="formatter"
        @path="formatters/pretty.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query-expression+css-selector"
        @target-schema="https://cem.dev/ns/query/css-selector/1"
        @target-category="css-selector-expression"
        @function-name="css-selector.format-expression"
        @formatter-profile="pretty"
    }

    {artifact
        @kind="formatter"
        @path="formatters/tabular.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query-expression+css-selector"
        @target-schema="https://cem.dev/ns/query/css-selector/1"
        @target-category="css-selector-expression"
        @function-name="css-selector.format-expression"
        @formatter-profile="tabular"
    }

    {artifact
        @kind="formatter-helper"
        @path="formatters/css-selector-format-expression.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query-expression+css-selector"
        @target-schema="https://cem.dev/ns/query/css-selector/1"
        @target-category="css-selector-expression"
        @function-name="css-selector.format-expression.tree"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/terminal.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query-expression+css-selector"
        @target-schema="https://cem.dev/ns/query/css-selector/1"
        @target-category="css-selector-expression"
        @function-name="css-selector.color-expression"
        @color-profile="terminal"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/html.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query-expression+css-selector"
        @target-schema="https://cem.dev/ns/query/css-selector/1"
        @target-category="css-selector-expression"
        @function-name="css-selector.color-expression"
        @color-profile="html"
    }

    {artifact
        @kind="colorizer"
        @path="colorizers/md.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query-expression+css-selector"
        @target-schema="https://cem.dev/ns/query/css-selector/1"
        @target-category="css-selector-expression"
        @function-name="css-selector.color-expression"
        @color-profile="md"
    }

    {artifact
        @kind="colorizer-helper"
        @path="colorizers/css-selector-color-expression.cemt"
        @content-type="application/vnd.cem.transform+cem"
        @schema="https://cem.dev/ns/transform/cem/1"
        @target-content-type="application/vnd.cem.query-expression+css-selector"
        @target-schema="https://cem.dev/ns/query/css-selector/1"
        @target-category="css-selector-expression"
        @function-name="css-selector.color-expression.tree"
    }

    {example
        @id="basic-selector"
        @path="examples/basic.css-selector"
        @content-type="application/vnd.cem.query-expression+css-selector"
        @schema="https://cem.dev/ns/query/css-selector/1"
        @expected-result="pass"
    }

    {example
        @id="relational-selector"
        @path="examples/relational.css-selector"
        @content-type="application/vnd.cem.query-expression+css-selector"
        @schema="https://cem.dev/ns/query/css-selector/1"
        @expected-result="pass"
    }

    {example
        @id="unbound-namespace"
        @path="examples/unbound-namespace.css-selector"
        @content-type="application/vnd.cem.query-expression+css-selector"
        @schema="https://cem.dev/ns/query/css-selector/1"
        @expected-result="fail"
        @expected-diagnostics="css-selector.namespace.unbound"
    }

    {example
        @id="source-map-selector"
        @path="examples/source-map-selector.css-selector"
        @content-type="application/vnd.cem.query-expression+css-selector"
        @schema="https://cem.dev/ns/query/css-selector/1"
        @expected-result="pass"
    }

    {example
        @id="namespace-wildcard"
        @path="examples/namespace-wildcard.css-selector"
        @content-type="application/vnd.cem.query-expression+css-selector"
        @schema="https://cem.dev/ns/query/css-selector/1"
        @expected-result="pass"
    }

    {example
        @id="budgeted-relational"
        @path="examples/budgeted-relational.css-selector"
        @content-type="application/vnd.cem.query-expression+css-selector"
        @schema="https://cem.dev/ns/query/css-selector/1"
        @expected-result="pass"
    }

    {example
        @id="invalid-syntax"
        @path="examples/invalid-syntax.css-selector"
        @content-type="application/vnd.cem.query-expression+css-selector"
        @schema="https://cem.dev/ns/query/css-selector/1"
        @expected-result="fail"
        @expected-diagnostics="css-selector.parse.invalid"
    }

    {example
        @id="unsupported-pseudo-element"
        @path="examples/unsupported-pseudo-element.css-selector"
        @content-type="application/vnd.cem.query-expression+css-selector"
        @schema="https://cem.dev/ns/query/css-selector/1"
        @expected-result="fail"
        @expected-diagnostics="css-selector.feature.unsupported"
    }

    {example
        @id="missing-host-capability"
        @path="examples/missing-host-capability.css-selector"
        @content-type="application/vnd.cem.query-expression+css-selector"
        @schema="https://cem.dev/ns/query/css-selector/1"
        @expected-result="fail"
        @expected-diagnostics="css-selector.capability.missing"
    }
}
