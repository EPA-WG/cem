@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function
        @name="css.color-document"
        @category="css-document"
        @subject="tokens"
        @produces="tokens"
        @content-type="text/css"
        @schema="https://cem.dev/ns/data/css/1"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="array" @required=true}
    }
}
