@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function @name="css.color-document" @visibility="public" @category="css-document" @subject="cem-tree" @produces="cem-tree" @content-type="text/css" @schema="https://cem.dev/ns/data/css/1" @profile="terminal" @extends="cem.color-tree" @canonical=false @deterministic=true @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body | {$ merge(call("css.color-document.tree", { subject: $subject, profile: "terminal", output: "terminal" }), {}) } }
    }
}
