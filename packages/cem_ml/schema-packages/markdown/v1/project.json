{
    "name": "cem_ml_schema_package_markdown_v1",
    "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ml/schema-packages/markdown/v1",
    "targets": {
        "build": {
            "cache": true,
            "executor": "nx:noop",
            "dependsOn": [
                "samples2readme"
            ],
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{workspaceRoot}/dist/cem_ml/schema-packages/markdown/v1/examples/*.html",
                "{projectRoot}/examples/previews/*.svg"
            ]
        },
        "samples2readme": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "cem_ml_cli"
                    ],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "node packages/cem_ml/schema-packages/scripts/samples2readme.mjs {projectRoot}"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "!{projectRoot}/examples/previews/**/*",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/Cargo.toml",
                "{workspaceRoot}/Cargo.lock",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/README.md",
                "{workspaceRoot}/dist/cem_ml/schema-packages/markdown/v1/examples/*.html",
                "{projectRoot}/examples/previews/*.svg"
            ]
        },
        "verify": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "cem_ml_cli"
                    ],
                    "target": "build"
                }
            ],
            "options": {
                "commands": [
                    "mkdir -p packages/cem_ml/schema-packages/markdown/v1/dist",
                    "./dist/target/cem_ml_cli/debug/cem-ml --quiet validate --fail-level parse --format json --content-type application/vnd.cem.schema-package+cem --schema https://cem.dev/ns/schema-package/1 --report-json packages/cem_ml/schema-packages/markdown/v1/dist packages/cem_ml/schema-packages/markdown/v1/package.cem",
                    "cargo test -p cem-ml markdown_package_examples_are_manifest_indexed -- --nocapture",
                    "cargo test -p cem-ml catalog_exposes_markdown_output_artifact_sources -- --nocapture",
                    "cargo test -p cem-ml evaluate_encode_expressions_executes_markdown_package_cemt_boundaries -- --nocapture",
                    "cargo test -p cem-ml builtins_load_markdown_content_type_as_internal_ast_stream -- --nocapture",
                    "cargo test -p cem-ml builtins_select_markdown_target_export_layer -- --nocapture",
                    "cargo test -p cem-ml builtin_markdown_lifecycle_output_pipeline_executes_package_cemt_assets -- --nocapture",
                    "cargo test -p cem-ml builtin_markdown_colorizer_profiles_execute_package_cemt_assets -- --nocapture",
                    "cargo test -p cem-ml builtin_registry_selects_markdown_to_html_converter_edge -- --nocapture",
                    "cargo test -p cem-ml markdown_source_validator -- --nocapture",
                    "cargo test -p cem-ml markdown_gfm_variant_emits_table_and_task_list_ast_events -- --nocapture",
                    "cargo test -p cem-ml-cli validate_markdown_source -- --nocapture",
                    "cargo test -p cem-ml-cli convert_markdown_same_schema_uses_borrowed_lifecycle_ast_stream -- --nocapture",
                    "cargo test -p cem-ml-cli convert_markdown_to_html_embeds_cem_ml_svg -- --nocapture",
                    "cargo test -p cem-ml-cli convert_markdown_gfm_to_html_renders_tables_and_task_lists -- --nocapture",
                    "cargo test -p cem-ml-cli transform_config_converts_markdown_glob_to_typed_html_exports -- --nocapture",
                    "node packages/cem_ml/schema-packages/markdown/v1/scripts/verify-previews.mjs"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/package.cem",
                "{projectRoot}/README.md",
                "{projectRoot}/schema/**/*.cem",
                "{projectRoot}/formatters/**/*.cemt",
                "{projectRoot}/colorizers/**/*.cemt",
                "{projectRoot}/converters/**/*.cemt",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/examples/**/*",
                "{workspaceRoot}/packages/cem_ml/schema-packages/scripts/**/*.mjs",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml"
            ],
            "outputs": [
                "{projectRoot}/dist/cem-ml.report.json"
            ]
        }
    },
    "tags": [
        "scope:cem-ml",
        "type:schema-package",
        "lang:cem"
    ]
}
