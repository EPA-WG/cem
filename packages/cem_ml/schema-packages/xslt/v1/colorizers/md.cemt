@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function @name="xslt.color-stylesheet" @visibility="public" @category="xslt-stylesheet" @subject="cem-tree" @produces="cem-tree" @content-type="application/xslt+xml" @schema="https://cem.dev/ns/transform/xslt/1" @profile="md" @extends="cem.color-tree" @canonical=false @deterministic=true @streamable=true |
        {param @name="subject" @type="object" @required=true}
        {body | {$ merge(call("xslt.color-stylesheet.tree", { subject: $subject, profile: "md", output: "md" }), {}) } }
    }
}
