@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
    {color-function
        @name="xslt.color-stylesheet"
        @category="xslt-stylesheet"
        @subject="tokens"
        @produces="tokens"
        @content-type="application/xslt+xml"
        @schema="https://cem.dev/ns/transform/xslt/1"
        @canonical=false
        @deterministic=true
        @streamable=true |
        {param @name="subject" @type="array" @required=true}
    }
}
