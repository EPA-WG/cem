@doc cem-ml 1
@ns schema = "https://cem.dev/ns/schema/1"
@ns cemml = "https://cem.dev/ns/cem-ml/1"
@ns xml = "https://cem.dev/ns/data/xml/1"
@ns xpath = "https://cem.dev/ns/query/xpath/1"
@default schema

{schema @name="xslt" @namespace="https://cem.dev/ns/transform/xslt/1" @version="1.0.0" |
    {summary |
        {text | XSLT stylesheet resource schema. XSLT is XML-backed and uses the version-stable XSLT namespace. This package registers standard XSLT stylesheet identity and the legacy custom-element XSLT compatibility aliases consumed by the bounded CEM adapter.}
    }

    {uses |
        {use @schema="https://cem.dev/ns/schema/1" @as="schema"}
        {use @schema="https://cem.dev/ns/cem-ml/1" @as="cemml"}
        {use @schema="https://cem.dev/ns/data/xml/1" @as="xml"}
        {use @schema="https://cem.dev/ns/query/xpath/1" @as="xpath"}
    }

    {content-types |
        {content-type @value="application/xslt+xml" @primary=true}
        {content-type @value="text/xsl" @alias=true}
        {content-type @value="custom-element-xslt" @alias=true}
        {content-type @value="text/custom-element-xslt" @alias=true}
        {content-type @value="application/custom-element-xslt" @alias=true}
        {content-type @value="text/x-custom-element-xslt" @alias=true}
    }

    {namespaces |
        {namespace @prefix="cemxslt" @uri="https://cem.dev/ns/transform/xslt/1" @role="schema"}
        {namespace @prefix="xsl" @uri="http://www.w3.org/1999/XSL/Transform" @role="document-namespace"}
        {namespace @prefix="xml" @uri="https://cem.dev/ns/data/xml/1" @role="base-format"}
        {namespace @prefix="xpath" @uri="https://cem.dev/ns/query/xpath/1" @role="expression-language"}
    }

    {elements |
        {element @name="stylesheet-module" @base="xml:document" @required-attributes="encoding" @optional-attributes="charset source-id byte-offset byte-length" @children="stylesheet"}
        {element @name="stylesheet" @base="xml:element" @required-attributes="namespace-uri version" @optional-attributes="id default-mode default-collation xpath-default-namespace extension-element-prefixes exclude-result-prefixes compatibility-profile adapter-line source-id byte-offset byte-length" @children="declaration* template*"}
        {element @name="declaration" @base="xml:element" @required-attributes="kind" @optional-attributes="name href method media-type encoding priority source-id byte-offset byte-length" @children="param* variable* sequence-constructor*"}
        {element @name="template" @base="xml:element" @optional-attributes="name match mode priority visibility source-id byte-offset byte-length" @children="param* sequence-constructor*"}
        {element @name="param" @base="xml:element" @required-attributes="name" @optional-attributes="select as required tunnel source-id byte-offset byte-length" @children="sequence-constructor*"}
        {element @name="variable" @base="xml:element" @required-attributes="name" @optional-attributes="select as visibility source-id byte-offset byte-length" @children="sequence-constructor*"}
        {element @name="sequence-constructor" @base="xml:element" @children="instruction* literal-result* text*"}
        {element @name="instruction" @base="xml:element" @required-attributes="kind" @optional-attributes="select test name match mode href method order data-type namespace terminate source-id byte-offset byte-length" @children="param* sort* sequence-constructor*"}
        {element @name="sort" @base="xml:element" @optional-attributes="select order data-type lang case-order source-id byte-offset byte-length"}
        {element @name="literal-result" @base="xml:element" @required-attributes="namespace-uri local-name" @optional-attributes="prefix source-id byte-offset byte-length" @children="instruction* literal-result* text*"}
        {element @name="text" @base="xml:text" @optional-attributes="value source-id byte-offset byte-length"}
    }

    {attributes |
        {attribute @name="encoding" @base="xml:encoding"}
        {attribute @name="charset" @base="xml:charset"}
        {attribute @name="source-id" @base="xml:source-id"}
        {attribute @name="byte-offset" @base="xml:byte-offset"}
        {attribute @name="byte-length" @base="xml:byte-length"}
        {attribute @name="namespace-uri" @base="xml:namespace-uri"}
        {attribute @name="local-name" @base="xml:local-name"}
        {attribute @name="prefix" @base="xml:prefix"}
        {attribute @name="id" @type="schema:identifier"}
        {attribute @name="version" @type="schema:string"}
        {attribute @name="adapter-line" @type="schema:semver"}
        {attribute @name="compatibility-profile" @type="schema:identifier" @values="full-xslt bounded-custom-element legacy-fragment"}
        {attribute @name="kind" @type="schema:identifier" @values="stylesheet transform output import include template param variable value-of text if choose when otherwise for-each apply-templates call-template with-param sort copy copy-of attribute element literal-result result-document message function script"}
        {attribute @name="name" @type="schema:string"}
        {attribute @name="match" @type="schema:string"}
        {attribute @name="mode" @type="schema:string"}
        {attribute @name="priority" @type="schema:string"}
        {attribute @name="visibility" @type="schema:identifier" @values="public private final abstract hidden"}
        {attribute @name="select" @type="schema:string"}
        {attribute @name="test" @type="schema:string"}
        {attribute @name="as" @type="schema:string"}
        {attribute @name="required" @type="schema:boolean"}
        {attribute @name="tunnel" @type="schema:boolean"}
        {attribute @name="href" @type="schema:string"}
        {attribute @name="method" @type="schema:identifier" @values="xml html xhtml text json adaptive"}
        {attribute @name="media-type" @type="schema:media-type"}
        {attribute @name="order" @type="schema:identifier" @values="ascending descending"}
        {attribute @name="data-type" @type="schema:identifier" @values="text number"}
        {attribute @name="lang" @type="schema:string"}
        {attribute @name="case-order" @type="schema:identifier" @values="upper-first lower-first"}
        {attribute @name="namespace" @type="schema:string"}
        {attribute @name="terminate" @type="schema:boolean"}
        {attribute @name="default-mode" @type="schema:string"}
        {attribute @name="default-collation" @type="schema:string"}
        {attribute @name="xpath-default-namespace" @type="schema:string"}
        {attribute @name="extension-element-prefixes" @type="schema:string"}
        {attribute @name="exclude-result-prefixes" @type="schema:string"}
        {attribute @name="value" @type="schema:string"}
    }

    {constraints |
        {constraint @kind="xslt-source-parser" @target="stylesheet-module" @diagnostic="cem.xslt.not_well_formed_xml" @behavior="xslt-report-fact" @fact-kind="not-well-formed-xml" @policy="delegate to the generic XML event parser while retaining XSLT schema and media-type identity"}
        {constraint @kind="xslt-source-encoding" @target="stylesheet-module" @diagnostic="cem.xslt.unsupported_encoding" @behavior="xslt-report-fact" @fact-kind="unsupported-encoding" @policy="inherit the XML package UTF-8 and US-ASCII decoder policy"}
        {constraint @kind="xslt-encoding-conflict" @target="stylesheet-module" @diagnostic="cem.xslt.encoding_conflict" @behavior="xslt-report-fact" @fact-kind="encoding-conflict" @policy="MIME charset and XML declaration encoding must not conflict"}
        {constraint @kind="xslt-namespace-prefix-binding" @target="stylesheet-module" @diagnostic="cem.xslt.unbound_namespace_prefix" @behavior="xslt-report-fact" @fact-kind="unbound-namespace-prefix" @policy="inherit XML namespace prefix binding rules"}
        {constraint @kind="xslt-attribute-namespace-uniqueness" @target="stylesheet-module" @diagnostic="cem.xslt.duplicate_attribute" @behavior="xslt-report-fact" @fact-kind="duplicate-attribute" @policy="inherit XML expanded-name attribute uniqueness rules"}
        {constraint @kind="application-xslt-primary" @target="stylesheet-module" @policy="application/xslt+xml is the canonical registered media type for XSLT stylesheet modules"}
        {constraint @kind="text-xsl-legacy-alias" @target="stylesheet-module" @policy="text/xsl is accepted as a compatibility alias for old browser and XML-stylesheet processing-instruction usage"}
        {constraint @kind="custom-element-aliases" @target="stylesheet-module" @policy="custom-element-xslt aliases select the bounded legacy custom-element compatibility adapter"}
        {constraint @kind="xml-base-schema-compatible" @target="stylesheet-module" @policy="required"}
        {constraint @kind="xslt-root-element" @target="stylesheet" @diagnostic="cem.xslt.root_not_stylesheet" @behavior="xslt-report-fact" @fact-kind="root-not-stylesheet" @policy="root element must be xsl:stylesheet or xsl:transform"}
        {constraint @kind="xslt-namespace-required" @target="stylesheet" @diagnostic="cem.xslt.namespace_missing" @behavior="xslt-report-fact" @fact-kind="namespace-missing" @policy="stylesheet and transform roots must use http://www.w3.org/1999/XSL/Transform"}
        {constraint @kind="version-required" @target="stylesheet" @diagnostic="cem.xslt.version_missing" @behavior="xslt-report-fact" @fact-kind="version-missing" @policy="xsl:stylesheet or xsl:transform version is required for version-pinned dispatch"}
        {constraint @kind="version-lexical-form" @target="stylesheet" @diagnostic="cem.xslt.version_malformed" @behavior="xslt-report-fact" @fact-kind="version-malformed" @policy="version must use major.minor decimal syntax"}
        {constraint @kind="version-supported" @target="stylesheet" @diagnostic="cem.xslt.unsupported_version" @behavior="xslt-report-fact" @fact-kind="unsupported-version" @policy="the native source lifecycle recognizes XSLT versions 1 through 3"}
        {constraint @kind="version-stable-namespace" @target="stylesheet" @policy="the XSLT namespace is not the version source; the version attribute resolves against the CEM adapter line"}
        {constraint @kind="bounded-compatibility-profile" @target="stylesheet" @policy="current executable support is the bounded legacy custom-element and XSLT parity profile, not a full XSLT 3 or 4 engine"}
        {constraint @kind="no-browser-xslt-engine" @target="stylesheet" @policy="do not delegate execution to browser XSLTProcessor"}
        {constraint @kind="xslt-attribute-value-default-grammar" @target="attribute-value" @value="literal" @policy="attribute values remain literal unless a more specific schema-owned grammar selector applies"}
        {constraint @kind="xslt-xpath-expression-attributes" @target="attribute-value" @value="xsl:*@select xsl:*@test xsl:*@use xsl:*@group-by xsl:*@group-adjacent xsl:number@value" @policy="whole XPath expression attributes delegate once to the XPath package with their native host attachment"}
        {constraint @kind="xslt-pattern-attributes" @target="attribute-value" @value="xsl:*@match xsl:*@count xsl:*@from xsl:*@group-starting-with xsl:*@group-ending-with" @policy="XSLT pattern attributes remain distinct from XPath expression ASTs until a package-owned pattern parser is registered"}
        {constraint @kind="xslt-avt-attributes" @target="attribute-value" @value="literal-result@*" @policy="non-XSLT attributes on literal result elements use the XSLT attribute value template grammar and require typed segmentation before embedded XPath fusion"}
        {constraint @kind="xslt-avt-unclosed-expression" @target="attribute-value-template" @diagnostic="cem.xslt.avt_unclosed_expression" @behavior="xslt-report-fact" @fact-kind="avt-unclosed-expression" @policy="W3C XSLT XTSE0350: an unescaped left brace in a fixed part must have a matching expression-closing right brace"}
        {constraint @kind="xslt-avt-unescaped-right-brace" @target="attribute-value-template" @diagnostic="cem.xslt.avt_unescaped_right_brace" @behavior="xslt-report-fact" @fact-kind="avt-unescaped-right-brace" @policy="W3C XSLT XTSE0370: a right brace in a fixed part must be escaped as a doubled right brace"}
        {constraint @kind="entrypoint-required" @target="template" @diagnostic="cem.xslt.entrypoint_missing" @behavior="xslt-report-fact" @fact-kind="entrypoint-missing" @policy="at least one top-level xsl:template is required"}
        {constraint @kind="external-uri-policy" @target="declaration" @diagnostic="cem.xslt.external_uri_rejected" @behavior="xslt-report-fact" @fact-kind="external-uri-rejected" @policy="include import document and result-document URI access require explicit resolver policy; local fragments and data URIs remain lexical references"}
        {constraint @kind="extension-policy" @target="instruction" @diagnostic="legacy_xslt.unsupported_construct" @behavior="xslt-report-fact" @fact-kind="unsupported-construct" @policy="extension functions and extension instructions require explicit capability support"}
        {constraint @kind="doctype-policy" @target="stylesheet-module" @diagnostic="cem.xslt.dtd_rejected" @behavior="xslt-report-fact" @fact-kind="dtd-rejected" @policy="preserve doctype lexemes but inherit XML rejection of DTD declarations until an explicit resolver policy enables them"}
        {constraint @kind="external-entity-policy" @target="stylesheet-module" @diagnostic="cem.xslt.external_entity_rejected" @behavior="xslt-report-fact" @fact-kind="external-entity-rejected" @policy="inherit XML rejection of non-built-in entity references"}
        {constraint @kind="entity-expansion-limit" @target="stylesheet-module" @diagnostic="cem.xslt.entity_expansion_limit" @behavior="xslt-report-fact" @fact-kind="entity-expansion-limit" @policy="inherit XML entity expansion safety limits"}
        {constraint @kind="source-map-preferred" @target="instruction" @diagnostic="cem.xslt.source_map_unavailable" @behavior="xslt-report-fact" @fact-kind="source-map-unavailable" @policy="source ranges and source maps are required when the XML parser exposes source identity"}
    }

    {diagnostics |
        {diagnostic @code="cem.xslt.parse_error" @severity="error"}
        {diagnostic @code="cem.xslt.not_well_formed_xml" @severity="error"}
        {diagnostic @code="cem.xslt.unsupported_encoding" @severity="error"}
        {diagnostic @code="cem.xslt.encoding_conflict" @severity="error"}
        {diagnostic @code="cem.xslt.unbound_namespace_prefix" @severity="error"}
        {diagnostic @code="cem.xslt.duplicate_attribute" @severity="error"}
        {diagnostic @code="cem.xslt.dtd_rejected" @severity="error"}
        {diagnostic @code="cem.xslt.external_entity_rejected" @severity="error"}
        {diagnostic @code="cem.xslt.entity_expansion_limit" @severity="error"}
        {diagnostic @code="cem.xslt.root_not_stylesheet" @severity="error"}
        {diagnostic @code="cem.xslt.namespace_missing" @severity="error"}
        {diagnostic @code="cem.xslt.version_missing" @severity="error"}
        {diagnostic @code="cem.xslt.version_malformed" @severity="error"}
        {diagnostic @code="cem.xslt.unsupported_version" @severity="error"}
        {diagnostic @code="legacy_xslt.unsupported_construct" @severity="warning"}
        {diagnostic @code="legacy_xslt.unsupported_function" @severity="warning"}
        {diagnostic @code="cem.xslt.external_uri_rejected" @severity="error"}
        {diagnostic @code="cem.xslt.entrypoint_missing" @severity="error"}
        {diagnostic @code="cem.xslt.browser_engine_rejected" @severity="fatal"}
        {diagnostic @code="cem.xslt.source_map_unavailable" @severity="info"}
        {diagnostic @code="cem.xslt.avt_unclosed_expression" @severity="error"}
        {diagnostic @code="cem.xslt.avt_unescaped_right_brace" @severity="error"}
    }

    {compatibility |
        {note @version="1.0.0" @value="IANA registers application/xslt+xml for XSLT stylesheet modules with optional charset parameter and .xsl/.xslt extensions. The registered type is appropriate for earlier and later XSLT versions."}
        {note @version="1.0.0" @value="text/xsl and custom-element-xslt markers are compatibility aliases only. They route copied custom-element templates through the CEM-owned bounded adapter and do not reintroduce browser-native XSLT execution."}
        {note @version="1.0.0" @value="The XSLT namespace http://www.w3.org/1999/XSL/Transform is version-stable across XSLT recommendations; requested XSLT version is read from the stylesheet version attribute."}
    }

    {open-content |
        {accept @kind="literal-result-element" @policy="delegate-to-target-schema"}
        {accept @kind="extension-instruction" @policy="reject-unless-capability-registered"}
        {accept @kind="xpath-expression" @policy="delegate-to-https://cem.dev/ns/query/xpath/1 with an XSLT host attachment and static namespace context"}
    }
}
