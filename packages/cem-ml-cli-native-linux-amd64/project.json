{
  "name": "cem_ml_cli_native_linux_amd64",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["cem_ml_cli"],
  "tags": ["scope:cem-ml", "type:deployment", "platform:linux", "arch:amd64"],
  "targets": {
    "compile": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/compile.mjs",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/deployment.json",
        "{projectRoot}/scripts/lib.mjs",
        "{projectRoot}/scripts/compile.mjs",
        "{workspaceRoot}/.cargo/config.toml",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
        "{workspaceRoot}/packages/cem_ml/Cargo.toml",
        "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
        "{workspaceRoot}/packages/cem_ml_cli/examples/native-capability-emit.rs",
        "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml",
        "{workspaceRoot}/packages/cem_ml_transform_cem_ql/src/**/*.rs",
        "{workspaceRoot}/packages/cem_ml_transform_cem_ql/Cargo.toml",
        "{workspaceRoot}/packages/cem_ql/src/**/*.rs",
        "{workspaceRoot}/packages/cem_ql/Cargo.toml",
        { "runtime": "rustc --version --verbose" },
        { "runtime": "cargo --version" }
      ],
      "outputs": ["{workspaceRoot}/dist/packages/cem-ml-cli-native-linux-amd64/compiled"]
    },
    "build": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "options": {
        "command": "node scripts/build.mjs",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/deployment.json",
        "{projectRoot}/scripts/lib.mjs",
        "{projectRoot}/scripts/build.mjs",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": false
        },
        { "runtime": "git rev-parse HEAD" },
        { "env": "SOURCE_DATE_EPOCH" }
      ],
      "outputs": ["{workspaceRoot}/dist/packages/cem-ml-cli-native-linux-amd64/build"]
    },
    "package": {
      "cache": true,
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/package.mjs",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/deployment.json",
        "{projectRoot}/README.md",
        "{projectRoot}/scripts/lib.mjs",
        "{projectRoot}/scripts/package.mjs",
        "{workspaceRoot}/LICENSE",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": false
        },
        { "runtime": "git rev-parse HEAD" },
        { "env": "SOURCE_DATE_EPOCH" }
      ],
      "outputs": ["{workspaceRoot}/dist/packages/cem-ml-cli-native-linux-amd64/artifacts"]
    },
    "sign": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["package"],
      "options": {
        "command": "node scripts/sign.mjs",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/packages/cem-ml-cli-native-linux-amd64/artifacts"]
    },
    "verify": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["sign"],
      "options": {
        "command": "node scripts/verify.mjs",
        "cwd": "{projectRoot}"
      },
      "outputs": []
    },
    "verify:release": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["sign"],
      "options": {
        "command": "node tools/scripts/cem-ml-platform-release.mjs verify-unit native-linux-amd64",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
        { "dependentTasksOutputFiles": "**/*", "transitive": false },
        { "runtime": "git rev-parse HEAD" }
      ],
      "outputs": []
    },
    "record:producer-evidence": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/cem-ml-platform-release.mjs record-producer-evidence native-linux-amd64",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
        "{workspaceRoot}/dist/packages/cem-ml-cli-native-linux-amd64/artifacts/**/*",
        { "runtime": "git rev-parse HEAD" },
        { "env": "CEM_ML_ARTIFACT_ATTESTATION_ID" },
        { "env": "CEM_ML_ARTIFACT_ATTESTATION_URL" },
        { "env": "GITHUB_RUN_ID" },
        { "env": "GITHUB_RUN_ATTEMPT" }
      ],
      "outputs": ["{workspaceRoot}/dist/packages/cem-ml-cli-native-linux-amd64/artifacts"]
    },
    "verify:producer-evidence": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/cem-ml-platform-release.mjs finalize-producer-evidence native-linux-amd64",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
        "{workspaceRoot}/dist/packages/cem-ml-cli-native-linux-amd64/artifacts/**/*",
        { "runtime": "git rev-parse HEAD" },
        { "env": "CEM_ML_PRODUCER_EVIDENCE_ATTESTATION_BUNDLE" }
      ],
      "outputs": ["{workspaceRoot}/dist/packages/cem-ml-cli-native-linux-amd64/artifacts"]
    },
    "preflight:release": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/cem-ml-platform-release.mjs preflight-native-host native-linux-amd64",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
        "{workspaceRoot}/packages/cem_ml/Cargo.toml",
        "{workspaceRoot}/packages/cem-ml-cli-native-linux-amd64/deployment.json",
        { "runtime": "git rev-parse HEAD" },
        { "env": "CEM_ML_RELEASE_TAG" }
      ],
      "outputs": []
    },
    "publish": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["preflight:release", "verify"],
      "options": {
        "command": "node scripts/publish.mjs",
        "cwd": "{projectRoot}"
      },
      "outputs": []
    },
    "smoke:install": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["verify"],
      "options": {
        "command": "node scripts/smoke.mjs install",
        "cwd": "{projectRoot}"
      },
      "inputs": ["{projectRoot}/scripts/smoke.mjs", "{projectRoot}/tests/smoke-input.cem"],
      "outputs": []
    },
    "smoke:upgrade": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["verify"],
      "options": {
        "command": "node scripts/smoke.mjs upgrade",
        "cwd": "{projectRoot}"
      },
      "inputs": ["{projectRoot}/scripts/smoke.mjs", "{projectRoot}/tests/smoke-input.cem"],
      "outputs": []
    },
    "smoke:uninstall": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["verify"],
      "options": {
        "command": "node scripts/smoke.mjs uninstall",
        "cwd": "{projectRoot}"
      },
      "inputs": ["{projectRoot}/scripts/smoke.mjs", "{projectRoot}/tests/smoke-input.cem"],
      "outputs": []
    },
    "smoke:release": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["verify", "verify:release"],
      "options": {
        "commands": [
          "node scripts/smoke.mjs install",
          "node scripts/smoke.mjs upgrade",
          "node scripts/smoke.mjs uninstall"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      },
      "inputs": ["{projectRoot}/scripts/smoke.mjs", "{projectRoot}/tests/smoke-input.cem"],
      "outputs": []
    }
  }
}
