{
    "name": "@epa-wg/cem-theme",
    "version": "0.1.1",
    "author": {
        "name": "Sasha Firsov",
        "email": "sasha@firsov.net"
    },
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/EPA-WG/cem.git",
        "directory": "packages/cem-theme"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "@epa-wg/cem": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./styles.css": "./dist/lib/css/cem-combined.css",
        "./tokens/cem.tokens.json": "./dist/lib/tokens/cem.tokens.json",
        "./tokens/cem.tokens.catalog.json": "./dist/lib/tokens/cem.tokens.catalog.json",
        "./tokens/cem.voice.tokens.json": "./dist/lib/tokens/cem.voice.tokens.json",
        "./tokens/cem.tokens.report.json": "./dist/lib/tokens/cem.tokens.report.json",
        "./tokens/cem.tokens.ts": "./dist/lib/tokens/cem.tokens.ts",
        "./tokens/figma/*": "./dist/lib/tokens/figma/*"
    },
    "files": [
        "dist",
        "!**/*.tsbuildinfo"
    ],
    "scripts": {
        "build:docs": "../../dist/target/cem_ml_cli/debug/cem-ml transform --config src/docs.cem --quiet",
        "build:html": "node ../../tools/scripts/compile-html.mjs",
        "build:css": "node ../../tools/scripts/compile-html.mjs && node ../../tools/scripts/capture-xpath-text.mjs \"dist/lib/css-generators/cem-*.html\" \"//code[@data-generated-css]\" \"dist/lib/css/*.css\" && node scripts/generate-token-coverage.mjs && ../../dist/target/cem_ml_cli/debug/cem-ml transform --config docs/generated-token-coverage.cem --quiet && node scripts/generate-css-index.mjs",
        "build:tokens": "node scripts/export-tokens.mjs"
    },
    "devDependencies": {
        "glob": "13.0.6",
        "playwright": "1.60.0",
        "postcss": "8.5.12"
    },
    "publishConfig": {
        "access": "public"
    }
}
