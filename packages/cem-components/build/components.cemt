{module |{template @name=copy |{param @name=node}{body |{cem:choose |{cem:when @test='node.kind == "element"' |{cem:element @name="{$node.name}" @namespace="{$node.namespace}" |{cem:for-each @select="node.attributes" @as=attr |{cem:if @test='attr.namespace != "http://www.w3.org/2000/xmlns/"' |{cem:attribute @name='{if attr.namespace == "http://www.w3.org/XML/1998/namespace" { "xml:" + attr.name } else { attr.name }}'  @value="{$attr.value}"}}}{cem:for-each @select="node.children" @as=child |{call @template=copy @with:node="{child}"}}}}{cem:otherwise | {$node.value}}}}}{body |{html @xmlns="http://www.w3.org/1999/xhtml" |{head | {title | CEM component declarations}}{cem:element @name=body |{cem:for-each @select="input.items" @as=item |{cem:for-each @select="item.primary.children" @as=declaration |{cem:if @test='declaration.kind == "element"' |{section @xml:base="../src/components/{$item.bindings.stem}/{$item.bindings.file}" |{call @template=copy @with:node="{declaration}"}}}}}}}}}
