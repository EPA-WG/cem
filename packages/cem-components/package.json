{
    "name": "@epa-wg/cem-components",
    "version": "0.1.1",
    "author": {
        "name": "Sasha Firsov",
        "email": "sasha@firsov.net"
    },
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/EPA-WG/cem.git",
        "directory": "packages/cem-components"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "@epa-wg/cem": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./components/*": "./src/components/*/*.xhtml",
        "./styles.css": "./dist/styles.css",
        "./catalog/cem.components.catalog.json": "./dist/catalog/cem.components.catalog.json",
        "./playgrounds/cem-action.html": "./dist/cem-action.html",
        "./playgrounds/cem-action-gallery.html": "./dist/cem-action-gallery.html",
        "./playgrounds/cem-theme-switch.html": "./dist/cem-theme-switch.html",
        "./playgrounds/cem-select.html": "./dist/cem-select.html",
        "./components.xhtml": "./dist/components.xhtml",
        "./playgrounds/cem-bundle.html": "./dist/cem-bundle.html",
        "./playgrounds/cem-icon-button.html": "./dist/cem-icon-button.html",
        "./playgrounds/cem-menu-item.html": "./dist/cem-menu-item.html",
        "./playgrounds/cem-field.html": "./dist/cem-field.html",
        "./playgrounds/cem-text-field.html": "./dist/cem-text-field.html",
        "./playgrounds/cem-select-gallery.html": "./dist/cem-select-gallery.html",
        "./playgrounds/cem-theme-switch-gallery.html": "./dist/cem-theme-switch-gallery.html",
        "./playgrounds/cem-icon-button-gallery.html": "./dist/cem-icon-button-gallery.html",
        "./playgrounds/cem-menu-item-gallery.html": "./dist/cem-menu-item-gallery.html",
        "./playgrounds/cem-field-gallery.html": "./dist/cem-field-gallery.html",
        "./playgrounds/cem-text-field-gallery.html": "./dist/cem-text-field-gallery.html",
        "./playgrounds/cem-icon.html": "./dist/cem-icon.html",
        "./playgrounds/cem-icon-gallery.html": "./dist/cem-icon-gallery.html"
    },
    "files": [
        "dist",
        "src/components/**/*.xhtml",
        "!**/*.tsbuildinfo",
        "playgrounds",
        "demo.css",
        "build"
    ],
    "dependencies": {
        "@epa-wg/cem-demo-element": "^0.1.1",
        "@epa-wg/cem-elements": "^0.1.1",
        "@epa-wg/cem-theme": "^0.1.1"
    },
    "publishConfig": {
        "access": "public"
    }
}
