                "{workspaceRoot}/docs/component-mvp.md",
                "{workspaceRoot}/docs/figma-ui-kit-plan.md",
                "{workspaceRoot}/examples/figma/component-library.json",
                "{workspaceRoot}/examples/figma/component-library-fixture.md",
                "{projectRoot}/docs/**/*.md",
                "{projectRoot}/declarative-migration.json",
                "{projectRoot}/src/components/**/*",
                "{projectRoot}/tests/state-matrix-coverage.json"
            ],
            "outputs": [
                "{projectRoot}/dist/reports/figma-component-library.{json,md}"
            ]
        },
