                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-components-workflows.mjs",
                "{workspaceRoot}/docs/component-mvp.md",
                "{projectRoot}/examples/**/*.html",
                "{projectRoot}/examples/README.md",
                "{projectRoot}/tests/workflows/**/*.html"
            ],
            "outputs": []
        },
        "verify-state-matrix": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/verify-cem-components-state-matrix.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-components-state-matrix.mjs",
                "{workspaceRoot}/docs/component-mvp.md",
                "{projectRoot}/tests/state-matrix-coverage.json",
                "{projectRoot}/src/lib/**/*.browser.spec.ts",
                "{projectRoot}/tests/workflows/**/*.html"
            ],
            "outputs": ["{projectRoot}/dist/reports/component-state-matrix.{json,md}"]
        },
        "verify-package": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "options": {
                "command": "node scripts/verify-package.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{projectRoot}/scripts/verify-package.mjs",
                "{projectRoot}/package.json",
                "{projectRoot}/src/index.ts",
                "{projectRoot}/src/lib/cem-components.ts",
                "{projectRoot}/src/lib/primitives.ts",
                {
                    "dependentTasksOutputFiles": "**/*.{js,css,json}",
                    "transitive": false
                }
            ],
            "outputs": []
        },
        "verify-phase3-harness": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                "lint",
                "typecheck",
                "test-ci--src/lib/testing/component-harness.browser.spec.ts"
            ],
            "options": {
                "command": "echo \"Phase 3 component harness green: real CEM-ML substrate rendering/re-rendering, events, native forms, accessibility, deterministic Chromium visual baseline, and screenshot capture passed.\"",
                "cwd": "{workspaceRoot}"
            },
            "outputs": []
        },
        "verify": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "verify-primitives",
                "verify-figma-inventory",
                "verify-material-parity",
                "verify-style-contract",
                "verify-input-indicator-forced-colors",
                "verify-autocomplete-forced-colors",
                "verify-navigation-hover-forced-colors",
                "verify-content-hover-forced-colors",
