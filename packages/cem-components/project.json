{
    "name": "@epa-wg/cem-components",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/cem-components/src",
    "projectType": "library",
    "targets": {
        "build": {
            "dependsOn": ["^build", "build:styles"]
        },
        "build:styles": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/copy-styles.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": ["{projectRoot}/scripts/copy-styles.mjs", "{projectRoot}/src/styles.css"],
            "outputs": ["{projectRoot}/dist/styles.css"]
        },
        "verify-primitives": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/verify-cem-components-primitives.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-components-primitives.mjs",
                "{workspaceRoot}/docs/component-mvp.md",
                "{projectRoot}/src/lib/primitives.ts"
            ],
            "outputs": []
        },
        "verify-style-contract": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                { "projects": ["@epa-wg/cem-theme"], "target": "build:tokens" },
                { "projects": ["@epa-wg/cem-theme"], "target": "verify-package" }
            ],
            "options": {
                "command": "node tools/scripts/verify-cem-components-styles.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-components-styles.mjs",
                "{workspaceRoot}/docs/component-mvp.md",
                "{projectRoot}/package.json",
                "{projectRoot}/src/lib/primitives.ts",
                "{projectRoot}/examples/**/*.html",
                "{projectRoot}/tests/workflows/**/*.html",
                "{projectRoot}/**/*.css",
                "{projectRoot}/**/*.scss",
                "{projectRoot}/**/*.less",
                "{workspaceRoot}/packages/cem-theme/package.json",
                "{workspaceRoot}/packages/cem-theme/dist/lib/tokens/cem.tokens.json",
                "{workspaceRoot}/packages/cem-theme/dist/lib/css/cem-combined.css"
            ],
            "outputs": []
        },
        "verify-input-indicator-forced-colors": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                { "projects": ["@epa-wg/cem-theme"], "target": "build:tokens" }
            ],
            "options": {
                "command": "node scripts/verify-input-indicator-forced-colors.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{projectRoot}/scripts/verify-input-indicator-forced-colors.mjs",
                "{projectRoot}/src/styles.css",
                {
                    "dependentTasksOutputFiles": "**/*.css",
                    "transitive": false
                }
            ],
            "outputs": []
        },
        "verify-workflows": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/verify-cem-components-workflows.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-components-workflows.mjs",
                "{workspaceRoot}/docs/component-mvp.md",
                "{projectRoot}/examples/**/*.html",
                "{projectRoot}/examples/README.md",
                "{projectRoot}/tests/workflows/**/*.html"
            ],
            "outputs": []
        },
        "verify-state-matrix": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/verify-cem-components-state-matrix.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-components-state-matrix.mjs",
                "{workspaceRoot}/docs/component-mvp.md",
                "{projectRoot}/tests/state-matrix-coverage.json",
                "{projectRoot}/src/lib/**/*.browser.spec.ts",
                "{projectRoot}/tests/workflows/**/*.html"
            ],
            "outputs": ["{projectRoot}/dist/reports/component-state-matrix.{json,md}"]
        },
        "verify-package": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "options": {
                "command": "node scripts/verify-package.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{projectRoot}/scripts/verify-package.mjs",
                "{projectRoot}/package.json",
                "{projectRoot}/src/index.ts",
                "{projectRoot}/src/lib/cem-components.ts",
                {
                    "dependentTasksOutputFiles": "**/*.{js,css}",
                    "transitive": false
                }
            ],
            "outputs": []
        },
        "verify": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "verify-primitives",
                "verify-style-contract",
                "verify-input-indicator-forced-colors",
                "verify-workflows",
                "verify-state-matrix",
                "verify-package",
                "test"
            ],
            "options": {
                "command": "echo \"cem-components verification gate green: primitive manifest + state matrix + style contract + workflow examples + browser harness tests passed.\"",
                "cwd": "{workspaceRoot}"
            },
            "outputs": []
        }
    }
}
