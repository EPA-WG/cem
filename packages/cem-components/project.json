                "{projectRoot}/src/components/**/*.xhtml",
                "{projectRoot}/package.json",
                "{workspaceRoot}/tools/scripts/verify-cem-component-playgrounds.mjs",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": true
                }
            ],
            "outputs": []
        },
        "verify-playgrounds": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                "build"
            ],
            "options": {
                "command": "node ../../tools/scripts/verify-cem-component-playgrounds.mjs",
                "cwd": "{projectRoot}"
            },
