{
    "name": "@epa-wg/cem-components",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/cem-components/src",
    "projectType": "library",
    "targets": {
        "build": {
            "dependsOn": ["^build", "build:styles", "build:catalog"]
        },
        "test": {
            "dependsOn": ["^build", "verify-phase3-harness"],
            "options": {
                "command": "vitest --no-file-parallelism"
            }
        },
        "build:styles": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/copy-styles.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": ["{projectRoot}/scripts/copy-styles.mjs", "{projectRoot}/src/styles.css"],
            "outputs": ["{projectRoot}/dist/styles.css"]
        },
        "build:catalog": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["verify-primitives", "verify-state-matrix"],
            "options": {
                "command": "node scripts/build-component-catalog.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{projectRoot}/scripts/build-component-catalog.mjs",
                "{projectRoot}/package.json",
                "{projectRoot}/src/lib/primitives.ts",
                "{projectRoot}/docs/component-reference.md",
                "{projectRoot}/docs/conventions.md",
                "{projectRoot}/docs/accessibility.md",
                "{projectRoot}/examples/README.md",
                "{projectRoot}/examples/*.html",
                "{workspaceRoot}/docs/component-mvp.md",
                "{workspaceRoot}/packages/cem-elements/project.json",
                {
                    "dependentTasksOutputFiles": "**/component-state-matrix.json",
                    "transitive": false
                }
            ],
            "outputs": ["{projectRoot}/dist/catalog/cem.components.catalog.json"]
        },
        "verify-primitives": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/verify-cem-components-primitives.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-components-primitives.mjs",
                "{workspaceRoot}/docs/component-mvp.md",
                "{projectRoot}/src/lib/primitives.ts"
            ],
            "outputs": []
        },
        "verify-figma-inventory": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [{ "projects": ["@epa-wg/cem-theme"], "target": "test:figma" }],
            "options": {
                "command": "node tools/scripts/verify-cem-components-figma-inventory.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-components-figma-inventory.mjs",
                "{workspaceRoot}/docs/component-mvp.md",
                "{workspaceRoot}/docs/figma-ui-kit-plan.md",
                "{workspaceRoot}/examples/figma/component-library.json",
                "{workspaceRoot}/examples/figma/component-library-fixture.md",
                "{projectRoot}/docs/**/*.md",
                "{projectRoot}/src/lib/primitives.ts",
                "{projectRoot}/tests/state-matrix-coverage.json"
            ],
            "outputs": ["{projectRoot}/dist/reports/figma-component-library.{json,md}"]
        },
        "verify-material-parity": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/verify-cem-components-material-parity.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-components-material-parity.mjs",
                "{projectRoot}/tests/angular-material-parity.json",
                "{projectRoot}/src/lib/primitives.ts"
            ],
            "outputs": []
        },
        "verify-style-contract": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                { "projects": ["@epa-wg/cem-theme"], "target": "build:tokens" },
                { "projects": ["@epa-wg/cem-theme"], "target": "verify-package" }
            ],
            "options": {
                "command": "node tools/scripts/verify-cem-components-styles.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-components-styles.mjs",
                "{workspaceRoot}/docs/component-mvp.md",
                "{projectRoot}/package.json",
                "{projectRoot}/src/lib/primitives.ts",
                "{projectRoot}/examples/**/*.html",
                "{projectRoot}/tests/workflows/**/*.html",
                "{projectRoot}/**/*.css",
                "{projectRoot}/**/*.scss",
                "{projectRoot}/**/*.less",
                "{workspaceRoot}/packages/cem-theme/package.json",
                "{workspaceRoot}/packages/cem-theme/dist/lib/tokens/cem.tokens.json",
                "{workspaceRoot}/packages/cem-theme/dist/lib/css/cem-combined.css"
            ],
            "outputs": []
        },
        "verify-input-indicator-forced-colors": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                { "projects": ["@epa-wg/cem-theme"], "target": "build:tokens" }
            ],
            "options": {
                "command": "node scripts/verify-input-indicator-forced-colors.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{projectRoot}/scripts/verify-input-indicator-forced-colors.mjs",
                "{projectRoot}/src/styles.css",
                {
                    "dependentTasksOutputFiles": "**/*.css",
                    "transitive": false
                }
            ],
            "outputs": []
        },
        "verify-autocomplete-forced-colors": {
