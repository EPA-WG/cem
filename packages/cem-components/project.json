                "{workspaceRoot}/tools/scripts/verify-cem-component-playgrounds.mjs",
                "{projectRoot}/package.json",
                "{projectRoot}/src/components/**/*.xhtml",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": true
                }
            ],
            "outputs": []
        },
        "build": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "^build",
                "build:styles",
                "build:catalog",
                "build:playgrounds",
                "build:bundle"
            ],
            "options": {
                "cwd": "",
                "command": "node tools/scripts/clean-cem-components-runtime.mjs"
            },
            "inputs": [
                "{projectRoot}/package.json",
                "{projectRoot}/src/components/**/*.xhtml",
                "{workspaceRoot}/tools/scripts/clean-cem-components-runtime.mjs",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": true
                }
            ]
        },
        "test": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "verify-declarative",
                "build"
            ],
            "options": {
                "cwd": "",
                "command": "yarn nx run cem-elements:test packages/cem-components/src/components"
            }
        },
        "build:styles": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node ../../tools/cem-components/copy-styles.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/cem-components/copy-styles.mjs",
                "{projectRoot}/src/styles.css"
            ],
            "outputs": [
                "{projectRoot}/dist/styles.css"
            ],
            "dependsOn": [
                "verify-declarative"
            ]
        },
        "build:catalog": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                "verify-declarative",
                "verify-state-matrix"
            ],
            "options": {
                "command": "node ../../tools/cem-components/build-component-catalog.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/cem-components/build-component-catalog.mjs",
                "{projectRoot}/package.json",
                "{projectRoot}/declarative-migration.json",
                "{projectRoot}/src/components/**/*",
                "{projectRoot}/docs/component-reference.md",
                "{projectRoot}/docs/conventions.md",
                "{projectRoot}/docs/accessibility.md",
                "{projectRoot}/examples/README.md",
                "{projectRoot}/examples/*.html",
                "{workspaceRoot}/docs/component-mvp.md",
                "{workspaceRoot}/packages/cem-elements/project.json",
                {
                    "dependentTasksOutputFiles": "**/component-state-matrix.json",
                    "transitive": false
                }
            ],
            "outputs": [
                "{projectRoot}/dist/catalog/cem.components.catalog.json"
            ]
        },
        "verify-declarative": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/verify-cem-components-declarative.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-components-declarative.mjs",
                "{workspaceRoot}/docs/declarative-ui-principle.md",
                "{workspaceRoot}/docs/component-mvp.md",
                "{projectRoot}/declarative-migration.json",
                "{projectRoot}/src/components/**/*",
                "{workspaceRoot}/packages/cem-elements/.storybook/main.ts",
                "{workspaceRoot}/packages/cem-elements/.storybook/preview.ts",
                "{projectRoot}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"
            ],
            "outputs": []
        },
        "verify-figma-inventory": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "@epa-wg/cem-theme"
                    ],
                    "target": "test:figma"
