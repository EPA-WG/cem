        "verify-demo-imports": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": [
                "build:playgrounds",
                "build:bundle",
                { "projects": ["cem-elements", "@epa-wg/cem-demo-element"], "target": "build" },
                { "projects": ["@epa-wg/cem-theme"], "target": "build:css" }
            ],
            "options": {
                "command": "node tools/scripts/verify-cem-demo-imports.mjs",
                "cwd": "{workspaceRoot}"
            }
        },
        "build:bundle": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                "verify-declarative",
                {
                    "projects": [
                        "cem_ml_cli"
                    ],
                    "target": "build"
                }
            ],
            "options": {
                "cwd": "packages/cem-components",
                "command": "../../dist/target/cem_ml_cli/debug/cem-ml transform --config build/components.transform.cem"
            },
            "inputs": [
                "{projectRoot}/build/**/*",
                "{projectRoot}/src/components/**/*.xhtml"
            ],
            "outputs": [
                "{projectRoot}/dist/components.xhtml",
                "{projectRoot}/dist/components.xhtml.map"
            ]
        },
