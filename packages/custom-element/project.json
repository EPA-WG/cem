{
    "name": "@epa-wg/custom-element",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/custom-element",
    "projectType": "library",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "dependsOn": [
                { "projects": ["cem-elements"], "target": "build" },
                { "projects": ["cem_ql"], "target": "build:wasm" },
                { "projects": ["cem_ml_cli"], "target": "build" }
            ],
            "options": {
                "commands": [
                    "node scripts/build-package.mjs",
                    "../../dist/target/cem_ml_cli/debug/cem-ml transform --config material/importmap.transform.cem"
                ],
                "parallel": false,
                "cwd": "packages/custom-element"
            },
            "cache": true,
            "inputs": [
                "{projectRoot}/bin/**/*",
                "{projectRoot}/demo/**/*",
                "{projectRoot}/docs/**/*",
                "{projectRoot}/ide/**/*",
                "{projectRoot}/material/**/*",
                "{projectRoot}/*.js",
                "{projectRoot}/*.d.ts",
                "{projectRoot}/*.html",
                "{projectRoot}/*.md",
                "{projectRoot}/LICENSE",
                "{projectRoot}/package.json",
                "{projectRoot}/package-archive.json",
                "{projectRoot}/scripts/build-package.mjs",
                "{workspaceRoot}/packages/cem-elements/src/**/*",
                "{workspaceRoot}/packages/cem-elements/package.json",
                "{workspaceRoot}/packages/cem-elements/tsconfig.lib.json",
                "{workspaceRoot}/packages/cem-elements/dist/**/*",
                "{workspaceRoot}/packages/cem_ql/src/**/*",
                "{workspaceRoot}/packages/cem_ql/Cargo.toml",
                "{workspaceRoot}/packages/cem_ql/dist/wasm/**/*"
            ],
            "outputs": ["{projectRoot}/dist"]
        },
        "test": {
            "dependsOn": [
                "verify-reference-corpus",
                "verify-packed-archive",
                "build",
                { "projects": ["@epa-wg/cem-theme"], "target": "build:html" }
            ],
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "node scripts/inventory-xslt-compat.mjs",
                    "node scripts/verify-package-baseline.mjs",
                    "node scripts/verify-theme-vendor-runtime.mjs",
                    "node scripts/verify-browser-fixtures.mjs"
                ],
                "parallel": false,
                "cwd": "packages/custom-element"
            },
            "cache": true,
            "inputs": [
                "{projectRoot}/dist/**/*",
                "{projectRoot}/scripts/inventory-xslt-compat.mjs",
                "{projectRoot}/scripts/verify-package-baseline.mjs",
                "{projectRoot}/scripts/verify-theme-vendor-runtime.mjs",
                "{projectRoot}/scripts/verify-browser-fixtures.mjs",
                "{workspaceRoot}/packages/cem-theme/dist/**/*.html",
                "{workspaceRoot}/packages/cem-theme/dist/vendor/@epa-wg/custom-element/*.js",
                "{projectRoot}/test-fixtures/**/*.json",
                "{projectRoot}/test-fixtures/**/*",
                "{projectRoot}/demo/**/*",
                "{projectRoot}/material/**/*",
                "{projectRoot}/package.json"
            ],
            "outputs": [
                "{projectRoot}/dist/reports/xslt-compat-inventory.json",
                "{projectRoot}/dist/reports/xslt-compat-inventory.md"
            ]
        },
        "verify-reference-corpus": {
            "executor": "nx:run-commands",
            "cache": true,
            "options": {
                "command": "node scripts/verify-external-reference-corpus.mjs",
                "cwd": "packages/custom-element"
            },
            "inputs": [
                "{projectRoot}/scripts/verify-external-reference-corpus.mjs",
                "{projectRoot}/test-fixtures/external-reference-corpus.json",
                "{projectRoot}/project.json",
                "{projectRoot}/custom-element.js",
                "{projectRoot}/test-fixtures/browser-smoke.js",
                "{workspaceRoot}/packages/cem-elements/project.json",
                "{workspaceRoot}/packages/cem-elements/src/lib/cem-elements.stories.ts",
                "{workspaceRoot}/packages/cem-elements/src/lib/legacy-xslt-parity.stories.ts",
                "{workspaceRoot}/packages/cem-elements/src/lib/material-parity.stories.ts",
                "{workspaceRoot}/packages/cem-elements/src/lib/processing-boundary.spec.ts",
                "{workspaceRoot}/docs/custom-element-phase3.6-inventory.md",
                "{workspaceRoot}/docs/custom-element-history-import-plan.md"
            ],
            "outputs": []
        },
        "verify-packed-archive": {
            "dependsOn": ["build"],
            "executor": "nx:run-commands",
            "cache": true,
            "options": {
                "command": "node scripts/verify-packed-archive.mjs",
                "cwd": "packages/custom-element"
            },
            "inputs": [
                "{projectRoot}/dist/**/*",
                "{projectRoot}/package.json",
                "{projectRoot}/package-archive.json",
                "{projectRoot}/scripts/verify-packed-archive.mjs",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/yarn.lock"
            ],
            "outputs": []
        },
        "xslt:inventory": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/inventory-xslt-compat.mjs",
                "cwd": "packages/custom-element"
            },
            "cache": true,
            "inputs": [
                "{projectRoot}/scripts/inventory-xslt-compat.mjs",
                "{projectRoot}/demo/**/*",
                "{projectRoot}/material/**/*"
            ],
            "outputs": [
                "{projectRoot}/dist/reports/xslt-compat-inventory.json",
                "{projectRoot}/dist/reports/xslt-compat-inventory.md"
            ]
        },
        "verify-history": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "node scripts/verify-history-provenance.mjs",
                "cwd": "packages/custom-element"
            },
            "outputs": []
        },
        "lint": {
            "dependsOn": ["test"],
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/verify-package-baseline.mjs",
                "cwd": "packages/custom-element"
            },
            "outputs": []
        },
        "nx-release-publish": {
            "executor": "@nx/js:release-publish",
            "options": {
                "packageRoot": "packages/custom-element/dist"
            }
        },
        "verify": {
            "dependsOn": ["build", "test", "lint", "verify-history", "verify-packed-archive"],
            "executor": "nx:run-commands",
            "options": {
                "command": "echo \"custom-element package scaffold verified.\"",
                "cwd": "{workspaceRoot}"
            },
            "outputs": []
        }
    },
    "release": {
        "version": {
            "manifestRootsToUpdate": ["packages/custom-element/dist"]
        }
    }
}
