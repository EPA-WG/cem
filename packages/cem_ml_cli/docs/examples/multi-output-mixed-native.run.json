{
  "resolvers": [
    {
      "uriPrefix": "cem+repo://",
      "localRoot": ".",
      "read": true,
      "write": true
    }
  ],
  "inputs": [
    {
      "uri": "cem+repo://packages/cem_ml_cli/docs/examples/native-output-cem.input.cem",
      "rootScope": {
        "defaultContentType": "application/cem",
        "schema": "https://cem.dev/ns/cem-ml/1"
      }
    },
    {
      "uri": "cem+repo://packages/cem_ml_cli/docs/examples/native-output-yaml.input.json",
      "rootScope": {
        "defaultContentType": "application/json",
        "schema": "https://cem.dev/ns/data/json/1"
      }
    }
  ],
  "outputs": [
    {
      "inputRef": "cem+repo://packages/cem_ml_cli/docs/examples/native-output-cem.input.cem",
      "destination": "cem+repo://packages/cem_ml_cli/dist/multi-output-mixed-native.cem",
      "rootScope": {
        "defaultContentType": "application/cem",
        "schema": "https://cem.dev/ns/cem-ml/1"
      }
    },
    {
      "inputRef": "cem+repo://packages/cem_ml_cli/docs/examples/native-output-yaml.input.json",
      "destination": "cem+repo://packages/cem_ml_cli/dist/multi-output-mixed-native.yml",
      "rootScope": {
        "defaultContentType": "application/yaml",
        "schema": "https://cem.dev/ns/data/yaml/1"
      }
    }
  ]
}
