{
  "resolvers": [
    {
      "uriPrefix": "cem+repo://",
      "localRoot": ".",
      "read": true,
      "write": true
    }
  ],
  "inputs": [
    {
      "uri": "cem+repo://packages/cem_ml_cli/docs/examples/cemt-output-pipeline.input.cem",
      "rootScope": {
        "defaultContentType": "application/cem",
        "schema": "https://cem.dev/ns/cem-ml/1"
      }
    }
  ],
  "outputs": [
    {
      "inputRef": "cem+repo://packages/cem_ml_cli/docs/examples/cemt-output-pipeline.input.cem",
      "destination": "cem+repo://packages/cem_ml_cli/dist/cemt-output-pipeline.html",
      "rootScope": {
        "defaultContentType": "text/html",
        "schema": "https://cem.dev/ns/html/1",
        "cemtFormatter": "acme.showcase.format-tree",
        "cemtFormatterProfile": "acme.showcase.format-tree",
        "cemtColorizer": "acme.showcase.color-tree",
        "cemtColorProfile": "classes"
      }
    }
  ]
}
