                    "cargo run --package cem-ml-cli --target-dir dist/target/cem_ml_cli -- convert --config packages/cem_ml_cli/docs/examples/native-output-yaml.run.json --artifact-json packages/cem_ml_cli/dist/native-output-yaml.artifact.json",
