                    "cargo run --package cem-ml-cli --target-dir dist/target/cem_ml_cli -- fixture cemt-pipeline --package-artifacts --out packages/cem_ml_cli/dist/cemt-output-pipeline.package-artifacts.fixture.cem",
                    "cargo run --package cem-ml-cli --target-dir dist/target/cem_ml_cli -- convert --config packages/cem_ml_cli/docs/examples/cemt-output-pipeline.run.json --artifact-json packages/cem_ml_cli/dist/cemt-output-pipeline.artifact.json --report packages/cem_ml_cli/dist/cemt-output-pipeline.report.cem --report-json packages/cem_ml_cli/dist/cemt-output-pipeline.report.json",
