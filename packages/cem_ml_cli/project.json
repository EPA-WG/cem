                    "node tools/scripts/verify-cli-error.mjs packages/cem_ml_cli/docs/examples/multi-output-global-out.error.expected.json -- cargo run --package cem-ml-cli --target-dir dist/target/cem_ml_cli --",
                    "node tools/scripts/verify-cli-error.mjs packages/cem_ml_cli/docs/examples/multi-output-artifact-json.error.expected.json -- cargo run --package cem-ml-cli --target-dir dist/target/cem_ml_cli --",
