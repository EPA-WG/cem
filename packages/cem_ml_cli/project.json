                    "diff -u packages/cem_ml_cli/docs/examples/cemt-output-pipeline.report.expected.cem packages/cem_ml_cli/dist/cemt-output-pipeline.report.cem",
                    "node tools/scripts/verify-json-output.mjs packages/cem_ml_cli/docs/examples/cemt-output-pipeline.report.expected.json packages/cem_ml_cli/dist/cemt-output-pipeline.report.json",
                    "cargo run --package cem-ml-cli --target-dir dist/target/cem_ml_cli -- convert --config packages/cem_ml_cli/docs/examples/native-output-cem.run.json --artifact-json packages/cem_ml_cli/dist/native-output-cem.artifact.json",
