{
    "name": "cem_ql",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ql/src",
    "namedInputs": {
        "rustDependencies": [
            "{workspaceRoot}/vendor/url/Cargo.toml",
            "{workspaceRoot}/vendor/url/src/**/*.rs",
            "{workspaceRoot}/Cargo.toml",
            "{workspaceRoot}/Cargo.lock",
            "{workspaceRoot}/rust-toolchain.toml",
            "{workspaceRoot}/packages/cem_ml/src/**/*",
            "{workspaceRoot}/packages/cem_ml/grammar/tree-sitter-cem/**/*",
            "{workspaceRoot}/packages/cem_ml/Cargo.toml",
            "{workspaceRoot}/packages/cem_ml/schema/**/*",
            "{workspaceRoot}/packages/cem_ml/schema-packages/**/*"
        ],
        "default": [
            "{projectRoot}/**/*",
            "sharedGlobals",
            "rustDependencies"
        ]
    },
    "targets": {
        "verify:url-package": {
            "cache": false,
            "executor": "nx:run-commands",
            "options": {
                "command": "python3 tools/scripts/verify-cem-url-package.py",
                "cwd": "{workspaceRoot}"
            },
            "outputs": ["{workspaceRoot}/dist/target/cem_url_package/package"]
        },
        "test:url-integration": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ql --test module_query --test url_integration --test url_query --test url_params_query --test url_parse --test url_params --test url_setters --target-dir dist/target/cem_ql"
            },
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/packages/cem_ql/fixtures/url/**/*"
            ],
            "outputs": []
        },
        "build": {
            "cache": true,
            "executor": "@monodon/rust:check",
            "outputs": ["{options.target-dir}"],
            "options": {
                "package": "cem-ql",
                "target-dir": "dist/target/cem_ql"
            }
        },
        "test": {
            "cache": true,
            "executor": "@monodon/rust:test",
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/packages/cem-elements/index.html",
                "{workspaceRoot}/packages/cem-elements/demo/attributes.html",
                "{workspaceRoot}/packages/cem-elements/demo/data-slices.html",
                "{workspaceRoot}/packages/cem-components/src/components/cem-select/cem-select.xhtml",
                "{workspaceRoot}/packages/cem-elements/src/lib/cem-elements.stories.ts",
                "{workspaceRoot}/packages/cem-elements/demo/data-island-tree.xsl",
                "{workspaceRoot}/packages/cem-elements/demo/http-data.cemt",
                "{workspaceRoot}/packages/cem-elements/demo/npm-versions-demo.html",
                "{workspaceRoot}/packages/cem-elements/demo/npm-versions.json",
                "{workspaceRoot}/packages/cem-elements/demo/html-template.xhtml",
                "{workspaceRoot}/packages/cem-elements/demo/data-table-view.cemt",
                "{workspaceRoot}/packages/cem-elements/demo/data-tree-view.cemt",
                "{workspaceRoot}/packages/cem-elements/demo/data-tree-request.cemt",
                "{workspaceRoot}/packages/cem-elements/demo/tree-source.xml",
                "{workspaceRoot}/packages/cem-elements/demo/tree-source.json",
                "{workspaceRoot}/packages/cem-elements/demo/data-table-view.xslt",
                "{workspaceRoot}/packages/cem-elements/demo/data-table-aspects.cemt",
                "{workspaceRoot}/packages/cem-elements/demo/cell-overrides.html",
                "{workspaceRoot}/packages/cem-elements/demo/local-storage.html",
                "{workspaceRoot}/packages/cem-elements/demo/stock-cell.cemt",
                "{workspaceRoot}/packages/cem-elements/demo/data-table-aspects.xslt",
                "{workspaceRoot}/packages/cem-elements/demo/xpath-functions.html",
                "{workspaceRoot}/packages/cem-elements/demo/xpath-functions.cemt"
            ],
            "outputs": ["{options.target-dir}"],
            "options": {
                "package": "cem-ql",
                "target-dir": "dist/target/cem_ql"
            },
            "configurations": {
                "production": {
                    "release": true
                }
            }
        },
        "lint": {
            "cache": true,
            "executor": "@monodon/rust:lint",
            "outputs": ["{options.target-dir}"],
            "options": {
                "package": "cem-ql",
                "target-dir": "dist/target/cem_ql"
            }
        },
        "build:wasm": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/build-cem-ql-wasm.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*",
                "{projectRoot}/Cargo.toml",
                "rustDependencies",
                "{workspaceRoot}/tools/scripts/build-cem-ql-wasm.mjs"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ql/wasm32-unknown-unknown", "{projectRoot}/dist/wasm"]
        },
        "bench": {
            "cache": false,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --release --package cem-ql --test perf_budgets --target-dir dist/target/cem_ql -- --nocapture",
                "cwd": "{workspaceRoot}"
            },
            "outputs": ["{workspaceRoot}/dist/target/cem_ql/release"]
        },
        "verify-embedded-expressions": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ql --test embedded_expressions --target-dir dist/target/cem_ql",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/embedded_expressions.rs",
                "{projectRoot}/fixtures/embedded-expression-waivers.json",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/vendor/url/Cargo.toml",
                "{workspaceRoot}/vendor/url/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                "{workspaceRoot}/packages/**/*.cem",
                "{workspaceRoot}/packages/**/*.cemt",
                "{workspaceRoot}/examples/**/*.cem",
                "{workspaceRoot}/examples/**/*.cemt"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ql"]
        },
        "test:rust-first-parity": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ql --test rust_first_parity --target-dir dist/target/cem_ql",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/rust_first_parity.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/vendor/url/Cargo.toml",
                "{workspaceRoot}/vendor/url/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ql"]
        },
        "test:fixtures": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ql --test fixtures_snapshot --target-dir dist/target/cem_ql",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/fixtures_snapshot.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/vendor/url/Cargo.toml",
                "{workspaceRoot}/vendor/url/src/**/*.rs",
                "{workspaceRoot}/examples/cem-ml/**/*.cem",
                "{workspaceRoot}/examples/semantic/**/*.html",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ql"]
        },
        "test:set-operator-identity": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ql --test set_operator_identity --target-dir dist/target/cem_ql",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/set_operator_identity.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/vendor/url/Cargo.toml",
                "{workspaceRoot}/vendor/url/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ql"]
        },
        "test:reference-resolution": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ql --test reference_resolution --target-dir dist/target/cem_ql",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/reference_resolution.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/vendor/url/Cargo.toml",
                "{workspaceRoot}/vendor/url/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ql"]
        },
        "test:read-content-negotiation": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ql --test read_content_negotiation --target-dir dist/target/cem_ql",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/read_content_negotiation.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/vendor/url/Cargo.toml",
                "{workspaceRoot}/vendor/url/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ql"]
        },
        "test:policy-hooks": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ql --test policy_hooks --target-dir dist/target/cem_ql",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/policy_hooks.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/vendor/url/Cargo.toml",
                "{workspaceRoot}/vendor/url/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ql"]
        },
        "test:compiled-artifact-reload": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ql --test compiled_artifact_reload --target-dir dist/target/cem_ql",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/compiled_artifact_reload.rs",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/vendor/url/Cargo.toml",
                "{workspaceRoot}/vendor/url/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ql/v1/examples/compiled-artifact-identity.cemql",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ql"]
        },
        "test:retained-stylesheets": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build:wasm"],
            "options": {
                "commands": [
                    "cargo test --package cem-ql --test retained_stylesheets --target-dir dist/target/cem_ql",
                    "node packages/cem_ql/tests/retained-stylesheets-wasm.mjs"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/tools/scripts/build-cem-ql-wasm.mjs"
            ],
            "outputs": []
        },
        "test:template-artifact-reload": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ql --test template_artifact_reload --target-dir dist/target/cem_ql",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/tests/template_artifact_reload.rs",
                "{projectRoot}/fixtures/component-template-artifact.cem",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/vendor/url/Cargo.toml",
                "{workspaceRoot}/vendor/url/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml"
            ],
            "outputs": ["{workspaceRoot}/dist/target/cem_ql"]
        },
        "build:template-artifact-fixture": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo run --package cem-ql --example compile_template_artifact --target-dir dist/target/cem_ql -- packages/cem_ql/fixtures/component-template-artifact.cem dist/artifacts/cem_ql/component-template-artifact.cem-template.bin dev phase-3a-local-default items title tone visible",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.rs",
                "{projectRoot}/examples/compile_template_artifact.rs",
                "{projectRoot}/fixtures/component-template-artifact.cem",
                "{projectRoot}/Cargo.toml",
                "{workspaceRoot}/vendor/url/Cargo.toml",
                "{workspaceRoot}/vendor/url/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml"
            ],
            "outputs": ["{workspaceRoot}/dist/artifacts/cem_ql"]
        },
        "test:reference-consumers": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                "build:wasm"
            ],
            "options": {
                "commands": [
                    "cargo test --locked --package cem-ml --test node_references --test reference_schema_contracts --test reference_expression_sources --test reference_resolution --test reference_traversal_policy --test reference_unresolved_policy --test schema_declaration_references --test native_namespace_properties --test pending_namespace_names --test reference_reload_bundle --test resumable_input_validation --test reference_syntax_adoption --target-dir dist/target/cem_ml_cli",
                    "cargo test --locked --package cem-ql --test node_references --test constructor_references --test public_reference_contract --test reference_resolution --test reference_runtime_resolution --test schema_declaration_references --test lexical_scope_handoff --test namespace_name_views --test namespace_lifecycle --test reference_transport_api --test reference_export_contract --test reference_reload_attachment --test reference_lifecycle_api --test reference_resource_session --test reference_query_snapshot --test native_value_control --test reference_host_adapters --target-dir dist/target/cem_ml_cli",
                    "cargo test --locked --package cem-ml-transform-cem-ql --test reload_ingress --test reload_engine_validation --test resumable_schema_validation --test namespace_query_ingress --test reference_query_bridge --target-dir dist/target/cem_ml_cli",
                    "cargo test --locked --package cem-ml-cli --test reference_transport_cli --test reload_validation_cli --target-dir dist/target/cem_ml_cli",
                    "node packages/cem_ql/tests/reference-transport-wasm.mjs",
                    "node packages/cem_ql/tests/native-values-wasm.mjs"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/packages/cem_ml/tests/**/*",
                "{workspaceRoot}/packages/cem_ml_transform_cem_ql/**/*",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*",
                "{workspaceRoot}/packages/cem_ml_cli/tests/**/*",
                "{workspaceRoot}/packages/cem_ml_cli/Cargo.toml",
                "{workspaceRoot}/tools/scripts/build-cem-ql-wasm.mjs"
            ],
            "outputs": []
        },
        "test:transport-protocol": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test --package cem-ql --test transport_protocol --target-dir dist/target/cem_ql",
