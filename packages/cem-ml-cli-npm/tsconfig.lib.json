{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "emitDeclarationOnly": false,
        "forceConsistentCasingInFileNames": true,
        "lib": ["es2022", "dom", "dom.iterable", "webworker"],
        "resolveJsonModule": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
