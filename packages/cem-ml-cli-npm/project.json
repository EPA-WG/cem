{
    "name": "@epa-wg/cem-ml-cli",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem-ml-cli-npm/src",
    "implicitDependencies": ["@epa-wg/cem-ml", "cem_ml_cli"],
    "targets": {
        "build": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": ["@epa-wg/cem-ml"],
                    "target": "build"
                },
                {
                    "projects": ["cem_ml_cli"],
                    "target": "emit-command-schema"
                }
            ],
            "options": {
                "command": "node scripts/build.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{projectRoot}/package.json",
                "{projectRoot}/tsconfig.lib.json",
                "{projectRoot}/src/**/*.ts",
                "{projectRoot}/scripts/build.mjs",
                "{workspaceRoot}/packages/cem_ml/Cargo.toml",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": false
                }
            ],
            "outputs": ["{projectRoot}/dist"]
        },
        "lint": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "yarn eslint packages/cem-ml-cli-npm",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.ts",
                "{projectRoot}/tests/**/*.mjs",
                "{projectRoot}/scripts/**/*.mjs",
                "{projectRoot}/package.json"
            ]
        },
        "test": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "options": {
                "command": "node --test tests/command-schema.test.mjs tests/command-all-operations.test.mjs tests/node-command-service.test.mjs tests/node-worker-pool.test.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{projectRoot}/tests/**/*.mjs",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": false
                }
            ],
            "outputs": []
        },
        "test:browser": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "options": {
                "command": "node scripts/verify-browser.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{projectRoot}/scripts/verify-browser.mjs",
                "{projectRoot}/tests/browser-worker-pool.fixture.mjs",
                "{projectRoot}/tests/command-all-operations.fixture.mjs",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": false
                }
            ],
            "outputs": []
        },
        "verify": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build", "test", "test:browser"],
            "options": {
                "command": "node scripts/verify-dist.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{projectRoot}/scripts/verify-dist.mjs",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": false
                }
            ],
            "outputs": []
        },
        "package": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                "build",
                "verify",
                {
                    "projects": ["@epa-wg/cem-ml"],
                    "target": "package"
                }
            ],
            "options": {
                "command": "node scripts/package.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{projectRoot}/scripts/package.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-npm-release-evidence.mjs",
                "{workspaceRoot}/tools/scripts/cem-ml-platform-release.mjs",
                {
                    "dependentTasksOutputFiles": "**/*",
                    "transitive": false
                }
            ],
            "outputs": ["{workspaceRoot}/dist/packages/cem-ml-cli-npm"]
        },
        "sign": {
            "cache": false,
            "executor": "nx:run-commands",
            "dependsOn": ["package"],
            "options": {
                "command": "node tools/scripts/cem-ml-npm-release-evidence.mjs attest @epa-wg/cem-ml-cli",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/cem-ml-npm-release-evidence.mjs",
                { "dependentTasksOutputFiles": "**/*", "transitive": false },
                { "env": "CEM_ML_GITHUB_ATTESTATION_BUNDLE" },
                { "env": "CEM_ML_RELEASE_SIGNING" }
            ],
            "outputs": ["{workspaceRoot}/dist/packages/cem-ml-cli-npm/artifacts"]
        },
        "verify:consumer": {
            "cache": false,
            "executor": "nx:run-commands",
            "dependsOn": [
                "package",
                {
                    "projects": ["@epa-wg/cem-ml"],
                    "target": "package"
                }
            ],
            "options": {
                "command": "node scripts/verify-consumer.mjs",
                "cwd": "{projectRoot}"
            },
            "inputs": [
                "{projectRoot}/scripts/verify-consumer.mjs",
                "{projectRoot}/tests/command-all-operations.fixture.mjs"
            ],
            "outputs": []
        },
        "check": {
            "executor": "nx:run-commands",
            "dependsOn": ["lint", "verify", "verify:consumer"],
            "options": {
                "command": "node -e \"console.log('CEM-ML CLI browser and Node worker deployment checks passed.')\"",
                "cwd": "{workspaceRoot}"
            },
            "outputs": []
        }
    }
}
