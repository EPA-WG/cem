  "archiveSchemaVersion": 1,
  "project": {
    "$schema": "https://cem.dev/ns/studio/project/1",
    "schemaVersion": 1,
    "id": "scss-stylesheet-seed",
    "name": "SCSS stylesheet",
    "description": "Validate passive SCSS, inspect its expanded CSS, resolve a project-owned module, repair source syntax and build an independent HTML/CSS preview.",
    "rootUri": "studio://scss-stylesheet-seed/",
    "revision": 1,
    "createdAt": "2026-10-17T00:00:00Z",
    "updatedAt": "2026-10-17T00:00:00Z",
    "entries": [
      {
        "id": "validate-scss",
        "kind": "validation",
        "name": "Validate passive SCSS source",
        "description": "Validate the SCSS source grammar without loading its local module or expanding variables.",
        "resourceIds": [
          "scss-source",
          "command-validate-scss"
        ],
        "runConfigResourceId": "command-validate-scss",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "validate-unresolved-module",
        "kind": "validation",
        "name": "Validate syntax without loading a module",
        "description": "A syntactically valid source may mention an unavailable module: passive validation does not grant resolver access.",
        "resourceIds": [
          "unresolved-module",
          "command-validate-unresolved-module"
        ],
        "runConfigResourceId": "command-validate-unresolved-module",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "parse-scss-ast",
        "kind": "inspection",
        "name": "Parse expanded CSS AST with SCSS origins",
        "description": "Expand the owned SCSS module set and inspect typed CSS structure with original SCSS origin frames, not a raw SCSS source AST.",
        "resourceIds": [
          "scss-source",
          "command-parse-scss-ast",
          "scss-tokens"
        ],
        "runConfigResourceId": "command-parse-scss-ast",
        "tags": [
          "parse"
        ]
      },
      {
        "id": "parse-scss-events",
        "kind": "inspection",
        "name": "Parse expanded CSS events with SCSS origins",
        "description": "Inspect the expanded native CSS event projection and retained SCSS source identities.",
        "resourceIds": [
          "scss-source",
          "command-parse-scss-events",
          "scss-tokens"
        ],
        "runConfigResourceId": "command-parse-scss-events",
        "tags": [
          "parse"
        ]
      },
      {
        "id": "expand-css",
        "kind": "conversion",
        "name": "Expand SCSS to exact browser CSS",
        "description": "Use native variables, a namespaced local mixin and nested selectors; serialize the resulting typed CSS using its own output pipeline.",
        "resourceIds": [
          "scss-source",
          "command-expand-css",
          "scss-tokens",
          "expected-css"
        ],
        "runConfigResourceId": "command-expand-css",
        "tags": [
          "convert"
        ]
      },
      {
        "id": "repair-scss-syntax",
        "kind": "validation",
        "name": "Repair the SCSS opening brace",
        "description": "Restore the opening block brace and revalidate the same saved source before attempting expansion.",
        "resourceIds": [
          "invalid-scss",
          "command-repair-scss-syntax"
        ],
        "runConfigResourceId": "command-repair-scss-syntax",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "build-html",
        "kind": "transformation-graph",
        "name": "Build HTML and generated CSS",
        "description": "Build a validated HTML source through an explicit CEMT wrapper plus native SCSS-to-CSS output; publish both artifacts with an explicit HTML entry.",
        "resourceIds": [
          "scss-graph",
          "command-build-html",
          "scss-source",
          "scss-tokens",
          "preview-html",
          "html-template",
          "expected-css",
          "expected-html"
        ],
        "runConfigResourceId": "command-build-html",
        "entryArtifact": "generated/index.html",
        "tags": [
          "transform"
        ]
      }
    ],
