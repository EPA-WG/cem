{
  "archiveSchemaVersion": 1,
  "project": {
    "$schema": "https://cem.dev/ns/studio/project/1",
    "schemaVersion": 1,
    "id": "cem-transform-seed",
    "name": "CEM transformation",
    "description": "Transform owned XML into a native report and HTML with CEM or XSLT views, preserving native stage ownership, parameters and explicit entry artifacts.",
    "rootUri": "studio://cem-transform-seed/",
    "revision": 1,
    "createdAt": "2026-10-17T00:00:00Z",
    "updatedAt": "2026-10-17T00:00:00Z",
    "entries": [
      {
        "id": "validate-template",
        "kind": "validation",
        "name": "Validate the report template source",
        "description": "Validate the declared template identity independently of graph execution or the output data contract.",
        "resourceIds": [
          "report-template",
          "command-validate-template"
        ],
        "runConfigResourceId": "command-validate-template",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "inspect-template",
        "kind": "inspection",
        "name": "Inspect original template structure",
        "description": "Inspect the native source tree and original template ranges; this does not execute the template.",
        "resourceIds": [
          "report-template",
          "command-inspect-template"
        ],
        "runConfigResourceId": "command-inspect-template",
        "tags": [
          "inspect"
        ]
      },
      {
        "id": "format-template",
        "kind": "conversion",
        "name": "Format the report template",
        "description": "Apply the native tabular source formatter and compare its exact source bytes.",
        "resourceIds": [
          "report-template",
          "command-format-template",
          "expected-format"
        ],
        "runConfigResourceId": "command-format-template",
        "tags": [
          "convert"
        ]
      },
      {
        "id": "validate-graph",
        "kind": "validation",
        "name": "Validate the explicit transformation graph",
        "description": "Validate graph declarations, source/template identities, parameters and export definitions without claiming a successful build.",
        "resourceIds": [
          "report-graph",
          "command-validate-graph"
        ],
        "runConfigResourceId": "command-validate-graph",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "inspect-graph",
        "kind": "inspection",
        "name": "Inspect graph stages and export declarations",
        "description": "Inspect the native graph source tree: orders import, filtered report model, HTML view, parameters and explicit exports.",
        "resourceIds": [
          "report-graph",
          "command-inspect-graph"
        ],
        "runConfigResourceId": "command-inspect-graph",
        "tags": [
          "inspect"
        ]
      },
      {
        "id": "repair-template",
        "kind": "validation",
        "name": "Repair the template source contract",
        "description": "Review the original native source diagnostic, restore the required declaration and revalidate the saved copy.",
        "resourceIds": [
          "invalid-template",
          "command-repair-template"
        ],
        "runConfigResourceId": "command-repair-template",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "build-report",
        "kind": "transformation-graph",
        "name": "Build the two-stage order report",
        "description": "Filter original orders into a native report model, then render the model through the shared CEM-native template runtime. The explicit HTML entry drives project preview.",
        "resourceIds": [
          "report-graph",
          "command-build-report",
          "orders-source",
          "report-template",
          "page-template",
          "expected-html",
          "expected-report"
        ],
        "runConfigResourceId": "command-build-report",
        "entryArtifact": "generated/index.html",
        "tags": [
          "transform"
        ]
      },
      {
        "id": "build-xslt-report",
        "kind": "transformation-graph",
        "name": "Build the CEM report through native XSLT",
        "description": "Pass the constructed native report into an owned XDM document for namespace-aware XPath and XSLT; no XML encoding or reparsing occurs.",
        "resourceIds": [
          "xslt-report-graph",
          "command-build-xslt-report",
          "orders-source",
          "report-template",
          "page-xslt-template",
          "expected-xslt-html",
          "expected-report"
        ],
        "runConfigResourceId": "command-build-xslt-report",
        "entryArtifact": "generated/index.html",
        "tags": [
          "transform"
        ]
      }
    ],
