  "archiveSchemaVersion": 1,
  "project": {
    "$schema": "https://cem.dev/ns/studio/project/1",
    "schemaVersion": 1,
    "id": "mathml-formula-seed",
    "name": "MathML formula",
    "description": "Inspect, validate, query and format a namespaced mathematical expression, repair its namespace and build a bounded Presentation MathML HTML preview.",
    "rootUri": "studio://mathml-formula-seed/",
    "revision": 1,
    "createdAt": "2026-10-17T00:00:00Z",
    "updatedAt": "2026-10-17T00:00:00Z",
    "entries": [
      {
        "id": "inspect-mathml",
        "kind": "inspection",
        "name": "Inspect retained MathML formula",
        "description": "Inspect expanded names and original source positions from the genuine XML-backed family owner in the shared retained CEM tree.",
        "resourceIds": [
          "formula-source",
          "command-inspect-mathml"
        ],
        "runConfigResourceId": "command-inspect-mathml",
        "tags": [
          "inspect"
        ]
      },
      {
        "id": "validate-presentation",
        "kind": "validation",
        "name": "Validate Presentation MathML",
        "description": "Validate XML well-formedness and the documented family/profile source facts, without claiming complete language conformance.",
        "resourceIds": [
          "formula-source",
          "command-validate-presentation"
        ],
        "runConfigResourceId": "command-validate-presentation",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "validate-content",
        "kind": "validation",
        "name": "Validate Content MathML source",
        "description": "Validate a separate Content MathML expression source. This is not Content-to-Presentation conversion or algebraic evaluation.",
        "resourceIds": [
          "formula-content",
          "command-validate-content"
        ],
        "runConfigResourceId": "command-validate-content",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "query-mathml",
        "kind": "query",
        "name": "Query the MathML formula structure",
        "description": "Use caller-bound expanded XML names to summarize the source structure and values, independently of source prefix spelling.",
        "resourceIds": [
          "formula-source",
          "command-query-mathml",
          "formula-query",
          "formula-summary"
        ],
        "runConfigResourceId": "command-query-mathml",
        "tags": [
          "query"
        ]
      },
      {
        "id": "format-mathml",
        "kind": "conversion",
        "name": "Format Presentation MathML (pretty)",
        "description": "Run the native family-owned pretty formatter with source text/token boundaries preserved and synthetic indentation unmapped.",
        "resourceIds": [
          "formula-source",
          "command-format-mathml",
          "expected-mathml"
        ],
        "runConfigResourceId": "command-format-mathml",
        "tags": [
          "convert"
        ]
      },
      {
        "id": "repair-mathml-namespace",
        "kind": "validation",
        "name": "Repair the MathML namespace",
        "description": "Restore the required family namespace on a well-formed XML document and revalidate the same saved resource.",
        "resourceIds": [
          "invalid-mathml",
          "command-repair-mathml-namespace"
        ],
        "runConfigResourceId": "command-repair-mathml-namespace",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "build-html",
        "kind": "transformation-graph",
        "name": "Build and preview the formula",
        "description": "Construct an HTML wrapper and copy the retained, namespaced source element without its XML prolog. Preview bounded inert foreign content through shared components.",
        "resourceIds": [
          "formula-graph",
          "command-build-html",
          "formula-source",
          "formula-template",
          "expected-html"
        ],
        "runConfigResourceId": "command-build-html",
        "entryArtifact": "generated/formula.html",
        "tags": [
          "transform"
        ]
      }
    ],
