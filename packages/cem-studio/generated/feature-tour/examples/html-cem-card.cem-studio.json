    "id": "html-cem-card-seed",
    "name": "HTML and CEM card",
    "description": "Compare HTML and CEM-ML card semantics, inspect the canonical shared declaration, generate native HTML and reuse packaged declarative cards in an independent live view.",
    "rootUri": "studio://html-cem-card-seed/",
    "revision": 1,
    "createdAt": "2026-10-17T00:00:00Z",
