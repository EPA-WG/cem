      {
        "id": "semantics-html",
        "kind": "query",
        "name": "Card semantics from HTML",
        "description": "Compare the same nine literal card fields using expanded element names and explicit HTML/CEM attribute namespace mappings.",
        "resourceIds": [
          "card-html",
          "command-semantics-html",
          "card-query",
          "card-semantics"
        ],
        "runConfigResourceId": "command-semantics-html",
        "tags": [
          "query"
        ]
      },
      {
        "id": "semantics-cem",
