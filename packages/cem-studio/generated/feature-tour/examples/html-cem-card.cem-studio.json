        "name": "Card semantics from CEM-ML",
        "description": "Compare the same nine literal card fields using expanded element names and explicit HTML/CEM attribute namespace mappings.",
        "resourceIds": [
          "card-cem",
          "command-semantics-cem",
          "card-query",
          "card-semantics"
        ],
        "runConfigResourceId": "command-semantics-cem",
        "tags": [
          "query"
        ]
      },
      {
        "id": "build-html",
        "kind": "transformation-graph",
        "name": "Build the card as HTML",
        "description": "Generate an HTML article from saved HTML data using a native CEMT template; inspect exact output bytes and original template provenance.",
        "resourceIds": [
          "card-graph",
          "command-build-html",
          "card-html",
          "card-template",
          "card-expected-html"
        ],
        "runConfigResourceId": "command-build-html",
        "entryArtifact": "generated/card.html",
        "tags": [
          "transform"
        ]
      },
      {
        "id": "live-view",
        "kind": "inspection",
        "name": "Shared card live view",
        "description": "Render two existing shared cem-card instances from saved HTML data and projected content; Show details uses shared slice bindings and a local alert, without project JavaScript or new declaration authority.",
        "resourceIds": [
          "card-live-view",
          "command-live-view",
          "card-html"
        ],
        "runConfigResourceId": "command-live-view",
        "tags": [
          "parse",
          "live-preview",
          "preview-component:cem-card",
          "preview-component:cem-action",
          "preview-component:cem-alert"
        ]
      },
      {
        "id": "inspect-component",
        "kind": "inspection",
        "name": "Inspect component declaration",
        "description": "Inspect the unchanged packaged declaration as native CEM-ML source-AST vocabulary. Line-fenced literal attributes preserve complete mixed-quote template text without evaluating it or expanding DCEs.",
        "resourceIds": [
          "card-component",
          "command-inspect-component"
        ],
        "runConfigResourceId": "command-inspect-component",
        "tags": [
          "inspect"
        ]
      },
      {
        "id": "repair-html-policy",
        "kind": "validation",
        "name": "Repair inline HTML policy",
        "description": "Diagnose an ungranted inline event handler at its original source range, remove the attribute, save and validate again.",
        "resourceIds": [
          "card-invalid-policy",
          "command-repair-html-policy"
        ],
        "runConfigResourceId": "command-repair-html-policy",
        "tags": [
          "validate"
        ]
      }
    ],
