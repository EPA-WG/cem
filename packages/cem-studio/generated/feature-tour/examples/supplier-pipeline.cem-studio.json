    "$schema": "https://cem.dev/ns/studio/project/1",
    "schemaVersion": 1,
    "id": "supplier-pipeline-seed",
    "name": "Supplier pipeline",
    "description": "Namespace-aware XML catalog validation and selection, then XML products and CSV stock reconciled through explicit native domain rules into JSON, YAML and HTML, with failure/repair and source provenance.",
    "rootUri": "studio://supplier-pipeline-seed/",
    "revision": 1,
    "createdAt": "2026-10-17T00:00:00Z",
    "updatedAt": "2026-10-17T00:00:00Z",
    "entries": [
      {
        "id": "catalog-source",
        "kind": "inspection",
        "name": "Inspect supplier catalog",
        "resourceIds": [
          "supplier-catalog",
          "command-catalog-source"
        ],
        "runConfigResourceId": "command-catalog-source",
        "tags": [
          "parse"
        ]
      },
      {
        "id": "validate-catalog",
        "kind": "validation",
        "name": "Validate supplier catalog",
        "description": "Validate native XML source syntax and namespace bindings; business rules remain in the availability templates.",
        "resourceIds": [
          "supplier-catalog",
          "command-validate-catalog"
        ],
        "runConfigResourceId": "command-validate-catalog",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "query-products",
        "kind": "query",
        "name": "Select namespaced supplier products",
        "description": "Select product IDs and names by expanded XML namespace, independently of the source prefix spelling.",
        "resourceIds": [
          "supplier-catalog",
          "command-query-products",
          "supplier-products-query",
          "supplier-expected-products"
        ],
        "runConfigResourceId": "command-query-products",
        "tags": [
          "query"
        ]
      },
      {
        "id": "repair-catalog",
        "kind": "validation",
        "name": "Repair malformed supplier XML",
        "description": "Run the deliberate mismatched-tag failure, inspect the original source range, then repair the closing product tag and rerun.",
        "resourceIds": [
          "supplier-invalid-catalog",
          "command-repair-catalog"
        ],
        "runConfigResourceId": "command-repair-catalog",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "stock-source",
        "kind": "inspection",
        "name": "Inspect supplier stock",
        "resourceIds": [
          "supplier-stock",
          "command-stock-source"
        ],
        "runConfigResourceId": "command-stock-source",
        "tags": [
          "parse"
        ]
      },
      {
        "id": "availability",
        "kind": "transformation-graph",
        "name": "Supplier availability pipeline",
        "description": "Match saved XML products and CSV stock by ID; generate an HTML view, JSON service payload and YAML partner feed. Edit stock through Resources, save and rerun.",
        "resourceIds": [
          "supplier-graph",
          "command-availability",
          "supplier-catalog",
          "supplier-stock",
          "supplier-reconcile",
          "supplier-view",
          "supplier-expected-json",
          "supplier-expected-yaml",
          "supplier-expected-html"
        ],
        "runConfigResourceId": "command-availability",
        "entryArtifact": "generated/availability.html",
        "tags": [
          "transform"
        ]
      }
    ],
