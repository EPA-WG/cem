    "schemaVersion": 1,
    "id": "css-stylesheet-seed",
    "name": "CSS stylesheet",
    "description": "Inspect lossless and semantic CSS views, validate and format source, repair an unclosed layer and preview a native CSS/HTML build with a scoped card style.",
    "rootUri": "studio://css-stylesheet-seed/",
    "revision": 1,
    "createdAt": "2026-10-17T00:00:00Z",
    "updatedAt": "2026-10-17T00:00:00Z",
    "entries": [
      {
        "id": "inspect-css",
        "kind": "inspection",
        "name": "Inspect native CSS source",
        "description": "Inspect the lossless typed CSS source/token vocabulary and original source positions.",
        "resourceIds": [
          "style-source",
          "command-inspect-css"
        ],
        "runConfigResourceId": "command-inspect-css",
        "tags": [
          "inspect"
        ]
      },
      {
        "id": "inspect-tree",
        "kind": "inspection",
        "name": "Inspect retained CSS rules",
        "description": "Inspect native semantic CSS rules, declarations and original ranges, independently of the lexical source AST.",
        "resourceIds": [
          "style-source",
          "command-inspect-tree"
        ],
        "runConfigResourceId": "command-inspect-tree",
        "tags": [
          "inspect"
        ]
      },
      {
        "id": "validate-css",
        "kind": "validation",
        "name": "Validate the scoped CSS source",
        "description": "Check native syntax and source-policy facts, without evaluating the browser cascade or claiming full CSS conformance.",
        "resourceIds": [
          "style-source",
          "command-validate-css"
        ],
        "runConfigResourceId": "command-validate-css",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "format-css",
        "kind": "conversion",
        "name": "Format CSS (pretty profile)",
        "description": "Use the native conservative lexical formatter; pretty preserves comments, strings, values and source layout instead of claiming a CSS beautifier.",
        "resourceIds": [
          "style-source",
          "command-format-css",
          "expected-css"
        ],
        "runConfigResourceId": "command-format-css",
        "tags": [
          "convert"
        ]
      },
      {
        "id": "repair-css",
        "kind": "validation",
        "name": "Repair the unclosed CSS layer",
        "description": "Restore the missing closing delimiter and revalidate the same saved CSS resource at the original source position.",
        "resourceIds": [
          "invalid-css",
          "command-repair-css"
        ],
        "runConfigResourceId": "command-repair-css",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "build-html",
        "kind": "transformation-graph",
        "name": "Build and preview the scoped stylesheet",
        "description": "Publish an explicitly authored HTML wrapper and native CSS output as a two-artifact tree; the ordinary browser @scope rule is separate from DCE host scoping.",
        "resourceIds": [
          "style-graph",
          "command-build-html",
          "preview-document",
          "style-template",
          "style-source",
          "expected-html",
          "expected-css"
        ],
        "runConfigResourceId": "command-build-html",
        "entryArtifact": "generated/cards.html",
        "tags": [
          "transform"
        ]
      }
    ],
