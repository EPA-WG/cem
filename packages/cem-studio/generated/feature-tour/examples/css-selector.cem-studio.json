  "archiveSchemaVersion": 1,
  "project": {
    "$schema": "https://cem.dev/ns/studio/project/1",
    "schemaVersion": 1,
    "id": "css-selector-seed",
    "name": "CSS selector queries",
    "description": "Validate explicit CSS-selector expressions, select native HTML and namespaced XML elements in document order, inspect original query bytes and repair malformed selector source.",
    "rootUri": "studio://css-selector-seed/",
    "revision": 1,
    "createdAt": "2026-10-17T00:00:00Z",
    "updatedAt": "2026-10-17T00:00:00Z",
    "entries": [
      {
        "id": "inspect-selector",
        "kind": "inspection",
        "name": "Inspect the original selector source",
        "description": "View the existing CEM text envelope and original query bytes/offsets. This is not a typed selector-AST export; actual matching and validation use the native selector parser.",
        "resourceIds": [
          "selector-source",
          "command-inspect-selector"
        ],
        "runConfigResourceId": "command-inspect-selector",
        "tags": [
          "inspect"
        ]
      },
      {
        "id": "validate-selector",
        "kind": "validation",
        "name": "Validate the ready-card selector",
        "description": "Validate standalone selector grammar and capability facts using its explicit query identity, independently of any host document.",
        "resourceIds": [
          "selector-source",
          "command-validate-selector"
        ],
        "runConfigResourceId": "command-validate-selector",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "query-cards",
        "kind": "query",
        "name": "Select ready HTML product cards",
        "description": "Select actual native HTML element identities in document order; the overlapping selector list deduplicates Tea. JSON is an explicit human-facing result export.",
        "resourceIds": [
          "document-source",
          "command-query-cards",
          "selector-source",
          "selector-summary"
        ],
        "runConfigResourceId": "command-query-cards",
        "tags": [
          "query"
        ]
      },
      {
        "id": "query-namespaces",
        "kind": "query",
        "name": "Select namespaced XML products",
        "description": "Use an explicit static namespace binding over the original native XML element tree; source prefix spelling is not query identity.",
        "resourceIds": [
          "catalog-source",
          "command-query-namespaces",
          "namespace-selector",
          "namespace-summary"
        ],
        "runConfigResourceId": "command-query-namespaces",
        "tags": [
          "query"
        ]
      },
      {
        "id": "repair-selector",
        "kind": "validation",
        "name": "Repair the unclosed attribute selector",
        "description": "Replace the incomplete attribute selector with the valid project query and revalidate the same saved resource.",
        "resourceIds": [
          "invalid-selector",
          "command-repair-selector"
        ],
        "runConfigResourceId": "command-repair-selector",
        "tags": [
          "validate"
        ]
      }
    ],
