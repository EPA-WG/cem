    "$schema": "https://cem.dev/ns/studio/project/1",
    "schemaVersion": 1,
    "id": "cem-schema-seed",
    "name": "CEM schema authoring",
    "description": "Define a project-owned note schema and package, inspect and format native declarations, distinguish source validation from instance validation, and repair both contracts.",
    "rootUri": "studio://cem-schema-seed/",
    "revision": 1,
    "createdAt": "2026-10-17T00:00:00Z",
    "updatedAt": "2026-10-17T00:00:00Z",
    "entries": [
      {
        "id": "validate-schema",
        "kind": "validation",
        "name": "Validate the CEM schema source",
        "description": "Validate native schema declarations, attribute types, field contracts and diagnostic bindings without validating an instance.",
        "resourceIds": [
          "note-schema",
          "command-validate-schema"
        ],
        "runConfigResourceId": "command-validate-schema",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "inspect-schema",
        "kind": "inspection",
        "name": "Inspect the native CEM schema structure",
        "description": "Inspect the imported native CEM schema source and its original ranges; this is a source projection rather than application JSON.",
        "resourceIds": [
          "note-schema",
          "command-inspect-schema"
        ],
        "runConfigResourceId": "command-inspect-schema",
        "tags": [
          "inspect"
        ]
      },
      {
        "id": "format-schema",
        "kind": "conversion",
        "name": "Format the CEM schema source",
        "description": "Apply the native tabular formatter with exact expected bytes.",
        "resourceIds": [
          "note-schema",
          "command-format-schema",
          "formatted-schema"
        ],
        "runConfigResourceId": "command-format-schema",
        "tags": [
          "convert"
        ]
      },
      {
        "id": "validate-package",
        "kind": "validation",
        "name": "Validate the project-owned schema package",
        "description": "Validate the local schema source declaration, namespace claim and content-type metadata. Metadata alone grants no executable adapter.",
        "resourceIds": [
          "note-package",
          "command-validate-package"
        ],
        "runConfigResourceId": "command-validate-package",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "validate-instance",
        "kind": "validation",
        "name": "Validate a note using the owned CEM schema",
        "description": "Load the project-owned package and apply its required-id contract to a separately selected instance.",
        "resourceIds": [
          "note-instance",
          "command-validate-instance",
          "note-package",
          "note-schema"
        ],
        "runConfigResourceId": "command-validate-instance",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "repair-schema",
        "kind": "validation",
        "name": "Repair the missing schema namespace",
        "description": "Restore the required schema namespace declaration after reviewing the original native diagnostic.",
        "resourceIds": [
          "invalid-schema",
          "command-repair-schema"
        ],
        "runConfigResourceId": "command-repair-schema",
        "tags": [
          "validate"
        ]
      },
      {
        "id": "repair-instance",
        "kind": "validation",
        "name": "Repair the missing note id",
        "description": "Apply the loaded domain contract, then add the missing id to the separate instance source.",
        "resourceIds": [
          "invalid-instance",
          "command-repair-instance",
          "note-package",
          "note-schema"
        ],
        "runConfigResourceId": "command-repair-instance",
        "tags": [
          "validate"
        ]
      }
    ],
