{
    "name": "@epa-wg/cem-studio",
    "version": "0.1.0",
    "description": "Installable CEM-ML browser workbench bootstrap and static deployment",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/EPA-WG/cem.git",
        "directory": "packages/cem-studio"
    },
    "exports": {
        ".": {
            "types": "./src/bootstrap.d.ts",
            "import": "./dist/static/assets/@epa-wg/cem-studio/bootstrap.js",
            "default": "./dist/static/assets/@epa-wg/cem-studio/bootstrap.js"
        },
        "./repository": {
            "types": "./src/repository.d.ts",
            "import": "./dist/static/assets/@epa-wg/cem-studio/repository.js",
            "default": "./dist/static/assets/@epa-wg/cem-studio/repository.js"
        },
        "./feature-tour": {
            "types": "./src/feature-tour.d.ts",
            "import": "./dist/static/assets/@epa-wg/cem-studio/feature-tour.js",
            "default": "./dist/static/assets/@epa-wg/cem-studio/feature-tour.js"
        },
        "./workbench": {
            "types": "./src/workbench.d.ts",
            "import": "./dist/static/assets/@epa-wg/cem-studio/workbench.js",
            "default": "./dist/static/assets/@epa-wg/cem-studio/workbench.js"
        },
        "./shell": {
            "types": "./src/shell.d.ts",
            "import": "./dist/static/assets/@epa-wg/cem-studio/shell.js",
            "default": "./dist/static/assets/@epa-wg/cem-studio/shell.js"
        },
        "./manifest.webmanifest": "./dist/static/manifest.webmanifest",
        "./static/*": "./dist/static/*",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src/bootstrap.d.ts",
        "src/feature-tour.d.ts",
        "src/repository.d.ts",
        "src/shell.d.ts",
        "src/workbench.d.ts",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "engines": {
        "node": "^22.12.0 || ^24.0.0"
    },
    "dependencies": {
        "@epa-wg/cem-components": "0.1.1",
        "@epa-wg/cem-elements": "0.1.1",
        "@epa-wg/cem-ml-cli": "0.1.0",
        "@epa-wg/cem-theme": "0.1.1"
    },
    "devDependencies": {
        "@epa-wg/custom-element": "0.1.0",
        "@types/node": "25.6.0",
        "typescript": "6.0.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
