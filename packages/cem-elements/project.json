{
    "name": "cem-elements",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/cem-elements/src",
    "projectType": "library",
    "targets": {
        "build": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [{ "projects": ["cem_ql"], "target": "build:wasm" }],
            "inputs": [
                "{projectRoot}/package.json",
                "{projectRoot}/tsconfig.lib.json",
                "{projectRoot}/src/**/*.ts",
                "!{projectRoot}/src/**/*.spec.ts",
                "!{projectRoot}/src/**/*.test.ts",
                "!{projectRoot}/src/**/*.stories.ts",
                "{projectRoot}/scripts/package-runtime-assets.mjs",
                "{workspaceRoot}/tsconfig.base.json",
                "{workspaceRoot}/packages/cem_ql/dist/wasm/**"
            ],
            "outputs": ["{projectRoot}/dist"],
            "options": {
                "commands": [
                    "tsc --build tsconfig.lib.json",
                    "node scripts/package-runtime-assets.mjs"
                ],
                "parallel": false,
                "cwd": "{projectRoot}"
            }
        },
        "typecheck": {
            "dependsOn": [{ "projects": ["cem_ql"], "target": "build:wasm" }]
        },
        "storybook": {
            "executor": "nx:run-commands",
            "options": {
                "command": "yarn storybook dev --config-dir packages/cem-elements/.storybook --host 127.0.0.1 --port 4400 --no-open",
                "cwd": "{workspaceRoot}"
            }
        },
        "build-storybook": {
            "executor": "nx:run-commands",
            "outputs": ["{projectRoot}/storybook-static"],
            "options": {
                "command": "yarn storybook build --config-dir packages/cem-elements/.storybook --output-dir packages/cem-elements/storybook-static",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/.storybook/**/*",
                "{projectRoot}/src/**/*.ts",
                "{projectRoot}/tests/parity/legacy/**/*",
                "{projectRoot}/tests/parity/material/**/*",
                "{projectRoot}/package.json",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/yarn.lock",
                "{workspaceRoot}/examples/cem-ml/login.cem",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-transform/v1/examples/formatter-coloring-pipeline.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-transform/v1/examples/formatter-coloring-pipeline.fixture.cem",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/formatters/formatter-coloring-pipeline.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/formatters/cem-tree-helpers.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/colorizers/formatter-coloring-pipeline.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/colorizers/cem-tree-helpers.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/examples/formatter-coloring-pipeline.package-artifacts.fixture.cem"
            ]
        },
        "test": {
            "executor": "nx:run-commands",
            "dependsOn": [{ "projects": ["cem_ql"], "target": "build:wasm" }],
            "options": {
                "command": "yarn vitest --config packages/cem-elements/vitest.config.mts --project=storybook --run",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/.storybook/**/*",
                "{projectRoot}/src/**/*.ts",
                "{projectRoot}/tests/parity/legacy/**/*",
                "{projectRoot}/tests/parity/material/**/*",
                "{projectRoot}/vitest.config.mts",
                "{projectRoot}/package.json",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/yarn.lock",
                "{workspaceRoot}/examples/cem-ml/login.cem",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-transform/v1/examples/formatter-coloring-pipeline.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-transform/v1/examples/formatter-coloring-pipeline.fixture.cem",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/formatters/formatter-coloring-pipeline.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/formatters/cem-tree-helpers.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/colorizers/formatter-coloring-pipeline.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/colorizers/cem-tree-helpers.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/examples/formatter-coloring-pipeline.package-artifacts.fixture.cem"
            ],
            "outputs": []
        },
        "test:unit": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [{ "projects": ["cem_ql"], "target": "build:wasm" }],
            "options": {
                "command": "yarn vitest --config packages/cem-elements/vitest.unit.config.mts --run",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{projectRoot}/src/**/*.ts",
                "{projectRoot}/vitest.unit.config.mts",
                "{projectRoot}/package.json",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/yarn.lock",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-transform/v1/examples/formatter-coloring-pipeline.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-transform/v1/examples/formatter-coloring-pipeline.fixture.cem",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/formatters/formatter-coloring-pipeline.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/formatters/cem-tree-helpers.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/colorizers/formatter-coloring-pipeline.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/colorizers/cem-tree-helpers.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/examples/formatter-coloring-pipeline.package-artifacts.fixture.cem",
                "{workspaceRoot}/packages/cem_ml/src/legacy_custom_element.rs"
            ],
            "outputs": []
        },
        "verify-substrate": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [{ "projects": ["cem_ml_cli"], "target": "build" }],
            "options": {
                "command": "node tools/scripts/verify-cem-elements-substrate.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-elements-substrate.mjs",
                "{workspaceRoot}/examples/cem-elements/**/*.cem",
                "{workspaceRoot}/packages/cem_ml_cli/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ml/src/**/*.rs",
                "{workspaceRoot}/packages/cem_ql/src/**/*.rs"
            ],
            "outputs": []
        },
        "verify-legacy-fixtures": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/verify-cem-elements-legacy-fixtures.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-elements-legacy-fixtures.mjs",
                "{projectRoot}/tests/parity/legacy/**/*",
                "{projectRoot}/docs/legacy-parity-inventory.md"
            ],
            "outputs": []
        },
        "verify-material-fixtures": {
            "cache": true,
            "executor": "nx:run-commands",
            "options": {
                "command": "node tools/scripts/verify-cem-elements-material-fixtures.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-elements-material-fixtures.mjs",
                "{projectRoot}/tests/parity/material/**/*",
                "{projectRoot}/docs/material-parity-inventory.md"
            ],
            "outputs": []
        },
        "verify-demo-fixtures": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "options": {
                "command": "node tools/scripts/verify-cem-elements-demo-fixtures.mjs",
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-elements-demo-fixtures.mjs",
                "{projectRoot}/index.html",
                "{projectRoot}/demo/**/*",
                "{projectRoot}/src/**/*.ts",
                "{projectRoot}/package.json",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/yarn.lock"
            ],
            "outputs": []
        },
        "verify-cemt-pipeline-story": {
            "cache": false,
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "yarn storybook build --config-dir packages/cem-elements/.storybook --output-dir packages/cem-elements/storybook-static",
                    "node tools/scripts/verify-cem-elements-cemt-pipeline-story.mjs"
                ],
                "parallel": false,
                "cwd": "{workspaceRoot}"
            },
            "inputs": [
                "{workspaceRoot}/tools/scripts/verify-cem-elements-cemt-pipeline-story.mjs",
                "{projectRoot}/.storybook/**/*",
                "{projectRoot}/src/**/*.ts",
                "{projectRoot}/package.json",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/yarn.lock",
                "{workspaceRoot}/examples/cem-ml/login.cem",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-transform/v1/examples/formatter-coloring-pipeline.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-transform/v1/examples/formatter-coloring-pipeline.fixture.cem",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/formatters/formatter-coloring-pipeline.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/formatters/cem-tree-helpers.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/colorizers/formatter-coloring-pipeline.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/colorizers/cem-tree-helpers.cemt",
                "{workspaceRoot}/packages/cem_ml/schema-packages/cem-ml/v1/examples/formatter-coloring-pipeline.package-artifacts.fixture.cem"
            ],
            "outputs": []
        },
        "verify-package": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "inputs": [
                "{projectRoot}/scripts/verify-package.mjs",
                "{projectRoot}/package.json",
                {
                    "dependentTasksOutputFiles": "dist/**",
                    "transitive": false
                }
            ],
            "outputs": [],
            "options": {
                "command": "node scripts/verify-package.mjs",
                "cwd": "{projectRoot}"
            }
        },
        "test:edge-ssr-unit": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": ["cem_ql"],
                    "target": "build:wasm"
                }
            ],
            "options": {
                "command": "yarn vitest --config packages/cem-elements/vitest.edge-ssr.unit.config.mts --run"
            },
            "inputs": [
                "{projectRoot}/src/**/*.ts",
                "{projectRoot}/vitest.edge-ssr.unit.config.mts",
                "{projectRoot}/package.json",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/yarn.lock"
            ],
            "outputs": []
        },
        "test:edge-ssr": {
            "cache": true,
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": ["cem_ql"],
                    "target": "build:wasm"
                }
            ],
            "options": {
                "command": "yarn vitest --config packages/cem-elements/vitest.edge-ssr.config.mts --project=edge-ssr-storybook --run"
            },
            "inputs": [
                "{projectRoot}/.storybook-edge-ssr/**/*",
                "{projectRoot}/src/**/*.ts",
                "{projectRoot}/vitest.edge-ssr.config.mts",
                "{projectRoot}/package.json",
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/yarn.lock"
            ],
            "outputs": []
        },
        "verify-edge-ssr": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "verify-substrate",
                "test:edge-ssr-unit",
                "test:edge-ssr"
            ],
            "options": {
                "command": "echo \"Edge/SSR focused evidence gate green: substrate roundtrips, 5 processing-boundary unit cases, and 6 dedicated Storybook cases passed; external Phase 3.5 host fixtures remain roadmap work.\"",
                "cwd": "{workspaceRoot}"
            },
            "outputs": []
        },
        "verify:phase3a": {
            "executor": "nx:run-commands",
            "dependsOn": [
                { "projects": ["cem_ml_cli"], "target": "validate-fixtures" },
                { "projects": ["cem_ml_cli"], "target": "e2e" },
                { "projects": ["cem_ml"], "target": "bench" },
                "lint",
                "typecheck",
                "test:unit",
                "test",
                "verify-substrate",
                "verify-legacy-fixtures",
                "verify-material-fixtures",
                "verify-demo-fixtures",
                "verify-cemt-pipeline-story",
                "verify-package"
            ],
            "options": {
                "command": "echo \"Phase 3A browser verification gate green: lint, typecheck, unit and Storybook browser tests, CEM-ML validation/e2e/bench, substrate roundtrips, file-backed parity inventories, executable demos, the CEMT pipeline story, and the clean npm package check all passed.\"",
                "cwd": "{workspaceRoot}"
            },
            "outputs": []
        },
        "verify:phase3b": {
            "executor": "nx:run-commands",
            "dependsOn": ["verify:phase3a"],
            "options": {
                "command": "echo \"Phase 3B browser verification gate green: the Phase 3A aggregate plus bounded worker-pool, content-addressed LRU cache, fair scheduling, control-preemption, and deterministic trace evidence all passed.\"",
                "cwd": "{workspaceRoot}"
            },
            "outputs": []
        },
        "verify:phase3c": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "verify:phase3b",
                { "projects": ["cem_ql"], "target": "test:template-artifact-reload" },
                { "projects": ["cem_ql"], "target": "build:template-artifact-fixture" }
            ],
            "options": {
                "command": "echo \"Phase 3C browser verification gate green: the Phase 3B aggregate plus deterministic native component-template artifact generation, binary IR reload parity, fail-closed identity checks, optional registry loading/write-through, and source fallback evidence all passed.\"",
                "cwd": "{workspaceRoot}"
            },
            "outputs": []
        },
        "verify": {
            "executor": "nx:run-commands",
            "dependsOn": ["verify:phase3c"],
            "options": {
                "command": "echo \"cem-elements verification passed through the current Phase 3C browser gate; invoke verify-edge-ssr separately only for deferred Phase 3.5 evidence.\"",
                "cwd": "{workspaceRoot}"
            },
            "outputs": []
        }
    }
}
