{attribute @name=format | json}
{module |
    {import @as=base @src="./data-table-view.cemt"}

    {template @name=notes-as-tree @mode=inspect @priority=10
        @match='(datadom.slices.aspects ?? true) && key == "notes"
            && (node.namespace ?? "") == "cem:generic-data" && (node.name ?? "") == "array"' |
        {param @name=node}{param @name=key}
        {body |
            {call @from=base @template=tree @with:node="{$node}" @with:key="{$key}"}}}

    {template @name=ip-filter-form @mode=inspect @priority=10
        @match='(datadom.slices.aspects ?? true)
            && (node.namespace ?? "") == "cem:generic-data" && (node.name ?? "") == "object"
            && str:concat(seq:where(node.children, fn(property) => property.attributes.value == "kind").children.children.value, "") == "ip-filter"' |
        {param @name=node}
        {body |
            {cem:variable @name=address @select='datadom.slices.ipAddress ??
                str:concat(seq:where(node.children, fn(property) => property.attributes.value == "address").children.children.value, "")'}
            {cem:variable @name=action @select='datadom.slices.ipAction ??
                str:concat(seq:where(node.children, fn(property) => property.attributes.value == "action").children.children.value, "")'}
            {form @method=dialog @aria-label="IP filter" @slice=ipFilter |
                {fieldset |
                    {legend | 🛡 IP filter}
                    {label | Address / CIDR
                        {input @aria-label="Address / CIDR" @name=address @value="{$address}"
                            @slice=ipAddress @slice-event=input @slice-value="$target.value"}}
                    {label | Action
                        {select @aria-label="Action" @name=action @value="{$action}"
                            @slice=ipAction @slice-event=change |
                            {option @value=allow | ✓ Allow}{option @value=deny | ⛔ Deny}}}
                    {output @aria-live=polite | {$action}: {$address}}}
                {p | Preview only; no firewall changes or source write-back.}}
    }   }

    {body |
        {label |
            {input @type=checkbox @aria-label="Presentation aspects"
                @checked="{datadom.slices.aspects ?? true}" @slice=aspects
                @slice-event=change @slice-value="$target.checked"}
            🧩 Presentation aspects}
        {p | Switch off to see the unchanged base view. Notes become a tree;
            the IP-filter record becomes a form. Other arrays keep their tables.}
        {call @from=base @template=viewer}}
}
