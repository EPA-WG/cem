{import @as=base @src="./data-table-view.cemt"}
{template @mode=inspect
    @match='node.kind == "element" && node.name == "stock" && node.namespace == ""
        && str:trim(str:concat(node.children.value, "")) == "0"
        && dom::chain(node).parent()
            .filter(|p| p.name == "product" && p.namespace == "")
            .parent().filter(|p| p.name == "catalog" && p.namespace == "")
            .parent().any(|p| p.kind == "document")' |
    {strong | Out of stock (0)}}
{http-request @slice=catalog @url="./stock-cells.xml"
    @method=GET @content-type="application/xml"}
{cem:variable @name=state @select='datadom.slices.catalog.state ?? "loading"'}
{cem:choose |
    {cem:when @test='state == "loaded"' |
        {call @from=base @template=inspect
            @with:root='{datadom.slices.catalog.data}'}}
    {cem:when @test='state == "failed"' |
        {p @role=alert | Could not load the stock file.}}
    {cem:otherwise | {p @role=status | Loading stock…}}}
