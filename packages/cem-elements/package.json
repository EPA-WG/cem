{
    "name": "@epa-wg/cem-elements",
    "version": "0.1.1",
    "author": {
        "name": "Sasha Firsov",
        "email": "sasha@firsov.net"
    },
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/EPA-WG/cem.git",
        "directory": "packages/cem-elements"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "@epa-wg/cem": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./command-result": {
            "@epa-wg/cem": "./src/lib/command-result.ts",
            "types": "./dist/lib/command-result.d.ts",
            "import": "./dist/lib/command-result.js",
            "default": "./dist/lib/command-result.js"
        },
        "./component-generation": {
            "@epa-wg/cem": "./src/lib/internal/runtime-support/component-generation.ts",
            "types": "./dist/lib/internal/runtime-support/component-generation.d.ts",
            "import": "./dist/lib/internal/runtime-support/component-generation.js",
            "default": "./dist/lib/internal/runtime-support/component-generation.js"
        },
        "./schema-assets": {
            "@epa-wg/cem": "./src/lib/schema-asset-pack.ts",
            "types": "./dist/lib/schema-asset-pack.d.ts",
            "import": "./dist/lib/schema-asset-pack.js",
            "default": "./dist/lib/schema-asset-pack.js"
        }
    },
    "files": [
        "dist",
        "!**/*.tsbuildinfo"
    ],
    "devDependencies": {
        "@epa-wg/cem-demo-element": "workspace:^"
    },
    "publishConfig": {
        "access": "public"
    }
}
