      "imports": ["icon-link", "icon"],
      "markers": ["select=\"//selected[//selected/event] ?? //attributes/@value\"", "<xhtml:input", "hasBoolAttribute($required)", "<slice name=\"focused\""]
    },
    {
      "id": "autocomplete",
      "tag": "cem-autocomplete",
