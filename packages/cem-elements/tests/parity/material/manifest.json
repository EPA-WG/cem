      "markers": ["<a href=\"{$href}\">", "<slot></slot>", "module-url @slice=cemurl"]
    },
    {
      "id": "menu",
      "tag": "cem-menu",
      "legacy": "menu.legacy.html",
      "cemMl": "menu.cem.html",
      "imports": ["icon-link"],
      "markers": ["<attribute name=\"direction\">", "<style>", "<slot name=\"\"></slot>"]
    },
    {
      "id": "badge",
      "tag": "cem-badge",
      "legacy": "badge.legacy.html",
      "cemMl": "badge.cem.html",
      "imports": ["icon-link", "icon"],
      "markers": ["<if test=\"/datadom/slice/is-checked = 'on'\">", "slice=\"is-checked\"", "<slot></slot>"]
    },
    {
      "id": "action",
