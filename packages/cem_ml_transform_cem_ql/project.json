{
    "name": "cem_ml_transform_cem_ql",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/cem_ml_transform_cem_ql/src",
    "targets": {
        "build": {
            "cache": true,
            "executor": "@monodon/rust:check",
            "outputs": ["{options.target-dir}"],
            "options": {
                "package": "cem-ml-transform-cem-ql",
                "target-dir": "dist/target/cem_ml_transform_cem_ql"
            }
        },
        "test:ssr-exports:stripped": {
            "cache": true,
            "executor": "nx:run-commands",
            "inputs": ["default", "^default"],
            "outputs": [],
            "options": {
                "parallel": false,
                "commands": [
                    "cargo test --locked --package cem-ml-transform-cem-ql --no-default-features --test ssr_exports --target-dir dist/target/cem_ql_stripped",
                    "cargo test --locked --package cem-ml-transform-cem-ql --no-default-features --lib --target-dir dist/target/cem_ql_stripped -- ssr::tests"
                ]
            }
        },
        "test": {
            "cache": true,
            "executor": "@monodon/rust:test",
            "outputs": ["{options.target-dir}"],
            "options": {
                "package": "cem-ml-transform-cem-ql",
                "target-dir": "dist/target/cem_ml_transform_cem_ql"
            },
            "configurations": {
                "production": {
                    "release": true
                }
            }
        },
        "lint": {
            "cache": true,
            "executor": "@monodon/rust:lint",
            "outputs": ["{options.target-dir}"],
            "options": {
                "package": "cem-ml-transform-cem-ql",
                "target-dir": "dist/target/cem_ml_transform_cem_ql"
            }
        }
    },
    "tags": ["scope:cem-ml", "scope:cem-ql", "type:lib", "lang:rust"]
}
