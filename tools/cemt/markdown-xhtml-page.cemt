@doc cem-ml 1
@ns transform = "https://cem.dev/ns/transform/cem/1"
@default transform

{module @version="1.0.0" |
  {param @name="input" @type="object" @required=true}

  {template @name="page" @visibility="public" |{body |{element @name="html" @namespace="http://www.w3.org/1999/xhtml" |{attribute @name="xmlns" @value="http://www.w3.org/1999/xhtml"}{attribute @name="xml:lang" @value="en"}{attribute @name="lang" @value="en"}{element @name="head" @namespace="http://www.w3.org/1999/xhtml" |{element @name="meta" @namespace="http://www.w3.org/1999/xhtml" |{attribute @name="http-equiv" @value="Content-Type"}{attribute @name="content" @value="text/html; charset=UTF-8"}}{element @name="title" @namespace="http://www.w3.org/1999/xhtml" |{cem:for-each @select="$input.children" @as="node" |{cem:if @test='node.kind == "element" && node.name == "h1"' |{call @template="emit-text" @with:node="{$node}"}}}}{element @name="style" @namespace="http://www.w3.org/1999/xhtml" |{attribute @name="type" @value="text/css"}@import url("./index.css");}{element @name="link" @namespace="http://www.w3.org/1999/xhtml" |{attribute @name="rel" @value="stylesheet"}{attribute @name="href" @value="https://cdn.jsdelivr.net/npm/prismjs/themes/prism.css"}}{element @name="script" @namespace="http://www.w3.org/1999/xhtml" |{attribute @name="src" @value="https://cdn.jsdelivr.net/npm/prismjs/prism.js"}{attribute @name="type" @value="application/javascript"}}{element @name="script" @namespace="http://www.w3.org/1999/xhtml" |{attribute @name="src" @value="https://cdn.jsdelivr.net/npm/prismjs/components/prism-css.min.js"}{attribute @name="type" @value="application/javascript"}}{element @name="script" @namespace="http://www.w3.org/1999/xhtml" |{attribute @name="type" @value="application/javascript"}{attribute @name="defer" @value="defer"}Prism.highlightAll();}}{element @name="body" @namespace="http://www.w3.org/1999/xhtml" |{cem:for-each @select="$input.children" @as="node" |{call @template="emit-node" @with:node="{$node}"}}}}}}

  {template @name="emit-node" |{param @name="node" @type="object" @required=true}{body |{cem:choose |{cem:when @test='node.kind == "element"' |{element @name="{$node.name}" @namespace="{$node.namespace}" |{cem:for-each @select="$node.attributes" @as="attribute" |{cem:choose |{cem:when @test='attribute.name == "href"' |{attribute @name="{$attribute.name}" @namespace="{$attribute.namespace}" @value='{str:replace(attribute.value, ".md", ".xhtml")}'}}{cem:otherwise |{attribute @name="{$attribute.name}" @namespace="{$attribute.namespace}" @value="{$attribute.value}"}}}}{cem:for-each @select="$node.children" @as="child" |{call @template="emit-node" @with:node="{$child}"}}}}{cem:when @test='node.kind == "text" || node.kind == "whitespace"' |{$node.data}}{cem:when @test='node.kind == "comment"' |{comment @value="{$node.data}"}}}}}

  {template @name="emit-text" |{param @name="node" @type="object" @required=true}{body |{cem:choose |{cem:when @test='node.kind == "text" || node.kind == "whitespace"' |{$node.data}}{cem:when @test='node.kind == "element"' |{cem:for-each @select="$node.children" @as="child" |{call @template="emit-text" @with:node="{$child}"}}}}}}
}
